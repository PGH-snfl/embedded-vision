/* Raspberry Pi 4B + Adafruit Motor HAT #2348; default I2C 0x60.
 * Native C example derived from the reviewed MotorKit rover. Hardware untested.
 * M1=left, M2=right. Keep a separate motor power switch accessible.
 * Build: cc -std=c11 -Wall -Wextra -o pi_rover pi_rover.c -lm
 * Run: ./pi_rover forward --seconds 1
 */
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <fcntl.h>
#include <linux/i2c-dev.h>
#include <math.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <time.h>
#include <unistd.h>

struct command { const char *name; double left, right; };
static const struct command commands[] = {
$command_rows
};
static volatile sig_atomic_t interrupted;
static void signal_handler(int sig) { (void)sig; interrupted = 1; }
static int wr(int fd, unsigned char reg, unsigned char val) {
    unsigned char data[] = {reg, val};
    return write(fd, data, sizeof data) == (ssize_t)sizeof data ? 0 : -1;
}
/* PCA9685 12-bit, 0=full off, 4096=full on. */
static int pwm(int fd, int channel, int duty) {
    unsigned char buf[] = {(unsigned char)(0x06 + 4*channel), 0, 0, 0, 0};
    if (duty <= 0) buf[4] = 0x10;
    else if (duty >= 4096) buf[2] = 0x10;
    else {buf[3] = (unsigned char)(duty & 255); buf[4] = (unsigned char)(duty >> 8);}
    return write(fd, buf, sizeof buf) == (ssize_t)sizeof buf ? 0 : -1;
}
static int init_hat(int fd) {
    /* Default MotorKit 1600 Hz; nominal 25 MHz oscillator, prescale 3. */
    if (wr(fd,0x00,0x10) || wr(fd,0xfe,3) || wr(fd,0x00,0x20)) return -1;
    struct timespec t = {0, 5000000}; nanosleep(&t, NULL);
    if (wr(fd,0x00,0xa0)) return -1;
    /* Keep enables off while initialising both motor directions. */
    if (pwm(fd,8,0) || pwm(fd,13,0) || pwm(fd,9,0) || pwm(fd,10,0) || pwm(fd,11,0) || pwm(fd,12,0)) return -1;
    return 0;
}
static int motor(int fd, int enable, int positive, int negative, double value) {
    unsigned long raw=(unsigned long)(65535.0 * fabs(value));
    int duty=raw >= 65535UL ? 4096 : (int)(raw >> 4);
    if (value == 0) {
        /* MotorKit throttle=0 is brake: both direction inputs HIGH. */
        if (pwm(fd,positive,4096) || pwm(fd,negative,4096)) return -1;
    } else if (value > 0) {
        if (pwm(fd,negative,0) || pwm(fd,positive,duty)) return -1;
    } else {
        if (pwm(fd,positive,0) || pwm(fd,negative,duty)) return -1;
    }
    return pwm(fd,enable,4096);
}
static int stop_motors(int fd) {
    int left=motor(fd,8,9,10,0.0);
    int right=motor(fd,13,11,12,0.0);
    return left || right ? -1 : 0;
}
int main(int argc, char **argv) {
    if (argc != 2 && argc != 4) {fprintf(stderr,"Usage: %s command [--seconds 0..2]\n",argv[0]);return 2;}
    const struct command *selected=NULL;
    for (size_t i=0;i<sizeof commands/sizeof commands[0];i++) if (!strcmp(argv[1],commands[i].name)) selected=&commands[i];
    double seconds=1.0;
    if (!selected) {fprintf(stderr,"Unknown command\n");return 2;}
    if (argc == 4) {
        char *end; errno=0; seconds=strtod(argv[3],&end);
        if (strcmp(argv[2],"--seconds") || end==argv[3] || *end || errno || !isfinite(seconds) || seconds<0 || seconds>2) {fprintf(stderr,"Seconds must be 0..2\n");return 2;}
    }
    struct sigaction action={0}; action.sa_handler=signal_handler;sigemptyset(&action.sa_mask);
    sigaction(SIGINT,&action,NULL);sigaction(SIGTERM,&action,NULL);
    int fd=open("/dev/i2c-1",O_RDWR);
    if (fd<0) {perror("open /dev/i2c-1");return 1;}
    if (ioctl(fd,I2C_SLAVE,0x60)<0) {perror("I2C_SLAVE");close(fd);return 1;}
    int ok=0;
    if (init_hat(fd)) {perror("motor I2C");ok=1;}
    else if (!interrupted && motor(fd,8,9,10,selected->left)) {perror("motor I2C");ok=1;}
    else if (!interrupted && motor(fd,13,11,12,selected->right)) {perror("motor I2C");ok=1;}
    else if (!interrupted) {
        struct timespec t={(time_t)seconds,(long)((seconds-floor(seconds))*1e9)};
        while (!interrupted && nanosleep(&t,&t)<0 && errno==EINTR) {}
    }
    if (stop_motors(fd)) {fprintf(stderr,"Motor stop failed; turn motor power off.\n");ok=1;}
    close(fd);return interrupted ? 130 : ok;
}
