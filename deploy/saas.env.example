# Local example. Use the same data/origin settings for CLI, API and worker.
EV_SAAS_DATA=/home/snowflower/CVR_LAB/PCB/embedded_vision/.runtime/saas
EV_SAAS_ORIGIN=http://127.0.0.1:8770
EV_SAAS_DEVELOPMENT=1
EV_SAAS_MODE=1
EV_SAAS_AUTH_ENABLED=0
EV_SAAS_MAX_PENDING=8
EV_SAAS_DAILY_JOBS=100
EV_SAAS_ISOLATED_EDA=0
EMBEDDED_VISION_AUTO_ANALYSIS=1
# OPENAI_API_KEY belongs only in the worker's private environment/secret store.
# Optional worker secret file (not sourced as shell):
# EV_SAAS_WORKER_ENV=/path/to/private/saas-worker.env
# Production: EV_SAAS_DEVELOPMENT=0, EV_SAAS_AUTH_ENABLED=1, EV_SAAS_ORIGIN=https://your-domain.example
