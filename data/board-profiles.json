{
  "version": 1,
  "policy": {
    "selection": "prefer_observed_compatible_board_then_function_requirements",
    "fallback": "explicit_replacement_with_reason",
    "conversion": "deterministic_circuit_and_wiring_then_ai_firmware",
    "verification": "never_treat_profile_availability_as_pass",
    "same_stages": [
      "components",
      "function",
      "completion",
      "datasheet",
      "circuit",
      "structure",
      "assembly",
      "editor",
      "simulation",
      "verification"
    ]
  },
