  "activeBoardId": "U1",
  "fileGroups": {
    "group-U1": [
      {
        "name": "main.py",
        "content": "from machine import Pin\nfrom time import sleep_ms\nled = Pin(15, Pin.OUT)\nbutton = Pin(14, Pin.IN, Pin.PULL_UP)\nwhile True:\n    led.value(not button.value())\n    sleep_ms(10)\n"
      }
    ]
  },
