+import {useMemo,useEffect} from 'react';
+import {enclosureMesh,type EnclosureView as View} from './enclosureMeshes';
+import {disposeEnvironmentMesh} from './environmentMeshes';
+import {useStore} from './store';
+import {useSimulatorStore as native} from '../../store/useSimulatorStore';
+type Part=ReturnType<typeof native.getState>['components'][number];
+export function EnclosureShell({view,color}:{view:View;color:string}){
+ const mesh=useMemo(()=>enclosureMesh(view,color),[view,color]);
+ useEffect(()=>()=>disposeEnvironmentMesh(mesh),[mesh]);
+ return <primitive object={mesh}/>;
+}
+export function EnclosureControls(){
+ const parts=native(s=>s.components),mode=useStore(s=>s.enclosureView),selected=useStore(s=>s.selected);
+ const shells=parts.filter(p=>!!p.properties?.evEnclosure),modules=parts.filter(p=>!!p.properties?.evInternalHypothesis);
+ if(!shells.length)return null;
+ const change=(view:View)=>useStore.setState(s=>({enclosureView:view,selected:null,selectedNet:null,moveTarget:null,fitRevision:s.fitRevision+1}));
+ return <details className="ev-c3d-more"><summary>외장·내부 분해</summary><div>
+  {([['assembled','외장 보기'],['inside','내부 추정 보기'],['exploded','분해도']] as const).map(([view,label])=><button key={view} aria-pressed={mode===view} onClick={()=>change(view)}>{label}</button>)}
+  <small>외부 단서로 추론한 내부 후보 {modules.length}개 · 실물 내부 미확인</small>
+  <label>추정 부품 선택<select value={modules.some(m=>m.id===selected)?selected!:''} onChange={e=>{if(e.target.value)useStore.setState({enclosureView:'inside',selected:e.target.value,selectedNet:null,moveTarget:null});}}><option value="">모듈·부품 선택</option>{modules.map(p=><option value={p.id} key={p.id}>{String(p.properties.label||p.id)}</option>)}</select></label>
+ </div></details>;
+}
+export function EnclosureDetails({part}:{part:Part}){
+ const internal=part.properties?.evInternalHypothesis as {purpose?:string;rationale?:string;candidate_parts?:string[];alternatives?:string[];confidence?:'low'|'medium'|'high';photo_presence?:string}|undefined;
+ const shell=part.properties?.evEnclosure as {rationale?:string;assumptions?:string[];unknowns?:string[]}|undefined;
+ if(!internal&&!shell)return null;
+ return <div><p><strong>{internal?'내부 구성 추정 · 실제 존재 미확인':'외장 표시 모형 · 실제 내부 미확인'}</strong></p>
+  {internal?<><p>{internal.purpose}</p><p>후보: {internal.candidate_parts?.join(' / ')||'정확한 모델 미확인'}</p><p>{internal.rationale}</p><p>다른 가능성: {internal.alternatives?.join(' / ')||'추가 확인 필요'}</p><p>확신도: {internal.confidence?({low:'낮음',medium:'보통',high:'높음'})[internal.confidence]:'미확인'}</p></>:<><p>{shell?.rationale}</p><p>가정: {shell?.assumptions?.join(' / ')}</p><p>미확인: {shell?.unknowns?.join(' / ')}</p></>}
+  <p>위치·크기는 설명용 배치입니다. 실제 내부 사진이나 제작 도면이 아니며 최종 확인은 사용자가 진행합니다.</p>
+ </div>;
+}
