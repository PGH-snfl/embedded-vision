+import * as T from 'three';
+export type EnclosureView='assembled'|'inside'|'exploded';
+/** Illustrative six-panel enclosure, not a recovered CAD surface or an X-ray. */
+export function enclosureMesh(view:EnclosureView,color:string){
+ const root=new T.Group();root.name='inferred-enclosure';
+ const faces:[string,[number,number,number],[number,number,number]][]=[
+  ['base',[1,.025,1],[0,-.49,0]],['lid',[1,.025,1],[0,view==='exploded'?.95:.49,0]],
+  ['left',[.025,1,1],[view==='exploded'?-1.05:-.49,0,0]],['right',[.025,1,1],[view==='exploded'?1.05:.49,0,0]],
+  ['front',[1,1,.025],[0,0,view==='exploded'?1.05:.49]],['back',[1,1,.025],[0,0,view==='exploded'?-1.05:-.49]],
+ ];
+ for(const [name,size,position] of faces){
+  const opacity=view==='inside'?(name==='base'?.6:.13):view==='exploded'?.85:1;
+  const mesh=new T.Mesh(new T.BoxGeometry(...size),new T.MeshStandardMaterial({color,roughness:.66,metalness:.08,transparent:opacity<1,opacity,depthWrite:opacity===1}));
+  mesh.name=name;mesh.position.set(...position);mesh.visible=view!=='inside'||!['lid','front'].includes(name);root.add(mesh);
+ }
+ return root;
+}
