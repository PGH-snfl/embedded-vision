+import {buildInputFromStore} from '../simulation/spice/storeAdapter';
+import {translatedSimulationNotice} from '../components/translatedSimulationNotice';
+import fixture from './fixtures/enclosure-study.json';
+
+beforeEach(()=>{
+ sessionStorage.clear();
+ useSimulatorStore.setState({components:[],boards:[],wires:[],activeBoardId:null} as never);
+ useStore.setState({enclosureView:'inside',selected:null,moveTarget:null});
+});
+describe('functional hypotheses inside an opaque housing',()=>{
+ it('removes front/lid in cutaway and separates six panels in exploded view',()=>{
+  const assembled=enclosureMesh('assembled','#8c9ca7'),inside=enclosureMesh('inside','#8c9ca7'),exploded=enclosureMesh('exploded','#8c9ca7');
+  expect(assembled.children).toHaveLength(6);
+  expect(assembled.children.every(c=>c.visible)).toBe(true);
+  expect(inside.getObjectByName('lid')?.visible).toBe(false);
+  expect(inside.getObjectByName('front')?.visible).toBe(false);
+  expect((inside.getObjectByName('left') as T.Mesh).material).toMatchObject({transparent:true,depthWrite:false,opacity:.13});
+  const a=new T.Box3().setFromObject(assembled).getSize(new T.Vector3()),b=new T.Box3().setFromObject(exploded).getSize(new T.Vector3());
+  expect(b.x).toBeGreaterThan(a.x*1.9);expect(b.z).toBeGreaterThan(a.z*1.9);
+  [assembled,inside,exploded].forEach(disposeEnvironmentMesh);
+ });
+ it('round-trips the separate study with no MCU, wires or electrical input',async()=>{
+  await importVlxFile({text:async()=>JSON.stringify(fixture)} as File);
+  const state=useSimulatorStore.getState();
+  expect(state.boards).toEqual([]);expect(state.components).toHaveLength(5);expect(state.wires).toEqual([]);
+  expect(state.components.every(p=>geometryFor(p).pins.length===0)).toBe(true);
+  expect(buildInputFromStore({...state,boards:[]}).components).toEqual([]);
+  const project=registerProject(state);expect(project.board).toBe('none');expect(project.nets).toEqual([]);
+  expect(buildVlxPayload().components).toEqual(fixture.components);
+  const before=JSON.stringify(state.components);
+  useStore.setState({enclosureView:'exploded'});
+  expect(JSON.stringify(useSimulatorStore.getState().components)).toBe(before);
+  expect(translatedSimulationNotice(fixture.embeddedVision.recipe)).toContain('추론');
+ });
+ it('offers three views and reports unknown presence on selection without a generic detail overlay',async()=>{
+  expect(renderToStaticMarkup(createElement(EnclosureControls))).toBe('');
+  expect(renderToStaticMarkup(createElement(EnclosureDetails,{part:{id:'x',metadataId:'led',x:0,y:0,properties:{}}}))).toBe('');
+  await importVlxFile({text:async()=>JSON.stringify(fixture)} as File);
+  const host=document.createElement('div'),root=createRoot(host);
+  (globalThis as {IS_REACT_ACT_ENVIRONMENT?:boolean}).IS_REACT_ACT_ENVIRONMENT=true;
+  await act(async()=>root.render(createElement(EnclosureControls)));
+  const controls=host.innerHTML;
+  expect(controls).toContain('외장 보기');expect(controls).toContain('내부 추정 보기');expect(controls).toContain('분해도');
+  const card=renderToStaticMarkup(createElement(EnclosureDetails,{part:useSimulatorStore.getState().components[1]}));
+  expect(card).toContain('실제 존재 미확인');expect(card).toContain('설명용 배치');
+  expect(useStore.getState().selected).toBeNull();expect(useStore.getState().moveTarget).toBeNull();
+  const buttons=host.querySelectorAll('button');
+  await act(async()=>buttons[2].click());expect(useStore.getState().enclosureView).toBe('exploded');
+  expect(useStore.getState().moveTarget).toBeNull();
+  await act(async()=>root.unmount());
+ });
+});
