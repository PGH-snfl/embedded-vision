+ p.nets[0].endpoints.reverse();const reverse=guideWireRoute(p,step)!;expect(reverse[0]).toEqual([0,0,0]);expect(reverse.at(-1)![0]).toBeCloseTo(.3);
+ p.nets[0].hidden=true;expect(guideWireRoute(p,step)).toBeNull();p.nets[0].hidden=false;p.components=[];expect(guideWireRoute(p,step)).toBeNull();expect(guideWireRoute(project(),{...step,kind:'insert'})).toBeNull();
