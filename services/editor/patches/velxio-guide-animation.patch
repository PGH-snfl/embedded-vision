+import {useEffect,useMemo,useRef,useState} from 'react';
+import {useFrame} from '@react-three/fiber';
+import {Line} from '@react-three/drei';
+import * as T from 'three';
+import type {Project} from './project/schema';
+import type {AssemblyStep} from './assemblyGuide';
+import type {V} from './connectedWiring';
+import {guideMotionFrame,guideWireRoute,prepareGuideRoute,sampleGuideRoute} from './guideMotion';
+import {reducedViewMotion} from './photoViewMotion';
+
+function WirePass({points,reduced}:{points:V[];reduced:boolean}){
+ const group=useRef<T.Group>(null),dot=useRef<T.Mesh>(null),began=useRef<number|null>(null);
+ const key=JSON.stringify(points),route=useMemo(()=>prepareGuideRoute(points),[key]);
+ useEffect(()=>{began.current=null;},[key,reduced]);
+ useFrame(({clock})=>{
+  if(!group.current||!dot.current||!route)return;
+  const now=clock.elapsedTime*1000;if(began.current===null)began.current=now;
+  const frame=guideMotionFrame(now-began.current,reduced);group.current.visible=!!frame;
+  if(frame){dot.current.position.set(...sampleGuideRoute(route,frame.progress));(dot.current.material as T.MeshBasicMaterial).opacity=frame.opacity;}
+ });
+ if(!route||reduced)return null;
+ return <group ref={group} name="guide-connection-animation" raycast={()=>{}}>
+  <Line points={points} color="#4c9dce" lineWidth={2.4} transparent opacity={.45} depthTest={false} raycast={()=>{}}/>
+  <mesh ref={dot} renderOrder={120} raycast={()=>{}}><sphereGeometry args={[.0017,12,12]}/><meshBasicMaterial color="#fff7cc" transparent opacity={0} depthTest={false} depthWrite={false}/></mesh>
+ </group>;
+}
+export function GuideWireMotion({project,connections}:{project:Project;connections:AssemblyStep[]}){
+ const [reduced,setReduced]=useState(reducedViewMotion);
+ useEffect(()=>{
+  if(typeof window.matchMedia!=='function')return;
+  const media=window.matchMedia('(prefers-reduced-motion: reduce)'),update=()=>setReduced(media.matches);
+  media.addEventListener?.('change',update);return()=>media.removeEventListener?.('change',update);
+ },[]);
+ return <group name="guide-wire-motion">{connections.map(step=>{const points=guideWireRoute(project,step);return points?<WirePass key={step.from+'>'+step.to} points={points} reduced={reduced}/>:null;})}</group>;
+}
