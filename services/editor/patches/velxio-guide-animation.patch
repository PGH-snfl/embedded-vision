@@ -0,0 +1,33 @@
+import type {Project} from './project/schema';
+import type {AssemblyStep} from './assemblyGuide';
+import {resolveGuidePin} from './assemblyGuide';
+import {connectedWirePath,type V} from './connectedWiring';
+
+/** Only an existing, visible wire supplies a route. Never invent a shortcut. */
+export function guideWireRoute(project:Project,step:AssemblyStep):V[]|null{
+ if(step.kind!=='jumper')return null;
+ const a=resolveGuidePin(project,step.from),b=resolveGuidePin(project,step.to);
+ if(!a||!b)return null;
+ const net=project.nets.find(n=>!n.hidden&&n.endpoints.length===2&&n.endpoints.includes(a.ref)&&n.endpoints.includes(b.ref));
+ if(!net)return null;
+ const route=connectedWirePath(project,net);if(!route)return null;
+ return net.endpoints[0]===a.ref?route.points.map(p=>[...p] as V):route.points.map(p=>[...p] as V).reverse();
+}
+export function prepareGuideRoute(points:V[]){
+ if(points.length<2||points.some(p=>p.length!==3||p.some(x=>!Number.isFinite(x))))return null;
+ const lengths=[0];for(let i=1;i<points.length;i++)lengths.push(lengths[i-1]+Math.hypot(...points[i].map((v,j)=>v-points[i-1][j])));
+ const total=lengths.at(-1)!;return Number.isFinite(total)&&total>1e-9?{points,lengths,total}:null;
+}
+export function sampleGuideRoute(route:NonNullable<ReturnType<typeof prepareGuideRoute>>,progress:number):V{
+ const distance=Math.max(0,Math.min(1,progress))*route.total;
+ for(let i=1;i<route.points.length;i++)if(distance<=route.lengths[i]){
+  const amount=(distance-route.lengths[i-1])/(route.lengths[i]-route.lengths[i-1]||1);
+  return route.points[i-1].map((v,j)=>v+(route.points[i][j]-v)*amount) as V;
+ }
+ return [...route.points.at(-1)!];
+}
+/** One complete 1→2 pass, then hide. Replaying is an explicit user action. */
+export function guideMotionFrame(elapsedMs:number,reduced=false){
+ const time=Math.max(0,elapsedMs);if(reduced||time>=2100)return null;
+ return {progress:Math.min(1,time/1800),opacity:Math.min(1,time/120,(2100-time)/300)};
+}
