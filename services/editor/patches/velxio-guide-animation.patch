+.ev-guide-connection-sentence{padding:10px 12px;border-left:3px solid #297e63;background:#edf6f1;border-radius:5px;line-height:1.8;overflow-wrap:anywhere;}
+.ev-guide-draw{stroke-dasharray:1;stroke-dashoffset:1;animation:ev-guide-draw 1s ease-out forwards;}
+.ev-guide-motion-dot{animation:ev-guide-dot-fade 1.8s linear both;}
+.ev-guide-pin-pulse{transform-box:fill-box;transform-origin:center;animation:ev-guide-pin-pulse 1.4s ease-out;}
+.ev-guide-part-enter{animation:ev-guide-seat .6s ease-out both;}
+.ev-guide-pin-label{animation:ev-guide-label .9s ease-out;}
+@keyframes ev-guide-enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
+@keyframes ev-guide-draw{to{stroke-dashoffset:0}}
+@keyframes ev-guide-dot-fade{0%{opacity:0}10%,82%{opacity:1}100%{opacity:0}}
+@keyframes ev-guide-pin-pulse{0%,100%{transform:scale(1)}40%{transform:scale(1.35)}}
+@keyframes ev-guide-seat{from{opacity:.4;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
+@keyframes ev-guide-label{from{opacity:.45}to{opacity:.88}}
+@media(prefers-reduced-motion:reduce){
+ .ev-guide-step-content,.ev-guide-phase-enter,.ev-guide-draw,.ev-guide-pin-pulse,.ev-guide-part-enter,.ev-guide-pin-label{animation:none;transform:none;}
+ .ev-guide-draw{stroke-dashoffset:0;}
+ .ev-guide-motion-dot{display:none;animation:none;}
+}
