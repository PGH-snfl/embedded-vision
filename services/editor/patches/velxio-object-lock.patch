+/** Selection alone never enables movement. The activation is per object. */
+export function canDragComponent(options:{selected:boolean;armed:boolean;simulating:boolean;wireMode:boolean}){
+ return options.selected&&options.armed&&!options.simulating&&!options.wireMode;
+}
+export function movementObjectId(id:string,activeBoardId:string|null|undefined){
+ return id==='__board__'?activeBoardId||null:id.startsWith('__board__:')?id.slice('__board__:'.length):id;
+}
