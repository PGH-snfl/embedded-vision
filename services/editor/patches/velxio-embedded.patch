+function DefaultBody({
+  config,
+  componentId,
+  schematicSymbol,
+  onClick,
+  selected,
+  lit,
+  brightness,
+  pixels,
+  isButton,
+  simActive,
+}: {
+  config?: Record<string, unknown>;
+  componentId: string;
+  schematicSymbol?: string;
+  onClick: (e: ThreeEvent<MouseEvent>) => void;
