+import { describe, expect, it } from 'vitest';
+import { topViewFitZoom } from '../components/circuitiny/sceneCamera';
+
+describe('top view scene fit', () => {
+  it('uses the full wide viewport for a wide breadboard without clipping', () => {
+    const span = {x:.50, z:.14}, size = {width:1600, height:650};
+    const zoom = topViewFitZoom(span, size);
+    expect(zoom).toBeGreaterThan(2700);
+    expect(span.x * zoom).toBeLessThan(size.width);
+    expect(span.z * zoom).toBeLessThan(size.height);
+  });
+  it('fits a wide circuit on a narrow viewport and a tall circuit on a wide viewport', () => {
+    for (const [span,size] of [
+      [{x:.50,z:.14},{width:450,height:700}],
+      [{x:.14,z:.50},{width:1600,height:650}],
+    ] as const) {
+      const zoom = topViewFitZoom(span,size);
+      expect(span.x * zoom).toBeLessThanOrEqual(size.width);
+      expect(span.z * zoom).toBeLessThanOrEqual(size.height);
+      expect(Math.max(span.x * zoom / size.width, span.z * zoom / size.height)).toBeCloseTo(1 / 1.15, 5);
+    }
+  });
+});
