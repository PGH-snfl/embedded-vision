@@ -0,0 +1,49 @@
+import type { AssemblyStep } from './assemblyGuide';
+import { findStepWire } from './assemblyGuide';
+import type { Wire } from '../../types/wire';
+
+export type Hole = { row: string; column: number; ref: string };
+export type Placement = { pin: string; hole: Hole; current: boolean };
+
+/** Each insertion connection keeps the same number and color in the map and 3D view. */
+const CONNECTION_COLORS = ['#1768c8', '#c65c05', '#7654a5', '#0c8060', '#a02760', '#356274', '#8a5b00', '#684187'];
+export function guideConnectionColor(index: number): string {
+  return CONNECTION_COLORS[index % CONNECTION_COLORS.length];
+}
+export function guideConnectionNumber(index: number): string {
+  return index < 20 ? String.fromCodePoint(0x2460 + index) : String(index + 1);
+}
+
+/** Parse only actual full-size breadboard pin names, not an inferred position. */
+export function guideHole(ref: string): Hole | null {
+  const match = /^BB1\.(\d+)([tb])\.([a-j])$/.exec(ref);
+  if (!match) return null;
+  const column = Number(match[1]);
+  const row = match[3];
+  if (column < 1 || column > 63 || (match[2] === 't') !== ('abcde'.includes(row))) return null;
+  return { row: row.toUpperCase(), column, ref };
+}
+
+/** The other legs are taken from the original assembly steps and verified live. */
+export function graphicPlacements(step: AssemblyStep, steps: AssemblyStep[], wires: Wire[]): Placement[] | null {
+  const target = guideHole(step.to);
+  if (!target || !findStepWire(step, wires)) return null;
+  if (step.kind !== 'insert') return [{ pin: step.from.split('.').slice(1).join('.'), hole: target, current: true }];
+  const id = step.from.split('.')[0];
+  const seats = steps.filter(s => s.kind === 'insert' && s.from.split('.')[0] === id);
+  if (!seats.length || seats.some(s => !guideHole(s.to) || !findStepWire(s, wires)) ||
+      new Set(seats.map(s => s.from)).size !== seats.length ||
+      new Set(seats.map(s => s.to)).size !== seats.length) return null;
+  return seats.map(s => ({pin: s.from.split('.').slice(1).join('.'), hole: guideHole(s.to)!, current: s.from === step.from && s.to === step.to}));
+}
+
+/** Include adjacent columns and every known seat; never imply positions outside the breadboard. */
+export function graphicColumns(placements: Placement[]): number[] {
+  if (!placements.length) return [];
+  const columns = placements.map(p => p.hole.column);
+  const min = Math.max(1, Math.min(...columns) - 1);
+  const max = Math.min(63, Math.max(...columns) + 1);
+  // Unusually wide custom components cannot be legibly shown in a 3D guide card.
+  if (max - min > 12) return [];
+  return Array.from({length:max - min + 1}, (_, i) => min + i);
+}
