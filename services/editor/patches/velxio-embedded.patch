+}
+@media (max-width: 767px) {
+  .ev-3d-controls {
+    top: 6px;
+    left: 6px;
+    gap: 3px;
+  }
+  .ev-3d-controls button {
+    padding: 7px;
+    font-size: 10px;
+  }
+  .ev-3d-help {
+    max-width: 85%;
+    font-size: 9px;
+    bottom: 25px;
+  }
+  .ev-3d-note {
+    font-size: 8px;
+  }
+  .ev-3d-selection {
