@@ -0,0 +1,565 @@
+import { useEffect, useLayoutEffect, useRef, useState } from 'react';
+import Viewer3D from './Viewer3D';
+import { connectCircuitiny, encodePin } from './bridge';
+import { useStore } from './store';
+import { definitions } from './catalog';
+import { useSimulatorStore as native } from '../../store/useSimulatorStore';
+import { useOscilloscopeStore } from '../../store/useOscilloscopeStore';
+import { ComponentRegistry } from '../../services/ComponentRegistry';
+import { PartInspectorDialog } from '../simulator/PartInspectorDialog';
+import { SensorControlPanel } from '../simulator/SensorControlPanel';
+import { getSensorControlForComponent } from '../../simulation/sensorControlConfig';
+import { readPinInfo } from '../../utils/readPinInfo';
+import { sharedTool, SHARED_PIN_EVENT } from './sharedTools';
+import { guideSteps, findStepWire, readableRef, guideWarning } from './assemblyGuide';
+import { guideConnectionColor, guideConnectionNumber } from './guideGraphic';
+import { GuideGraphic } from './GuideGraphic';
+import { useBreadboardHoverPreview } from './useBreadboardHoverPreview';
+import { isBreadboard } from '../../utils/breadboardNets';
+import {
+  rotateSelected,
+  copySelected,
+  pasteSelected,
+  deleteSelected,
+  propertyChange,
+  wireChange,
+  addWaypoint,
+  splitAt,
+  probeWire,
+  runtimeButton,
+  runtimeLatchButton,
+  runtimeSwitch,
+  releaseButtons,
+  releaseAllButtons,
+} from './actions';
+import './CircuitinyEditor.css';
+
+export function CircuitinyEditor({ onEdit }: { onEdit: () => void }) {
+  const hoverPreview = useBreadboardHoverPreview();
+  const [guide] = useState(() => guideSteps(window.location.hash));
+  const [guideOpen, setGuideOpen] = useState(false);
+  const [guideIndex, setGuideIndex] = useState(0);
+  const [guideFocusRevision, setGuideFocusRevision] = useState(0);
+  const guidePanel = useRef<HTMLElement>(null);
+  useLayoutEffect(() => { if (guidePanel.current) guidePanel.current.scrollTop = 0; }, [guideIndex, guideOpen]);
+  const [details, setDetails] = useState(false),
+    [start, setStart] = useState(''),
+    [end, setEnd] = useState(''),
+    [inspector, setInspector] = useState<string | null>(null),
+    [sensor, setSensor] = useState<string | null>(null);
+  const project = useStore((s) => s.project),
+    selected = useStore((s) => s.selected),
+    moveTarget = useStore((s) => s.moveTarget),
+    selectedNet = useStore((s) => s.selectedNet),
+    wireMode = useStore((s) => s.wireMode),
+    message = useStore((s) => s.message),
+    running = useStore((s) => s.simulating),
+    wireColor = useStore((s) => s.wireColor),
+    brightness = useStore((s) => s.externalBrightness),
+    timing = useStore((s) => s.externalTiming);
+  const endpointDrag = useStore((s) => s.endpointDrag);
+  const components = native((s) => s.components),
+    boards = native((s) => s.boards),
+    historyIndex = native((s) => s.historyIndex),
+    historyLength = native((s) => s.history.length),
+    clipboard = native((s) => s.canvasClipboard),
+    wires = native((s) => s.wires),
+    movableInfrastructure = native((s) => s.infrastructureMoveEnabled),
+    resetNonce = native((s) => s.sensorResetNonce);
+  const component = components.find((c) => c.id === selected),
+    board = boards.find((b) => b.id === selected),
+    wire = wires.find((w) => w.id === selectedNet),
+    registry = ComponentRegistry.getInstance(),
+    meta = component && registry.getById(component.metadataId);
+  const lockedPosition = !movableInfrastructure && (!!board || !!(component && isBreadboard(component.metadataId)));
+  useEffect(() => {
+    if (moveTarget && (moveTarget !== selected || running || wireMode || lockedPosition || (!component && !board))) {
+      useStore.setState({ moveTarget: null });
+    }
+  }, [moveTarget, selected, running, wireMode, lockedPosition, component, board]);
+  const guideStep = guide.steps[guideIndex];
+  const guideWire = guideStep && findStepWire(guideStep, wires);
+  const guideProblem = guideStep ? guideWarning(guideStep, wires, project) : '';
+  const guidePart = guideStep && components.find(c => c.id === guideStep.from.split('.')[0]);
+  const inspectPart = components.find((c) => c.id === inspector),
+    inspectMeta = inspectPart && registry.getById(inspectPart.metadataId);
+  const sensorPart = components.find((c) => c.id === sensor),
+    sensorDef = component && getSensorControlForComponent(component);
+  const previousIds = useRef(new Set([...components, ...boards].map((i) => i.id)));
+  useEffect(() => connectCircuitiny(), []);
+  useEffect(() => {
+    const pick = (event: Event) => {
+      if (native.getState().running) return;
+      const { id, pin } = (event as CustomEvent<{ id: string; pin: string }>).detail;
+      const state = useStore.getState();
+      const board = state.project.boards?.find((b) => b.instance === id);
+      event.preventDefault();
+      useStore.setState({ wireMode: true });
+      useStore.getState().clickPin(`${board?.config?.pinOwner || id}.${encodePin(pin)}`);
+    };
+    window.addEventListener(SHARED_PIN_EVENT, pick);
+    return () => window.removeEventListener(SHARED_PIN_EVENT, pick);
+  }, []);
+  useEffect(() => {
+    const fresh = [...components, ...boards].filter((i) => !previousIds.current.has(i.id));
+    previousIds.current = new Set([...components, ...boards].map((i) => i.id));
+    if (fresh.length)
+      useStore.setState((s) => ({
+        selected: fresh.at(-1)!.id,
+        selectedNet: null,
+        fitRevision: s.fitRevision + 1,
+      }));
+  }, [components, boards]);
+  useEffect(() => {
+    window.addEventListener('blur', releaseButtons);
+    window.addEventListener('pointerup', releaseButtons);
+    return () => {
+      releaseAllButtons();
+      window.removeEventListener('blur', releaseButtons);
+      window.removeEventListener('pointerup', releaseButtons);
+    };
+  }, []);
+  useEffect(() => { if (!running) releaseAllButtons(); }, [running]);
+  const pinGroups = [...(project.boards || []), ...project.components];
+  const selectNet = (id: string) => {
+    useStore.setState({ selected: null, selectedNet: id, selectedPoint: null });
+    native.getState().setSelectedWire(id);
+  };
+  const keys = (e: React.KeyboardEvent) => {
+    const t = e.target as HTMLElement;
+    if (t.closest('input,textarea,select,[contenteditable="true"],[role="dialog"]')) return;
+    const mod = e.ctrlKey || e.metaKey,
+      key = e.key.toLowerCase();
+    let handled = true;
+    if (running) return;
