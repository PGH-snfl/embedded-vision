+ return <header className="ev-topbar">
+  <div className="ev-project">
+   <div className="ev-eyebrow"><a href={returnUrl} target="_blank" rel="noreferrer">← 사진 분석</a><span>EMBEDDED VISION / SIMULATOR</span></div>
