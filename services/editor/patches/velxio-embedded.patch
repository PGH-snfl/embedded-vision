+import { describe, it, expect } from 'vitest';
+import { breadboardHoverPreview as preview, directBreadboardComponents as direct } from '../utils/breadboardHoverPreview';
+import type { Wire } from '../types/wire';
+
+const components = [
+  { id: 'BB1', metadataId: 'breadboard' },
+  { id: 'BB2', metadataId: 'breadboard-mini' },
+  { id: 'R1', metadataId: 'resistor' },
+  { id: 'D1', metadataId: 'led' },
+  { id: 'R2', metadataId: 'resistor' },
+];
+const endpoint = (componentId: string, pinName: string) => ({componentId, pinName, x: 0, y: 0});
+const wire = (id: string, a: [string, string], b: [string, string], bb = false): Wire =>
+  ({id, start: endpoint(...a), end: endpoint(...b), waypoints: [], color: '#abcdef', bb});
+const wires = [
+  wire('seat-r1', ['BB1','23t.b'], ['R1','1'], true),
+  wire('jumper', ['BB1','23t.c'], ['BB2','5b.g']),
+  wire('seat-d1', ['D1','A'], ['BB2','5b.j'], true),
+  wire('direct', ['D1','A'], ['U1','5']),
+  wire('other-leg', ['R1','2'], ['BB1','24t.a'], true),
+  wire('unrelated', ['R2','1'], ['BB1','23b.f'], true),
+];
+
+describe('breadboard hover preview', () => {
+  it('traces existing wires and other boards but never crosses a component', () => {
+    const original = structuredClone({components,wires});
+    const result = preview(components, wires, endpoint('BB1','23t.e'))!;
+    expect(result.groups.map(g => [g.breadboardId, g.groupKey])).toEqual(expect.arrayContaining([
+      ['BB1','col23t'], ['BB2','col5b'],
+    ]));
+    expect(result.groups.find(g => g.breadboardId === 'BB1')!.holeNames).toEqual(['23t.a','23t.b','23t.c','23t.d','23t.e']);
+    expect(result.groups.find(g => g.breadboardId === 'BB2')!.holeNames).toEqual(['5b.f','5b.g','5b.h','5b.i','5b.j']);
+    expect(result.componentIds.sort()).toEqual(['D1','R1','U1']);
+    expect(result.wireIds.sort()).toEqual(['direct','jumper','seat-d1','seat-r1']);
+    expect(result.endpoints).toContainEqual({componentId:'R1',pinName:'1'});
+    expect(result.endpoints).not.toContainEqual({componentId:'R1',pinName:'2'});
+    expect({components,wires}).toEqual(original);
+  });
+  it('keeps the two banks separated across the trench', () => {
+    const result = preview(components, wires, endpoint('BB1','23b.j'))!;
+    expect(result.groups).toHaveLength(1);
+    expect(result.groups[0].holeNames).toEqual(['23b.f','23b.g','23b.h','23b.i','23b.j']);
+    expect(result.componentIds).toEqual(['R2']);
+  });
+  it('shows a complete power rail without merging other rails', () => {
+    const result = preview(components, [wire('rail', ['U1','5V'], ['BB1','tp.7'])], endpoint('BB1','tp.50'))!;
+    expect(result.groups[0].holeNames).toHaveLength(50);
+    expect(result.groups[0].holeNames).toContain('tp.1');
+    expect(result.groups[0].holeNames).not.toContain('tn.1');
+    expect(result.componentIds).toEqual(['U1']);
+  });
+  it('rejects non-existent holes, wrong bank and mini-board rails', () => {
+    for (const [id,pin] of [['BB1','64t.a'],['BB1','2t.f'],['BB1','tp.51'],['BB2','tp.1'],['R1','1'],['BAD','1t.a']])
+      expect(preview(components,wires,endpoint(id,pin))).toBeNull();
+  });
+  it('excludes the dragged wire so its former net does not bridge the preview', () => {
+    const withoutDragged = preview(components,wires,endpoint('BB1','23t.a'),'jumper')!;
+    expect(withoutDragged.groups).toHaveLength(1);
+    expect(withoutDragged.wireIds).toEqual(['seat-r1']);
+    expect(withoutDragged.componentIds).toEqual(['R1']);
+  });
+});
+
+describe('components physically on the hovered breadboard strip', () => {
+  it('returns direct seated parts once and ignores jumpers and remote strips', () => {
+    const seats = [
+      wire('seat-a', ['R1','1'], ['BB1','23t.b'], true),
+      wire('seat-b', ['BB1','23t.d'], ['D1','A'], true),
+      wire('duplicate', ['D1','A'], ['BB1','23t.e'], true),
+      wire('other-bank', ['R2','1'], ['BB1','23b.f'], true),
+      wire('remote', ['R2','2'], ['BB2','5b.g'], true),
+      wire('bridge', ['BB1','23t.c'], ['BB2','5b.f']),
+      wire('board', ['BB1','23t.a'], ['U1','5']),
+    ];
+    const original = structuredClone({components, seats});
+    expect(direct(components,seats,endpoint('BB1','23t.a')).sort()).toEqual(['D1','R1']);
+    expect(direct(components,seats,endpoint('BB1','23b.j'))).toEqual(['R2']);
+    expect(direct(components,seats,endpoint('BB2','5b.h'))).toEqual(['R2']);
+    expect({components,seats}).toEqual(original);
+  });
+  it('validates the target and honors wire exclusion and rails', () => {
+    const seats = [wire('seat', ['R1','1'], ['BB1','tp.3'], true),
+      wire('not-seated', ['D1','A'], ['BB1','tp.5'])];
+    expect(direct(components,seats,endpoint('BB1','tp.50'))).toEqual(['R1']);
+    expect(direct(components,seats,endpoint('BB1','tp.50'),'seat')).toEqual([]);
+    expect(direct(components,seats,endpoint('BB1','tp.51'))).toEqual([]);
+    expect(direct(components,seats,endpoint('BB1','23t.f'))).toEqual([]);
+    expect(direct(components,seats,endpoint('R1','1'))).toEqual([]);
+  });
+});
