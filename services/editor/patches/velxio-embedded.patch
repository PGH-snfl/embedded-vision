+/** Shared native edits: 3D never owns a second electrical circuit or undo stack. */
+import { useSimulatorStore as native } from '../../store/useSimulatorStore';
+import { useElectricalStore } from '../../store/useElectricalStore';
+import { useOscilloscopeStore } from '../../store/useOscilloscopeStore';
+import { resolveProbe } from '../../simulation/probeResolve';
+import { useStore } from './store';
+import { geometryFor } from './geometry';
+import { PX } from './catalog';
+import { isBreadboard } from '../../utils/breadboardNets';
+
+export function edit(action: () => void) {
+  try {
+    if (native.getState().running) throw new Error('정지한 뒤 회로를 편집하세요.');
+    action();
+  } catch (e) {
+    useStore.setState({ message: e instanceof Error ? e.message : '편집하지 못했습니다.' });
+  }
+}
+export function atomic(label: string, change: () => void) {
+  const state = native.getState(),
+    before = {
+      components: state.components,
+      wires: state.wires,
+      boards: state.boards,
+      boardPosition: state.boardPosition,
+    };
+  change();
+  const after = native.getState();
+  const next = {
+    components: after.components,
+    wires: after.wires,
+    boards: after.boards,
+    boardPosition: after.boardPosition,
+  };
+  state.pushCommand(
+    {
+      description: label,
+      execute: () => native.setState(next),
+      undo: () => native.setState(before),
+    },
+    { applyNow: false },
+  );
+}
+export function rotateSelected(id: string) {
+  edit(() => {
+    const s = native.getState(),
+      c = s.components.find((c) => c.id === id),
+      b = s.boards.find((b) => b.id === id);
+    if (c && isBreadboard(c.metadataId)) {
+      const riders = new Set(
+        s.wires
+          .filter((w) => w.bb && (w.start.componentId === id || w.end.componentId === id))
+          .map((w) => (w.start.componentId === id ? w.end.componentId : w.start.componentId)),
+      );
+      const before = s.components
+          .filter((part) => riders.has(part.id))
+          .map((part) => ({ part, g: geometryFor(part) })),
+        pivot = geometryFor(c).position;
+      atomic('3D rotate breadboard with parts', () => {
+        s.updateComponent(id, {
+          properties: {
+            ...c.properties,
+            rotation: ((Number(c.properties.rotation) || 0) + 90) % 360,
+          },
+        });
+        for (const { part, g } of before) {
+          const next = {
+              ...part,
+              properties: {
+                ...part.properties,
+                rotation: ((Number(part.properties.rotation) || 0) + 90) % 360,
+              },
+            },
+            offset = geometryFor(next).offset;
+          const x = pivot[0] - (g.position[2] - pivot[2]),
+            z = pivot[2] + g.position[0] - pivot[0];
+          s.updateComponent(part.id, {
+            x: x / PX - offset.x,
+            y: z / PX - offset.y,
+            properties: next.properties,
+          });
+        }
+      });
+    } else if (c) {
+      atomic('3D rotate and seating', () =>
+        s.updateComponent(id, {
+          properties: {
+            ...c.properties,
+            rotation: ((Number(c.properties.rotation) || 0) + 90) % 360,
+          },
+        }),
+      );
+    } else if (b) {
+      atomic('3D rotate board', () => s.rotateBoard(id));
+    }
+  });
+}
+export function copySelected(id: string) {
+  edit(() => {
+    const s = native.getState();
+    if (s.components.some((c) => c.id === id)) s.copyComponent(id);
+    else s.copyBoard(id);
+    useStore.setState({ message: '복사했습니다. 붙여넣기로 새 부품을 만드세요.' });
+  });
+}
+export function pasteSelected() {
+  edit(() => {
+    const p = native.getState().pasteClipboard();
+    if (p)
+      useStore.setState((v) => ({
+        selected: p.id,
+        selectedNet: null,
+        fitRevision: v.fitRevision + 1,
+      }));
+  });
+}
+export function deleteSelected(id: string) {
+  edit(() => {
+    const s = native.getState();
+    if (s.components.some((c) => c.id === id)) s.recordRemoveComponent(id);
+    else s.removeBoard(id);
+    useStore.setState({ selected: null });
+  });
+}
+export function propertyChange(id: string, key: string, value: unknown) {
+  edit(() => {
+    const s = native.getState(),
+      c = s.components.find((c) => c.id === id);
+    if (c && c.properties[key] !== value) {
+      s.updateComponent(id, { properties: { ...c.properties, [key]: value } });
+      s.recordSetProperty(id, key, c.properties[key], value);
+    }
+  });
+}
+export function wireChange(
+  id: string,
+  changes: { color?: string; waypoints?: Array<{ x: number; y: number }>; autoRouted?: boolean },
+) {
+  edit(() => {
+    const s = native.getState(),
+      wire = s.wires.find((w) => w.id === id);
+    if (!wire || wire.bb) return;
+    const before = Object.fromEntries(
+      Object.keys(changes).map((k) => [k, wire[k as keyof typeof wire]]),
+    );
+    s.recordUpdateWire(id, before, changes);
+  });
+}
+export function moveWaypoint(id: string, index: number, p: [number, number, number]) {
+  const w = native.getState().wires.find((w) => w.id === id);
+  if (!w) return;
+  wireChange(id, {
+    waypoints: w.waypoints.map((v, i) => (i === index ? { x: p[0] / PX, y: p[2] / PX } : v)),
+    autoRouted: false,
+  });
+}
+export function addWaypoint(id: string) {
+  const w = native.getState().wires.find((w) => w.id === id);
+  if (w)
+    wireChange(id, {
+      waypoints: [...w.waypoints, { x: (w.start.x + w.end.x) / 2, y: (w.start.y + w.end.y) / 2 }],
+      autoRouted: false,
+    });
+}
+export function splitAt(id: string, p: [number, number, number]) {
+  edit(() => {
+    const s = native.getState();
+    s.recalculateAllWirePositions();
+    const junction = s.splitWireWithJunction(id, p[0] / PX, p[2] / PX, 18);
+    if (junction)
+      useStore.setState({
+        selected: junction,
+        selectedNet: null,
+        message: '실제 연결 분기점을 추가했습니다.',
+      });
+    else useStore.setState({ message: '배선 위의 위치를 선택하세요.' });
+  });
+}
+export function probeWire(id: string) {
+  const state = native.getState(),
+    wire = state.wires.find((w) => w.id === id);
+  if (!wire) return;
+  const target = resolveProbe(wire, { state, pinNetMap: useElectricalStore.getState().pinNetMap }),
+    scope = useOscilloscopeStore.getState();
+  if (!target) {
+    useStore.setState({ message: '아직 측정할 신호가 없습니다. 회로를 연결하고 실행하세요.' });
+    return;
+  }
+  if (target.kind === 'digital')
+    scope.addChannel(target.boardId, target.pin, target.label, target.amplitudeV);
+  else scope.addNetChannel(target.netName, target.label);
+  scope.openOscilloscope();
+}
+const pressed = new Set<string>();
+const latched = new Set<string>();
+export function runtimeButton(id: string, down: boolean) {
+  const el = document.getElementById(id);
+  if (!el) return;
+  latched.delete(id);
+  if (down) pressed.add(id);
+  else pressed.delete(id);
+  el.dispatchEvent(
+    new CustomEvent(down ? 'button-press' : 'button-release', { bubbles: true, composed: true }),
+  );
+}
+/** Click-to-hold is separate from pointer presses, which release on pointerup. */
+export function runtimeLatchButton(id: string, down: boolean) {
+  const el = document.getElementById(id);
+  if (!el) return;
+  pressed.delete(id);
+  if (down) latched.add(id);
+  else latched.delete(id);
+  el.dispatchEvent(new CustomEvent(down ? 'button-press' : 'button-release', { bubbles: true, composed: true }));
+}
+export function releaseButtons() {
+  for (const id of [...pressed]) runtimeButton(id, false);
+}
+export function releaseAllButtons() {
+  releaseButtons();
+  for (const id of [...latched]) runtimeLatchButton(id, false);
+}
+export function runtimeSwitch(id: string) {
+  const el = document.getElementById(id) as (HTMLElement & { value: unknown }) | null;
+  if (!el) return;
+  el.value = Number(el.value) === 1 ? 0 : 1;
+  el.dispatchEvent(new Event('change', { bubbles: true }));
+}
+export function nudge(id: string, dx: number, dz: number) {
+  const s = native.getState(),
+    item = s.components.find((c) => c.id === id) || s.boards.find((b) => b.id === id);
+  if (!item) return;
+  const p = geometryFor(item).position;
+  useStore.getState().moveComponent(id, [p[0] + dx * 0.00254, p[1], p[2] + dz * 0.00254]);
+}
