diff --git a/frontend/src/__tests__/guide-camera.test.ts b/frontend/src/__tests__/guide-camera.test.ts
new file mode 100644
index 0000000..96f3a23
--- /dev/null
+++ b/frontend/src/__tests__/guide-camera.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+import * as THREE from 'three';
+import { guideCameraView, splitNearbyGuideLabels } from '../components/circuitiny/guideCamera';
+import { guidePointerLayout } from '../components/circuitiny/guidePointer';
+
+describe('guide camera framing', () => {
+  function check(points: [number, number, number][], aspect: number) {
+    const camera = new THREE.PerspectiveCamera(40, aspect, .001, 10);
+    camera.position.set(.12,.1,.12); camera.lookAt(0,0,0); camera.updateMatrixWorld();
+    const orientation = camera.quaternion.clone();
+    const view = guideCameraView(camera, points)!;
+    camera.position.copy(view.position); camera.lookAt(view.target); camera.updateMatrixWorld(); camera.updateProjectionMatrix();
+    for (const point of points) {
+      const projected = new THREE.Vector3(...point).project(camera);
+      expect(Math.abs(projected.x)).toBeLessThan(.8);
+      expect(Math.abs(projected.y)).toBeLessThan(.8);
+    }
+    expect(Math.abs(camera.quaternion.dot(orientation))).toBeCloseTo(1, 5);
+  }
+  it('frames a board pin and a distant breadboard pin without changing viewing direction', () => {
+    check([[-.13, .015, -.02], [.18, .003, .08]], 1.5);
+    check([[-.13, .015, -.02], [.18, .003, .08]], .65);
+  });
+  it('frames coincident seated component and breadboard pins without zooming inside the board', () => {
+    const camera = new THREE.PerspectiveCamera(40, 1.5, .001, 10);
+    camera.position.set(.12,.1,.12); camera.lookAt(0,0,0); camera.updateMatrixWorld();
+    const view = guideCameraView(camera, [[.1,0,.01], [.1,0,.01]])!;
+    expect(view.position.distanceTo(view.target)).toBeGreaterThanOrEqual(.09);
+    check([[.1,0,.01], [.1,0,.01]], 1.5);
+  });
+  it('frames all four seated button legs, including both endpoints per leg', () => {
