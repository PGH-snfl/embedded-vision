@@ -0,0 +1,379 @@
+import { validateWireConnection as validateWire } from '../../utils/wireReconnect';
+import { LED_OUTPUT_EVENT, lastLedOutput, type LedOutputSample } from '../../simulation/ledOutput';
+import { useSimulatorStore as native } from '../../store/useSimulatorStore';
+import { isBreadboard } from '../../utils/breadboardNets';
+import { nearestHole, computeSeating } from '../../utils/breadboardSnap';
+import { geometryFor } from './geometry';
+import { ComponentRegistry } from '../../services/ComponentRegistry';
+import { resolvePin } from './project/pins';
+import { getRenderedPoints } from '../../utils/wireHitDetection';
+import { atomic } from './actions';
+import type { ComponentInstance, Project } from './project/schema';
+import { definitions, boardDefinitions, catalog, setUno, pin, PX } from './catalog';
+import { useStore } from './store';
+import type { WireEndpoint } from '../../types/wire';
+export const encodePin = (id: string) => id.replaceAll('.', '__');
+export const decodePin = (id: string) => id.replaceAll('__', '.');
+type NativeState = ReturnType<typeof native.getState>;
+type NativePart = NativeState['components'][number];
+const offsets = new Map<string, { x: number; y: number; h: number }>();
+export function registerProject(s: NativeState): Project {
+  definitions.clear();
+  boardDefinitions.clear();
+  offsets.clear();
+  const primary = s.boards.find((b) => b.id === s.activeBoardId) || s.boards[0];
+  const registry = ComponentRegistry.getInstance();
+  const make = (item: NativePart | NativeState['boards'][number]): ComponentInstance => {
+    const g = geometryFor(item),
+      isBoard = g.board;
+    const metadataId = g.kind,
+      metadata = registry.getById(metadataId);
+    const cid = metadataId + '@' + item.id;
+    offsets.set(item.id, g.offset);
+    const pins = g.pins.map((p) =>
+      pin(
+        encodePin(p.name),
+        isBreadboard(metadataId)
+          ? '빵판 ' + p.name.split('.')[1].toUpperCase() + parseInt(p.name)
+          : p.name,
+        /GND/i.test(p.name)
+          ? 'ground'
+          : isBoard && ['5V', '3.3V', '3V3', 'VIN'].includes(p.name)
+            ? 'power_out'
+            : 'digital_io',
+        p.position,
+      ),
+    );
+    definitions.set(cid, {
+      id: cid,
+      name: metadata?.name || metadataId,
+      version: '1',
+      category: 'misc',
+      model: '',
+      pins,
+      schematic: { symbol: 'generic-rect' },
+    });
+    if (primary?.id === item.id) {
+      setUno({
+        id: primary.boardKind,
+        name: primary.name || primary.boardKind,
+        version: '1',
+        category: 'misc',
+        model: '',
+        target: 'atmega328p',
+        pins,
+        inputOnlyPins: [],
+        strappingPins: [],
+        flashPins: [],
+        usbPins: [],
+        adc1Pins: [],
+        adc2Pins: [],
+        railBudgetMa: { '3v3': 50, '5v': 500 },
+      });
+    }
+    return {
+      instance: item.id,
+      componentId: cid,
+      position: g.position,
+      pinAssignments: {},
+      config: {
+        ...('properties' in item ? item.properties : {}),
+        metadataId,
+        nativeId: item.id,
+        isBoard,
+        width: g.size.w * PX,
+        depth: g.size.h * PX,
+        rotation: g.rotation,
+        bodyCenter: g.bodyCenter,
+        name: metadata?.name || (isBoard ? ('name' in item ? item.name : metadataId) : metadataId),
+        pinReady: g.pinReady,
+        pinOwner: primary?.id === item.id ? 'board' : item.id,
+        generic: ![
+          'arduino-uno',
+          'resistor',
+          'led',
+          'breadboard',
+          'breadboard-mini',
+          'pushbutton',
+          'pushbutton-6mm',
+          'slide-switch',
+        ].includes(metadataId),
+      },
+    };
+  };
+  const boards = s.boards.map(make),
+    components = s.components.map(make);
+  const project: Project = {
+    schemaVersion: 1,
+    name: '3D 회로 편집',
+    target: 'atmega328p',
+    board: primary?.boardKind || 'none',
+    boards,
+    boardPosition: boards.find((b) => b.instance === primary?.id)?.position,
+    components,
+    nets: [],
+    app: { wifi: { enabled: false }, log_level: 'info' },
+  };
+  const reference = (e: WireEndpoint) => {
+    const id = e.componentId === primary?.id ? 'board' : e.componentId;
+    const def =
+      id === 'board'
+        ? catalog.getBoard(project.board)
+        : definitions.get(
+            [...components, ...boards].find((c) => c.instance === e.componentId)?.componentId || '',
+          );
+    const pinName = def?.pins.some((p) => p.id === encodePin(e.pinName))
+      ? e.pinName
+      : e.pinName === 'GND'
+        ? decodePin(def?.pins.find((p) => p.label.startsWith('GND'))?.id || e.pinName)
+        : e.pinName;
+    return id + '.' + encodePin(pinName);
+  };
+  project.nets = s.wires.map((w) => {
+    const endpoints = [reference(w.start), reference(w.end)],
+      a = resolvePin(project, endpoints[0]),
+      b = resolvePin(project, endpoints[1]);
+    const route =
+      a && b
+        ? getRenderedPoints({
+            ...w,
+            start: { ...w.start, x: a.position[0] / PX, y: a.position[2] / PX },
+            end: { ...w.end, x: b.position[0] / PX, y: b.position[2] / PX },
+          })
+            .slice(1, -1)
+            .map((p) => [p.x * PX, 0.012, p.y * PX] as [number, number, number])
+        : [];
+    return {
+      id: w.id,
+      endpoints,
+      hidden: w.bb,
+      color: w.color,
+      route,
+      handles: w.waypoints.map((p) => [p.x * PX, 0.012, p.y * PX] as [number, number, number]),
+    };
+  });
+  return project;
+}
+export function endpoint(ref: string, s: NativeState): WireEndpoint {
+  const [owner, ...names] = ref.split('.'),
+    pinId = names.join('.');
+  const primary = s.boards.find((b) => b.id === s.activeBoardId) || s.boards[0];
+  const componentId = owner === 'board' ? primary?.id : owner;
+  const resolved = resolvePin(useStore.getState().project, ref);
+  if (!componentId || !resolved) throw new Error('핀 위치가 아직 확인되지 않았습니다.');
+  return {
+    componentId,
+    pinName: decodePin(pinId),
+    x: resolved.position[0] / PX,
+    y: resolved.position[2] / PX,
+  };
+}
+export function connectCircuitiny() {
+  let disposed = false;
+  let lastGeometry = '';
+  const report = (e: unknown) =>
+    useStore.setState({ message: e instanceof Error ? e.message : String(e) });
+  const sync = () => {
+    if (disposed) return;
+    const s = native.getState();
+    const current = useStore.getState();
+    if (current.simulating !== s.running) {
+      useStore.setState({
+        simulating: s.running,
+        ...(s.running ? { moveTarget: null } : {}),
+        externalBrightness: s.running ? nativeLedBrightness(s) : {},
+        ...(!s.running ? { externalLit: [], externalTiming: {} } : {}),
+      });
+    }
+    const geometry = JSON.stringify({
+      boards: s.boards.map((b) => [b.id, b.x, b.y, b.boardKind, b.rotation, b.name]),
+      measurements: [...s.boards, ...s.components].map((i) => {
+        const g = geometryFor(i);
+        return [i.id, g.size, g.rotation, g.pinReady, g.pins.map((p) => [p.name, p.position])];
+      }),
+      components: s.components,
+      wires: s.wires,
+    });
+    if (geometry === lastGeometry) return;
+    try {
+      const project = registerProject(s);
+      lastGeometry = geometry;
+      useStore.setState((v) => ({
+        project,
+        sceneKey: s.hydrationSeq,
+        catalogVersion: v.catalogVersion + 1,
+      }));
+    } catch (e) {
+      useStore.setState((v) => ({
+        project: { ...v.project, board: 'unavailable', components: [], nets: [] },
+      }));
+      report(e);
+    }
+  };
+  const editable = () => {
+    if (native.getState().running) throw new Error('정지한 뒤 회로를 편집하세요.');
+  };
+  useStore.setState({
+    selected: null,
+    moveTarget: null,
+    pendingPin: null,
+    pendingRoute: [],
+    selectedNet: null,
+    wireMode: false,
+    externalLit: [],
+    externalBrightness: {},
+    externalTiming: {},
+    message: '부품을 선택해 이동하거나, 배선 모드에서 핀 두 개를 누르세요.',
+    clickPin: (ref) => {
+      try {
+        editable();
+        if (!useStore.getState().wireMode) return;
+        const start = useStore.getState().pendingPin;
+        if (!start) {
+          useStore.setState({ pendingPin: ref, pendingRoute: [] });
+          return;
+        }
+        if (start === ref) {
+          useStore.setState({ pendingPin: null });
+          return;
+        }
+        const s = native.getState(),
+          a = endpoint(start, s),
+          b = endpoint(ref, s);
+        validateWire(s, a, b);
+        s.recordAddWire({
+          id: 'C3D_' + crypto.randomUUID(),
+          start: a,
+          end: b,
+          color: useStore.getState().wireColor,
+          waypoints: useStore.getState().pendingRoute,
+          autoRouted: !useStore.getState().pendingRoute.length,
+        });
+        useStore.setState({
+          pendingPin: null,
+          pendingRoute: [],
+          message: '배선을 추가했습니다. 실행해서 동작을 확인하세요.',
+        });
+      } catch (e) {
+        report(e);
+      }
+    },
+    removeNet: (id) => {
+      try {
+        editable();
+        const s = native.getState(),
+          w = s.wires.find((w) => w.id === id);
+        if (w?.bb) throw new Error('삽입된 다리는 부품을 이동해서 분리하세요.');
+        s.recordRemoveWire(id);
+        useStore.setState({ message: '배선을 삭제했습니다. 되돌리기로 복구할 수 있습니다.' });
+      } catch (e) {
+        report(e);
+      }
+    },
+    moveComponent: (id, position) => {
+      try {
+        editable();
+        const s = native.getState(),
+          c = s.components.find((c) => c.id === id),
+          board = s.boards.find((b) => b.id === id),
+          offset = offsets.get(id);
+        if (!offset || (!c && !board)) return;
+        if ((board || (c && isBreadboard(c.metadataId))) && !s.infrastructureMoveEnabled)
+          throw new Error('보드·빵판 이동 허용 버튼을 켜면 이동할 수 있습니다.');
+        let x = position[0] / PX - offset.x,
+          y = position[2] / PX - offset.y;
+        if (c && !isBreadboard(c.metadataId)) {
+          const g = geometryFor({ ...c, x, y }),
+            first = g.pins[0];
+          if (first) {
+            const wx = (g.position[0] + first.position[0]) / PX,
+              wy = (g.position[2] + first.position[2]) / PX;
+            let closest: ReturnType<typeof nearestHole> = null;
+            for (const bb of s.components.filter((c) => isBreadboard(c.metadataId))) {
+              const h = nearestHole(bb, { x: wx, y: wy }, 12);
+              if (h && (!closest || h.dist < closest.dist)) closest = h;
+            }
+            if (closest) {
+              x += closest.x - wx;
+              y += closest.y - wy;
+            }
+          }
+          const seats = computeSeating({ ...c, x, y }, s.components) || [];
+          for (const seat of seats)
+            if (
+              s.wires.some(
+                (w) =>
+                  w.start.componentId !== id &&
+                  w.end.componentId !== id &&
+                  [w.start, w.end].some(
+                    (e) => e.componentId === seat.bbId && e.pinName === seat.holeName,
+                  ),
+              )
+            )
+              throw new Error('다른 부품이나 배선이 사용 중인 구멍입니다. 옆 열로 이동하세요.');
+        }
+        atomic('3D move and contacts', () => {
+          if (board) {
+            s.setBoardPosition({ x, y }, id);
+            s.recalculateAllWirePositions();
+          } else s.updateComponent(id, { x, y });
+        });
+        useStore.setState({ message: '위치와 빵판 연결을 갱신했습니다.' });
+        sync();
+      } catch (e) {
+        report(e);
+      }
+    },
+  });
+  const off = native.subscribe(sync);
+  sync();
+  const retry = setInterval(sync, 200);
+  const onOutput = (event: Event) => {
+    if (!native.getState().running) return;
+    const sample = (event as CustomEvent<LedOutputSample>).detail;
+    const id = sample.componentId;
+    useStore.setState((v) => {
+      const values = { ...v.externalBrightness, [id]: sample.brightness };
+      return {
+        externalBrightness: values,
+        externalLit: Object.keys(values).filter((id) => values[id] > 1e-3),
+        externalTiming: { ...v.externalTiming, [id]: sample },
+        simulating: true,
+        simTime: sample.guestMs !== null ? sample.guestMs / 1000 : v.simTime,
+      };
+    });
+  };
+  window.addEventListener(LED_OUTPUT_EVENT, onOutput);
+  // Opening 3D in the middle of a run reads the same last native outputs.
+  useStore.setState({ externalBrightness: nativeLedBrightness(native.getState()) });
+  for (const c of native.getState().components) {
+    const el = document.getElementById(c.id);
+    const sample = el && lastLedOutput(el);
+    if (sample) onOutput(new CustomEvent(LED_OUTPUT_EVENT, { detail: sample }));
+  }
+  return () => {
+    disposed = true;
+    off();
+    clearInterval(retry);
+    window.removeEventListener(LED_OUTPUT_EVENT, onOutput);
+  };
+}
+
+/** Same final LED output as 2D: includes duty integration, current limit and burnout. */
+export function nativeLedBrightness(s: NativeState): Record<string, number> {
+  if (!s.running) return {};
+  return Object.fromEntries(
+    s.components
+      .filter((c) => c.metadataId === 'led')
+      .map((c) => {
+        const el = document.getElementById(c.id) as
+          | (HTMLElement & { value?: boolean; brightness?: number })
+          | null;
+        const value =
+          el?.value && typeof el.brightness === 'number' && Number.isFinite(el.brightness)
+            ? Math.max(0, Math.min(1, el.brightness))
+            : 0;
+        return [c.id, value];
+      }),
+  );
+}
