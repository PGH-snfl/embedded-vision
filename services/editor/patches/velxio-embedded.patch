+/** Embedded Vision local integration, 2026-10-27. AGPL-3.0, same as Velxio. */
+import {useEffect,useState,useRef} from 'react';
+import {importVlxFile,buildVlxPayload,triggerDownloadVlx} from '../utils/vlxFile';
+import {useSimulatorStore} from '../store/useSimulatorStore';
+import {useEditorStore} from '../store/useEditorStore';
+import {hostedWorkspace,openCloudDraft} from './embeddedCloud';
+import {initialSimulationBehavior,INITIAL_BEHAVIOR_NOTE} from './embeddedInitialBehavior';
+import {analysisReturnUrl} from './embeddedAnalysisReturn';
+
+export function EmbeddedVisionBridge({onReady}:{onReady?:(ready:boolean)=>void}){
+ const [message,setMessage]=useState('로컬 편집기 · 컴파일 지원: Arduino UNO');
+ const [key,setKey]=useState('');
+ const [notice,setNotice]=useState('');
+ const [title,setTitle]=useState('회로를 불러오고 있습니다');
+ const [behavior,setBehavior]=useState('');
+ const [returnUrl,setReturnUrl]=useState(()=>analysisReturnUrl(hostedWorkspace(),undefined));
+ const [failed,setFailed]=useState(false);
+ const resetting=useRef(false);
+ const cloud=useRef<Awaited<ReturnType<typeof openCloudDraft>>>(null);
+ const [cloudStatus,setCloudStatus]=useState('');
+ const [cloudSaving,setCloudSaving]=useState(false);
+ const [recoveryKey,setRecoveryKey]=useState('');
+ const running=useSimulatorStore(s=>s.running);
+ useEffect(()=>{
+  const encoded=new URLSearchParams(location.hash.slice(1)).get('project');
+  if(!encoded)return;
+  let cancelled=false,unsub1=()=>{},unsub2=()=>{},flush=()=>{},timer:ReturnType<typeof setTimeout>;
+  (async()=>{
+   const original=JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(encoded),c=>c.charCodeAt(0))));
+   const source=original.embeddedVision;
+   if(original.format!=='velxio-project'||!source?.source_graph_sha256)throw new Error('사진 분석에서 내보낸 회로 파일이 아닙니다.');
