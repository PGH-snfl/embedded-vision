+// @vitest-environment jsdom
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import fixture from './fixtures/embedded-breadboard-led.json';
+import { useSimulatorStore as native } from '../store/useSimulatorStore';
+import { WireEndpointHandles } from '../components/simulator/WireEndpointHandles';
+import { wirePinTarget, reconnectWireEnd } from '../utils/wireReconnect';
+
+vi.mock('../utils/wireReconnect', () => ({ wirePinTarget: vi.fn(), reconnectWireEnd: vi.fn() }));
+
+const world = (x: number, y: number) => ({x, y});
+const target = { componentId: 'BB1', pinName: '5t.c', x: 470, y: 160 };
+let host: HTMLDivElement;
+let root: ReturnType<typeof createRoot>;
+function pointer(type: string) {
+  const event = new MouseEvent(type, { bubbles: true, clientX: 470, clientY: 160 });
+  Object.defineProperty(event, 'pointerId', { value: 7 });
+  return event;
+}
+function begin() {
+  const circle = host.querySelector('[aria-label="J2 시작점 이동"]') as SVGElement;
+  expect(circle).toBeTruthy();
+  Object.defineProperty(circle, 'setPointerCapture', { value: vi.fn() });
+  Object.defineProperty(circle, 'releasePointerCapture', { value: vi.fn() });
+  act(() => circle.dispatchEvent(pointer('pointerdown')));
+}
+
+describe('2D breadboard endpoint hover', () => {
+  beforeEach(() => {
+    (globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
+    vi.clearAllMocks();
+    native.setState({ boards: structuredClone(fixture.boards) as any, components: structuredClone(fixture.components) as any,
+      wires: structuredClone(fixture.wires) as any, selectedWireId: null, running: false });
+    host = document.createElement('div'); document.body.append(host);
+    root = createRoot(host);
+    act(() => root.render(createElement(WireEndpointHandles, { toWorld: world, zoom: 1, disabled: false })));
+  });
+  afterEach(() => { act(() => root.unmount()); host.remove(); });
+
+  it('shows the hovered strip and only the component seated on it without changing the circuit', () => {
+    const before = structuredClone(native.getState().wires);
+    vi.mocked(wirePinTarget).mockReturnValue({ endpoint: target, valid: true, reason: '' });
+    begin();
+    act(() => window.dispatchEvent(pointer('pointermove')));
+    const overlay = host.querySelector('[data-breadboard-preview="true"]')!;
+    const line = overlay.querySelector('line[data-connected-strip="col5t"]')!;
+    expect(line).not.toBeNull();
+    expect(overlay.querySelectorAll('line')).toHaveLength(1);
+    expect(overlay.querySelector('[data-connected-hole]')).toBeNull();
+    expect(overlay.querySelector('[data-connected-component="R1"]')).not.toBeNull();
+    expect(overlay.querySelector('[data-connected-component="D1"]')).toBeNull();
+    expect(overlay.querySelector('[data-connected-component="U1"]')).toBeNull();
+    expect(overlay.querySelector('[data-connected-wire]')).toBeNull();
+    expect(Number(line.getAttribute('x1'))).toBeCloseTo(Number(line.getAttribute('x2')));
+    expect(Math.abs(Number(line.getAttribute('y2')) - Number(line.getAttribute('y1')))).toBeGreaterThan(20);
+    const handle = host.querySelector('[aria-label="J2 시작점 이동"]')!;
+    expect(handle.getAttribute('fill')).not.toBe('#339864');
+    expect(native.getState().wires).toEqual(before);
+    act(() => window.dispatchEvent(pointer('pointercancel')));
+    expect(host.querySelector('[data-breadboard-preview]')).toBeNull();
+    expect(reconnectWireEnd).not.toHaveBeenCalled();
+    expect(native.getState().wires).toEqual(before);
+  });
+
+  it('renders only the hovered strip even when another strip is joined through a jumper', () => {
+    native.setState(s => ({wires: [...s.wires, {
+      id: 'bridge', start: {...target, pinName: '5t.d'}, end: {...target, pinName: '11t.c'},
+      color: '#000000', waypoints: [], autoRouted: true,
+    } as any]}));
+    vi.mocked(wirePinTarget).mockReturnValue({ endpoint: target, valid: true, reason: '' });
+    begin();
+    act(() => window.dispatchEvent(pointer('pointermove')));
+    const lines = host.querySelectorAll('[data-connected-strip]');
+    expect(lines).toHaveLength(1);
+    expect(lines[0].getAttribute('data-connected-strip')).toBe('col5t');
+    expect(host.querySelector('[data-connected-component="R1"]')).not.toBeNull();
+    expect(host.querySelector('[data-connected-component="D1"]')).toBeNull();
+    act(() => window.dispatchEvent(pointer('pointercancel')));
+  });
+
+  it('follows the rotation of the breadboard and never crosses the central gap', () => {
+    native.setState(s => ({components: s.components.map(c => c.id === 'BB1' ? {...c, properties: {...c.properties, rotation: 90}} : c)}));
+    vi.mocked(wirePinTarget).mockReturnValue({ endpoint: target, valid: true, reason: '' });
+    begin();
+    act(() => window.dispatchEvent(pointer('pointermove')));
+    const line = host.querySelector('line[data-connected-strip="col5t"]')!;
+    expect(line).not.toBeNull();
+    expect(Math.abs(Number(line.getAttribute('x2')) - Number(line.getAttribute('x1')))).toBeGreaterThan(20);
+    expect(Number(line.getAttribute('y1'))).toBeCloseTo(Number(line.getAttribute('y2')));
+    expect(host.querySelector('[data-connected-strip="col5b"]')).toBeNull();
+    act(() => window.dispatchEvent(pointer('pointercancel')));
+  });
+
+  it('shows the target power rail as one line', () => {
+    native.setState(s => ({components: s.components.map(c => c.id === 'BB1' ? {...c, metadataId:'breadboard'} : c)}));
+    vi.mocked(wirePinTarget).mockReturnValue({ endpoint: {...target, pinName:'tp.1'}, valid: true, reason: '' });
+    begin();
+    act(() => window.dispatchEvent(pointer('pointermove')));
+    const line = host.querySelector('line[data-connected-strip="railtp"]')!;
+    expect(line).not.toBeNull();
+    expect(host.querySelectorAll('[data-connected-strip]')).toHaveLength(1);
+    expect(Math.abs(Number(line.getAttribute('x2')) - Number(line.getAttribute('x1')))).toBeGreaterThan(400);
+    act(() => window.dispatchEvent(pointer('pointercancel')));
+  });
+
+  it('shows occupied-hole context while preventing invalid drops and clears on leave', () => {
+    vi.mocked(wirePinTarget).mockReturnValue({ endpoint: target, valid: false, reason: '이미 다리가 꽂힌 구멍입니다.' });
+    begin();
+    act(() => window.dispatchEvent(pointer('pointermove')));
+    expect(host.querySelector('[data-breadboard-preview]')).not.toBeNull();
+    expect(host.textContent).toContain('이미 다리가 꽂힌 구멍입니다.');
+    vi.mocked(wirePinTarget).mockReturnValue(null);
+    act(() => window.dispatchEvent(pointer('pointermove')));
+    expect(host.querySelector('[data-breadboard-preview]')).toBeNull();
+    act(() => window.dispatchEvent(pointer('pointerup')));
+    expect(reconnectWireEnd).not.toHaveBeenCalled();
+  });
+});
