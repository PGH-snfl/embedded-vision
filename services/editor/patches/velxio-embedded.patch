+/** Initial proposal text is not a live interpretation of edited circuit code. */
+export const INITIAL_BEHAVIOR_NOTE = '회로·코드를 편집해도 이 초기 설명은 자동으로 바뀌지 않습니다.';
+
+export function initialSimulationBehavior(source: {
+  simulation_behavior?: unknown;
+  function?: { output_behavior?: unknown } | null;
+} | null | undefined): string {
+  const candidates = [source?.simulation_behavior, source?.function?.output_behavior];
+  return candidates.find((value): value is string => typeof value === 'string' && !!value.trim())?.trim()
+    || '보드와 배선을 확인하고 실행해 보세요.';
+}
diff --git a/frontend/src/components/simulator/BreadboardHoverOverlay.tsx b/frontend/src/components/simulator/BreadboardHoverOverlay.tsx
new file mode 100644
index 0000000..7df3b40
--- /dev/null
+++ b/frontend/src/components/simulator/BreadboardHoverOverlay.tsx
@@ -0,0 +1,54 @@
+import { geometryFor } from '../circuitiny/geometry';
+import { PX } from '../circuitiny/catalog';
+import { breadboardGroupKey } from '../../utils/breadboardNets';
+import { directBreadboardComponents, type BreadboardHoverPreview } from '../../utils/breadboardHoverPreview';
+import type { Wire } from '../../types/wire';
+
+type Item = Parameters<typeof geometryFor>[0];
+
+/** The one physical strip or rail under the candidate hole, in 2D world coordinates. */
+export function BreadboardHoverOverlay({ preview, items, wires, zoom, excludeWireId }: {
+  preview: BreadboardHoverPreview; items: Item[]; wires: Wire[]; zoom: number; excludeWireId?: string;
+}) {
+  const item = items.find(part => part.id === preview.target.componentId);
+  if (!item?.metadataId) return null;
+  const key = breadboardGroupKey(item.metadataId, preview.target.pinName);
+  const group = preview.groups.find(g => g.breadboardId === item.id && g.groupKey === key);
+  if (!group) return null;
+  const geometry = geometryFor(item), names = new Set(group.holeNames);
+  const components = items.filter((part): part is Item & { metadataId: string } => !!part.metadataId);
+  const directIds = directBreadboardComponents(components, wires, preview.target, excludeWireId);
+  const points = geometry.pins.filter(pin => names.has(pin.name)).map(pin => ({
+    x: (geometry.position[0] + pin.position[0]) / PX,
+    y: (geometry.position[2] + pin.position[2]) / PX,
+  }));
+  if (points.length < 2) return null;
+  // geometryFor already accounts for the breadboard's measured pivot and rotation.
+  let first = points[0], last = points[1], maxDistance = -1;
+  for (let i = 0; i < points.length; i++) for (let j = i + 1; j < points.length; j++) {
+    const d = (points[i].x - points[j].x) ** 2 + (points[i].y - points[j].y) ** 2;
+    if (d > maxDistance) { maxDistance = d; first = points[i]; last = points[j]; }
+  }
+  return <g aria-label="빵판 내부 연결선 미리보기" pointerEvents="none" data-breadboard-preview="true">
+    <line data-connected-strip={key} x1={first.x} y1={first.y} x2={last.x} y2={last.y}
+      stroke="#e9a330" strokeWidth={4 / zoom} strokeOpacity={0.8} strokeLinecap="round" />
+    {directIds.map(id => {
+      const part = items.find(candidate => candidate.id === id);
+      if (!part) return null;
+      const g = geometryFor(part), angle = g.rotation * Math.PI / 180;
+      const cx = (g.position[0] + g.bodyCenter[0] * Math.cos(angle) - g.bodyCenter[2] * Math.sin(angle)) / PX;
+      const cy = (g.position[2] + g.bodyCenter[0] * Math.sin(angle) + g.bodyCenter[2] * Math.cos(angle)) / PX;
+      const margin = 5 / zoom;
+      return <g key={id} data-connected-component={id}>
+        <rect x={cx - g.size.w / 2 - margin} y={cy - g.size.h / 2 - margin}
+          width={g.size.w + 2 * margin} height={g.size.h + 2 * margin} rx={7 / zoom}
+          transform={`rotate(${g.rotation} ${cx} ${cy})`} fill="#e9a330" fillOpacity={0.10}
+          stroke="#bd7500" strokeWidth={2.5 / zoom} strokeDasharray={`${5 / zoom} ${3 / zoom}`} />
+        <text x={cx} y={cy - g.size.h / 2 - 8 / zoom} textAnchor="middle" fontSize={11 / zoom}
+          fontWeight="bold" fill="#8e5200" stroke="#fff" strokeWidth={3 / zoom} paintOrder="stroke">
+          {id} · 이 줄에 연결
+        </text>
+      </g>;
+    })}
+  </g>;
+}
diff --git a/frontend/src/components/simulator/WireEndpointHandles.tsx b/frontend/src/components/simulator/WireEndpointHandles.tsx
new file mode 100644
index 0000000..377fd3e
--- /dev/null
+++ b/frontend/src/components/simulator/WireEndpointHandles.tsx
@@ -0,0 +1,218 @@
+import { useEffect, useRef, useState } from 'react';
+import { useSimulatorStore as native } from '../../store/useSimulatorStore';
+import { wirePinTarget, reconnectWireEnd, type WireEnd } from '../../utils/wireReconnect';
+import { breadboardHoverPreview, type BreadboardHoverPreview } from '../../utils/breadboardHoverPreview';
+import { BreadboardHoverOverlay } from './BreadboardHoverOverlay';
+export function WireEndpointHandles({
+  toWorld,
+  zoom,
+  disabled,
+}: {
+  toWorld: (x: number, y: number) => { x: number; y: number };
+  zoom: number;
+  disabled: boolean;
+}) {
+  const selected = native((s) => s.selectedWireId),
+    wires = native((s) => s.wires);
+  const [preview, setPreview] = useState<{
+    wireId: string;
+    side: WireEnd;
+    x: number;
+    y: number;
+    valid: boolean;
+    label: string;
+  } | null>(null);
+  const [message, setMessage] = useState<{ wireId: string; text: string } | null>(null);
+  const [connectedPreview, setConnectedPreview] = useState<BreadboardHoverPreview | null>(null);
+  const held = useRef<{
+    wireId: string;
+    side: WireEnd;
+    point: { x: number; y: number };
+    capture: Element;
+    pointerId: number;
+  } | null>(null);
+  const release = () => {
+    try {
+      held.current?.capture.releasePointerCapture(held.current.pointerId);
+    } catch {
+      /* already released */
+    }
+    held.current = null;
+    setPreview(null);
+    setConnectedPreview(null);
+  };
+  useEffect(() => {
+    const move = (e: PointerEvent) => {
+      const h = held.current;
+      if (!h) return;
+      h.point = toWorld(e.clientX, e.clientY);
+      const state = native.getState();
+      const hit = wirePinTarget(state, h.wireId, h.side, h.point, 14 / zoom);
+      const connected = hit ? breadboardHoverPreview(state.components, state.wires, hit.endpoint, h.wireId) : null;
+      setConnectedPreview(connected);
+      setPreview({
+        wireId: h.wireId,
+        side: h.side,
+        ...(hit?.endpoint || h.point),
+        valid: !!hit?.valid,
+        label: hit
+          ? hit.valid
+            ? `${hit.endpoint.componentId}.${hit.endpoint.pinName}${connected ? ' · 빵판 내부 연결선' : ''}`
+            : hit.reason
+          : '핀 근처에 놓으세요',
+      });
+    };
+    const up = (e: PointerEvent) => {
+      const h = held.current;
+      if (!h) return;
+      const pos = toWorld(e.clientX, e.clientY);
+      const hit = wirePinTarget(native.getState(), h.wireId, h.side, pos, 14 / zoom);
+      try {
+        if (!hit?.valid)
+          throw new Error(hit?.reason || '핀 근처에 놓으세요. 원래 연결을 유지했습니다.');
+        reconnectWireEnd(h.wireId, h.side, hit.endpoint);
+        setMessage({
+          wireId: h.wireId,
+          text: `${h.side === 'start' ? '시작점' : '끝점'}을 ${hit.endpoint.componentId}.${hit.endpoint.pinName}으로 옮겼습니다.`,
+        });
+      } catch (err) {
+        setMessage({
+          wireId: h.wireId,
+          text: err instanceof Error ? err.message : '배선을 옮기지 못했습니다.',
+        });
+      }
+      release();
+    };
+    const cancel = () => release(),
+      key = (e: KeyboardEvent) => {
+        if (e.key === 'Escape') cancel();
+      };
+    window.addEventListener('pointermove', move);
+    window.addEventListener('pointerup', up);
+    window.addEventListener('pointercancel', cancel);
+    window.addEventListener('blur', cancel);
+    window.addEventListener('keydown', key);
+    return () => {
+      release();
+      window.removeEventListener('pointermove', move);
+      window.removeEventListener('pointerup', up);
+      window.removeEventListener('pointercancel', cancel);
+      window.removeEventListener('blur', cancel);
+      window.removeEventListener('keydown', key);
+    };
+  }, [toWorld, zoom]);
+  useEffect(() => { if (disabled) release(); }, [disabled]);
+  if (disabled) return null;
+  return (
+    <svg
+      className="wire-endpoint-handles"
+      onClick={(e) => e.stopPropagation()}
+      onMouseUp={(e) => e.stopPropagation()}
+      style={{
+        position: 'absolute',
+        inset: 0,
+        width: '100%',
+        height: '100%',
+        overflow: 'visible',
+        pointerEvents: 'none',
+        zIndex: 85,
+      }}
+    >
+      <style>{`.wire-endpoint-label{opacity:0;pointer-events:none}.wire-endpoint-handle:hover .wire-endpoint-label,.wire-endpoint-handle[data-emphasized=true] .wire-endpoint-label{opacity:1}`}</style>
+      {connectedPreview && <BreadboardHoverOverlay preview={connectedPreview} items={[...native.getState().boards, ...native.getState().components]} wires={wires} excludeWireId={preview?.wireId} zoom={zoom} />}
+      {wires
+        .filter((w) => !w.bb)
+        .flatMap((wire) =>
+          (['start', 'end'] as WireEnd[]).map((side) => {
+            const active = preview?.wireId === wire.id && preview.side === side;
+            const p = active ? preview : wire[side];
+            const radius = (selected === wire.id ? 8 : 6.5) / zoom;
+            return (
+              <g
+                key={wire.id + side}
+                className="wire-endpoint-handle"
+                data-emphasized={selected === wire.id || active}
+              >
+                {active && (
+                  <line
+                    x1={wire[side === 'start' ? 'end' : 'start'].x}
+                    y1={wire[side === 'start' ? 'end' : 'start'].y}
+                    x2={p.x}
+                    y2={p.y}
+                    stroke={preview.valid ? '#66838c' : '#bd6947'}
+                    strokeWidth={2 / zoom}
+                    strokeDasharray="5 3"
+                  />
+                )}
+                <circle
+                  role="button"
+                  aria-label={`${wire.id} ${side === 'start' ? '시작점' : '끝점'} 이동`}
+                  cx={p.x}
+                  cy={p.y}
+                  r={radius}
+                  fill={
+                    active
+                      ? preview.valid
+                        ? '#66838c'
+                        : '#d57343'
+                      : side === 'start'
+                        ? '#247fbd'
+                        : '#d69b38'
+                  }
+                  stroke="white"
+                  strokeWidth={2 / zoom}
+                  style={{ pointerEvents: 'all', cursor: 'grab', touchAction: 'none' }}
+                  onMouseDown={(e) => {
+                    e.stopPropagation();
+                    e.preventDefault();
+                  }}
+                  onPointerDown={(e) => {
+                    e.stopPropagation();
+                    e.preventDefault();
+                    e.currentTarget.setPointerCapture(e.pointerId);
+                    held.current = {
+                      wireId: wire.id,
+                      side,
+                      point: wire[side],
+                      capture: e.currentTarget,
+                      pointerId: e.pointerId,
+                    };
+                    setMessage(null);
+                    setPreview({
+                      wireId: wire.id,
+                      side,
+                      ...wire[side],
+                      valid: true,
+                      label: '새 핀으로 끌어 놓으세요',
+                    });
+                  }}
+                >
+                  <title>{side === 'start' ? '시작점' : '끝점'}을 새 핀으로 끌어 놓으세요</title>
+                </circle>
+                <text
+                  className="wire-endpoint-label"
+                  x={p.x + 12 / zoom}
+                  y={p.y - 10 / zoom}
+                  fill="#315b44"
+                  fontSize={11 / zoom}
+                >
+                  {active ? preview.label : side === 'start' ? '시작점 ↔' : '끝점 ↔'}
+                </text>
+              </g>
+            );
+          }),
+        )}
+      {message && wires.find((w) => w.id === message.wireId) && (
+        <text
+          role="status"
+          x={wires.find((w) => w.id === message.wireId)!.end.x + 12 / zoom}
+          y={wires.find((w) => w.id === message.wireId)!.end.y + 24 / zoom}
+          fontSize={12 / zoom}
+          fill="#315b44"
+        >
+          {message.text}
+        </text>
+      )}
+    </svg>
+  );
+}
