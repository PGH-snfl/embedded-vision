+/** Live native display texture. This reads rendered output, not fabricated sensor/display data. */
+import { useEffect, useMemo, useState, useRef } from 'react';
+import * as T from 'three';
+import { useThree } from '@react-three/fiber';
+import { useStore } from './store';
+import { nativeSurfaceEvent, releaseNativeSurfaces } from './nativeInteraction';
+export function NativeFace({ id, width, depth }: { id: string; width: number; depth: number }) {
+  const { controls } = useThree();
+  const running = useStore((s) => s.simulating);
+  const locked = useRef(false);
+  const unlock = () => {
+    if (locked.current && controls && 'enabled' in controls)
+      (controls as { enabled: boolean }).enabled = true;
+    locked.current = false;
+    releaseNativeSurfaces();
+  };
+  useEffect(() => {
+    window.addEventListener('pointerup', unlock);
+    window.addEventListener('blur', unlock);
+    return () => {
+      unlock();
+      window.removeEventListener('pointerup', unlock);
+      window.removeEventListener('blur', unlock);
+    };
+  }, [controls]);
+  const interact = (phase: 'down' | 'move' | 'up', e: any) => {
+    if (!running || !e.uv || (phase === 'down' && e.nativeEvent.button !== 0)) return;
+    if (phase === 'down') {
+      useStore.getState().select(id);
+      locked.current = true;
+      if (controls && 'enabled' in controls) (controls as { enabled: boolean }).enabled = false;
+    }
+    if (!locked.current) return;
+    e.stopPropagation();
+    nativeSurfaceEvent(id, phase, e.uv, e.pointerId);
+    if (phase === 'up') unlock();
+  };
+  const texture = useMemo(() => new T.CanvasTexture(document.createElement('canvas')), []);
+  const [ready, setReady] = useState(false);
+  useEffect(() => {
+    let disposed = false,
+      previous = '',
+      generation = 0;
+    texture.colorSpace = T.SRGBColorSpace;
+    const update = () => {
+      const el = document.getElementById(id),
+        root = el?.shadowRoot || el;
+      if (!root) return;
+      const svg = root.querySelector('svg'),
+        canvas = root.querySelector('canvas');
+      if (canvas?.width && canvas.height) {
+        try {
+          const source = canvas.toDataURL();
+          if (source === previous) return;
+          previous = source;
+          const target = texture.image as HTMLCanvasElement;
+          target.width = canvas.width;
+          target.height = canvas.height;
+          target.getContext('2d')?.drawImage(canvas, 0, 0);
+          texture.needsUpdate = true;
+          setReady(true);
+          return;
+        } catch {
+          /* Some third-party canvases are not readable. Keep an explicit generic body. */
+        }
+      }
+      if (!svg) return;
+      const copy = svg.cloneNode(true) as SVGElement;
+      copy.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
+      const styles = [...root.querySelectorAll('style')].map((s) => s.textContent).join('\n');
+      if (styles) {
+        const style = document.createElementNS('http://www.w3.org/2000/svg', 'style');
+        style.textContent = styles;
+        copy.prepend(style);
+      }
+      const text = new XMLSerializer().serializeToString(copy);
+      if (text === previous) return;
+      previous = text;
+      const image = new Image(),
+        current = ++generation;
+      image.onload = () => {
+        if (disposed || current !== generation) return;
+        const target = texture.image as HTMLCanvasElement;
+        target.width = Math.min(1200, Math.max(64, image.naturalWidth * 2));
+        target.height = Math.min(1200, Math.max(64, image.naturalHeight * 2));
+        const ctx = target.getContext('2d');
+        ctx?.clearRect(0, 0, target.width, target.height);
+        ctx?.drawImage(image, 0, 0, target.width, target.height);
+        texture.needsUpdate = true;
+        setReady(true);
+      };
+      image.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(text);
+    };
+    update();
+    const timer = setInterval(update, 150);
+    return () => {
+      disposed = true;
+      clearInterval(timer);
+    };
+  }, [id, texture]);
+  useEffect(() => () => texture.dispose(), [texture]);
+  if (!ready) return null;
+  return (
+    <mesh
+      position={[0, 0.0077, 0]}
+      rotation={[-Math.PI / 2, 0, 0]}
+      onPointerDown={(e) => interact('down', e)}
+      onPointerMove={(e) => interact('move', e)}
+      onPointerUp={(e) => interact('up', e)}
+    >
+      <planeGeometry args={[width, depth]} />
+      <meshBasicMaterial map={texture} transparent side={T.DoubleSide} />
+    </mesh>
+  );
+}
