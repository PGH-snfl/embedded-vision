+import labels from './componentKorean.json';
+import type { ComponentMetadata } from '../types/component-metadata';
+export function isKoreanWorkbench() {
+  return (
+    typeof document !== 'undefined' &&
+    (!!document.querySelector('.embedded-workbench') ||
+      (typeof location !== 'undefined' &&
+        new URLSearchParams(location.search).get('embedded') === '1'))
+  );
+}
+export function koreanBoardName(id: string, fallback: string): string {
+  const found = (labels as Record<string, { name: string }>)[id];
+  if (found) return found.name;
+  return fallback
+    .replace(/Arduino Uno/gi, '아두이노 우노')
+    .replace(/Arduino Nano/gi, '아두이노 나노')
+    .replace(/Arduino Mega/gi, '아두이노 메가')
+    .replace(/Raspberry Pi/gi, '라즈베리파이')
+    .replace(/DevKit/g, '개발 보드')
+    .replace(/board/gi, '보드');
+}
+export function localizeComponent(c: ComponentMetadata): ComponentMetadata {
+  const label = (labels as Record<string, { name: string; description: string }>)[c.id];
+  const name = label?.name || (c.category === 'boards' ? koreanBoardName(c.id, c.name) : c.name);
+  const description = label?.description || c.description;
+  if (name === c.name && description === c.description) return c;
+  return {
+    ...c,
+    name,
+    description,
+    keywords: [...new Set([...(c.keywords || []), c.name, c.description || ''])],
+  };
+}
