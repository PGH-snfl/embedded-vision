+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest';
+import { componentToSpice } from '../simulation/spice/componentToSpice';
+import { buildNetlist } from '../simulation/spice/NetlistBuilder';
+import { runNetlist } from './helpers/testSolver';
+import { PartSimulationRegistry } from '../simulation/parts/PartSimulationRegistry';
+import { dispatchSensorUpdate } from '../simulation/SensorUpdateRegistry';
+import '../simulation/parts/ComplexParts';
+
+describe('photoresistor Wokwi-compatible circuit model', () => {
+  const solve = async (lux:number, missingGnd=false) => {
+    const input={components:[{id:'S1',metadataId:'photoresistor-sensor',properties:{lux,ldrModel:'wokwi'}}],
+      wires:[{id:'w1',start:{componentId:'U1',pinName:'5V'},end:{componentId:'S1',pinName:'VCC'}},
+             {id:'w2',start:{componentId:'U1',pinName:'A0'},end:{componentId:'S1',pinName:'AO'}},
+             ...(!missingGnd?[{id:'w3',start:{componentId:'U1',pinName:'GND'},end:{componentId:'S1',pinName:'GND'}}]:[])],
+      boards:[{id:'U1',boardKind:'arduino-uno',vcc:5,pins:{},groundPinNames:['GND'],vccPinNames:['5V']}],analysis:{kind:'op'}} as any;
+    const {netlist,pinNetMap}=buildNetlist(input);
+    const result=await runNetlist(netlist);
+    return {v:result.dcValue(`v(${pinNetMap.get('U1:A0')})`), netlist};
+  };
+  it('matches the documented 5 V dark/light voltage direction and threshold', async () => {
+    const dark=await solve(0), hundred=await solve(100), bright=await solve(1000);
+    expect(dark.v).toBeGreaterThan(4.9);
+    expect(hundred.v).toBeCloseTo(2.5,1);
+    expect(bright.v).toBeCloseTo(.83,1);
+    expect(dark.v/5*1024).toBeGreaterThan(512);
+    expect(bright.v/5*1024).toBeLessThan(512);
+  });
+  it('does not invent sensor voltage when ground is disconnected', async () => {
+    const unpowered=await solve(0,true);
+    expect(unpowered.netlist).not.toContain('R_S1_ldr');
+    expect(unpowered.v).toBeLessThan(.1);
+  });
+  it('does not inject a made-up ADC value into a SPICE-driven MCU', () => {
+    const adc={channelValues:[1.234]};
+    const sim={spiceDrivenInputs:true,getADC:()=>adc,pinManager:{onPinChange:vi.fn()}};
+    const element=document.createElement('div') as HTMLElement & {value:number};element.value=1023;(element as any).ldrModel='wokwi';
+    const property=vi.fn();window.addEventListener('velxio:property-change',property);
+    const detach=PartSimulationRegistry.get('photoresistor-sensor')!.attachEvents!(element,sim as never,(pin:string)=>pin==='AO'?14:null,'S1');
+    expect(adc.channelValues[0]).toBe(1.234);
+    element.dispatchEvent(new Event('input'));
+    dispatchSensorUpdate('S1',{lux:900});
+    expect(adc.channelValues[0]).toBe(1.234);
+    expect(property).toHaveBeenCalled();
+    detach?.();window.removeEventListener('velxio:property-change',property);
+  });
+  it('keeps explicitly opted-in legacy dark/k project models', () => {
+    const nets:Record<string,string>={VCC:'vcc',AO:'ao',GND:'0'};
+    const model=componentToSpice({id:'L',metadataId:'photoresistor-sensor',properties:{lux:400,dark:'1Meg',k:20}},(p:string)=>nets[p]??null,{} as never);
+    expect(model?.cards[0]).toMatch(/R_L_ldr vcc ao 111111/);
+  });
+});
