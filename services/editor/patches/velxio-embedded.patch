+import type { AssemblyStep } from './assemblyGuide';
+import { readableRef } from './assemblyGuide';
+import { graphicColumns, graphicPlacements, guideConnectionColor, guideConnectionNumber } from './guideGraphic';
+import type { Wire } from '../../types/wire';
+
+function PartIcon({type}: {type: string}) {
+  if (type === 'resistor') return <g><path d="M27 78h22m46 0h22" stroke="#8e9c9b" strokeWidth="4"/><rect x="49" y="67" width="46" height="22" rx="9" fill="#d8b677" stroke="#a17d42"/><path d="M61 68v20m8-20v20m9-20v20m9-20v20" stroke="#814c30" strokeWidth="3"/></g>;
+  if (type === 'led') return <g><path d="M64 87v24m22-24v19" stroke="#818f8b" strokeWidth="3"/><path d="M57 84V68a18 18 0 0 1 36 0v16Z" fill="#e85d55" stroke="#a93430" strokeWidth="2"/><path d="M63 66q2-8 7-10" stroke="#ffd6ce" strokeWidth="3" fill="none"/></g>;
+  if (type.startsWith('pushbutton')) return <g><path d="M43 68h12m34 0h12M43 89h12m34 0h12" stroke="#7f908c" strokeWidth="4"/><rect x="53" y="57" width="38" height="42" rx="5" fill="#404c4b"/><circle cx="72" cy="78" r="11" fill="#b84942"/></g>;
+  if (type === 'photoresistor-sensor') return <g><rect x="37" y="56" width="78" height="44" rx="5" fill="#276aa4"/><circle cx="55" cy="78" r="12" fill="#e4d6ac"/><path d="M51 72v12m5-12v12" stroke="#8e612d" strokeWidth="2"/><path d="M85 97v10m7-10v10m7-10v10" stroke="#697977" strokeWidth="3"/></g>;
+  if (type === 'board') return <g><rect x="32" y="52" width="88" height="55" rx="6" fill="#267a86"/><rect x="25" y="67" width="17" height="20" rx="2" fill="#b4c3bf"/><rect x="75" y="66" width="23" height="24" rx="2" fill="#263b39"/><path d="M46 57h57" stroke="#bce6d8" strokeWidth="4" strokeDasharray="4 3"/></g>;
+  return <g><rect x="42" y="56" width="65" height="45" rx="5" fill="#92aba4"/><circle cx="75" cy="78" r="9" fill="#d6e4dc"/></g>;
+}
+
+/** A magnified, labelled map; illustrations are deliberately not to scale. */
+export function GuideGraphic({step, connections, wires, type, color}: {step: AssemblyStep; connections: AssemblyStep[]; wires: Wire[]; type: string; color?: string}) {
+  const placements = graphicPlacements(step, connections, wires);
+  const columns = placements && graphicColumns(placements);
+  if (!placements || !columns?.length) return <p className="ev-guide-graphic-unavailable" role="status">현재 연결을 확인할 수 없어 확대 그림을 표시하지 않습니다.</p>;
+  const inserting = step.kind === 'insert';
+  const rows = 'ABCDEFGHIJ'.split('');
+  const gx = 226, pitch = Math.min(22, 166 / Math.max(1, columns.length - 1));
+  const startX = gx + (166 - pitch * (columns.length - 1)) / 2;
+  const yFor = (row: string) => 54 + rows.indexOf(row) * 14 + (rows.indexOf(row) >= 5 ? 12 : 0);
+  const xFor = (col: number) => startX + columns.indexOf(col) * pitch;
+  const wireColor = /^#[\da-f]{6}$/i.test(color || '') ? color! : '#297e63';
+  const from = readableRef(step.from);
+  const pinLabel = (pin: string) => type === 'led' ? (pin === 'A' ? 'A (긴 다리, +)' : pin === 'C' ? 'C (짧은 다리, −)' : pin) : pin;
+  const target = placements[0].hole.row + placements[0].hole.column;
+  const title = inserting ? `${step.from.split('.')[0]}의 모든 다리와 빵판 구멍` : `${from}에서 빵판 ${target} 구멍으로 연결`;
+  return <figure className="ev-guide-visual" aria-label={`조립 확대 그림: ${title}`}>
+    <svg viewBox="0 0 420 232" role="img" aria-label={title}>
+      <rect x="5" y="9" width="139" height="191" rx="10" fill="#edf6f1" stroke="#d4e4da"/>
+      <text x="74" y="32" textAnchor="middle" className="ev-guide-svg-heading">{inserting ? '연결할 부품' : '① 연결할 부품'}</text>
+      <PartIcon type={type}/>
+      <text x="74" y="143" textAnchor="middle" className="ev-guide-svg-name">{step.from.split('.')[0]}</text>
+      <text x="74" y="163" textAnchor="middle" className="ev-guide-svg-pin">{inserting ? '모든 다리 함께' : step.from.split('.').slice(1).join('.') + ' 핀'}</text>
+      <rect x="192" y="9" width="220" height="210" rx="10" fill="#fbfaf5" stroke="#d8ded7"/>
+      <text x="302" y="28" textAnchor="middle" className="ev-guide-svg-heading">{inserting ? '빵판 확대' : '② 빵판 확대'}</text>
+      <rect x="204" y="116" width="196" height="13" rx="5" fill="#dce5df"/><text x="302" y="126" textAnchor="middle" fontSize="8" fill="#596d60">가운데 홈</text>
+      {columns.map(col => <text key={col} x={xFor(col)} y="45" textAnchor="middle" fontSize="10" fill="#4d6356" fontWeight={placements.some(p => p.hole.column === col) ? '700' : '400'}>{col}</text>)}
+      {rows.map(row => <g key={row}><text x="207" y={yFor(row)+3} textAnchor="middle" fontSize="9" fill="#4d6356">{row}</text>{columns.map(col => {
+        const index = placements.findIndex(p => p.hole.column === col && p.hole.row === row);
+        const marked = index >= 0;
+        const markColor = inserting ? guideConnectionColor(index) : guideConnectionColor(1);
+        return <g key={col}><circle cx={xFor(col)} cy={yFor(row)} r={marked ? 6 : 3.5} fill={marked ? markColor : '#43544c'} stroke={marked ? '#fff' : '#ccd5cb'} strokeWidth={marked ? 1.4 : .6}/>{marked && <text x={xFor(col)} y={yFor(row)+2.5} textAnchor="middle" fontSize="7" fill="white" fontWeight="700">{inserting ? index+1 : 2}</text>}</g>;
+      })}</g>)}
+      {!inserting && <><path d={`M145 110 C160 110 164 ${yFor(placements[0].hole.row)} 190 ${yFor(placements[0].hole.row)}`} fill="none" stroke={wireColor} strokeWidth="3"/><path d={`M184 ${yFor(placements[0].hole.row)-4} l7 4 -7 4`} fill="none" stroke={wireColor} strokeWidth="2"/></>}
+      <text x="302" y="216" textAnchor="middle" fontSize="10" fill="#34543d" fontWeight="700">{inserting ? '번호에 맞춰 모든 다리 연결' : `② ${target} 구멍`}</text>
+    </svg>
+    <figcaption>확대 안내 그림 · 부품 모양과 크기는 단순화했습니다. 실제 핀 위치는 3D 표시와 부품 표기를 확인하세요.{inserting && ' 모든 다리를 한 번에 꽂습니다.'}</figcaption>
+    {inserting && <div className="ev-guide-leg-list" aria-label="부품의 다리와 빵판 구멍">{placements.map((p, index) => <span key={p.pin} style={{color:guideConnectionColor(index)}}><b>{guideConnectionNumber(index)}</b> {pinLabel(p.pin)} → {p.hole.row}{p.hole.column}</span>)}</div>}
+  </figure>;
+}
