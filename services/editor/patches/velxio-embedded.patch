+// @vitest-environment jsdom
+import {readFileSync} from 'node:fs';
+import {it,expect,vi} from 'vitest';
+import {BREADBOARD_PINS} from '../velxio-elements/breadboard-element';
+
+it('aligns both printed row labels with the real 830-hole pin coordinates',async()=>{
+ const art=readFileSync('public/component-svgs/fritzing/breadboard-full.svg','utf8');
+ vi.stubGlobal('fetch',vi.fn(async()=>({ok:true,text:async()=>art})));
+ const el=document.createElement('velxio-breadboard');document.body.append(el);
+ await vi.waitFor(()=>expect(el.shadowRoot?.querySelectorAll('text').length).toBeGreaterThan(20));
+ const labels=[...el.shadowRoot!.querySelectorAll('text')].filter(n=>/^[A-J]$/.test(n.textContent?.trim()||''));
+ expect(labels).toHaveLength(20);
+ for(const label of labels){
+  const row=label.textContent!.trim().toLowerCase();
+  const y=Number(label.getAttribute('transform')!.match(/matrix\([^)]*\s([\d.]+)\)/)![1]);
+  const pin=BREADBOARD_PINS.find(p=>p.name===`1${'abcde'.includes(row)?'t':'b'}.${row}`)!;
+  expect(Math.abs(y-pin.y/(4/3))).toBeLessThan(2);
+ }
+ el.remove();vi.unstubAllGlobals();
+});
