@@ -866,3 +866,54 @@ describe('CircuitSimulationService — error handling', () => {
     warn.mockRestore();
   });
 });
+
+// PWM envelope timing uses physical on/off solves once, then the MCU's event clock.
+async function pwmLedFixture(extraComponents:Array<{id:string;metadataId:string;properties:Record<string,unknown>}>=[],delay=0) {
+ let pad=0;
+ const fake=new FakeSolverAdapter({solveDelayMs:delay,vectors:()=>({'i(v_d1_sense)':pad>=4?.014:0})});
+ fake.onAlter=(name,value)=>{if(name.toLowerCase()==='v_uno_5')pad=value;};
+ __setSchedulerSolverFactoryForTests(()=>fake);
+ const sim=makeSimStore({components:[{id:'r1',metadataId:'resistor',properties:{value:'220'}},{id:'D1',metadataId:'led',properties:{}},...extraComponents],
+ wires:[{id:'a',start:{componentId:'uno',pinName:'5'},end:{componentId:'r1',pinName:'1'}},
+ {id:'b',start:{componentId:'r1',pinName:'2'},end:{componentId:'D1',pinName:'A'}},
+ {id:'c',start:{componentId:'D1',pinName:'C'},end:{componentId:'uno',pinName:'GND'}}],
+ boards:[{id:'uno',boardKind:'arduino-uno'}]});
+ const elec=makeElectricalStore();
+ const service=new CircuitSimulationService(sim.port,elec.port,getMixedModeScheduler() as unknown as MixedModeSchedulerPort,
+ {collectBoardPinStates:()=>({'5':{type:'digital',v:0}})});
+ _activeServices.push(service);await service.tick();return{service,elec,fake,sim};
+}
+it('preserves all 20ms PWM updates synchronously after two-state SPICE warm-up',async()=>{
+ const {service,elec,fake}=await pwmLedFixture();
+ await service.handleMcuPwm('uno','5',.5,5,100);
+ const count=fake.calls.solve.length;
+ for(let i=1;i<=51;i++) {
+  void service.handleMcuPwm('uno','5',i/51,5,100+i*20);
+  const sample=elec.snapshots.at(-1)!.pwm!;
+  expect(sample.guestMs).toBe(100+i*20);expect(sample.intervalMs).toBe(20);
+  expect(sample.branchCurrents.v_d1_sense).toBeCloseTo(.014*i/51);
+ }
+ expect(fake.calls.solve.length).toBe(count);
+ expect(fake.calls.loadCircuit.length).toBe(1);
+ await service.handleMcuPwm('uno','5',0,5,1140);
+ expect(elec.snapshots.at(-1)!.pwm?.branchCurrents.v_d1_sense).toBe(0);
+ expect(elec.snapshots.at(-1)!.branchCurrents.v_d1_sense).toBe(0);
+});
+it('coalesces only the unavailable warm-up result and never replays old brightness over a newer timestamp',async()=>{
+ const {service,elec}=await pwmLedFixture([],5);
+ const warm=service.handleMcuPwm('uno','5',.1,5,20);
+ void service.handleMcuPwm('uno','5',.8,5,40);await warm;
+ expect(elec.snapshots.at(-1)!.pwm).toMatchObject({duty:.8,guestMs:40});
+ const count=elec.snapshots.length;void service.handleMcuPwm('uno','5',.2,5,10);
+ expect(elec.snapshots.length).toBe(count);
+});
+it('keeps reactive circuits on the general solver path instead of applying a static LED approximation',async()=>{
+ const {service,elec}=await pwmLedFixture([{id:'c1',metadataId:'capacitor',properties:{value:'100n'}}]);
+ await service.handleMcuPwm('uno','5',.5,5,20);
+ expect(elec.snapshots.at(-1)?.pwm).toBeUndefined();
+});
+it('does not publish a late PWM warm-up result after Stop',async()=>{
+ const {service,elec}=await pwmLedFixture([],5);const count=elec.snapshots.length;
+ const warm=service.handleMcuPwm('uno','5',.5,5,20);service.stop();await warm;
+ expect(elec.snapshots.length).toBe(count);
+});
