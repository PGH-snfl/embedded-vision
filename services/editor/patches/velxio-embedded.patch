@@ -0,0 +1,44 @@
+/** Shared native LED output, emitted at the MCU/solver event, never by a display timer. */
+import type { PwmLedSnapshot } from './spice/types';
+export const LED_OUTPUT_EVENT = 'velxio:led-output';
+export interface LedOutputSample {
+  componentId: string;
+  brightness: number;
+  guestMs: number | null;
+  intervalMs: number | null;
+  sequence: number;
+  duty: number | null;
+  source: 'mcu-pwm' | 'spice';
+}
+const last = new WeakMap<HTMLElement, LedOutputSample>();
+export const lastLedOutput = (element: HTMLElement) => last.get(element);
+export function emitLedOutput(
+  element: HTMLElement,
+  componentId: string,
+  brightness: number,
+  guestMs: number | null,
+  pwm?: PwmLedSnapshot,
+): void {
+  const sample: LedOutputSample = {
+    componentId,
+    brightness: Number.isFinite(brightness) ? Math.max(0, Math.min(1, brightness)) : 0,
+    guestMs: pwm?.guestMs ?? guestMs,
+    intervalMs: pwm?.intervalMs ?? null,
+    sequence: pwm?.sequence ?? 0,
+    duty: pwm?.duty ?? null,
+    source: pwm ? 'mcu-pwm' : 'spice',
+  };
+  const previous = last.get(element);
+  // Re-publishing an old SPICE snapshot must not manufacture a new MCU step.
+  if (
+    previous?.brightness === sample.brightness &&
+    previous.source === sample.source &&
+    previous.sequence === sample.sequence
+  )
+    return;
+  last.set(element, sample);
+  if (typeof element.dispatchEvent === 'function' && typeof CustomEvent !== 'undefined')
+    element.dispatchEvent(
+      new CustomEvent(LED_OUTPUT_EVENT, { detail: sample, bubbles: true, composed: true }),
+    );
+}
diff --git a/frontend/src/utils/breadboardHoverPreview.ts b/frontend/src/utils/breadboardHoverPreview.ts
new file mode 100644
index 0000000..28b556d
--- /dev/null
+++ b/frontend/src/utils/breadboardHoverPreview.ts
@@ -0,0 +1,127 @@
+/** Read-only electrical preview for a tentative breadboard connection. */
+import { breadboardGroupKey, isBreadboard } from './breadboardNets';
+import { breadboardHoles } from './breadboardSnap';
+import type { Wire } from '../types/wire';
+
+type Component = { id: string; metadataId: string };
+type Endpoint = { componentId: string; pinName: string };
+export type BreadboardHoverGroup = { breadboardId: string; groupKey: string; holeNames: string[] };
+export type BreadboardHoverPreview = {
+  target: Endpoint;
+  groups: BreadboardHoverGroup[];
+  /** Non-breadboard objects touched by the existing connected net, including boards. */
+  componentIds: string[];
+  /** Existing wires in the net, including invisible component seating wires. */
+  wireIds: string[];
+  endpoints: Endpoint[];
+};
+
+const cache = new Map<string, { pins: Map<string, string>; groups: Map<string, string[]> }>();
+function holesFor(metadataId: string) {
+  const old = cache.get(metadataId);
+  if (old) return old;
+  const pins = new Map<string, string>(), groups = new Map<string, string[]>();
+  for (const hole of breadboardHoles(metadataId) || []) {
+    const group = breadboardGroupKey(metadataId, hole.name);
+    if (!group) continue;
+    pins.set(hole.name, group);
+    const names = groups.get(group) || [];
+    names.push(hole.name);
+    groups.set(group, names);
+  }
+  const result = { pins, groups };
+  cache.set(metadataId, result);
+  return result;
+}
+
+/**
+ * Components physically seated on the hovered strip, without following
+ * jumpers to remote pins or treating a component's other pins as connected.
+ * Seating wires are marked `bb`; ordinary wires represent external jumpers.
+ * The result is read-only and contains each component at most once.
+ */
+export function directBreadboardComponents(
+  components: readonly Component[],
+  wires: readonly Wire[],
+  target: Endpoint,
+  excludeWireId?: string,
+): string[] {
+  const byId = new Map(components.map(c => [c.id, c]));
+  const breadboard = byId.get(target.componentId);
+  if (!breadboard || !isBreadboard(breadboard.metadataId)) return [];
+  const pins = holesFor(breadboard.metadataId).pins;
+  const group = pins.get(target.pinName);
+  if (!group) return [];
+  const result = new Set<string>();
+  for (const wire of wires) {
+    if (!wire.bb || wire.id === excludeWireId) continue;
+    for (const [hole, other] of [[wire.start, wire.end], [wire.end, wire.start]]) {
+      if (hole.componentId !== target.componentId || pins.get(hole.pinName) !== group) continue;
+      const part = byId.get(other.componentId);
+      if (part && !isBreadboard(part.metadataId)) result.add(part.id);
+    }
+  }
+  return [...result];
+}
+
+/**
+ * Show existing electrical connections only; this function does not make a
+ * connection or imply power. Follow wires and breadboard strips, never cross
+ * the internals of a component. Exclude the dragged wire to avoid retaining
+ * its old connection before the user releases it.
+ */
+export function breadboardHoverPreview(
+  components: readonly Component[],
+  wires: readonly Wire[],
+  target: Endpoint,
+  excludeWireId?: string,
+): BreadboardHoverPreview | null {
+  const byId = new Map(components.map(c => [c.id, c]));
+  const bb = byId.get(target.componentId);
+  if (!bb || !isBreadboard(bb.metadataId)) return null;
+  const targetGroup = holesFor(bb.metadataId).pins.get(target.pinName);
+  if (!targetGroup) return null;
+
+  // JSON tuples prevent dots in pin names and ids from colliding.
+  const nodeOf = (endpoint: Endpoint): string | null => {
+    const part = byId.get(endpoint.componentId);
+    if (part && isBreadboard(part.metadataId)) {
+      const group = holesFor(part.metadataId).pins.get(endpoint.pinName);
+      return group ? JSON.stringify(['strip', endpoint.componentId, group]) : null;
+    }
+    return JSON.stringify(['pin', endpoint.componentId, endpoint.pinName]);
+  };
+  const start = JSON.stringify(['strip', target.componentId, targetGroup]);
+  const adjacency = new Map<string, Array<{ to: string; wire: Wire }>>();
+  for (const wire of wires) {
+    if (wire.id === excludeWireId) continue;
+    const a = nodeOf(wire.start), b = nodeOf(wire.end);
+    if (!a || !b) continue;
+    const aa = adjacency.get(a) || []; aa.push({ to: b, wire }); adjacency.set(a, aa);
+    const bbEdges = adjacency.get(b) || []; bbEdges.push({ to: a, wire }); adjacency.set(b, bbEdges);
+  }
+
+  const pending = [start], visited = new Set<string>(), wireIds = new Set<string>();
+  while (pending.length) {
+    const node = pending.pop()!;
+    if (visited.has(node)) continue;
+    visited.add(node);
+    for (const edge of adjacency.get(node) || []) {
+      wireIds.add(edge.wire.id);
+      if (!visited.has(edge.to)) pending.push(edge.to);
+    }
+  }
+  const groups: BreadboardHoverGroup[] = [], endpoints: Endpoint[] = [], partIds = new Set<string>();
+  for (const node of visited) {
+    const [type, id, pinOrGroup] = JSON.parse(node) as [string, string, string];
+    if (type === 'strip') {
+      const part = byId.get(id)!;
+      // Copy arrays so a consumer cannot mutate our cached geometry.
+      groups.push({ breadboardId: id, groupKey: pinOrGroup, holeNames: [...(holesFor(part.metadataId).groups.get(pinOrGroup) || [])] });
+    } else {
+      partIds.add(id);
+      endpoints.push({ componentId: id, pinName: pinOrGroup });
+    }
+  }
+  return { target: { ...target }, groups, componentIds: [...partIds], wireIds: [...wireIds], endpoints };
+}
