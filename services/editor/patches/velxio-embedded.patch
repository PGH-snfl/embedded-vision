+    else if(localStorage.getItem(storageKey+':recovery'))setRecoveryKey(storageKey+':recovery');
+    payload=cloud.current.payload;restored=true;setCloudStatus('서버 저장본 r'+cloud.current.revision()+' · 브라우저 임시 저장과 별도');}
+   else if(cloud.current)setCloudStatus('아직 서버 저장본 없음 · 편집 후 작업공간에 저장하세요.');
+   if(cancelled)return;
+   await importVlxFile(new File([JSON.stringify(payload)],'embedded.vlx',{type:'application/json'}));
+   if(cancelled)return;
+   setKey(storageKey);
+   onReady?.(true);
+   setTitle(source.function?.summary||original.name||'새 회로');
+   setBehavior(initialSimulationBehavior(source));
