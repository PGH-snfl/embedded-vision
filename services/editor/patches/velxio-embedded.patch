+  return { pm, sim, frame: (t: number) => frames.shift()!(t) };
+}
+it.each([0.5, 1, 2])(
+  'paces actual cycles at %sx independent of multi-cycle instructions',
+  (speed) => {
+    const { sim, frame } = setup();
+    sim.setSpeed(speed);
+    sim.start();
+    frame(1000);
+    expect(sim.getCurrentCycles()).toBe(0);
+    for (let t = 8; t <= 104; t += 8) frame(1000 + t);
+    expect(Math.abs(sim.getCurrentCycles() - 104 * 16000 * speed)).toBeLessThan(4);
+  },
+);
+it('caps background catch-up and never runs a negative elapsed frame', () => {
+  const { sim, frame } = setup();
+  sim.start();
+  frame(100);
+  frame(1100);
+  expect(Math.abs(sim.getCurrentCycles() - 50 * 16000)).toBeLessThan(4);
+  const before = sim.getCurrentCycles();
+  frame(1090);
+  expect(sim.getCurrentCycles()).toBe(before);
+});
+it('reports analogWrite digital endpoints instead of retaining stale PWM OCR values', () => {
+  const { sim, pm, frame } = setup();
+  const cpu = (sim as any).cpu;
+  cpu.data[0x44] = 0x23;
+  cpu.data[0x48] = 128;
+  const samples: Array<{ duty: number; ms: number | undefined }> = [];
+  pm.onPwmChange(5, (_p, duty, timeMs) => samples.push({ duty, ms: timeMs }));
+  sim.start();
+  frame(0);
+  expect(samples.at(-1)?.duty).toBeCloseTo(128 / 255);
+  cpu.data[0x44] = 3;
+  cpu.data[0x2b] |= 32;
+  frame(20);
+  expect(samples.at(-1)?.duty).toBe(1);
+  cpu.data[0x2b] &= ~32;
+  frame(40);
+  expect(samples.at(-1)?.duty).toBe(0);
+  cpu.data[0x44] = 0x23;
+  frame(60);
+  expect(samples.at(-1)?.duty).toBeCloseTo(128 / 255);
+  samples.forEach((s, i) => expect(Math.abs(s.ms! - [0, 0, 20, 40][i])).toBeLessThan(0.02));
+});
+
+it.each([0.5, 1, 2])(
+  'real compiled delay(20) PWM keeps guest timestamps and %sx wall-clock rate',
+  (speed) => {
+    const { sim, pm, frame } = setup();
+    sim.loadHex(FADE_HEX);
+    sim.setSpeed(speed);
+    const samples: Array<{ value: number; ms: number }> = [];
+    pm.onPwmChange(5, (_p, duty, ms) => {
+      if (ms !== undefined) samples.push({ value: Math.round(duty * 255), ms });
+    });
+    sim.start();
+    frame(0);
+    for (let t = 10; t <= 1200; t += 10) frame(t);
+    expect(Math.abs(sim.getCurrentCycles() / 16000 - 1200 * speed)).toBeLessThan(0.01);
+    const intervals = samples.slice(1).map((s, i) => s.ms - samples[i].ms);
+    const regular = intervals.filter((t) => t > 10);
+    expect(regular.length).toBeGreaterThan((1200 * speed) / 20 - 8);
+    expect(regular.every((t) => t >= 19 && t <= 21.2)).toBe(true);
+    if (speed === 2) {
+      expect(samples.some((s) => s.value === 255)).toBe(true);
+      expect(samples.some((s) => s.value === 0)).toBe(true);
+    }
+  },
+);
