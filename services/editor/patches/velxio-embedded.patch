+}
+
+.ev-3d-live {
+  position: absolute;
+  right: 16px;
+  bottom: 14px;
+  color: #41654c;
+  background: #ffffffe6;
+  border: 1px solid #d6e3d9;
+  border-radius: 20px;
+  padding: 7px 12px;
+  font-size: 11px;
+}
diff --git a/frontend/src/components/assembly/Assembly3D.tsx b/frontend/src/components/assembly/Assembly3D.tsx
new file mode 100644
index 0000000..f2485e4
--- /dev/null
+++ b/frontend/src/components/assembly/Assembly3D.tsx
@@ -0,0 +1,490 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import * as T from 'three';
+import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
+import { useSimulatorStore } from '../../store/useSimulatorStore';
+import { useElectricalStore } from '../../store/useElectricalStore';
+import { breadboardHoles } from '../../utils/breadboardSnap';
+import {
+  BREADBOARD_MINI_WIDTH,
+  BREADBOARD_MINI_HEIGHT,
+} from '../../velxio-elements/breadboard-mini-element';
+import { BREADBOARD_WIDTH, BREADBOARD_HEIGHT } from '../../velxio-elements/breadboard-element';
+import { assemblyModel, type SceneBoard, type ScenePart } from './assemblyModel';
+import './Assembly3D.css';
+
+type Props = { onEdit: () => void };
+export function Assembly3D({ onEdit }: Props) {
+  const host = useRef<HTMLDivElement>(null),
+    view = useRef<(mode: string) => void>(() => {});
+  const [error, setError] = useState(''),
+    [selected, setSelected] = useState(''),
+    [liveLed, setLiveLed] = useState('');
+  const boardData = useSimulatorStore((s) =>
+    JSON.stringify(
+      s.boards.map((b) => ({
+        id: b.id,
+        boardKind: b.boardKind,
+        x: b.x,
+        y: b.y,
+        rotation: b.rotation,
+      })),
+    ),
+  );
+  const boards = useMemo(() => JSON.parse(boardData) as SceneBoard[], [boardData]);
+  const components = useSimulatorStore((s) => s.components),
+    wires = useSimulatorStore((s) => s.wires);
+  const model = useMemo(
+    () => assemblyModel(boards, components, wires),
+    [boards, components, wires],
+  );
+  const selectedPart = components.find((p) => p.id === selected);
+  const selectedWires = wires.filter(
+    (w) => w.start.componentId === selected || w.end.componentId === selected,
+  );
+  const terminalLabel=(ref:string,pin:string)=>{
+    const part=components.find(p=>p.id===ref);
+    if(part?.metadataId.startsWith('breadboard')){
+      const match=pin.match(/^(\d+)[tb]\.([a-j])$/);
+      if(match)return '빵판 '+match[2].toUpperCase()+match[1];
+    }
+    if(part?.metadataId==='led')return ref+' '+pin+(pin==='A'?' (양극 +)':' (음극 −)');
+    if(boards.some(b=>b.id===ref))return 'UNO '+(/^\d+$/.test(pin)?'D'+pin:pin);
+    return ref+'.'+pin;
+  };
+  useEffect(() => {
+    const element = host.current;
+    if (!element) return;
+    setError('');
+    let renderer: T.WebGLRenderer;
+    try {
+      renderer = new T.WebGLRenderer({ antialias: true, alpha: false });
+    } catch {
+      setError(
+        '이 브라우저에서 3D 그래픽을 시작하지 못했습니다. 2D 빵판 보기로 연결을 확인하세요.',
+      );
+      return;
+    }
+    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
+    renderer.shadowMap.enabled = true;
+    renderer.shadowMap.type = T.PCFSoftShadowMap;
+    renderer.outputColorSpace = T.SRGBColorSpace;
+    renderer.toneMapping = T.ACESFilmicToneMapping;
+    renderer.toneMappingExposure = 1.15;
+    renderer.domElement.setAttribute('aria-label', '회전 가능한 빵판 조립 3D 모델');
+    renderer.domElement.setAttribute('role', 'img');
+    element.appendChild(renderer.domElement);
+    const scene = new T.Scene();
+    scene.background = new T.Color('#f0f4f0');
+    const camera = new T.PerspectiveCamera(42, 1, 0.5, 10000);
+    const controls = new OrbitControls(camera, renderer.domElement);
+    controls.enableDamping = true;
+    controls.maxPolarAngle = Math.PI * 0.49;
+    controls.minDistance = 80;
+    controls.maxDistance = 3500;
+    scene.add(new T.HemisphereLight('#ffffff', '#a2ad9e', 1.8));
+    const sun = new T.DirectionalLight('#fff8e8', 2.3);
+    sun.position.set(-150, 700, -300);
+    sun.castShadow = true;
+    sun.shadow.mapSize.set(2048, 2048);
+    sun.shadow.camera.left = -900;
+    sun.shadow.camera.right = 900;
+    sun.shadow.camera.top = 900;
+    sun.shadow.camera.bottom = -900;
+    sun.shadow.camera.far = 2000;
+    sun.shadow.bias = -0.0004;
+    scene.add(sun);
+    const root = new T.Group();
+    scene.add(root);
+    const mat = (color: string, metalness = 0) =>
+      new T.MeshStandardMaterial({ color, roughness: metalness ? 0.32 : 0.72, metalness });
+    const white = mat('#f6f3e9'),
+      black = mat('#202833'),
+      metal = mat('#aab4bd', 0.7),
+      gold = mat('#bd974c', 0.65),
+      pcb = mat('#08789a');
+    function box(
+      parent: T.Object3D,
+      x: number,
+      y: number,
+      z: number,
+      w: number,
+      h: number,
+      d: number,
+      m: T.Material,
+    ) {
+      const mesh = new T.Mesh(new T.BoxGeometry(w, h, d), m);
+      mesh.position.set(x, y, z);
+      mesh.castShadow = true;
+      mesh.receiveShadow = true;
+      parent.add(mesh);
+      return mesh;
+    }
+    function tube(parent: T.Object3D, points: T.Vector3[], color: string, radius = 1.4) {
+      const curve = new T.CatmullRomCurve3(points);
+      const mesh = new T.Mesh(new T.TubeGeometry(curve, 40, radius, 8, false), mat(color));
+      mesh.castShadow = true;
+      parent.add(mesh);
+      return mesh;
+    }
+    function label(
+      parent: T.Object3D,
+      text: string,
+      x: number,
+      y: number,
+      z: number,
+      width: number,
+      color = '#335343',
+    ) {
+      const canvas = document.createElement('canvas');
+      const ctx = canvas.getContext('2d')!;
+      ctx.font = '600 40px sans-serif';
+      canvas.width = Math.ceil(ctx.measureText(text).width + 20);
+      canvas.height = 64;
+      ctx.font = '600 40px sans-serif';
+      ctx.textAlign = 'center';
+      ctx.textBaseline = 'middle';
+      ctx.fillStyle = color;
+      ctx.fillText(text, canvas.width / 2, 32);
+      const texture = new T.CanvasTexture(canvas);
+      texture.colorSpace = T.SRGBColorSpace;
+      const plane = new T.Mesh(
+        new T.PlaneGeometry(width, width * 64 / canvas.width),
+        new T.MeshBasicMaterial({ map: texture, transparent: true, depthWrite: false, toneMapped: false }),
+      );
+      plane.rotation.x = -Math.PI / 2;
+      plane.position.set(x, y, z);
+      parent.add(plane);
+    }
+    function group(id: string) {
+      const g = new T.Group();
+      g.userData.ref = id;
+      root.add(g);
+      return g;
+    }
+    const ledMaterials = new Map<string, T.MeshStandardMaterial>();
+    for (const b of boards) {
+      if (b.boardKind !== 'arduino-uno' || b.rotation) continue;
+      const g = group(b.id);
+      g.position.set(b.x, 0, b.y);
+      box(g, 137, 8, 100, 274, 6, 201, pcb);
+      box(g, 27, 23, 45, 44, 27, 41, metal);
+      box(g, 24, 18, 172, 30, 22, 33, black);
+      box(g, 170, 15, 132, 95, 12, 28, black);
+      box(g, 87, 13, 70, 18, 8, 18, black);
+      for (const z of [9, 191.5])
+        for (let i = 0; i < 18; i++) {
+          const x = 105 + i * 9;
+          box(g, x, 17, z, 8, 13, 8, black);
+          box(g, x, 24, z, 3, 1, 3, gold);
+        }
+      label(g, 'ARDUINO UNO', 152, 12, 70, 135, '#ffffff');
+      label(g, b.id + ' · USB 5V', 136, 12, 99, 85, '#d1edf0');
+      // Pin labels are taken from the actual exported jumper endpoints.
+      for (const j of model.jumpers) {
+        const e =
+          j.wire.start.componentId === b.id
+            ? j.wire.start
+            : j.wire.end.componentId === b.id
+              ? j.wire.end
+              : null;
+        if (!e) continue;
+        const p = j.wire.start === e ? j.a : j.b;
+        if (p)
+          label(
+            g,
+            e.pinName,
+            p.x - b.x,
+            28,
+            p.z - b.y + (p.z - b.y < 100 ? 13 : -15),
+            24,
+            '#ffffff',
+          );
+      }
+    }
+    for (const c of components as ScenePart[]) {
+      if (model.unsupported.includes(c.id)) continue;
+      const g = group(c.id);
+      if (c.metadataId === 'breadboard-mini' || c.metadataId === 'breadboard') {
+        const mini = c.metadataId === 'breadboard-mini',
+          w = mini ? BREADBOARD_MINI_WIDTH : BREADBOARD_WIDTH,
+          h = mini ? BREADBOARD_MINI_HEIGHT : BREADBOARD_HEIGHT;
+        g.position.set(c.x + 6, 0, c.y + 6);
+        box(g, w / 2, 15, h / 2, w, 28, h, white);
+        box(g, w / 2, 29, h * 0.58, w - 9, 0.5, 10, mat('#e2ded2'));
+        const holes = breadboardHoles(c.metadataId) || [];
+        const holeMesh = new T.InstancedMesh(
+          new T.CylinderGeometry(1.6, 1.3, 0.9, 10),
+          black,
+          holes.length,
+        );
+        const matrix = new T.Matrix4();
+        holes.forEach((p, i) => {
+          matrix.makeTranslation(p.x, 29.3, p.y);
+          holeMesh.setMatrixAt(i, matrix);
+        });
+        g.add(holeMesh);
+        const cols = mini ? 17 : 63;
+        for (let col = 1; col <= cols; col++) {
+          const p = holes.find((h) => h.name === col + 't.a');
+          if (p && (mini || col % 5 === 0)) label(g, String(col), p.x, 29.9, p.y - 10, 11);
+        }
+        for (const row of 'abcdefghij') {
+          const p = holes.find((h) => h.name === '1' + (row < 'f' ? 't' : 'b') + '.' + row);
+          if (p) label(g, row.toUpperCase(), 5, 30, p.y, 9);
+        }
+        label(g, c.id + ' · BREADBOARD', w / 2, 3, h + 16, 110);
+      } else if (c.metadataId === 'resistor') {
+        const a = model.seats.get(c.id + '.1'),
+          b = model.seats.get(c.id + '.2');
+        if (!a || !b) continue;
+        const mid = new T.Vector3((a.x + b.x) / 2, 42, (a.z + b.z) / 2),
+          direction = new T.Vector3(b.x - a.x, 0, b.z - a.z).normalize();
+        const mesh = new T.Mesh(new T.CylinderGeometry(4.5, 4.5, 26, 16), mat('#d8b481'));
+        mesh.position.copy(mid);
+        mesh.quaternion.setFromUnitVectors(new T.Vector3(0, 1, 0), direction);
+        g.add(mesh);
+        const value = String(c.properties.value || '');
+        const colors =
+          value === '220'
+            ? ['#b82b20', '#b82b20', '#493428', '#bb9a44']
+            : ['#734b2f', '#171819', '#d98322', '#bb9a44'];
+        colors.forEach((color, i) => {
+          const band = new T.Mesh(new T.CylinderGeometry(4.6, 4.6, 2, 16), mat(color));
+          band.position.copy(mid).addScaledVector(direction, -9 + i * 6);
+          band.quaternion.copy(mesh.quaternion);
+          g.add(band);
+        });
+        for (const p of [a, b])
+          tube(
+            g,
+            [
+              new T.Vector3(p.x, 30, p.z),
+              new T.Vector3(p.x, 39, p.z),
+              mid.clone().addScaledVector(direction, p === a ? -13 : 13),
+            ],
+            '#aab4bd',
+            0.7,
+          );
+      } else if (c.metadataId === 'led') {
+        const a = model.seats.get(c.id + '.A'),
+          b = model.seats.get(c.id + '.C');
+        if (!a || !b) continue;
+        const x = (a.x + b.x) / 2,
+          z = (a.z + b.z) / 2;
+        const material = mat(String(c.properties.color || 'red'));
+        material.emissive.set('#ff1808');
+        ledMaterials.set(c.id, material);
+        const bulb = new T.Mesh(new T.SphereGeometry(8, 24, 16), material);
+        bulb.scale.set(1, 1.25, 1);
+        bulb.position.set(x, 56, z);
+        g.add(bulb);
+        const base = new T.Mesh(new T.CylinderGeometry(8, 8, 12, 24), material);
+        base.position.set(x, 50, z);
+        g.add(base);
+        for (const p of [a, b])
+          tube(
+            g,
+            [new T.Vector3(p.x, 30, p.z), new T.Vector3(p.x, 42, p.z), new T.Vector3(p.x, 47, p.z)],
+            '#b9c4cc',
+            0.65,
+          );
+      }
+    }
+    for (const { wire, a, b } of model.jumpers) {
+      if (!a || !b) continue;
+      const g = group(wire.id),
+        height = Math.max(a.y, b.y) + 35;
+      const points = [
+        new T.Vector3(a.x, a.y, a.z),
+        new T.Vector3(a.x, height, a.z),
+        new T.Vector3((a.x + b.x) / 2, height + 8, (a.z + b.z) / 2),
+        new T.Vector3(b.x, height, b.z),
+        new T.Vector3(b.x, b.y, b.z),
+      ];
+      tube(g, points, wire.color || '#257d50', 1.6);
+      for (const p of [a, b]) box(g, p.x, p.y + 3, p.z, 4, 8, 4, black);
+    }
+    root.traverse((o) => {
+      if (o instanceof T.Mesh) {
+        o.castShadow = true;
+        o.receiveShadow = true;
+      }
+    });
+    const bounds = new T.Box3().setFromObject(root),
+      center = bounds.isEmpty() ? new T.Vector3(300, 20, 150) : bounds.getCenter(new T.Vector3());
+    const extent = bounds.isEmpty() ? 450 : bounds.getSize(new T.Vector3()).length();
+    const ground = new T.Mesh(new T.PlaneGeometry(5000, 5000), mat('#e6ece6'));
+    ground.rotation.x = -Math.PI / 2;
+    ground.position.set(center.x, 0, center.z);
+    ground.receiveShadow = true;
+    scene.add(ground);
+    let mode = 'iso';
+    const reset = (next: string) => {
+      if (next === 'zoom-in' || next === 'zoom-out') {
+        camera.position
+          .sub(controls.target)
+          .multiplyScalar(next === 'zoom-in' ? 0.8 : 1.25)
+          .add(controls.target);
+        controls.update();
+        return;
+      }
+      mode = next;
+      const distance = Math.max(
+        300,
+        ((extent / Math.sin(T.MathUtils.degToRad(camera.fov / 2))) * 0.43) /
+          Math.min(1, camera.aspect),
+      );
+      const dir =
+        next === 'top'
+          ? new T.Vector3(0, 1, 0.001)
+          : next === 'front'
+            ? new T.Vector3(0.05, 0.45, 1)
+            : new T.Vector3(0.65, 1, 1);
+      camera.position.copy(center).addScaledVector(dir.normalize(), distance);
+      controls.target.copy(center);
+      controls.update();
+    };
+    view.current = reset;
+    const resize = () => {
+      const w = element.clientWidth,
+        h = element.clientHeight;
+      if (!w || !h) return;
+      renderer.setSize(w, h, false);
+      camera.aspect = w / h;
+      camera.updateProjectionMatrix();
+      reset(mode);
+    };
+    const observer = new ResizeObserver(resize);
+    observer.observe(element);
+    resize();
+    const raycaster = new T.Raycaster(),
+      pointer = new T.Vector2();
+    let down = { x: 0, y: 0 };
+    const onDown = (e: PointerEvent) => {
+      down = { x: e.clientX, y: e.clientY };
+    };
+    const onClick = (e: MouseEvent) => {
+      if (Math.hypot(e.clientX - down.x, e.clientY - down.y) > 5) return;
+      const r = renderer.domElement.getBoundingClientRect();
+      pointer.set(
+        ((e.clientX - r.left) / r.width) * 2 - 1,
+        (-(e.clientY - r.top) / r.height) * 2 + 1,
+      );
+      raycaster.setFromCamera(pointer, camera);
+      const hit = raycaster.intersectObject(root, true)[0];
+      let o: T.Object3D | undefined = hit?.object;
+      while (o && !o.userData.ref) o = o.parent || undefined;
+      setSelected(o?.userData.ref || '');
+    };
+    renderer.domElement.addEventListener('pointerdown', onDown);
+    renderer.domElement.addEventListener('click', onClick);
+    let frame = 0,
+      lastStatus = 0,
+      statusText = '';
+    const animate = () => {
+      frame = requestAnimationFrame(animate);
+      controls.update();
+      const state = useSimulatorStore.getState(),
+        electrical = useElectricalStore.getState();
+      const live: string[] = [];
+      ledMaterials.forEach((m, id) => {
+        const current = electrical.branchCurrents[`v_${id.toLowerCase()}_sense`];
+        const liveElement = document.getElementById(id) as
+          | (HTMLElement & { value?: boolean; brightness?: number })
+          | null;
+        const brightness = state.running
+          ? Number.isFinite(current)
+            ? Math.min(1, Math.abs(current) / 0.02)
+            : liveElement?.value
+              ? Number(liveElement.brightness ?? 1)
+              : 0
+          : 0;
+        live.push(id + ' · ' + (brightness > 0.01 ? '켜짐' : '꺼짐'));
+        m.emissiveIntensity = brightness * 1.8;
+        m.color.set(brightness > 0.01 ? '#ff4a34' : '#8f211b');
+      });
+      if (performance.now() - lastStatus > 150) {
+        lastStatus = performance.now();
+        const text = live.join(' / ');
+        if (text !== statusText) {
+          statusText = text;
+          setLiveLed(text);
+        }
+      }
+      renderer.render(scene, camera);
+    };
+    animate();
+    return () => {
+      cancelAnimationFrame(frame);
+      observer.disconnect();
+      controls.dispose();
+      renderer.domElement.removeEventListener('pointerdown', onDown);
+      renderer.domElement.removeEventListener('click', onClick);
+      const textures = new Set<T.Texture>(),
+        materials = new Set<T.Material>(),
+        geometries = new Set<T.BufferGeometry>();
+      scene.traverse((o) => {
+        if (o instanceof T.Mesh) {
+          geometries.add(o.geometry);
+          for (const m of Array.isArray(o.material) ? o.material : [o.material]) {
+            materials.add(m);
+            if ((m as T.MeshBasicMaterial).map) textures.add((m as T.MeshBasicMaterial).map!);
+          }
+        }
+      });
+      textures.forEach((t) => t.dispose());
+      materials.forEach((m) => m.dispose());
+      geometries.forEach((g) => g.dispose());
+      renderer.dispose();
+      renderer.domElement.remove();
+    };
+  }, [boards, components, wires, model]);
+  return (
+    <section className="ev-assembly-3d" aria-label="3D 빵판 조립 보기">
+      <div ref={host} className="ev-3d-viewport" />
+      <div className="ev-3d-controls">
+        <button onClick={() => view.current('iso')}>입체 보기</button>
+        <button onClick={() => view.current('top')}>위에서 보기</button>
+        <button onClick={() => view.current('front')}>앞에서 보기</button>
+        <button onClick={() => view.current('zoom-in')} aria-label="3D 확대">
+          ＋
+        </button>
+        <button onClick={() => view.current('zoom-out')} aria-label="3D 축소">
+          −
+        </button>
+        <button onClick={onEdit}>2D에서 배선 편집</button>
+      </div>
+      <span className="ev-3d-live" role="status">
+        {liveLed ? '가상 LED: ' + liveLed : '동일한 배선으로 실행합니다'}
+      </span>
+      <p className="ev-3d-help">
+        드래그: 회전 · 휠: 확대 · 오른쪽 드래그: 이동 · 부품 클릭: 연결 확인
+      </p>
+      {(error || model.unresolved.length > 0 || model.unsupported.length > 0) && (
+        <div className="ev-3d-warning" role="status">
+          {error ||
+            `3D 표시 대기/미지원: ${[...model.unresolved, ...model.unsupported].join(', ')}. 2D에서 확인하세요.`}
+        </div>
+      )}
+      {selected && (
+        <aside className="ev-3d-selection">
+          <button aria-label="부품 정보 닫기" onClick={() => setSelected('')}>
+            ×
+          </button>
+          <strong>
+            {selected}{' '}
+            {selectedPart?.properties.value ? String(selectedPart.properties.value) + 'Ω' : ''}
+          </strong>
+          {selectedWires.map((w) => (
+            <p key={w.id}>
+              {terminalLabel(w.start.componentId,w.start.pinName)} → {terminalLabel(w.end.componentId,w.end.pinName)}
+              {w.bb ? ' · 빵판에 삽입' : ''}
+            </p>
+          ))}
+          <small>같은 열 a~e / f~j는 각각 연결됩니다.</small>
+        </aside>
+      )}
+      <span className="ev-3d-note">조립 이해용 3D 형상 · 실제 부품 치수는 별도 확인</span>
+    </section>
+  );
+}
diff --git a/frontend/src/components/assembly/assemblyModel.ts b/frontend/src/components/assembly/assemblyModel.ts
new file mode 100644
index 0000000..2c92eb8
--- /dev/null
+++ b/frontend/src/components/assembly/assemblyModel.ts
@@ -0,0 +1,62 @@
+import type { Wire, WireEndpoint } from '../../types/wire';
+import { breadboardHoles } from '../../utils/breadboardSnap';
+
+export type ScenePart = {
+  id: string;
+  metadataId: string;
+  x: number;
+  y: number;
+  properties: Record<string, unknown>;
+};
+export type SceneBoard = { id: string; boardKind: string; x: number; y: number; rotation?: number };
+export function assemblyModel(boards: SceneBoard[], parts: ScenePart[], wires: Wire[]) {
+  const byId = new Map(parts.map((p) => [p.id, p]));
+  const holePoint = (e: WireEndpoint) => {
+    const c = byId.get(e.componentId),
+      h = c && breadboardHoles(c.metadataId)?.find((p) => p.name === e.pinName);
+    return c && h ? { x: c.x + 6 + h.x, z: c.y + 6 + h.y, y: 30 } : null;
+  };
+  const seats = new Map<string, { x: number; z: number; y: number; hole: string }>();
+  for (const w of wires.filter((w) => w.bb)) {
+    for (const [pin, hole] of [
+      [w.start, w.end],
+      [w.end, w.start],
+    ]) {
+      const point = holePoint(hole);
+      if (point)
+        seats.set(pin.componentId + '.' + pin.pinName, {
+          ...point,
+          hole: hole.componentId + '.' + hole.pinName,
+        });
+    }
+  }
+  function endpoint(e: WireEndpoint) {
+    const seated = seats.get(e.componentId + '.' + e.pinName);
+    if (seated) return seated;
+    const hole = holePoint(e);
+    if (hole) return hole;
+    if (!Number.isFinite(e.x) || !Number.isFinite(e.y) || (e.x === 0 && e.y === 0)) return null;
+    return { x: e.x, z: e.y, y: boards.some((b) => b.id === e.componentId) ? 19 : 34 };
+  }
+  const jumpers = wires
+    .filter((w) => !w.bb)
+    .map((w) => ({ wire: w, a: endpoint(w.start), b: endpoint(w.end) }));
+  const unsupported = [
+    ...boards.filter((b) => b.boardKind !== 'arduino-uno' || Number(b.rotation)).map((b) => b.id),
+    ...parts
+      .filter(
+        (p) =>
+          !['breadboard-mini', 'breadboard', 'resistor', 'led'].includes(p.metadataId) ||
+          Number(p.properties.rotation) ||
+          (p.metadataId==='resistor' && (!seats.has(p.id+'.1') || !seats.has(p.id+'.2'))) ||
+          (p.metadataId==='led' && (!seats.has(p.id+'.A') || !seats.has(p.id+'.C'))),
+      )
+      .map((p) => p.id),
+  ];
+  return {
+    seats,
+    jumpers,
+    unsupported,
+    unresolved: jumpers.filter((j) => !j.a || !j.b).map((j) => j.wire.id),
+  };
+}
