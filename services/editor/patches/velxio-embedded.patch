@@ -0,0 +1,26 @@
+import { useMemo } from 'react';
+import { useSimulatorStore as native } from '../../store/useSimulatorStore';
+import { breadboardHoverPreview, directBreadboardComponents } from '../../utils/breadboardHoverPreview';
+import { useStore } from './store';
+
+/** Derive the existing net without mutating the simulator while a wire is held. */
+export function useBreadboardHoverPreview() {
+  const drag = useStore(s => s.endpointDrag);
+  const components = native(s => s.components);
+  const wires = native(s => s.wires);
+  const target = drag?.hoverTarget;
+  return useMemo(() => target
+    ? breadboardHoverPreview(components, wires, target, drag?.wireId)
+    : null, [components, wires, target?.componentId, target?.pinName, drag?.wireId]);
+}
+
+/** Components physically seated on the candidate strip, not remote jumper nets. */
+export function useDirectBreadboardComponents() {
+  const drag = useStore(s => s.endpointDrag);
+  const components = native(s => s.components);
+  const wires = native(s => s.wires);
+  const target = drag?.hoverTarget;
+  return useMemo(() => target
+    ? directBreadboardComponents(components, wires, target, drag?.wireId)
+    : [], [components, wires, target?.componentId, target?.pinName, drag?.wireId]);
+}
diff --git a/frontend/src/components/embeddedAnalysisReturn.ts b/frontend/src/components/embeddedAnalysisReturn.ts
