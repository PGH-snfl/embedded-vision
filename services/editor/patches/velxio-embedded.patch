+          mat.emissiveIntensity = 0.8;
+        } else {
+          mat.emissive = new THREE.Color('#000000');
+          mat.emissiveIntensity = 0;
+        }
+      }
+    });
+  }, [scene, lit, simActive, glow.emissive]);
