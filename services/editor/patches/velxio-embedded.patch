+// @vitest-environment jsdom
+import { beforeEach, afterEach, describe, it, expect } from 'vitest';
+import fixture from './fixtures/embedded-breadboard-led.json';
+import { useSimulatorStore as native } from '../store/useSimulatorStore';
+import { connectCircuitiny, endpoint, registerProject } from '../components/circuitiny/bridge';
+import { useStore } from '../components/circuitiny/store';
+import { PX } from '../components/circuitiny/catalog';
+import { breadboardHoles } from '../utils/breadboardSnap';
+let dispose = () => {};
+function mount(id: string, pinInfo: unknown) {
+  const el = document.createElement('div');
