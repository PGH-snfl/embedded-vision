+/** Boards have a dedicated picker path; all other registered entries remain visible. */
+export function isCatalogComponent(id: string): boolean {
+  return !Object.prototype.hasOwnProperty.call(BOARD_KIND_LABELS, id);
+}
+
+/** Catalog entries whose artwork exists but which cannot be placed as parts. */
+export function pickerUnavailableReason(id: string, korean: boolean): string | null {
+  if (id === 'nano-rp2040-connect' || id === 'esp32-devkit-v1') {
+    return korean
+      ? '보드 그림만 제공 · 실행 및 추가 불가'
+      : 'Board artwork only · cannot be placed or simulated';
+  }
+  if (id === 'junction') {
+    return korean
+      ? '배선 끝을 다른 배선에 놓거나 연결점 도구로 생성'
+      : 'Create by dropping a wire end onto another wire or using the junction tool';
+  }
+  return null;
+}
