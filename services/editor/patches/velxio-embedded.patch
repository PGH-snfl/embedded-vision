+};
+export function useWorkbenchTranslation() {
+  const result = useTranslation();
+  const native = result.t;
+  const t = ((key: unknown, options?: unknown) => {
+    if (isKoreanWorkbench() && typeof key === 'string') {
+      const category = key.startsWith('editor.componentCategories.')
+        ? KOREAN_CATEGORIES[key.split('.').at(-1)!]
+        : undefined;
+      const translated = words[key] || category;
+      if (translated) return translated;
+    }
+    return native(key as never, options as never);
+  }) as typeof native;
+  return { ...result, t };
