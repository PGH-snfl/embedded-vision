+import { describe, expect, it } from 'vitest';
+import { hoveredStripLine3D } from '../components/circuitiny/hoverStrip3D';
+import { breadboardHoverPreview } from '../utils/breadboardHoverPreview';
+import { breadboardHoles } from '../utils/breadboardSnap';
+import type { Wire } from '../types/wire';
+
+const parts = [{id:'BB1',metadataId:'breadboard'}, {id:'BB2',metadataId:'breadboard-mini'}];
+const ep = (componentId:string,pinName:string) => ({componentId,pinName,x:0,y:0});
+const connectingWire = {id:'J1',start:ep('BB1','23t.a'),end:ep('BB2','5b.f'),waypoints:[],color:'#fff'} as Wire;
+const coords = new Map<string,[number,number,number]>(parts.flatMap(p => (breadboardHoles(p.metadataId) || []).map(h => [`${p.id}.${h.name}`, [h.x,0,h.y] as [number,number,number]])));
+const resolve = (ref:string) => coords.get(ref);
+
+describe('3D hovered strip', () => {
+  it('shows only the target 5-hole strip even if another board is connected', () => {
+    const preview = breadboardHoverPreview(parts,[connectingWire],ep('BB1','23t.c'))!;
+    expect(preview.groups).toHaveLength(2);
+    const line = hoveredStripLine3D(preview,resolve)!;
+    expect(line[0][0]).toBe(line[1][0]);
+    expect(line[0][2]).toBe(coords.get('BB1.23t.a')![2]);
+    expect(line[1][2]).toBe(coords.get('BB1.23t.e')![2]);
+  });
+  it('keeps the lower strip separate and spans a power rail along its own row', () => {
+    const lower = hoveredStripLine3D(breadboardHoverPreview(parts,[],ep('BB1','23b.h')),resolve)!;
+    expect(lower[0][2]).toBe(coords.get('BB1.23b.f')![2]);
+    expect(lower[1][2]).toBe(coords.get('BB1.23b.j')![2]);
+    for (const rail of ['tp','tn','bp','bn']) {
+      const line = hoveredStripLine3D(breadboardHoverPreview(parts,[],ep('BB1',`${rail}.7`)),resolve)!;
+      expect(line[0][0]).toBe(coords.get(`BB1.${rail}.1`)![0]);
+      expect(line[1][0]).toBe(coords.get(`BB1.${rail}.50`)![0]);
+      expect(line[0][2]).toBe(line[1][2]);
+    }
+  });
+  it('draws nothing without a target or resolved endpoints', () => {
+    expect(hoveredStripLine3D(null,resolve)).toBeNull();
+    expect(hoveredStripLine3D(breadboardHoverPreview(parts,[],ep('BB1','23t.a')),() => undefined)).toBeNull();
+  });
+});
