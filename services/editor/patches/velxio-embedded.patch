+// @vitest-environment jsdom
+import { describe, it, expect, vi } from 'vitest';
+import { useSimulatorStore } from '../store/useSimulatorStore';
+
+describe('rotated button live input', () => {
+  it('keeps contacts on press and release, but re-seats when rotation changes', () => {
+    const store = useSimulatorStore.getState();
+    const rewire = vi.fn();
+    const reseat = vi.fn();
+    useSimulatorStore.setState({
+      components: [{ id: 'SW1', metadataId: 'pushbutton-6mm', x: 0, y: 0,
+        properties: { rotation: 90, pressed: false } }],
+      updateWirePositions: rewire,
+      reseatComponentOnBreadboard: reseat,
+    });
+    try {
+      useSimulatorStore.getState().applyLivePropertyChange('SW1', 'pressed', true);
+      useSimulatorStore.getState().applyLivePropertyChange('SW1', 'pressed', false);
+      expect(rewire).not.toHaveBeenCalled();
+      expect(reseat).not.toHaveBeenCalled();
+      useSimulatorStore.getState().updateComponent('SW1', { properties: { rotation: 180 } });
+      expect(rewire).toHaveBeenCalledOnce();
+      expect(reseat).toHaveBeenCalledOnce();
+    } finally {
