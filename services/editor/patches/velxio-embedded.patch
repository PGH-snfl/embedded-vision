+    c = Math.cos(a),
+    s = Math.sin(a);
+  return [p[0] * c + p[2] * s, p[1], -p[0] * s + p[2] * c];
+}
+export function UnoBody({
+  componentId,
+  rotation = 0,
+}: { componentId?: string; rotation?: number } = {}) {
+  const board = componentId ? definitions.get(componentId) : catalog.getBoard('arduino-uno');
+  return (
+    <UnoModel
+      id={componentId?.split('@')[1] || 'U1'}
+      width={UNO_W * PX}
+      depth={UNO_H * PX}
+      pins={(board?.pins || []).map((p) => ({ ...p, position: unrotate(p.position, rotation) }))}
+    />
+  );
+}
+export const EmbeddedBody = memo(function EmbeddedBody({
+  componentId,
+  config,
+  lit = false,
+  brightness = lit ? 1 : 0,
+}: {
+  componentId: string;
+  config?: Record<string, unknown>;
+  lit?: boolean;
+  brightness?: number;
+}) {
+  const def = definitions.get(componentId);
+  if (!def) return null;
+  const kind = String(config?.metadataId || componentId.split('@')[0]),
+    rotation = Number(config?.rotation) || 0;
+  const pins = def.pins.map((p) => ({ ...p, position: unrotate(p.position, rotation) }));
+  const width = Number(config?.width) || 0.015,
+    depth = Number(config?.depth) || 0.015,
+    center = (config?.bodyCenter || [0, 0, 0]) as [number, number, number],
+    id = String(config?.nativeId || componentId.split('@')[1]);
+  if (kind === 'arduino-uno') return <UnoBody componentId={componentId} rotation={rotation} />;
+  if (kind === 'led')
+    return <LedModel pins={pins} color={String(config?.color || 'red')} brightness={brightness} />;
+  if (kind.startsWith('breadboard'))
+    return <BreadboardModel id={id} width={width} depth={depth} pins={pins} />;
+  if (kind === 'resistor') return <ResistorModel pins={pins} value={String(config?.value || '')} />;
+  if (kind.startsWith('pushbutton') || kind === 'slide-switch')
+    return (
+      <ButtonModel
+        pins={pins}
+        width={width}
+        depth={depth}
+        center={center}
+        pressed={!!config?.pressed}
+        slide={kind === 'slide-switch'}
+        value={!!Number(config?.value)}
+        color={String(config?.color || '#292d30')}
+      />
+    );
+  return (
+    <group>
+      <group position={center}>
+        <RoundedBox
+          args={[width, 0.006, depth]}
+          radius={Math.min(0.001, width / 6, depth / 6)}
+          smoothness={2}
+          position={[0, 0.0035, 0]}
+          castShadow
+          receiveShadow
+        >
+          <meshStandardMaterial color={config?.isBoard ? '#1e6553' : '#a7bdb0'} roughness={0.5} />
+        </RoundedBox>
+        <NativeFace id={id} width={width} depth={depth} />
+        <Html
+          position={[0, 0.009, -depth / 2 - 0.002]}
+          center
+          style={{ pointerEvents: 'none', fontSize: 10, color: '#42624d', whiteSpace: 'nowrap' }}
+        >
+          {String(config?.name || kind)} · {id}
+        </Html>
+      </group>
+      {pins.map((p) => (
+        <Lead
+          key={p.id}
+          points={[
+            p.position,
+            [p.position[0], 0.003, p.position[2]],
+            [p.position[0] * 0.9, 0.003, p.position[2] * 0.9],
+          ]}
+        />
+      ))}
+    </group>
+  );
+});
+export function FitScene() {
+  const { camera, scene, size, controls } = useThree();
+  const sceneKey = useStore((s) => s.sceneKey),
+    hasScene = useStore((s) => !!(s.project.components.length || s.project.boards?.length)),
+    fitRevision = useStore((s) => s.fitRevision);
+  useEffect(() => {
+    const timer = setTimeout(() => {
+      const root = scene.getObjectByName('circuitiny-design');
+      if (!root) return;
+      root.updateWorldMatrix(true, true);
+      const project = useStore.getState().project,
+        points: T.Vector3[] = [];
+      for (const c of [...project.components, ...(project.boards || [])])
+        definitions
+          .get(c.componentId)
+          ?.pins.forEach((p) =>
+            points.push(
+              new T.Vector3(...p.position).add(new T.Vector3(...(c.position || [0, 0, 0]))),
+            ),
+          );
+      const box = new T.Box3().setFromPoints(points).expandByScalar(0.009);
+      if (box.isEmpty()) return;
+      const center = box.getCenter(new T.Vector3()),
+        extent = box.getSize(new T.Vector3()).length();
+      const aspect = size.width / Math.max(1, size.height),
+        distance = Math.max(0.09, (extent * 1.16) / Math.min(1, aspect));
+      const viewMode = useStore.getState().viewMode;
+      if (camera instanceof T.OrthographicCamera) {
+        camera.up.set(0, 1, 0);
+        camera.position.copy(center).addScaledVector(
+          (viewMode === 'front' ? new T.Vector3(0.05, 0.4, 1) : new T.Vector3(0.55, 0.9, 1)).normalize(),
+          distance,
+        );
+        if (viewMode === 'top') alignTopView(camera, center);
+        camera.zoom = topViewFitZoom(box.getSize(new T.Vector3()), size) / (viewMode === 'top' ? 1 : 1.5);
+        camera.updateProjectionMatrix();
+      } else {
+        camera.up.set(0, 1, 0);
+        camera.position.copy(center).addScaledVector(
+          (viewMode === 'front' ? new T.Vector3(0.05, 0.4, 1) : new T.Vector3(0.55, 0.9, 1)).normalize(),
+          distance,
+        );
+      }
+      camera.lookAt(center);
+      if (controls && 'target' in controls) {
+        (controls as unknown as { target: T.Vector3; update: () => void }).target.copy(center);
+        (controls as unknown as { update: () => void }).update();
+      }
+    }, 120);
+    return () => clearTimeout(timer);
+  }, [sceneKey, hasScene, fitRevision, size.width, size.height, camera, scene, controls]);
+  return null;
+}
diff --git a/frontend/src/components/circuitiny/EndpointHandle.tsx b/frontend/src/components/circuitiny/EndpointHandle.tsx
new file mode 100644
index 0000000..12033b6
--- /dev/null
+++ b/frontend/src/components/circuitiny/EndpointHandle.tsx
@@ -0,0 +1,209 @@
+import { useEffect, useRef, useState } from 'react';
+import { useThree } from '@react-three/fiber';
+import { Html } from '@react-three/drei';
+import * as T from 'three';
+import { useStore } from './store';
+import { useSimulatorStore as native } from '../../store/useSimulatorStore';
+import { wirePinTarget, reconnectWireEnd, type WireEnd } from '../../utils/wireReconnect';
+import { PX } from './catalog';
+
+export function EndpointHandle({
+  wireId,
+  side,
+  position,
+  emphasized = false,
+}: {
+  wireId: string;
+  side: WireEnd;
+  position: [number, number, number];
+  emphasized?: boolean;
+}) {
+  const { camera, gl, controls } = useThree();
+  const [hovered, setHovered] = useState(false);
+  const drag = useStore((s) => s.endpointDrag);
+  const active = useRef(false),
+    wasEnabled = useRef(true),
+    capture = useRef<{ releasePointerCapture: (id: number) => void; id: number } | null>(null);
+  const point = useRef<[number, number, number]>(position);
+  const plane = new T.Plane(new T.Vector3(0, 1, 0), -position[1]);
+  const name = side === 'start' ? '시작점' : '끝점';
+  const stop = (commit: boolean) => {
+    if (!active.current) return;
+    active.current = false;
+    if (controls && 'enabled' in controls)
+      (controls as { enabled: boolean }).enabled = wasEnabled.current;
+    try {
+      capture.current?.releasePointerCapture(capture.current.id);
+    } catch {
+      /* canvas may have released it */
+    }
+    capture.current = null;
+    if (commit) {
+      const p = point.current,
+        target = wirePinTarget(native.getState(), wireId, side, { x: p[0] / PX, y: p[2] / PX }, 14);
+      try {
+        if (!target?.valid)
+          throw new Error(target?.reason || '핀 근처에 놓으세요. 원래 연결을 유지했습니다.');
+        reconnectWireEnd(wireId, side, target.endpoint);
+        useStore.setState({
+          message: `${name}을 ${target.endpoint.componentId}.${target.endpoint.pinName}으로 옮겼습니다.`,
+        });
+      } catch (e) {
+        useStore.setState({
+          message: e instanceof Error ? e.message : '연결을 옮기지 못했습니다.',
+        });
+      }
+    }
+    useStore.setState({ endpointDrag: null });
+  };
+  const projectPointer = (x: number, y: number) => {
+    const r = gl.domElement.getBoundingClientRect();
+    const ray = new T.Raycaster();
+    ray.setFromCamera(
+      new T.Vector2(((x - r.left) / r.width) * 2 - 1, (-(y - r.top) / r.height) * 2 + 1),
+      camera,
+    );
+    return ray.ray.intersectPlane(plane, new T.Vector3());
+  };
+  const move = (x: number, y: number) => {
+    if (!active.current) return;
+    const rect = gl.domElement.getBoundingClientRect();
+    if (x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) {
+      useStore.setState(s => s.endpointDrag ? { endpointDrag: { ...s.endpointDrag, hoverTarget: null, valid: false, label: '화면 안의 핀으로 옮기세요' } } : {});
+      return;
+    }
+    const p = projectPointer(x, y);
+    if (!p) return;
+    point.current = [p.x, position[1], p.z];
+    const hit = wirePinTarget(native.getState(), wireId, side, { x: p.x / PX, y: p.z / PX }, 14);
+    const at = hit?.endpoint;
+    useStore.setState({
+      endpointDrag: {
+        wireId,
+        side,
+        point: at ? [at.x * PX, position[1], at.y * PX] : point.current,
+        valid: !!hit?.valid,
+        hoverTarget: at ? {componentId: at.componentId, pinName: at.pinName} : null,
+        label: hit
+          ? hit.valid
+            ? `${at!.componentId}.${at!.pinName}`
+            : hit.reason
+          : '핀 근처로 옮기세요',
+      },
+    });
+  };
+  useEffect(() => {
+    const onMove = (e: PointerEvent) => move(e.clientX, e.clientY);
+    const onUp = (e: PointerEvent) => {
+      if (!active.current) return;
+      move(e.clientX, e.clientY);
+      const r = gl.domElement.getBoundingClientRect();
+      stop(
+        e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom,
+      );
+    };
+    const cancel = () => stop(false);
+    const key = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') cancel();
+    };
+    window.addEventListener('pointermove', onMove);
+    window.addEventListener('pointerup', onUp);
+    window.addEventListener('pointercancel', cancel);
+    window.addEventListener('blur', cancel);
+    window.addEventListener('keydown', key);
+    return () => {
+      cancel();
+      window.removeEventListener('pointermove', onMove);
+      window.removeEventListener('pointerup', onUp);
+      window.removeEventListener('pointercancel', cancel);
+      window.removeEventListener('blur', cancel);
+      window.removeEventListener('keydown', key);
+    };
+  }, [wireId, side, camera, gl, controls]);
+  const mine = drag?.wireId === wireId && drag.side === side;
+  const at = mine ? drag.point : position;
+  const down = (e: {
+    pointerId: number;
+    stopPropagation: () => void;
+    nativeEvent: { button: number; preventDefault: () => void };
+    target: EventTarget;
+  }) => {
+    if (native.getState().running || e.nativeEvent.button !== 0) return;
+    e.stopPropagation();
+    e.nativeEvent.preventDefault();
+    point.current = position;
+    active.current = true;
+    if (controls && 'enabled' in controls) {
+      wasEnabled.current = (controls as { enabled: boolean }).enabled;
+      (controls as { enabled: boolean }).enabled = false;
+    }
+    const target = e.target as unknown as {
+      setPointerCapture: (id: number) => void;
+      releasePointerCapture: (id: number) => void;
+    };
+    target.setPointerCapture(e.pointerId);
+    capture.current = {
+      releasePointerCapture: (id) => target.releasePointerCapture(id),
+      id: e.pointerId,
+    };
+    useStore.setState({
+      endpointDrag: {
+        wireId,
+        side,
+        point: position,
+        valid: true,
+        label: `${name}을 새 핀으로 끌어 놓으세요.`,
+      },
+    });
+  };
+  return (
+    <group position={at}>
+      <mesh onPointerDown={down} onClick={(e) => e.stopPropagation()} renderOrder={20}>
+        <sphereGeometry args={[0.0017, 16, 12]} />
+        <meshBasicMaterial
+          color={
+            mine ? (drag.valid ? '#d69b38' : '#d97a3d') : side === 'start' ? '#247fbd' : '#d69b38'
+          }
+          depthTest={false}
+        />
+      </mesh>
+      <Html center position={[0, 0, 0]} zIndexRange={[200, 150]}>
+        <button
+          type="button"
+          aria-label={`${wireId} ${name} 이동`}
+          title={`${name}을 새 핀으로 끌어 놓으세요`}
+          onPointerDown={down}
+          onPointerEnter={() => setHovered(true)}
+          onPointerLeave={() => setHovered(false)}
+          onClick={(e) => e.stopPropagation()}
+          style={{
+            width: 20,
+            height: 20,
+            padding: 0,
+            border: '2px solid white',
+            borderRadius: '50%',
+            touchAction: 'none',
+            cursor: 'grab',
+            background: mine
+              ? drag.valid
+                ? '#d69b38'
+                : '#d97a3d'
+              : side === 'start'
+                ? '#247fbd'
+                : '#d69b38',
+            boxShadow: '0 1px 5px #2345',
+          }}
+        />
+      </Html>
+      {(mine || emphasized || hovered) && (
+        <Html
+          center
+          position={[0, 0.005, 0]}
+          style={{ pointerEvents: 'none', whiteSpace: 'nowrap', fontSize: 11, color: '#2c563e' }}
+        >
+          {mine ? drag.label : name + ' ↔'}
+        </Html>
+      )}
+    </group>
+  );
+}
