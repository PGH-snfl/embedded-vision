+   unsub1=useSimulatorStore.subscribe((s,p)=>{if(s.components!==p.components||s.wires!==p.wires||JSON.stringify(s.boards.map(b=>[b.id,b.x,b.y,b.rotation,b.boardKind,b.name,b.activeFileGroupId]))!==JSON.stringify(p.boards.map(b=>[b.id,b.x,b.y,b.rotation,b.boardKind,b.name,b.activeFileGroupId])))save();});
