index 0000000..16aeb35
--- /dev/null
+++ b/frontend/src/components/embeddedAnalysisReturn.ts
@@ -0,0 +1,16 @@
+const DEFAULT_ANALYSIS_URL = 'http://127.0.0.1:8766/';
+
+/** Local origins come from imported project metadata; never trust arbitrary URLs. */
+export function analysisReturnUrl(workspace: string | undefined, origin: unknown): string {
+  // Hosted projects must stay in their current workspace, irrespective of
+  // metadata imported from another project.
+  if (workspace && /^[a-f0-9]{32}$/.test(workspace)) return `/w/${workspace}/`;
+  if (typeof origin !== 'string') return DEFAULT_ANALYSIS_URL;
+  try {
+    const url = new URL(origin);
+    if ((url.protocol === 'http:' || url.protocol === 'https:') &&
+        (url.hostname === 'localhost' || url.hostname === '127.0.0.1') &&
+        !url.username && !url.password) return `${url.origin}/`;
+  } catch { /* Old or malformed project metadata uses the local default. */ }
+  return DEFAULT_ANALYSIS_URL;
+}
diff --git a/frontend/src/components/embeddedCloud.ts b/frontend/src/components/embeddedCloud.ts
new file mode 100644
index 0000000..2ed5b4b
--- /dev/null
+++ b/frontend/src/components/embeddedCloud.ts
@@ -0,0 +1,55 @@
+import { getCsrfHeaders } from '../lib/apiBase';
+
+export function hostedWorkspace() {
+  return /^\/w\/([a-f0-9]{32})(?:\/|$)/.exec(location.pathname)?.[1];
+}
+
+/** Explicit cloud save, with revision checks; browser drafts remain independently recoverable. */
+export async function openCloudDraft(source: Record<string, any>) {
+  const workspace = hostedWorkspace();
+  if (!workspace) return null;
+  const project = source.source_project;
+  if (typeof project !== 'string' || !/^[a-f0-9]{32}$/.test(project))
+    throw new Error(
+      '작업공간의 원본 프로젝트가 필요합니다. 사진 분석 화면에서 편집기를 다시 여세요.',
+    );
+  const bytes = new TextEncoder().encode(
+    JSON.stringify([
+      source.source_graph_sha256,
+      source.inventory_plan,
+      source.recipe,
+      source.function_version,
+      source.assembly?.layout_version,
+    ]),
+  );
+  const hash = await crypto.subtle.digest('SHA-256', bytes);
+  const key = Array.from(new Uint8Array(hash), (b) => b.toString(16).padStart(2, '0')).join('');
+  const endpoint = `/api/w/${workspace}/workbench/projects/${project}/${key}`;
+  const response = await fetch(endpoint, { credentials: 'same-origin' });
+  if (!response.ok)
+    throw new Error('서버 저장본을 불러오지 못했습니다. 로그인과 프로젝트 권한을 확인하세요.');
+  const initial = await response.json();
+  let revision = initial.revision;
+  return {
+    payload: initial.payload,
+    revision: () => revision,
+    async save(payload: unknown) {
+      const saved = await fetch(endpoint, {
+        method: 'PUT',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', ...getCsrfHeaders() },
+        body: JSON.stringify({ expected_revision: revision, payload }),
+      });
+      if (!saved.ok) {
+        const error = await saved.json().catch(() => ({}));
+        throw new Error(
+          typeof error.detail === 'string'
+            ? error.detail
+            : '서버 저장 실패 · 프로젝트 파일로 보관하세요.',
+        );
+      }
+      revision = (await saved.json()).revision;
+      return revision;
+    },
+  };
+}
