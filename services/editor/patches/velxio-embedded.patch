+    {recoveryKey&&<button disabled={running} onClick={async()=>{const saved=localStorage.getItem(recoveryKey);if(saved){try{await importVlxFile(new File([saved],'browser-draft.vlx',{type:'application/json'}));setCloudStatus('브라우저 초안 복원됨 · 서버에 반영하려면 작업공간에 저장하세요.');}catch{setCloudStatus('브라우저 초안을 불러오지 못했습니다.');}}}}>브라우저 초안 복원</button>}
+    {key&&<button onClick={()=>{if(confirm('이 편집 내용을 버리고 최초 제안으로 되돌릴까요?')){resetting.current=true;localStorage.removeItem(key);location.reload();}}}>최초 제안으로 복원</button>}
+    <a href="https://github.com/davidmonterocrespo24/velxio" target="_blank" rel="noreferrer">Powered by Velxio · AGPL-3.0</a>
+   </div></details>
+  </div>
+  {failed&&<p className="ev-import-error" role="alert">{message}</p>}
+ </header>;
+}
