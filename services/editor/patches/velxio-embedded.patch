+import * as THREE from 'three';
+
+/** Seated pins can coincide; split their labels so neither covers the other. */
+export function splitNearbyGuideLabels(pins: readonly [number, number, number][]) {
+  if (pins.length !== 2 || pins.some(p => p.some(n => !Number.isFinite(n)))) return false;
+  return new THREE.Vector3(...pins[0]).distanceTo(new THREE.Vector3(...pins[1])) < .02;
+}
+
+/** Frame both observed pin positions while retaining the user's current viewing direction. */
+export function guideCameraView(camera: THREE.PerspectiveCamera | THREE.OrthographicCamera, pins: readonly [number, number, number][], viewport = { width: 1280, height: 720 }) {
+  if (!pins.length || pins.some(p => p.some(n => !Number.isFinite(n)))) return null;
+  // Frame the lifted label anchors, not just the holes. Leave room in pixels
+  // for labels and the toolbar, which can occupy much of a narrow canvas.
+  const anchors = pins.map((p, i) => new THREE.Vector3(p[0], p[1] + (pins.length > 2 ? .05 : i === 0 ? .014 : .026), p[2]));
+  // With a group of legs both the actual contacts and their lifted labels
+  // must fit; framing only the labels can push the breadboard out of view.
+  const points = pins.length > 2 ? [...pins.map(p => new THREE.Vector3(...p)), ...anchors] : anchors;
+  const center = new THREE.Box3().setFromPoints(points).getCenter(new THREE.Vector3());
+  const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
+  const up = new THREE.Vector3(0, 1, 0).applyQuaternion(camera.quaternion);
+  const backward = new THREE.Vector3(0, 0, 1).applyQuaternion(camera.quaternion);
+  const width = Math.max(viewport.width, 1), height = Math.max(viewport.height, 1);
+  const sideMargin = Math.min(80, width * .23);
+  const topMargin = Math.min((width <= 700 ? 100 : 65) + 48, height * .42);
+  const bottomMargin = Math.min(44, height * .2);
+  const xLimit = Math.max(.1, 1 - 2 * sideMargin / width);
+  const yUpper = 1 - 2 * topMargin / height;
+  const yLower = -1 + 2 * bottomMargin / height;
+  const yLimit = Math.max(.1, (yUpper - yLower) / 2);
+  const yCenter = (yUpper + yLower) / 2;
+  if (camera instanceof THREE.OrthographicCamera) {
+    // Orthographic scale is independent of distance. Fit all points with room
+    // for the labels and toolbar, and cap zoom to keep a useful board context.
+    const halfWidth = Math.max(0.02, ...points.map(p => Math.abs(p.clone().sub(center).dot(right))));
+    const halfHeight = Math.max(0.02, ...points.map(p => Math.abs(p.clone().sub(center).dot(up))));
+    const zoom = Math.min((camera.right - camera.left) * xLimit / (2 * halfWidth * 1.9),
+      (camera.top - camera.bottom) * yLimit / (2 * halfHeight * 1.9));
+    if (!Number.isFinite(zoom) || zoom <= 0) return null;
+    const target = center.clone().addScaledVector(up, -yCenter * (camera.top - camera.bottom) / (2 * zoom));
+    return { target, position: target.clone().addScaledVector(backward, Math.max(.09, camera.position.distanceTo(center))), zoom };
+  }
+  const tanY = Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2);
+  const tanX = tanY * Math.max(camera.aspect, 0.1);
+  // Leave room around both pins for their labels and avoid zooming inside a component.
+  let distance = 0.09;
+  for (const p of points) {
+    const offset = p.clone().sub(center), depth = offset.dot(backward);
+    distance = Math.max(distance, depth + Math.abs(offset.dot(right)) / (tanX * xLimit) * 1.9,
+      depth + Math.abs(offset.dot(up)) / (tanY * yLimit) * 1.9);
+  }
+  // Shift the framed area below the toolbar without changing viewing angle.
+  const target = center.clone().addScaledVector(up, -yCenter * distance * tanY);
+  return { target, position: target.clone().addScaledVector(backward, distance) };
+}
