+import { Camera, Vector3 } from 'three';
+
+/** Turn the existing camera straight down without changing its target or zoom. */
+export function alignTopView(camera: Camera, target: Vector3) {
+  const distance = Math.max(camera.position.distanceTo(target), .001);
+  // OrbitControls uses Y as up and cannot orbit from an exact pole. Its tiny
+  // offset is visually vertical and allows the next 3D drag to work instantly.
+  camera.up.set(0, 1, 0);
+  camera.position.copy(target).add(new Vector3(0, distance, distance * 1e-6));
+  camera.lookAt(target);
+}
+
+/** Fit the X/Z footprint of a top-down scene to the available viewport.
+ * OrthographicCamera's default frustum spans the viewport in pixels; zoom is
+ * pixels per world unit. Both axes must fit independently, with a small margin.
+ */
+export function topViewFitZoom(extent: {x: number; z: number}, viewport: {width: number; height: number}) {
+  const width = Math.max(1, viewport.width), height = Math.max(1, viewport.height);
+  const spanX = Number.isFinite(extent.x) ? Math.max(extent.x, .09) : .09;
+  const spanZ = Number.isFinite(extent.z) ? Math.max(extent.z, .09) : .09;
+  return Math.min(width / spanX, height / spanZ) / 1.15;
+}
