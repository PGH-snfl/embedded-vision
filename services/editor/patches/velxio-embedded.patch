+/** Assembly instructions describe the generated design, never the photographed wiring. */
+export type AssemblyStep = { from: string; to: string; kind: 'insert' | 'jumper' };
+export type GroupedAssemblyStep = AssemblyStep & { connections: AssemblyStep[] };
+import type { Project } from './project/schema';
+import { catalog } from './catalog';
+import { resolvePin } from './project/pins';
+type Endpoint = { componentId: string; pinName: string };
+type GuideWire = { start: Endpoint; end: Endpoint; bb?: boolean; color?: string };
+
+/** A component is seated as one operation; a jumper remains a separate operation. */
+export function groupAssemblySteps(steps: AssemblyStep[]): GroupedAssemblyStep[] {
+  const grouped: GroupedAssemblyStep[] = [];
+  const components = new Map<string, GroupedAssemblyStep>();
+  for (const step of steps.filter(s => s.kind === 'insert')) {
+    const id = step.from.split('.')[0];
+    const existing = components.get(id);
+    if (existing) existing.connections.push(step);
+    else {
+      const group = { ...step, connections: [step] };
+      components.set(id, group);
+      grouped.push(group);
+    }
+  }
+  for (const step of steps.filter(s => s.kind === 'jumper')) grouped.push({ ...step, connections: [step] });
+  return grouped;
+}
+
+export function guideSteps(hash: string): { steps: GroupedAssemblyStep[]; note: string } {
+  try {
+    const encoded = new URLSearchParams(hash.replace(/^#/, '')).get('project');
+    if (!encoded) return { steps: [], note: '' };
+    const data = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(encoded), c => c.charCodeAt(0))));
+    const assembly = data.embeddedVision?.assembly;
+    if (!Array.isArray(assembly?.steps)) return { steps: [], note: '' };
+    const steps = assembly.steps.filter((s: any) => typeof s.from === 'string' && typeof s.to === 'string' && (s.kind === 'insert' || s.kind === 'jumper')) as AssemblyStep[];
+    // Place components before adding jumper wires, preserving each group's original order.
+    return { steps: groupAssemblySteps(steps), note: typeof assembly.note === 'string' ? assembly.note : '' };
+  } catch { return { steps: [], note: '' }; }
+}
+
+export function findStepWire(step: AssemblyStep, wires: GuideWire[]): GuideWire | undefined {
+  const ref = (e: Endpoint) => `${e.componentId}.${e.pinName}`;
+  return wires.find(w => Boolean(w.bb) === (step.kind === 'insert') &&
+    ((ref(w.start) === step.from && ref(w.end) === step.to) || (ref(w.end) === step.from && ref(w.start) === step.to)));
+}
+
+export function readableRef(ref: string): string {
+  const [id, ...rest] = ref.split('.');
+  const pin = rest.join('.');
+  const hole = /^(\d+)[tb]\.([a-j])$/.exec(pin);
+  if (id === 'BB1' && hole) return `빵판 ${hole[2].toUpperCase()}${hole[1]} 구멍`;
+  const names: Record<string, string> = { U1: '아두이노 U1', D1: 'LED D1', R1: '저항 R1', R2: '저항 R2', SW1: '버튼 SW1', S1: '조도 센서 S1', BTN1: '버튼 BTN1', B1: '버튼 B1' };
+  const label = pin === 'A' && id.startsWith('D') ? 'A(긴 다리, +)' : pin === 'C' && id.startsWith('D') ? 'C(짧은 다리, −)' : pin;
+  if (id === 'S1') {
+    const sensorPin: Record<string, string> = {VCC: 'VCC(전원)', GND: 'GND(접지)', AO: 'AO(아날로그 출력)'};
+    return `${names[id]} ${sensorPin[pin] || pin} 핀`;
+  }
+  return `${names[id] || id} ${label} 핀`;
+}
+
+export function resolveGuidePin(project: Project, original: string) {
+  const [owner, ...parts] = original.split('.');
+  const instance = [...(project.boards || []), ...project.components].find(c => c.instance === owner);
+  if (!instance) return null;
+  const pinOwner = String(instance.config?.pinOwner || owner);
+  const rawPin = parts.join('.');
+  let result = resolvePin(project, pinOwner + '.' + rawPin.replaceAll('.', '__'));
+  if (!result && rawPin === 'GND') {
+    const definition = pinOwner === 'board' ? catalog.getBoard(project.board) : catalog.getComponent(instance.componentId);
+    const pin = definition?.pins.find(p => p.label.startsWith('GND'));
+    if (pin) result = resolvePin(project, pinOwner + '.' + pin.id);
+  }
+  return result;
+}
+
+export function guideWarning(step: AssemblyStep | GroupedAssemblyStep, wires: GuideWire[], project: Project): string {
+  const connections = 'connections' in step ? step.connections : [step];
+  if (step.kind === 'insert' && (new Set(connections.map(s => s.from)).size !== connections.length || new Set(connections.map(s => s.to)).size !== connections.length)) return '같은 부품의 다리 또는 구멍이 중복되어 표시를 숨겼습니다. 연결을 직접 확인하세요.';
+  if (!connections.length || connections.some(s => !findStepWire(s, wires))) return '편집한 회로가 이 단계와 달라 위치 강조를 숨겼습니다. 최초 제안으로 복원하거나 배선을 직접 확인하세요.';
+  if (connections.some(s => !resolveGuidePin(project, s.from) || !resolveGuidePin(project, s.to))) return '3D에서 핀 위치를 확인하지 못해 강조를 숨겼습니다. 부품 핀과 빵판 구멍을 직접 확인하세요.';
+  return '';
+}
