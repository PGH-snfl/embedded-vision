@@ -0,0 +1,65 @@
+// @vitest-environment jsdom
+import { expect, it, vi } from 'vitest';
+import { spawnSync } from 'node:child_process';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { AVRSimulator } from '../simulation/AVRSimulator';
+import { PinManager } from '../simulation/PinManager';
+import { buildNetlist } from '../simulation/spice/NetlistBuilder';
+import { runNetlist } from './helpers/testSolver';
+import { PartSimulationRegistry } from '../simulation/parts/PartSimulationRegistry';
+import { PROPERTY_CHANGE_EVENT } from '../simulation/parts/partUtils';
+import { dispatchSensorUpdate } from '../simulation/SensorUpdateRegistry';
+import '../simulation/parts/ComplexParts';
+
+const bridge=vi.hoisted(()=>({sim:null as any,electrical:{nodeVoltages:{} as Record<string,number>,pinNetMap:new Map<string,string>(),sourcedNets:new Set<string>(),timeWaveforms:null}}));
+vi.mock('../store/useSimulatorStore',()=>({useSimulatorStore:{getState:()=>({boards:[{id:'U1',boardKind:'arduino-uno'}]}),subscribe:()=>()=>{}},getBoardSimulator:()=>bridge.sim}));
+vi.mock('../store/useElectricalStore',()=>({useElectricalStore:{getState:()=>bridge.electrical,subscribe:()=>()=>{}}}));
+vi.stubGlobal('requestAnimationFrame',()=>1);vi.stubGlobal('cancelAnimationFrame',()=>{});
+const project=resolve(dirname(fileURLToPath(import.meta.url)),'../../../../..');
+const script=`
+import json,tempfile
+from pathlib import Path
+from backend.design.recipes import new_graph
+from backend.workbench.export import export_project
+from backend.emulator.toolchain import compile_firmware
+p=export_project(new_graph('a'*32,'arduino_light_led')[0])
+with tempfile.TemporaryDirectory(prefix='light-led-test-') as d:
+    compile_firmware(p['fileGroups']['group-U1'][0]['content'],d)
+    print(json.dumps({'project':p,'hex':Path(d,'firmware.hex').read_text()}))
+`;
+
+it('actual generated design drives LED by physical light sensor voltage, including disconnect', {timeout:60000}, async()=>{
+  const result=spawnSync(resolve(project,'.venv/bin/python'),['-c',script],{cwd:project,encoding:'utf8',timeout:45000});
+  expect(result.status,result.stderr).toBe(0);
+  const f=JSON.parse(result.stdout), {components,wires}=f.project;
+  const sensor=components.find((c:any)=>c.id==='S1');
+  expect(sensor.metadataId).toBe('photoresistor-sensor');
+  const pm=new PinManager(), sim=new AVRSimulator(pm,'uno');bridge.sim=sim;sim.loadHex(f.hex);
+  const {connectAnalogInputsToMcu}=await import('../simulation/spice/connectAnalogInputsToMcu');
+  const element=document.createElement('div');(element as any).ldrModel='wokwi';
+  const onChange=(evt:Event)=>{const d=(evt as CustomEvent).detail;if(d.componentId==='S1')sensor.properties[d.propName]=d.value;};
+  window.addEventListener(PROPERTY_CHANGE_EVENT,onChange);
+  const detach=PartSimulationRegistry.get('photoresistor-sensor')!.attachEvents!(element,sim as never,(pin:string)=>pin==='AO'?14:null,'S1');
+  const steps=(n=1800000)=>{for(let i=0;i<n;i++)sim.step();};
+  async function solve(){
+    const input={components,wires,boards:[{id:'U1',boardKind:'arduino-uno',vcc:5,
+      pins:{'5':{type:'digital',v:pm.getPinState(5)?5:0}},groundPinNames:['GND'],vccPinNames:['5V']}],analysis:{kind:'op'}} as Parameters<typeof buildNetlist>[0];
+    const {netlist,pinNetMap,sourcedNets}=buildNetlist(input), values=await runNetlist(netlist),net=pinNetMap.get('U1:A0')!;
+    const voltage=values.dcValue(`v(${net})`);
+    bridge.electrical={nodeVoltages:{[net]:voltage},pinNetMap,sourcedNets,timeWaveforms:null};
+    return {voltage,current:Math.abs(values.dcValue('i(v_D1_sense)'))};
+  }
+  for(const [lux,on] of [[0,true],[1000,false],[0,true],[1000,false]] as const){
+    dispatchSensorUpdate('S1',{lux});expect(sensor.properties.lux).toBe(lux);
+    const before=await solve(); if(on)expect(before.voltage).toBeGreaterThan(2.5);else expect(before.voltage).toBeLessThan(2.5);
+    connectAnalogInputsToMcu()();steps();expect(pm.getPinState(5)).toBe(on);
+    const after=await solve();if(on)expect(after.current).toBeGreaterThan(.001);else expect(after.current).toBeLessThan(.00001);
+  }
+  // Floating ADC holds its previous valid value; it must not be driven by lux.
+  const index=wires.findIndex((w:any)=>w.start.componentId==='S1' && w.start.pinName==='GND');expect(index).toBeGreaterThan(-1);wires.splice(index,1);
+  dispatchSensorUpdate('S1',{lux:0});
+  const noGround=await solve();expect(noGround.voltage).toBeLessThan(.1);
+  connectAnalogInputsToMcu()();steps();expect(pm.getPinState(5)).toBe(false);
+  detach?.();window.removeEventListener(PROPERTY_CHANGE_EVENT,onChange);
+});
