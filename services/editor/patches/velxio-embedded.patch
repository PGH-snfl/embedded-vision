+}
+
+function ViewModeCamera() {
+  const viewMode = useStore(s => s.viewMode);
+  const { camera, controls } = useThree();
+  const previous = useRef(viewMode);
+  useLayoutEffect(() => {
+    if (previous.current !== viewMode && viewMode === 'top' && controls && 'target' in controls) {
+      const orbit = controls as unknown as {target: THREE.Vector3; update: () => void};
+      alignTopView(camera, orbit.target);
+      orbit.update();
+    }
+    // The 3D button only enables orbit: do not move, zoom, or re-fit the camera.
+    previous.current = viewMode;
+  }, [viewMode, camera, controls]);
+  return null;
+}
+
+function GuideFocus({pins, revision}: {pins: string[]; revision: number}) {
+  const {camera, controls, gl, size} = useThree();
+  const applied = useRef(0);
+  const pinKey = pins.join('|');
+  useEffect(() => {
+    if (!revision || applied.current === revision) return;
+    // An invalid or hidden step consumes the navigation request; reconnecting
+    // a wire later must not unexpectedly move the user's camera.
+    if (!pins.length || !(camera instanceof THREE.PerspectiveCamera || camera instanceof THREE.OrthographicCamera)) { applied.current = revision; return; }
+    const resolved = pins.map(p => resolveGuidePin(useStore.getState().project, p));
+    if (resolved.some(p => !p)) { applied.current = revision; return; }
+    const view = guideCameraView(camera, resolved.map(p => p!.position), size);
+    if (!view) { applied.current = revision; return; }
+    applied.current = revision;
+    const focus = () => {
+      camera.position.copy(view.position);
+      if (camera instanceof THREE.OrthographicCamera && 'zoom' in view && typeof view.zoom === 'number') {
+        camera.zoom = view.zoom;
+        camera.updateProjectionMatrix();
+      }
+      camera.lookAt(view.target);
+      if (controls && 'target' in controls) {
+        const orbit = controls as unknown as {target: THREE.Vector3; update: () => void};
+        orbit.target.copy(view.target);
+        orbit.update();
+      }
+    };
+    focus();
+    // FitScene may still be handling a resize; let an explicit focus win, unless
+    // the user has begun moving the camera since pressing the focus button.
+    const timer = setTimeout(focus, 160);
+    const cancel = () => clearTimeout(timer);
+    gl.domElement.addEventListener('pointerdown', cancel);
+    gl.domElement.addEventListener('wheel', cancel);
+    return () => { clearTimeout(timer); gl.domElement.removeEventListener('pointerdown', cancel); gl.domElement.removeEventListener('wheel', cancel); };
+  }, [revision, pinKey, camera, controls, gl, size]);
+  return null;
+}
+
+export default function Viewer3D({ guideConnections = [], guideFocusRevision = 0 }: { guideConnections?: AssemblyStep[]; guideFocusRevision?: number }) {
+  const hoverPreview = useBreadboardHoverPreview();
+  const directComponents = useDirectBreadboardComponents();
+  const project = useStore((s) => s.project);
+  const viewMode = useStore((s) => s.viewMode);
+  const cameraLocked = useStore((s) => s.cameraLocked);
+  const selected = useStore((s) => s.selected);
+  const select = useStore((s) => s.select);
+  const cancel = useStore((s) => s.cancelWire);
+  const externalLit = useStore((s) => s.externalLit);
+  const brightness = useStore((s) => s.externalBrightness);
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') cancel();
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [cancel]);
+
+  const simStates = { lit: new Set(externalLit), active: new Set<string>() };
+  const guidePins = guideConnections.flatMap(c => [c.from, c.to]);
+  const insertion = guideConnections[0]?.kind === 'insert';
+  const markers = insertion
+    ? guideConnections.map((c, i) => ({ref:c.to, label:`${guideConnectionNumber(i)} ${readableRef(c.from)} → ${readableRef(c.to)}`, color:guideConnectionColor(i)}))
+    : guidePins.map((ref, i) => ({ref, label:`${guideConnectionNumber(i)} ${readableRef(ref)}`, color:guideConnectionColor(i)}));
+  const guideResolved = markers.map(m => resolveGuidePin(project, m.ref));
+  const splitLabels = !insertion && guideResolved.length === 2 && guideResolved.every(p => p !== null)
+    && splitNearbyGuideLabels(guideResolved.map(p => p!.position));
+
+  return (
+    <div style={{ position: 'relative', width: '100%', height: '100%' }}>
+      <Canvas
+        shadows="variance"
+        camera={{ position: [0.12, 0.1, 0.12], fov: 40, near: 0.001, far: 10 }}
+        style={{ background: '#F2F7F2' }}
+        onPointerMissed={() => select(null)}
+      >
+        <Suspense fallback={null}>
+          <OrthographicCamera makeDefault position={[0.12, 0.1, 0.12]} up={[0, 1, 0]} near={0.001} far={10} />
+          <ambientLight intensity={.72} />
+          <hemisphereLight args={["#fff9ed","#8b9a93",.8]} />
+          <directionalLight position={[-.15,.4,.2]} intensity={2.6} castShadow shadow-mapSize={[2048,2048]} shadow-camera-left={-.35} shadow-camera-right={.35} shadow-camera-top={.3} shadow-camera-bottom={-.3} shadow-camera-near={.01} shadow-camera-far={2} shadow-bias={-.00005}/>
+          <mesh rotation={[-Math.PI/2,0,0]} position={[0,-.0004,0]} receiveShadow><planeGeometry args={[3,3]}/><meshStandardMaterial color="#edf0eb" roughness={.92}/></mesh>
+          <FitScene />
+          <ViewModeCamera />
+          <GuideFocus pins={guidePins} revision={guideFocusRevision} />
+          <Grid
+            args={[1, 1]}
+            cellSize={0.005}
+            sectionSize={0.05}
+            cellColor="#d4e0d6"
+            sectionColor="#becfc1"
+            fadeDistance={0.5}
+            infiniteGrid
+          />
+          <group name="circuitiny-design">
+            {(project.boards || []).map((c) => (
+              <ComponentWithPins
+                key={c.instance}
+                c={c}
+                selected={selected === c.instance}
+                lit={false}
+                simActive={false}
+              />
+            ))}
+            {project.components.map((c) => (
+              <ComponentWithPins
+                key={c.instance}
+                c={c}
+                selected={selected === c.instance}
+                previewed={directComponents.includes(c.instance)}
+                lit={simStates.lit.has(c.instance)}
+                brightness={brightness[c.instance] || 0}
+                simActive={simStates.active.has(c.instance)}
+              />
+            ))}
+            <Wires3D />
+            <BreadboardNetPreview3D preview={hoverPreview} project={project} />
+            <WireGround />
+            {markers.map((marker, index) => {
+              const resolved = guideResolved[index];
+              if (!resolved) return null;
+              const color = marker.color;
+              const leader = guidePointerLayout(index, Boolean(insertion));
+              const direction = new THREE.Vector3(leader.x, leader.y, leader.z);
+              const length = direction.length();
+              const orientation = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.clone().normalize());
+              const transform = insertion && markers.length > 1 ? (index % 2 === 0 ? 'translate(calc(-100% - 8px),-50%)' : 'translate(8px,-50%)') : splitLabels ? (index === 0 ? 'translate(calc(-100% - 8px),-50%)' : 'translate(8px,-50%)') : (index === 0 ? 'translate(-50%,-120%)' : 'translate(-50%,10%)');
+              return <group key={marker.ref + index} position={resolved.position}>
+                <mesh renderOrder={100}><sphereGeometry args={[0.0011, 20, 20]} /><meshBasicMaterial color={color} transparent opacity={0.72} depthTest={false} depthWrite={false} /></mesh>
+                <mesh position={[leader.x/2,leader.y/2,leader.z/2]} quaternion={orientation} renderOrder={101}><cylinderGeometry args={[0.0003,0.0003,length,8]} /><meshBasicMaterial color={color} transparent opacity={leader.opacity} depthTest={false} depthWrite={false} /></mesh>
+                <Html position={[leader.x,leader.y,leader.z]} style={{pointerEvents:'none'}}><div style={{background:color,color:'white',opacity:.88,fontSize:12,fontWeight:700,padding:'4px 6px',border:'2px solid white',boxShadow:'0 2px 8px #0008',borderRadius:7,textAlign:'center',whiteSpace:'normal',width:'max-content',maxWidth:144,overflowWrap:'anywhere',transform}}>{marker.label}</div></Html>
+              </group>;
+            })}
+          </group>
+          <OrbitControls makeDefault target={[0, 0, 0]} enableDamping={false} autoRotate={false}
+            mouseButtons={cameraMouseButtons} {...cameraControlOptions(cameraLocked, viewMode)} />
+        </Suspense>
+      </Canvas>
+
+      <PendingHint />
+    </div>
+  );
+}
