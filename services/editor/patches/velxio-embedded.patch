+      }}
+    >
+      시작 핀 <b>{pendingPin.replaceAll('__', '.')}</b> → 연결할 핀을 클릭하세요.
+      <button
+        onClick={cancel}
+        style={{
+          marginLeft: 8,
+          background: 'transparent',
