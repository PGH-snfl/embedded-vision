+function LoadedGlb({
+  url,
+  scale = 1,
+  lit,
+  simActive,
+  componentId,
+  isBoard,
+}: {
+  url: string;
+  scale?: number;
+  lit?: boolean;
+  simActive?: boolean;
+  componentId?: string;
+  isBoard?: boolean;
+}) {
+  const gltf = useGLTF(url);
+  const scene = useMemo(() => gltf.scene.clone(true), [gltf]);
+  const glow = (componentId ? LED_GLB_GLOW[componentId] : undefined) ?? {
+    emissive: '#ff2200',
+    light: '#ff4400',
