+    { base: string; emissiveLit: string; emissiveOff: string; emissiveSel: string; light: string }
+  > = {
+    'led-5mm-red': {
+      base: '#ff1a1a',
+      emissiveLit: '#ff3030',
+      emissiveOff: '#220000',
+      emissiveSel: '#551100',
