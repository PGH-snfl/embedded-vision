+// Circuitiny-compatible catalog backed by the current Velxio Arduino/breadboard parts.
+import type { BoardDef, ComponentDef, PinDef } from './project/component';
+import type { PinType } from './project/schema';
+export const MM = 0.001,
+  PX = 0.0254 / 96;
+export const UNO_W = (72.58 * 96) / 25.4,
+  UNO_H = (53.34 * 96) / 25.4;
+export const definitions = new Map<string, ComponentDef>();
+export const boardDefinitions = new Map<string, BoardDef>();
+export let uno: BoardDef | undefined;
+export function setUno(board: BoardDef) {
+  uno = board;
+  boardDefinitions.set(board.id, board);
+}
+export const catalog = {
+  getBoard: (id: string) => boardDefinitions.get(id),
+  getComponent: (id: string) => definitions.get(id),
+  getGlbUrl: (_id: string): string | undefined => undefined,
+};
+export function pinColor(type: PinType) {
+  return type === 'ground' ? '#343e38' : type.startsWith('power') ? '#d15b45' : '#378b70';
+}
+export function pin(
+  id: string,
+  label: string,
+  type: PinType,
+  position: [number, number, number],
+): PinDef {
+  return { id, label, type, position, normal: [0, 1, 0] };
+}
