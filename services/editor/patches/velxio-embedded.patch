+  font-size: 11px;
+  padding: 5px 11px;
+  border: 1px solid #d5e3d8;
+  border-radius: 6px;
+  background: #fff;
+  color: #6b8373;
+  cursor: pointer;
+}
+.ev-dimension-switch button[aria-pressed='true'] {
+  background: #e5f1e8;
