@@ -0,0 +1,72 @@
+// @vitest-environment jsdom
+/** Compile and execute the exact exported UNO sketch, then decode its LCD pins. */
+import { describe, expect, it, vi } from 'vitest';
+import { spawnSync } from 'node:child_process';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { AVRSimulator } from '../simulation/AVRSimulator';
+import { PinManager } from '../simulation/PinManager';
+import { PartSimulationRegistry } from '../simulation/parts/PartSimulationRegistry';
+import { buildNetlist } from '../simulation/spice/NetlistBuilder';
+import { computeSeating } from '../utils/breadboardSnap';
+import '../simulation/parts/ComplexParts';
+
+vi.stubGlobal('requestAnimationFrame', () => 1);
+vi.stubGlobal('cancelAnimationFrame', () => {});
+const project = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../..');
+const python = resolve(project, '.venv/bin/python');
+const generate = `
+import json, tempfile
+from pathlib import Path
+from backend.design.recipes import new_graph
+from backend.workbench.export import export_project
+from backend.emulator.toolchain import compile_firmware
+p = export_project(new_graph('a' * 32, 'arduino_lcd')[0], {'function': {'display_text':'Javalab.org'}})
+src = p['fileGroups']['group-U1'][0]['content']
+with tempfile.TemporaryDirectory(prefix='lcd-test-') as d:
+    compile_firmware('#include <Arduino.h>\\n' + src, d)
+    print(json.dumps({'project': p, 'hex': Path(d, 'firmware.hex').read_text()}))
+`;
+
+describe('generated UNO LCD example', () => {
+  it('renders the selected text from real firmware on the connected LCD', {timeout: 60000}, () => {
+    const build=spawnSync(python,['-c',generate],{cwd:project,encoding:'utf8',timeout:45000});
+    expect(build.status,build.stderr).toBe(0);
+    const fixture=JSON.parse(build.stdout);
+    // Real LCD1602 pinInfo geometry. Generated position must not put the LCD
+    // header on a breadboard rail, where mount-time reseating would short it.
+    const lcd=fixture.project.components.find((c:{id:string})=>c.id==='LCD1');
+    const pins=['VSS','VDD','V0','RS','RW','E','D0','D1','D2','D3','D4','D5','D6','D7','A','K'];
+    const xs=[32,41.5,51.5,60.5,70.5,80,89.5,99.5,109,118.5,128,137.5,147,156.5,166.5,176];
+    const lcdEl=document.createElement('div'); lcdEl.id='LCD1';
+    Object.defineProperty(lcdEl,'pinInfo',{value:pins.map((name,i)=>({name,x:xs[i],y:87.5+11.5*96/25.4}))});
+    document.body.append(lcdEl);
+    const seating=computeSeating(lcd,fixture.project.components);
+    expect(seating).toEqual([]);
+    // Guard the original failure: y=5 places multiple LCD pins on the same rail.
+    const old=computeSeating({...lcd,y:5},fixture.project.components)!;
+    expect(old.filter(s=>s.holeName.startsWith('tp.')).length).toBeGreaterThan(2);
+    lcdEl.remove();
+    const circuit=buildNetlist({components:fixture.project.components,wires:fixture.project.wires,
+      boards:[{id:'U1',boardKind:'arduino-uno',vcc:5,pins:{},groundPinNames:['GND'],vccPinNames:['5V']}],analysis:{kind:'op'}});
+    expect(circuit.pinNetMap.get('R1:1')).not.toBe(circuit.pinNetMap.get('R1:2'));
+    const badSeats=old.map((s,i)=>({id:`lcd-ghost-${i}`,start:{componentId:'LCD1',pinName:s.pinName},
+      end:{componentId:s.bbId,pinName:s.holeName},bb:true}));
+    const broken=buildNetlist({components:fixture.project.components,wires:[...fixture.project.wires,...badSeats],
+      boards:[{id:'U1',boardKind:'arduino-uno',vcc:5,pins:{},groundPinNames:['GND'],vccPinNames:['5V']}],analysis:{kind:'op'}});
+    expect(broken.pinNetMap.get('R1:1')).toBe(broken.pinNetMap.get('R1:2'));
+    const wires=fixture.project.wires as {start:{componentId:string;pinName:string};end:{componentId:string;pinName:string}}[];
+    const pin = (name:string):number|null => {
+      const wire=wires.find(w => w.end.componentId==='LCD1' && w.end.pinName===name && w.start.componentId==='U1');
+      return wire ? Number(wire.start.pinName) : null;
+    };
+    expect(['RS','E','D4','D5','D6','D7'].map(pin)).toEqual([12,11,5,4,3,2]);
+    const pm=new PinManager(), sim=new AVRSimulator(pm,'uno');
+    const element=document.createElement('div') as HTMLElement & {characters:Uint8Array};
+    sim.loadHex(fixture.hex);
+    const stop=PartSimulationRegistry.get('lcd1602')!.attachEvents!(element,sim as never,pin,'LCD1');
+    for(let i=0;i<2_500_000;i++)sim.step();
+    expect(String.fromCharCode(...element.characters.slice(0,16))).toBe('Javalab.org     ');
+    stop?.();
+  });
+});
