+import { describe, expect, it, vi } from 'vitest';
+vi.mock('../components/circuitiny/catalog', () => ({
+  catalog: {
+    getBoard: () => ({name:'UNO', pins:[{id:'2',label:'2',position:[0,0,0],normal:[0,1,0],type:'digital_io'}, {id:'GND1',label:'GND1',position:[.01,0,0],normal:[0,1,0],type:'ground'}]}),
+    getComponent: (id: string) => id === 'bb' ? ({pins:[{id:'40t__a',label:'A40',position:[.04,0,0],normal:[0,1,0],type:'digital_io'}]}) : ({pins:[{id:'1__l',label:'1.l',position:[.005,0,0],normal:[0,1,0],type:'digital_io'}]})
+  }
+}));
+import { findStepWire, groupAssemblySteps, guideSteps, readableRef, resolveGuidePin, guideWarning } from '../components/circuitiny/assemblyGuide';
+
+describe('assembly guide', () => {
+  const step = {from:'U1.2',to:'BB1.40t.a',kind:'jumper' as const};
+  const wire = {start:{componentId:'U1',pinName:'2'},end:{componentId:'BB1',pinName:'40t.a'},bb:false};
+  it('loads only valid steps, placing components before jumper instructions', () => {
+    const payload = {embeddedVision:{assembly:{steps:[step,{from:'SW1.1.l',to:'BB1.40t.a',kind:'insert'},{from:'bad'}],note:'note'}}};
+    const hash = '#project=' + btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(payload))));
+    expect(guideSteps(hash).steps.map(s => s.kind)).toEqual(['insert','jumper']);
+    expect(guideSteps('#project=bad').steps).toEqual([]);
+  });
+  it('groups all legs of each component but retains one complete jumper per step', () => {
+    const i = (id:string,pin:string,hole:string) => ({from:`${id}.${pin}`,to:`BB1.${hole}`,kind:'insert' as const});
+    const legs = [i('R1','1','23t.b'),i('D1','A','29t.d'),i('R1','2','29t.b'),i('D1','C','28t.d'),i('R2','1','40t.b'),i('R2','2','46t.b'),
+      i('SW1','1.l','42t.e'),i('SW1','2.l','40t.e'),i('SW1','1.r','42b.f'),i('SW1','2.r','40b.f')];
+    const jumper = (pin:string,col:number) => ({from:`U1.${pin}`,to:`BB1.${col}t.a`,kind:'jumper' as const});
+    const jumpers = [jumper('5',23),jumper('GND',28),jumper('2',40),jumper('5V',46),jumper('GND',42)];
+    const groups = groupAssemblySteps([...jumpers,...legs]);
+    expect(groups).toHaveLength(9);
+    expect(groups.map(s=>s.from.split('.')[0])).toEqual(['R1','D1','R2','SW1','U1','U1','U1','U1','U1']);
+    expect(groups.slice(0,4).map(s=>s.connections.length)).toEqual([2,2,2,4]);
+    expect(groups.slice(4).every(s=>s.connections.length===1 && s.connections[0].from && s.connections[0].to)).toBe(true);
+    expect(groups.flatMap(s=>s.connections)).toHaveLength(15);
+  });
+  it('hides highlights after deleting or moving a wire to a different pin', () => {
+    expect(findStepWire(step,[wire])).toBe(wire);
+    expect(findStepWire(step,[])).toBeUndefined();
+    expect(findStepWire(step,[{...wire,end:{...wire.end,pinName:'41t.a'}}])).toBeUndefined();
+    expect(findStepWire({...step,kind:'insert'},[wire])).toBeUndefined();
+  });
+  it('resolves UNO, breadboard and component pins to their current positions', () => {
+    const project: any = {board:'uno',boardPosition:[.1,0,0], boards:[{instance:'U1',componentId:'uno',config:{pinOwner:'board'}}], components:[{instance:'BB1',componentId:'bb',position:[.2,0,0]},{instance:'SW1',componentId:'button',position:[.3,0,0]}]};
+    expect(resolveGuidePin(project,'U1.2')?.position[0]).toBeCloseTo(.1);
+    expect(resolveGuidePin(project,'U1.GND')?.position[0]).toBeCloseTo(.11);
+    expect(resolveGuidePin(project,'BB1.40t.a')?.position[0]).toBeCloseTo(.24);
+    expect(resolveGuidePin(project,'SW1.1.l')?.position[0]).toBeCloseTo(.305);
+    project.components[0].position=[.5,0,0];
+    expect(resolveGuidePin(project,'BB1.40t.a')?.position[0]).toBeCloseTo(.54);
+    expect(resolveGuidePin(project,'BB1.41t.a')).toBeNull();
+    expect(guideWarning(step,[wire],project)).toBe('');
+    expect(guideWarning(step,[],project)).toContain('편집한 회로');
+    const missingProject = {...project, components:[]};
+    expect(guideWarning(step,[wire],missingProject)).toContain('핀 위치를 확인하지 못해');
+    expect(readableRef('SW1.1.l')).toContain('버튼 SW1');
