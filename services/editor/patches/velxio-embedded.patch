+import { describe, expect, it } from 'vitest';
+import * as THREE from 'three';
+import { canDragComponent, createComponentDrag } from '../components/circuitiny/directComponentDrag';
+import { useStore } from '../components/circuitiny/store';
+
+describe('direct component drag', () => {
+  it('treats a click as selection and commits only after movement', () => {
+    const d = createComponentDrag([1, .1, 2], new THREE.Vector3(1.2, .1, 2.2), {x:100,y:100});
+    expect(d.update(new THREE.Vector3(1.3,.1,2.4), {x:101,y:101})).toBeNull();
+    expect(d.result()).toBeNull();
+    expect(d.update(new THREE.Vector3(1.3,.1,2.4), {x:105,y:100})?.z).toBeCloseTo(2.2);
+    expect(d.result()?.[0]).toBeCloseTo(1.1);
+    expect(d.result()?.[2]).toBeCloseTo(2.2);
+  });
+  it('preserves component elevation and the initial grab offset', () => {
+    const d = createComponentDrag([0, .015, 0], new THREE.Vector3(.04,.015,.06), {x:0,y:0});
+    const point = d.update(new THREE.Vector3(.05, .03, .08), {x:10,y:4})!;
+    expect(point.x).toBeCloseTo(.01);
+    expect(point.y).toBeCloseTo(.015);
+    expect(point.z).toBeCloseTo(.02);
+  });
+});
+
+describe('selected part movement mode', () => {
+  const base = {selected:true, armed:true, simulating:false, wireMode:false, infrastructure:false, infrastructureMoveEnabled:false};
+  it('requires a selected part and explicit activation', () => {
+    expect(canDragComponent(base)).toBe(true);
+    expect(canDragComponent({...base, armed:false})).toBe(false);
+    expect(canDragComponent({...base, selected:false})).toBe(false);
+  });
+  it('prevents moving during simulation, wiring, and locked infrastructure', () => {
+    expect(canDragComponent({...base, simulating:true})).toBe(false);
+    expect(canDragComponent({...base, wireMode:true})).toBe(false);
+    expect(canDragComponent({...base, infrastructure:true})).toBe(false);
+    expect(canDragComponent({...base, infrastructure:true, infrastructureMoveEnabled:true})).toBe(true);
+  });
+  it('keeps activation while clicking the selected part and clears it on another selection', () => {
+    useStore.setState({selected:'D1',moveTarget:'D1'});
+    useStore.getState().select('D1'); expect(useStore.getState().moveTarget).toBe('D1');
+    useStore.getState().select('R1'); expect(useStore.getState().moveTarget).toBeNull();
+    useStore.setState({moveTarget:'R1'});
+    useStore.getState().select(null); expect(useStore.getState().moveTarget).toBeNull();
+  });
+});
