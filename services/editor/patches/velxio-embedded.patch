+import * as THREE from 'three';
+
+/** Only the explicitly enabled selection can be dragged. */
+export function canDragComponent(options: {
+  selected: boolean; armed: boolean; simulating: boolean; wireMode: boolean;
+  infrastructure: boolean; infrastructureMoveEnabled: boolean;
+}) {
+  return options.selected && options.armed && !options.simulating && !options.wireMode
+    && (!options.infrastructure || options.infrastructureMoveEnabled);
+}
+
+/** A drag changes only the temporary 3D pose until a single release commit. */
+export function createComponentDrag(start: [number, number, number], hit: THREE.Vector3, screen: {x:number; y:number}) {
+  const origin = new THREE.Vector3(...start);
+  let latest = origin.clone(), moved = false;
+  return {
+    update(point: THREE.Vector3, client: {x:number; y:number}) {
+      if (!moved && Math.hypot(client.x - screen.x, client.y - screen.y) < 3) return null;
+      moved = true;
+      latest = origin.clone().add(new THREE.Vector3(point.x-hit.x, 0, point.z-hit.z));
+      return latest.clone();
+    },
+    result(): [number, number, number] | null { return moved ? latest.toArray() as [number, number, number] : null; },
+  };
+}
