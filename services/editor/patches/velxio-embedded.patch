+/** Detailed procedural presentation. Native pin coordinates remain the electrical authority. */
+import { useLayoutEffect, useMemo, useRef, useEffect } from 'react';
+import { RoundedBox } from '@react-three/drei';
+import * as T from 'three';
+type Pin = { id: string; position: [number, number, number] };
+function PrintedSurface({
+  width,
+  depth,
+  pins,
+  breadboard = false,
+}: {
+  width: number;
+  depth: number;
+  pins: Pin[];
+  breadboard?: boolean;
+}) {
+  const texture = useMemo(() => {
+    const canvas = document.createElement('canvas');
+    canvas.width = 2048;
+    canvas.height = Math.round((2048 * depth) / width);
+    const ctx = canvas.getContext('2d')!;
+    const sx = canvas.width / width,
+      sy = canvas.height / depth;
+    const at = (p: Pin) => [(p.position[0] + width / 2) * sx, (p.position[2] + depth / 2) * sy];
+    ctx.textAlign = 'center';
+    ctx.textBaseline = 'middle';
+    if (breadboard) {
+      ctx.fillStyle = '#777b72';
+      ctx.font = '600 13px sans-serif';
+      for (const row of 'abcdefghij') {
+        const p = pins.find((p) => new RegExp('^1[bt]__' + row + '$').test(p.id));
+        if (p) {
+          const [x, y] = at(p);
+          ctx.fillText(row.toUpperCase(), x - 25, y);
+          ctx.fillText(row.toUpperCase(), canvas.width - 18, y);
+        }
+      }
+      for (let col = 1; col <= 63; col++)
+        if (col === 1 || col % 5 === 0) {
+          for (const row of ['a', 'j']) {
+            const p = pins.find((p) => p.id === col + (row === 'a' ? 't' : 'b') + '__' + row);
+            if (p) {
+              const [x, y] = at(p);
+              ctx.fillText(String(col), x, y + (row === 'a' ? -22 : 22));
+            }
+          }
+        }
+      for (const rail of ['tp', 'tn', 'bp', 'bn']) {
+        const group = pins.filter((p) => p.id.startsWith(rail + '__'));
+        if (!group.length) continue;
+        const a = at(group[0]),
+          b = at(group[group.length - 1]);
+        const color = rail.endsWith('p') ? '#cf4445' : '#3886b3';
+        ctx.strokeStyle = color;
+        ctx.lineWidth = 4;
+        const y = a[1] + (rail.startsWith('t') ? -10 : 10);
+        ctx.beginPath();
+        ctx.moveTo(a[0] - 14, y);
+        ctx.lineTo(b[0] + 14, y);
+        ctx.stroke();
+        ctx.fillStyle = color;
+        ctx.font = 'bold 23px sans-serif';
+        ctx.fillText(rail.endsWith('p') ? '+' : '−', a[0] - 32, a[1]);
+        ctx.fillText(rail.endsWith('p') ? '+' : '−', b[0] + 32, a[1]);
+      }
+    } else {
+      ctx.fillStyle = '#eef5e9';
+      ctx.font = 'bold 75px sans-serif';
+      ctx.fillText('∞', canvas.width * 0.49, canvas.height * 0.43);
+      ctx.font = 'bold 45px sans-serif';
+      ctx.fillText('ARDUINO', canvas.width * 0.48, canvas.height * 0.53);
+      ctx.font = 'bold 42px sans-serif';
+      ctx.fillText('UNO', canvas.width * 0.68, canvas.height * 0.43);
+      ctx.font = '20px sans-serif';
+      ctx.fillText('DIGITAL  (PWM ~)', canvas.width * 0.6, canvas.height * 0.075);
+      ctx.fillText('POWER', canvas.width * 0.43, canvas.height * 0.78);
+      ctx.fillText('ANALOG IN', canvas.width * 0.78, canvas.height * 0.78);
+      for (const p of pins) {
+        const [x, y] = at(p);
+        ctx.save();
+        ctx.translate(x, y + (p.position[2] < 0 ? 68 : -63));
+        ctx.rotate(-Math.PI / 2);
+        ctx.font = '18px sans-serif';
+        ctx.fillText(p.id.replace(/__/g, '.'), 0, 0);
+        ctx.restore();
+      }
+      ctx.font = '18px sans-serif';
+      ctx.fillText('RX    TX    ON', canvas.width * 0.22, canvas.height * 0.36);
+    }
+    const t = new T.CanvasTexture(canvas);
+    t.colorSpace = T.SRGBColorSpace;
+    t.anisotropy = 8;
+    return t;
+  }, [width, depth, JSON.stringify(pins), breadboard]);
+  useEffect(() => () => texture.dispose(), [texture]);
+  return (
+    <mesh position={[0, breadboard ? 0.00777 : 0.0046, 0]} rotation={[-Math.PI / 2, 0, 0]}>
+      <planeGeometry args={[width, depth]} />
+      <meshBasicMaterial
+        map={texture}
+        transparent
+        depthWrite={false}
+        polygonOffset
+        polygonOffsetFactor={-1}
+        polygonOffsetUnits={-4}
+      />
+    </mesh>
+  );
+}
+const metal = { color: '#b8c1c5', metalness: 0.85, roughness: 0.27 };
+export function Lead({
+  points,
+  radius = 0.0003,
+}: {
+  points: [number, number, number][];
+  radius?: number;
+}) {
+  const geometry = useMemo(
+    () =>
+      new T.TubeGeometry(
+        new T.CatmullRomCurve3(
+          points.map((p) => new T.Vector3(...p)),
+          false,
+          'centripetal',
+        ),
+        24,
+        radius,
+        8,
+        false,
+      ),
+    [JSON.stringify(points), radius],
+  );
+  useEffect(() => () => geometry.dispose(), [geometry]);
+  return (
+    <mesh geometry={geometry} castShadow>
+      <meshStandardMaterial {...metal} />
+    </mesh>
+  );
+}
+export function UnoModel({
+  width,
+  depth,
+  pins,
+}: {
+  id: string;
+  width: number;
+  depth: number;
+  pins: Pin[];
+}) {
+  return (
+    <group>
+      <RoundedBox
+        args={[width, 0.0016, depth]}
+        radius={0.0006}
+        smoothness={3}
+        position={[0, 0.003, 0]}
+        castShadow
+        receiveShadow
+      >
+        <meshStandardMaterial color="#087c9d" roughness={0.4} />
+      </RoundedBox>
+      <PrintedSurface width={width} depth={depth} pins={pins} />
+      {[-1, 1].flatMap((x) =>
+        [-1, 1].map((z) => (
+          <group
+            key={x + ':' + z}
+            position={[x * (width / 2 - 0.004), 0.0039, z * (depth / 2 - 0.004)]}
+          >
+            <mesh rotation={[-Math.PI / 2, 0, 0]}>
+              <ringGeometry args={[0.0012, 0.0022, 24]} />
+              <meshStandardMaterial color="#e0c98b" metalness={0.72} roughness={0.3} />
+            </mesh>
+            <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -0.00003, 0]}>
+              <circleGeometry args={[0.0012, 24]} />
+              <meshStandardMaterial color="#172926" />
+            </mesh>
+          </group>
+        )),
+      )}
+      {/* Hollow USB socket, with rolled metal walls and a dark receptacle. */}
+      <group position={[-width / 2 + 0.006, 0.009, -depth * 0.24]}>
+        <RoundedBox args={[0.013, 0.01, 0.012]} radius={0.0008} smoothness={2} castShadow>
+          <meshStandardMaterial {...metal} />
+        </RoundedBox>
+        <mesh position={[-0.00655, 0, 0]} rotation={[0, Math.PI / 2, 0]}>
+          <planeGeometry args={[0.009, 0.007]} />
+          <meshStandardMaterial color="#17232c" roughness={0.9} />
+        </mesh>
+        <mesh position={[-0.0066, -0.001, 0]}>
+          <boxGeometry args={[0.00015, 0.003, 0.005]} />
+          <meshStandardMaterial color="#b8c2cb" />
+        </mesh>
+        {[-1, 1].map((z) => (
+          <mesh key={z} position={[0.001, 0.0051, z * 0.0038]}>
+            <boxGeometry args={[0.004, 0.00015, 0.001]} />
+            <meshStandardMaterial color="#667075" metalness={0.8} />
+          </mesh>
+        ))}
+      </group>
+      <group position={[-width / 2 + 0.007, 0.007, depth * 0.3]} rotation={[0, 0, Math.PI / 2]}>
+        <mesh castShadow>
+          <cylinderGeometry args={[0.0045, 0.0045, 0.011, 24]} />
+          <meshStandardMaterial color="#182226" roughness={0.4} />
+        </mesh>
+        <mesh position={[0, 0.0056, 0]}>
+          <cylinderGeometry args={[0.0031, 0.0031, 0.0002, 24]} />
+          <meshStandardMaterial color="#090d0f" />
+        </mesh>
+        <mesh position={[0, 0.0058, 0]}>
+          <cylinderGeometry args={[0.0007, 0.0007, 0.0004, 12]} />
+          <meshStandardMaterial {...metal} />
+        </mesh>
+      </group>
+      <group position={[0.007, 0.0052, 0.009]}>
+        <RoundedBox args={[0.026, 0.0036, 0.008]} radius={0.0005} smoothness={2} castShadow>
+          <meshStandardMaterial color="#1e2425" roughness={0.7} />
+        </RoundedBox>
+        {Array.from({ length: 14 }, (_, i) =>
+          [-1, 1].map((z) => (
+            <Lead
+              key={i + ':' + z}
+              radius={0.00022}
+              points={[
+                [-0.0117 + i * 0.0018, -0.0017, z * 0.0046],
+                [-0.0117 + i * 0.0018, 0, z * 0.0046],
+                [-0.0117 + i * 0.0018, 0, z * 0.0038],
+              ]}
+            />
+          )),
+        )}
+      </group>
+      {[-0.01, -0.004].map((x) => (
+        <group key={x} position={[x, 0.0068, depth * 0.32]}>
+          <mesh castShadow>
+            <cylinderGeometry args={[0.0023, 0.0023, 0.005, 20]} />
+            <meshStandardMaterial color="#22323a" roughness={0.4} />
+          </mesh>
+          <mesh position={[0, 0.0026, 0]}>
+            <cylinderGeometry args={[0.0021, 0.0021, 0.0002, 20]} />
+            <meshStandardMaterial {...metal} />
+          </mesh>
+        </group>
+      ))}
+      <RoundedBox
+        args={[0.009, 0.002, 0.0035]}
+        radius={0.0008}
+        smoothness={3}
+        position={[-0.005, 0.005, -0.004]}
+        castShadow
+      >
+        <meshStandardMaterial {...metal} />
+      </RoundedBox>
+      {pins.map((p) => (
+        <group key={p.id} position={[p.position[0], 0, p.position[2]]}>
+          <mesh position={[0, 0.0058, 0]} castShadow>
+            <boxGeometry args={[0.0024, 0.004, 0.0024]} />
+            <meshStandardMaterial color="#171d20" roughness={0.6} />
+          </mesh>
+          <mesh position={[0, 0.00788, 0]} rotation={[-Math.PI / 2, 0, 0]}>
+            <planeGeometry args={[0.00105, 0.00105]} />
+            <meshStandardMaterial color="#030709" />
+          </mesh>
+          <mesh position={[0, 0.00785, 0.0005]}>
+            <boxGeometry args={[0.0007, 0.00014, 0.00017]} />
+            <meshStandardMaterial color="#c8b27b" metalness={0.8} />
+          </mesh>
+        </group>
+      ))}
+    </group>
+  );
+}
+function HoleGrid({ pins }: { pins: Pin[] }) {
+  const ref = useRef<T.InstancedMesh>(null);
+  useLayoutEffect(() => {
+    if (!ref.current) return;
+    const dummy = new T.Object3D();
+    for (let i = 0; i < pins.length; i++) {
+      dummy.position.set(pins[i].position[0], 0.00784, pins[i].position[2]);
+      dummy.rotation.set(-Math.PI / 2, 0, 0);
+      dummy.updateMatrix();
+      ref.current.setMatrixAt(i, dummy.matrix);
+    }
+    ref.current.instanceMatrix.needsUpdate = true;
+  }, [pins]);
+  return (
+    <instancedMesh ref={ref} args={[undefined, undefined, pins.length]}>
+      <planeGeometry args={[0.00105, 0.00105]} />
+      <meshStandardMaterial color="#27302d" roughness={0.95} />
+    </instancedMesh>
+  );
+}
+export function BreadboardModel({
+  width,
+  depth,
+  pins,
+}: {
+  id: string;
+  width: number;
+  depth: number;
+  pins: Pin[];
+}) {
+  return (
+    <group>
+      <RoundedBox
+        args={[width, 0.007, depth]}
+        radius={0.0016}
+        smoothness={3}
+        position={[0, 0.0035, 0]}
+        castShadow
+        receiveShadow
+      >
+        <meshStandardMaterial color="#f2f0e8" roughness={0.52} />
+      </RoundedBox>
+      <mesh position={[0, 0.0003, 0]}>
+        <boxGeometry args={[width - 0.001, 0.0005, depth - 0.001]} />
+        <meshStandardMaterial color="#c7c8c1" roughness={0.9} />
+      </mesh>
+      <PrintedSurface width={width} depth={depth} pins={pins} breadboard />
+      <HoleGrid pins={pins} />
+      {[-1, 1].map((x) => (
+        <mesh key={x} position={[x * (width / 2 + 0.0007), 0.0035, 0]}>
+          <boxGeometry args={[0.0014, 0.003, 0.006]} />
+          <meshStandardMaterial color="#e0e0d7" roughness={0.65} />
+        </mesh>
+      ))}
+    </group>
+  );
+}
+export function LedModel({
+  pins,
+  color,
+  brightness,
+}: {
+  pins: Pin[];
+  color: string;
+  brightness: number;
+}) {
+  const level = Math.max(0, Math.min(1, brightness));
+  const tint = new T.Color(color).multiplyScalar(0.35 + level * 0.65);
+  const material = (
+    <meshPhysicalMaterial
+      color={tint}
+      emissive={color}
+      emissiveIntensity={level * 1.8}
+      roughness={0.14}
+      metalness={0}
+      clearcoat={1}
+      clearcoatRoughness={0.08}
+      transmission={0.18}
+      thickness={0.002}
+      ior={1.5}
+      transparent
+      opacity={0.88}
+    />
+  );
+  return (
+    <group>
+      <mesh position={[0, 0.0001, 0]} castShadow>
+        <cylinderGeometry args={[0.0026, 0.0026, 0.0007, 32]} />
+        {material}
+      </mesh>
+      <mesh position={[0, 0.0021, 0]} castShadow>
+        <cylinderGeometry args={[0.00235, 0.0024, 0.004, 32]} />
+        {material}
+      </mesh>
+      <mesh position={[0, 0.0041, 0]} castShadow>
+        <sphereGeometry args={[0.00235, 32, 20, 0, Math.PI * 2, 0, Math.PI / 2]} />
+        {material}
+      </mesh>
+      <mesh position={[0, 0.0016, 0]}>
+        <cylinderGeometry args={[0.00125, 0.00055, 0.0012, 16]} />
+        <meshStandardMaterial color="#d0d3cf" metalness={0.88} roughness={0.22} />
+      </mesh>
+      <mesh position={[0, 0.0023, 0]}>
+        <boxGeometry args={[0.0006, 0.00015, 0.0006]} />
+        <meshStandardMaterial color="#ffe9ab" emissive={color} emissiveIntensity={level * 4} />
+      </mesh>
+      {pins.map((p, i) => (
+        <Lead
+          key={p.id}
+          points={[
+            p.position,
+            [p.position[0], -0.0015, p.position[2]],
+            [i ? 0.0008 : -0.0008, -0.001, 0],
+            [i ? 0.0008 : -0.0008, 0.0012, 0],
+          ]}
+        />
+      ))}
+    </group>
+  );
+}
+export function ResistorModel({ pins, value }: { pins: Pin[]; value: string }) {
+  const colors =
+    value === '220'
+      ? ['#b22b22', '#b22b22', '#241d16', '#b69a4c']
+      : ['10000', '10k'].includes(value.toLowerCase())
+        ? ['#68452e', '#111716', '#c87327', '#b69a4c']
+        : [];
+  const profile = useMemo(
+    () =>
+      [
+        [-0.0034, 0.0006],
+        [-0.0031, 0.00105],
+        [-0.0024, 0.00115],
+        [-0.0019, 0.00097],
+        [0.0019, 0.00097],
+        [0.0024, 0.00115],
+        [0.0031, 0.00105],
+        [0.0034, 0.0006],
+      ].map(([x, r]) => new T.Vector2(r, x)),
+    [],
+  );
+  return (
+    <group>
+      <mesh rotation={[0, 0, Math.PI / 2]} castShadow>
+        <latheGeometry args={[profile, 24]} />
+        <meshStandardMaterial color="#d6c19b" roughness={0.56} />
+      </mesh>
+      {colors.map((color, i) => (
+        <mesh key={i} position={[-0.0022 + i * 0.0014, 0, 0]} rotation={[0, 0, Math.PI / 2]}>
+          <cylinderGeometry args={[i === 0 || i === 3 ? 0.00112 : 0.001, 0.00112, 0.00045, 24]} />
+          <meshStandardMaterial color={color} metalness={i === 3 ? 0.5 : 0} roughness={0.45} />
+        </mesh>
+      ))}
+      {pins.slice(0, 2).map((p, i) => (
+        <Lead
+          key={p.id}
+          radius={0.00025}
+          points={[
+            p.position,
+            [p.position[0], -0.001, p.position[2]],
+            [p.position[0], 0, 0],
+            [i ? 0.0034 : -0.0034, 0, 0],
+          ]}
+        />
+      ))}
+    </group>
+  );
+}
