diff --git a/frontend/src/components/circuitiny/nativeInteraction.ts b/frontend/src/components/circuitiny/nativeInteraction.ts
new file mode 100644
index 0000000..f5cc048
--- /dev/null
+++ b/frontend/src/components/circuitiny/nativeInteraction.ts
@@ -0,0 +1,105 @@
+/** Map a 3D face's UV coordinates onto the original native control, preserving its events. */
+type Press = { target: Element; x: number; y: number; pointerId: number };
+const active = new Map<string, Press>();
+function pointOnSurface(surface: Element, u: number, v: number) {
+  if (surface instanceof SVGSVGElement) {
+    const matrix = surface.getScreenCTM?.(),
+      box = surface.viewBox?.baseVal;
+    if (matrix && box?.width) {
+      const point = new DOMPoint(
+        box.x + u * box.width,
+        box.y + (1 - v) * box.height,
+      ).matrixTransform(matrix);
+      return { x: point.x, y: point.y };
+    }
+  }
+  const rect = surface.getBoundingClientRect();
+  return { x: rect.left + u * rect.width, y: rect.top + (1 - v) * rect.height };
+}
+function targetAt(root: ShadowRoot | Element, x: number, y: number, fallback: Element) {
+  const nodes = [...root.querySelectorAll('svg *,button,input,canvas')];
+  for (const node of nodes.reverse()) {
+    if (typeof SVGGeometryElement !== 'undefined' && node instanceof SVGGeometryElement) {
+      try {
+        const matrix = node.getScreenCTM();
+        if (matrix && node.isPointInFill(new DOMPoint(x, y).matrixTransform(matrix.inverse())))
+          return node;
+      } catch {
+        /* bounded box below */
+      }
+    }
+    const box = node.getBoundingClientRect();
+    if (
+      box.width > 0 &&
+      box.height > 0 &&
+      x >= box.left &&
+      x <= box.right &&
+      y >= box.top &&
+      y <= box.bottom
+    )
+      return node;
+  }
+  return fallback;
+}
+function emit(record: Press, phase: 'down' | 'move' | 'up', click = false) {
+  const names = {
+    down: ['pointerdown', 'mousedown'],
+    move: ['pointermove', 'mousemove'],
+    up: ['pointerup', 'mouseup'],
+  }[phase];
+  for (const type of names) {
+    const options = {
+      bubbles: true,
+      composed: true,
+      clientX: record.x,
+      clientY: record.y,
+      button: 0,
+      buttons: phase === 'up' ? 0 : 1,
+      pointerId: record.pointerId,
+      isPrimary: true,
+      pointerType: 'mouse',
+    };
+    record.target.dispatchEvent(
+      type.startsWith('pointer') && typeof PointerEvent !== 'undefined'
+        ? new PointerEvent(type, options)
+        : new MouseEvent(type, options),
+    );
+  }
+  if (click)
+    record.target.dispatchEvent(
+      new MouseEvent('click', {
+        bubbles: true,
+        composed: true,
+        clientX: record.x,
+        clientY: record.y,
+        button: 0,
+      }),
+    );
+}
+export function nativeSurfaceEvent(
+  id: string,
+  phase: 'down' | 'move' | 'up',
+  uv: { x: number; y: number },
+  pointerId = 1,
+) {
+  const element = document.getElementById(id),
+    root = element?.shadowRoot || element;
+  if (!root) return;
+  const surface = root.querySelector('canvas,svg');
+  if (!surface) return;
+  const p = pointOnSurface(surface, uv.x, uv.y);
+  let record = active.get(id);
+  if (phase === 'down') {
+    record = { target: targetAt(root, p.x, p.y, surface), ...p, pointerId };
+    active.set(id, record);
+  }
+  if (!record) return;
+  record.x = p.x;
+  record.y = p.y;
+  emit(record, phase, phase === 'up');
+  if (phase === 'up') active.delete(id);
+}
+export function releaseNativeSurfaces() {
+  for (const record of active.values()) emit(record, 'up');
+  active.clear();
+}
