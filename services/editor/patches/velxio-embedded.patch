--- /dev/null
+++ b/frontend/src/components/circuitiny/geometry.ts
@@ -0,0 +1,120 @@
+/** The same measured pins, wrapper pivot and rotation used by the native 2D canvas. */
+import { readPinInfo } from '../../utils/readPinInfo';
+import { breadboardHoles } from '../../utils/breadboardSnap';
+import { boardSize, normalizeRotation } from '../../utils/boardGeometry';
+import { PX } from './catalog';
+export type NativePin = {
+  name: string;
+  x: number;
+  y: number;
+  signals?: Array<{ type: string; signal?: string }>;
+};
+type Item = {
+  id: string;
+  x: number;
+  y: number;
+  metadataId?: string;
+  boardKind?: string;
+  rotation?: number;
+  properties?: Record<string, unknown>;
+};
+const FALLBACK: Record<
+  string,
+  { w: number; h: number; cx: number; cy: number; pins?: NativePin[] }
+> = {
+  resistor: {
+    w: 58.8,
+    h: 11.3,
+    cx: 29.4,
+    cy: 5.65,
+    pins: [
+      { name: '1', x: 0, y: 5.65 },
+      { name: '2', x: 58.8, y: 5.65 },
+    ],
+  },
+  led: {
+    w: 40,
+    h: 50,
+    cx: 20,
+    cy: 42,
+    pins: [
+      { name: 'A', x: 25, y: 42 },
+      { name: 'C', x: 15, y: 42 },
+    ],
+  },
+  'breadboard-mini': { w: 173, h: 134.552, cx: 86.5, cy: 67.276 },
+  breadboard: { w: (468.238 * 4) / 3, h: 201.6, cx: (468.238 * 2) / 3, cy: 100.8 },
+};
+function rotate(x: number, y: number, px: number, py: number, angle: number) {
+  const r = (angle * Math.PI) / 180,
+    c = Math.cos(r),
+    s = Math.sin(r);
+  return { x: px + (x - px) * c - (y - py) * s, y: py + (x - px) * s + (y - py) * c };
+}
+export function geometryFor(item: Item) {
+  const el = document.getElementById(item.id) as HTMLElement | null;
+  const board = !!item.boardKind,
+    kind = item.boardKind || item.metadataId || '';
+  const fallback = FALLBACK[kind];
+  const raw = readPinInfo<NativePin>(el) || breadboardHoles(kind) || fallback?.pins || [];
+  // Inline custom-element hosts can report a 20px line box while their SVG is much taller.
+  // clientWidth/Height are unrotated local CSS dimensions, unlike getBoundingClientRect.
+  const surface = el?.shadowRoot?.querySelector('svg,canvas') as HTMLElement | SVGSVGElement | null;
+  const measuredWidth = Math.max(el?.offsetWidth || 0, surface?.clientWidth || 0);
+  const measuredHeight = Math.max(el?.offsetHeight || 0, surface?.clientHeight || 0);
+  const size = board
+    ? boardSize(kind)
+    : {
+        w: measuredWidth || fallback?.w || Math.max(32, ...raw.map((p) => p.x + 10)),
+        h: measuredHeight || fallback?.h || Math.max(24, ...raw.map((p) => p.y + 10)),
+      };
+  const inset = board ? 0 : 6;
+  const rotation = normalizeRotation(board ? item.rotation : item.properties?.rotation);
+  const wrap = el?.closest('.dynamic-component-wrapper') as HTMLElement | null;
+  const pivot = {
+    x: board ? size.w / 2 : wrap?.offsetWidth ? wrap.offsetWidth / 2 - inset : size.w / 2,
+    y: board ? size.h / 2 : wrap?.offsetHeight ? wrap.offsetHeight / 2 - inset : size.h / 2,
+  };
+  const localCenter = board
+    ? { x: size.w / 2, y: size.h / 2 }
+    : { x: fallback?.cx ?? size.w / 2, y: fallback?.cy ?? size.h / 2 };
+  const center = rotate(localCenter.x, localCenter.y, pivot.x, pivot.y, rotation);
+  const height = kind.startsWith('breadboard')
+    ? 0
+    : kind === 'led'
+      ? 0.015
+      : kind === 'resistor'
+        ? 0.01
+        : 0;
+  const offset = { x: inset + center.x, y: inset + center.y, h: height };
+  const pins = raw.map((p) => {
+    const at = rotate(p.x, p.y, pivot.x, pivot.y, rotation);
+    return {
+      ...p,
+      position: [(at.x - center.x) * PX, 0.0075 - height, (at.y - center.y) * PX] as [
+        number,
+        number,
+        number,
+      ],
+    };
+  });
+  return {
+    offset,
+    size,
+    rotation,
+    pins,
+    position: [(item.x + offset.x) * PX, height, (item.y + offset.y) * PX] as [
+      number,
+      number,
+      number,
+    ],
+    bodyCenter: [(size.w / 2 - localCenter.x) * PX, 0, (size.h / 2 - localCenter.y) * PX] as [
+      number,
+      number,
+      number,
+    ],
+    pinReady: raw.length > 0,
+    board,
+    kind,
+  };
+}
