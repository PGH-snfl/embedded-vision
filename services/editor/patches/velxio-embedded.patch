+   flush=()=>{if(resetting.current)return;try{
+     const data=buildVlxPayload({name:original.name});
+     localStorage.setItem(storageKey,JSON.stringify({...data,embeddedVision:source}));
+    }catch{setFailed(true);setMessage('자동 저장에 실패했습니다. 파일 → Export .vlx로 저장하세요.');}};
