+      window: { ms: 40, states: [state(0.25, 0.02), state(0.75, 0)] },
+    });
+    vi.advanceTimersByTime(50);
+    expect(el.brightness).toBeCloseTo(0.25);
+    expect(useStore.getState().externalBrightness.D1).toBeCloseTo(0.25);
+    expect(useStore.getState().externalLit).toContain('D1');
+    useElectricalStore.setState({ branchCurrents: { v_d1_sense: 0.2 }, window: undefined });
+    vi.advanceTimersByTime(50);
+    expect(useStore.getState().externalBrightness.D1).toBe(0);
+    useElectricalStore.setState({ branchCurrents: { v_d1_sense: 0.01 } });
+    vi.advanceTimersByTime(50);
+    expect(useStore.getState().externalBrightness.D1).toBe(0);
+  } finally {
+    detach();
+    useElectricalStore.getState().reset();
+  }
+});
+it('clears the 3D light after Stop and never turns missing or invalid brightness into full light', () => {
+  const { el, detach } = attachActualLed();
+  try {
+    useElectricalStore.setState({ branchCurrents: { v_d1_sense: 0.01 } });
+    vi.advanceTimersByTime(50);
+    expect(useStore.getState().externalBrightness.D1).toBeCloseTo(0.5);
+    el.brightness = NaN;
+    expect(nativeLedBrightness(native.getState()).D1).toBe(0);
+    native.setState({ running: false });
+    vi.advanceTimersByTime(50);
+    expect(useStore.getState().externalBrightness).toEqual({});
+    native.setState({ running: true });
+    el.remove();
+    expect(nativeLedBrightness(native.getState()).D1).toBe(0);
+  } finally {
+    detach();
+    useElectricalStore.getState().reset();
+  }
+});
+
+it('delivers every 20ms MCU sample synchronously without advancing any browser timer', () => {
+  const { el, detach } = attachActualLed();
+  try {
+    for (let step = 1; step <= 51; step++) {
+      const duty = step / 51;
+      useElectricalStore.setState({
+        pwm: {
+          boardId: 'U1',
+          pinName: '5',
+          duty,
+          guestMs: step * 20,
+          intervalMs: 20,
+          sequence: step,
+          branchCurrents: { v_d1_sense: duty * 0.014 },
+          peakCurrents: { v_d1_sense: 0.014 },
+        },
+      });
+      expect(el.brightness).toBeCloseTo(duty * 0.7);
+      expect(useStore.getState().externalBrightness.D1).toBeCloseTo(duty * 0.7);
+      expect(useStore.getState().externalTiming.D1).toMatchObject({
+        guestMs: step * 20,
+        sequence: step,
+        intervalMs: 20,
+      });
+    }
+  } finally {
+    detach();
+    useElectricalStore.getState().reset();
+  }
+});
+
+it('reconnects an existing wire endpoint without losing its identity, color or route, and undoes it', () => {
+  const before = native.getState().wires.find((w) => w.id === 'J1')!;
+  const at = endpoint('board.6', native.getState());
+  const hit = wirePinTarget(native.getState(), 'J1', 'start', at, 3)!;
+  expect(hit.valid).toBe(true);
+  expect(hit.endpoint.pinName).toBe('6');
+  expect(reconnectWireEnd('J1', 'start', hit.endpoint)).toBe(true);
+  const after = native.getState().wires.find((w) => w.id === 'J1')!;
+  expect(after.start.pinName).toBe('6');
+  expect(after.color).toBe(before.color);
+  expect(after.waypoints).toEqual(before.waypoints);
+  native.getState().undo();
+  expect(native.getState().wires.find((w) => w.id === 'J1')).toEqual(before);
+  native.getState().redo();
+  expect(native.getState().wires.find((w) => w.id === 'J1')?.start.pinName).toBe('6');
+});
+it('snaps to a vacant breadboard hole but refuses a seated hole', () => {
+  const at = endpoint('BB1.6t__a', native.getState()),
+    hit = wirePinTarget(native.getState(), 'J1', 'end', at, 3)!;
+  expect(hit.valid).toBe(true);
+  reconnectWireEnd('J1', 'end', hit.endpoint);
+  expect(native.getState().wires.find((w) => w.id === 'J1')?.end.pinName).toBe('6t.a');
+  const occupied = endpoint('BB1.5t__b', native.getState()),
+    bad = wirePinTarget(native.getState(), 'J1', 'end', occupied, 3)!;
+  expect(bad.valid).toBe(false);
+  expect(() => reconnectWireEnd('J1', 'end', bad.endpoint)).toThrow('구멍');
+});
+it('previews without mutation, rejects invalid drops and prevents supply-ground shorts on reconnect', () => {
+  const state = native.getState(),
+    before = state.wires;
+  expect(wirePinTarget(state, 'J1', 'end', { x: 9999, y: 9999 }, 12)).toBeNull();
+  expect(native.getState().wires).toBe(before);
+  expect(() => reconnectWireEnd('J2', 'end', endpoint('board.5V', state))).toThrow('GND');
+  expect(() =>
+    reconnectWireEnd('J1', 'end', { componentId: 'UNKNOWN', pinName: '99', x: 0, y: 0 }),
+  ).toThrow('확인');
+  expect(native.getState().wires).toBe(before);
+});
+it('does not add history for an unchanged endpoint and refuses edits during a run', () => {
+  const s = native.getState(),
+    index = s.historyIndex;
+  expect(reconnectWireEnd('J1', 'start', s.wires.find((w) => w.id === 'J1')!.start)).toBe(false);
+  expect(native.getState().historyIndex).toBe(index);
+  native.setState({ running: true });
+  expect(() => reconnectWireEnd('J1', 'start', endpoint('board.6', native.getState()))).toThrow(
+    '정지',
+  );
+});
