+// @vitest-environment jsdom
+import { afterEach, expect, it } from 'vitest';
+import { OrthographicCamera, PerspectiveCamera, MOUSE } from 'three';
+import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
+import { cameraMouseButtons, cameraControlOptions } from '../components/circuitiny/mouseControls';
+import { alignTopView } from '../components/circuitiny/sceneCamera';
+
+let controls: OrbitControls | undefined;
+afterEach(() => { controls?.dispose(); document.body.innerHTML = ''; });
+function create() {
+ const el=document.createElement('div'); document.body.append(el);
+ Object.defineProperties(el,{clientWidth:{value:800},clientHeight:{value:600}});
+ el.setPointerCapture=()=>{};el.releasePointerCapture=()=>{};
+ const camera=new PerspectiveCamera(45,800/600,.001,10);camera.position.set(.12,.1,.12);
+ controls=new OrbitControls(camera,el);controls.mouseButtons=cameraMouseButtons;controls.enableDamping=false;controls.update();
+ return {el,camera,controls};
+}
+function drag(el:HTMLElement,button:number,endY=340) {
+ const emit=(type:string,x:number,y:number,buttons:number)=>{
+  const e=new MouseEvent(type,{button,buttons,clientX:x,clientY:y,bubbles:true});
+  Object.defineProperties(e,{pointerId:{value:1},pointerType:{value:'mouse'}});el.dispatchEvent(e);
+ };
+ emit('pointerdown',300,300,button===0?1:2);emit('pointermove',380,endY,button===0?1:2);emit('pointerup',380,endY,0);
+}
+it('left drag translates camera and target together',()=>{
+ const {el,camera,controls}=create(),p=camera.position.clone(),target=controls.target.clone();drag(el,0);
+ expect(camera.position.distanceTo(p)).toBeGreaterThan(0.001);
+ expect(controls.target.distanceTo(target)).toBeGreaterThan(0.001);
+ expect(camera.position.clone().sub(p).distanceTo(controls.target.clone().sub(target))).toBeLessThan(1e-9);
+});
+it('right drag orbits around a stationary target',()=>{
+ const {el,camera,controls}=create(),p=camera.position.clone(),target=controls.target.clone();drag(el,2);
+ expect(camera.position.distanceTo(p)).toBeGreaterThan(0.001);
+ expect(controls.target.distanceTo(target)).toBeLessThan(1e-9);
+ expect(camera.position.distanceTo(target)).toBeCloseTo(p.distanceTo(target),8);
+});
+it('keeps middle mouse zoom and no continued movement after release',()=>{
+ const {el,camera,controls}=create();expect(cameraMouseButtons.MIDDLE).toBe(MOUSE.DOLLY);drag(el,0);
+ const p=camera.position.clone(),t=controls.target.clone();controls.update();controls.update();
+ expect(camera.position.distanceTo(p)).toBeLessThan(1e-9);expect(controls.target.distanceTo(t)).toBeLessThan(1e-9);
+});
+it('locks camera pan, orbit and zoom even if editing controls re-enable OrbitControls',()=>{
+ const {el,camera,controls}=create(); Object.assign(controls,cameraControlOptions(true,'iso'));
+ // TransformControls may re-enable the master flag on release; individual camera operations stay disabled.
+ controls.enabled=true;const p=camera.position.clone(),t=controls.target.clone();
+ drag(el,0);drag(el,2);el.dispatchEvent(new WheelEvent('wheel',{deltaY:-100,bubbles:true,cancelable:true}));controls.update();
+ expect(camera.position.distanceTo(p)).toBeLessThan(1e-9);expect(controls.target.distanceTo(t)).toBeLessThan(1e-9);
+});
+it('top view permits pan and zoom but prevents tilt',()=>{
+ const {el,camera,controls}=create();Object.assign(controls,cameraControlOptions(false,'top'));
+ const p=camera.position.clone(),t=controls.target.clone();drag(el,2);
+ expect(camera.position.distanceTo(p)).toBeLessThan(1e-9);expect(controls.target.distanceTo(t)).toBeLessThan(1e-9);
+ drag(el,0);expect(controls.target.distanceTo(t)).toBeGreaterThan(.001);
+});
+it('releases the same top-down camera for 3D rotation without changing framing',()=>{
+ const el=document.createElement('div'); document.body.append(el);
+ Object.defineProperties(el,{clientWidth:{value:800},clientHeight:{value:600}});
+ el.setPointerCapture=()=>{};el.releasePointerCapture=()=>{};
+ const camera=new OrthographicCamera(-400,400,300,-300,.001,10);camera.position.set(.12,.1,.12);camera.zoom=2300;
+ controls=new OrbitControls(camera,el);controls.mouseButtons=cameraMouseButtons;controls.enableDamping=false;
+ controls.target.set(.02,0,.03);alignTopView(camera,controls.target);controls.update();
+ const p=camera.position.clone(),t=controls.target.clone(),zoom=camera.zoom;
+ Object.assign(controls,cameraControlOptions(false,'iso'));
+ expect(camera.position.distanceTo(p)).toBe(0);expect(controls.target.distanceTo(t)).toBe(0);expect(camera.zoom).toBe(zoom);
+ drag(el,2,260);
+ expect(camera.position.distanceTo(p)).toBeGreaterThan(.001);
+ expect(controls.target.distanceTo(t)).toBeLessThan(1e-9);expect(camera.zoom).toBe(zoom);
+});
