+const LED_GLB_GLOW: Record<string, { emissive: string; light: string }> = {
+  'led-5mm-red': { emissive: '#ff2200', light: '#ff4400' },
+  'led-5mm-green': { emissive: '#22ff22', light: '#44ff44' },
