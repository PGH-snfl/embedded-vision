+// @vitest-environment jsdom
+import React, { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import * as THREE from 'three';
+
+const mocks = vi.hoisted(() => ({
+  scene: {} as any,
+  target: null as any,
+  pinTarget: vi.fn(),
+  reconnect: vi.fn(),
+}));
+vi.mock('@react-three/fiber', () => ({ useThree: () => mocks.scene }));
+vi.mock('@react-three/drei', () => ({ Html: ({children}: {children: React.ReactNode}) => React.createElement('div', null, children) }));
+vi.mock('../utils/wireReconnect', () => ({
+  wirePinTarget: mocks.pinTarget,
+  reconnectWireEnd: mocks.reconnect,
+}));
+import { EndpointHandle } from '../components/circuitiny/EndpointHandle';
+import { useStore } from '../components/circuitiny/store';
+import { useSimulatorStore as native } from '../store/useSimulatorStore';
+import { cameraControlOptions } from '../components/circuitiny/mouseControls';
+
+let host: HTMLDivElement, root: Root, button: HTMLButtonElement;
+const pointer = (type: string, x: number, y: number) => {
+  const e = new MouseEvent(type, { bubbles: true, clientX: x, clientY: y, button: 0 });
+  Object.defineProperty(e, 'pointerId', { value: 7 });
+  return e;
+};
+const move = async (x: number, y: number) => act(async () => { window.dispatchEvent(pointer('pointermove', x, y)); });
+const down = async () => act(async () => { button.dispatchEvent(pointer('pointerdown', 50, 50)); });
+
+beforeEach(async () => {
+  (globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
+  const camera = new THREE.PerspectiveCamera(40, 1, .001, 100);
+  camera.position.set(0, 1, 1); camera.lookAt(0, 0, 0); camera.updateMatrixWorld();
+  const canvas = document.createElement('canvas');
+  canvas.getBoundingClientRect = () => ({left: 0, top: 0, right: 100, bottom: 100, width: 100, height: 100, x: 0, y: 0, toJSON: () => {}});
+  mocks.scene = {camera, gl: {domElement: canvas}, controls: {enabled: true}};
+  mocks.pinTarget.mockReset(); mocks.reconnect.mockReset();
+  native.setState({running: false}); useStore.setState({endpointDrag: null});
+  host = document.createElement('div'); document.body.append(host); root = createRoot(host);
+  await act(async () => root.render(React.createElement(EndpointHandle, {wireId: 'J1', side: 'end', position: [0, 0, 0]})));
+  button = host.querySelector('button')!;
+  button.setPointerCapture = vi.fn(); button.releasePointerCapture = vi.fn();
+});
+afterEach(async () => {
+  await act(async () => root.unmount()); host.remove(); useStore.setState({endpointDrag: null});
+});
+
+describe('3D endpoint preview lifecycle', () => {
+  it('shows the candidate only while dragging, clears on leaving and cancel, and never commits on cancel', async () => {
+    const before = structuredClone(native.getState().wires);
+    mocks.pinTarget.mockReturnValue({endpoint: {componentId:'BB1', pinName:'23t.b', x:1,y:2}, valid:true, reason:''});
+    await down(); await move(50, 50);
+    expect(useStore.getState().endpointDrag?.hoverTarget).toEqual({componentId:'BB1',pinName:'23t.b'});
+    expect(native.getState().wires).toEqual(before);
+    await move(101, 50);
+    expect(useStore.getState().endpointDrag?.hoverTarget).toBeNull();
+    expect(useStore.getState().endpointDrag?.valid).toBe(false);
+    await move(50, 50);
+    expect(useStore.getState().endpointDrag?.hoverTarget?.pinName).toBe('23t.b');
+    await act(async () => window.dispatchEvent(new KeyboardEvent('keydown', {key:'Escape'})));
+    expect(useStore.getState().endpointDrag).toBeNull();
+    expect(mocks.reconnect).not.toHaveBeenCalled();
+    expect(native.getState().wires).toEqual(before);
+    expect(mocks.scene.controls.enabled).toBe(true);
+  });
+  it('keeps the invalid reason, does not connect an invalid target, and commits only a valid drop', async () => {
+    const endpoint = {componentId:'BB1',pinName:'23t.b',x:1,y:2};
+    mocks.pinTarget.mockReturnValue({endpoint,valid:false,reason:'이미 사용 중인 구멍'});
+    await down(); await move(50,50);
+    expect(useStore.getState().endpointDrag).toMatchObject({hoverTarget:{componentId:'BB1',pinName:'23t.b'},valid:false,label:'이미 사용 중인 구멍'});
+    await act(async () => window.dispatchEvent(pointer('pointerup',50,50)));
+    expect(mocks.reconnect).not.toHaveBeenCalled();
+    expect(useStore.getState().endpointDrag).toBeNull();
+    mocks.pinTarget.mockReturnValue({endpoint,valid:true,reason:''});
+    await down(); await move(50,50);
+    await act(async () => window.dispatchEvent(pointer('pointerup',50,50)));
+    expect(mocks.reconnect).toHaveBeenCalledOnce();
+    expect(mocks.reconnect).toHaveBeenCalledWith('J1','end',endpoint);
+    expect(useStore.getState().endpointDrag).toBeNull();
+  });
+  it('drops outside and pointer cancellation clear the preview without changing the wire', async () => {
+    const before = structuredClone(native.getState().wires);
+    mocks.pinTarget.mockReturnValue({endpoint:{componentId:'BB1',pinName:'23t.b',x:1,y:2},valid:true,reason:''});
+    await down(); await move(50,50);
+    await act(async () => window.dispatchEvent(pointer('pointerup', 110, 50)));
+    expect(useStore.getState().endpointDrag).toBeNull();
+    expect(mocks.reconnect).not.toHaveBeenCalled();
+    await down(); await move(50,50);
+    await act(async () => window.dispatchEvent(pointer('pointercancel', 50, 50)));
+    expect(useStore.getState().endpointDrag).toBeNull();
+    expect(mocks.reconnect).not.toHaveBeenCalled();
+    expect(native.getState().wires).toEqual(before);
+    expect(mocks.scene.controls.enabled).toBe(true);
+  });
+  it('reconnects with an orthographic camera while camera movement remains locked', async () => {
+    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, .001, 10);
+    camera.up.set(0,0,-1);camera.position.set(0,1,0);camera.lookAt(0,0,0);camera.updateMatrixWorld();
+    mocks.scene.camera=camera;
+    Object.assign(mocks.scene.controls, cameraControlOptions(true, 'top'));
+    useStore.setState({cameraLocked:true,viewMode:'top'});
+    await act(async () => root.render(React.createElement(EndpointHandle, {wireId:'J1',side:'end',position:[0,0,0]})));
+    mocks.pinTarget.mockReturnValue({endpoint:{componentId:'BB1',pinName:'23t.b',x:1,y:2},valid:true,reason:''});
+    await down();await move(50,50);
+    expect(useStore.getState().endpointDrag?.hoverTarget?.pinName).toBe('23t.b');
+    await act(async () => window.dispatchEvent(pointer('pointerup',50,50)));
+    expect(mocks.reconnect).toHaveBeenCalledOnce();
+    expect(mocks.scene.controls).toMatchObject({enablePan:false,enableRotate:false,enableZoom:false});
+    useStore.setState({cameraLocked:false,viewMode:'iso'});
+  });
+});
