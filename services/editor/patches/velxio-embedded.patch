+}
+.ev-3d-warning {
+  position: absolute;
+  top: 65px;
+  left: 14px;
+  font-size: 11px;
+  color: #916421;
+  background: #fff8e8;
+  border: 1px solid #ead8ae;
+  border-radius: 8px;
+  max-width: 75%;
+  padding: 10px;
+}
+.ev-canvas-engine.ev-hidden-2d {
+  position: absolute !important;
+  inset: 0;
+  visibility: hidden;
+  pointer-events: none;
+}
+.ev-canvas-engine {
+  height: 100%;
+  width: 100%;
+}
+.ev-pane-heading .ev-dimension-switch {
