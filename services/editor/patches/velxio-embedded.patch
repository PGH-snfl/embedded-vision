+import type { BreadboardHoverPreview } from '../../utils/breadboardHoverPreview';
+
+/** The visual preview follows only the actual target strip, never remote nets. */
+export function hoveredStripLine3D(
+  preview: BreadboardHoverPreview | null,
+  resolve: (ref: string) => [number, number, number] | undefined,
+): [[number, number, number], [number, number, number]] | null {
+  if (!preview) return null;
+  const group = preview.groups.find(g => g.breadboardId === preview.target.componentId && g.holeNames.includes(preview.target.pinName));
+  if (!group || group.holeNames.length < 2) return null;
+  const start = resolve(`${group.breadboardId}.${group.holeNames[0]}`);
+  const end = resolve(`${group.breadboardId}.${group.holeNames[group.holeNames.length - 1]}`);
+  if (!start || !end) return null;
+  return [[start[0], start[1] + .0015, start[2]], [end[0], end[1] + .0015, end[2]]];
+}
