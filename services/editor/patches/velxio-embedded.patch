+import { describe, expect, it, vi } from 'vitest';
+import { isCatalogComponent, pickerUnavailableReason } from '../data/pickerAvailability';
+import metadata from '../../public/components-metadata.json' with { type: 'json' };
+import { BOARD_KIND_LABELS } from '../types/board';
+
+describe('catalog placement availability', () => {
+  it('shows all non-board registry entries, including all three previously hidden entries', () => {
+    const visible = new Set(metadata.components.filter((part) => isCatalogComponent(part.id)).map((part) => part.id));
+    for (const part of metadata.components) {
+      expect(visible.has(part.id)).toBe(!Object.prototype.hasOwnProperty.call(BOARD_KIND_LABELS, part.id));
+    }
+    for (const id of ['nano-rp2040-connect', 'esp32-devkit-v1', 'junction']) expect(visible.has(id)).toBe(true);
+  });
+
+  it('finds each previously hidden entry by Korean name and id', async () => {
+    vi.stubGlobal('document', { querySelector: () => ({}) });
+    vi.stubGlobal('fetch', async () => ({ ok: true, json: async () => structuredClone(metadata) }));
+    try {
+      const { ComponentRegistry } = await import('../services/ComponentRegistry');
+      const registry = ComponentRegistry.getInstance();
+      await registry.load();
+      for (const [id, query] of [
+        ['nano-rp2040-connect', '아두이노 나노 RP2040'],
+        ['esp32-devkit-v1', 'ESP32 개발 보드'],
+        ['junction', '배선 분기점'],
+      ]) {
+        expect(registry.search(query).some((part) => part.id === id && isCatalogComponent(part.id))).toBe(true);
+        expect(registry.search(id).some((part) => part.id === id && isCatalogComponent(part.id))).toBe(true);
+      }
+    } finally {
+      vi.unstubAllGlobals();
+    }
+  });
+
+  it.each(['nano-rp2040-connect', 'esp32-devkit-v1'])(
+    'explains that the %s board shell cannot run or be placed',
+    (id) => {
+      expect(pickerUnavailableReason(id, true)).toContain('실행 및 추가 불가');
+      expect(pickerUnavailableReason(id, false)).toContain('cannot be placed or simulated');
+    },
+  );
+
+  it('explains how to create a junction instead of placing an inert node', () => {
+    expect(pickerUnavailableReason('junction', true)).toContain('배선');
+  });
+
+  it('leaves ordinary parts available for placement', () => {
+    expect(pickerUnavailableReason('led', true)).toBeNull();
+  });
+});
