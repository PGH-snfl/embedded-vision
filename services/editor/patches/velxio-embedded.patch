+import { describe, expect, it } from 'vitest';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { createElement } from 'react';
+import { GuideGraphic } from '../components/circuitiny/GuideGraphic';
+import { graphicColumns, graphicPlacements, guideHole } from '../components/circuitiny/guideGraphic';
+import type { AssemblyStep } from '../components/circuitiny/assemblyGuide';
+import type { Wire } from '../types/wire';
+
+function wire(step: AssemblyStep): Wire {
+  const endpoint=(v:string) => { const [componentId,...pin]=v.split('.'); return {componentId,pinName:pin.join('.'),x:0,y:0}; };
+  return { id:step.from, start:endpoint(step.from), end:endpoint(step.to), color:'#263238', waypoints:[], bb:step.kind==='insert' };
+}
+
+describe('visual assembly instructions', () => {
+  const button:AssemblyStep[] = [
+    {from:'SW1.1.l',to:'BB1.42t.e',kind:'insert'},
+    {from:'SW1.2.l',to:'BB1.40t.e',kind:'insert'},
+    {from:'SW1.1.r',to:'BB1.42b.f',kind:'insert'},
+    {from:'SW1.2.r',to:'BB1.40b.f',kind:'insert'},
+  ];
+  const wires=button.map(wire);
+  it('shows all four observed button legs across the actual breadboard centre gap', () => {
+    const placements=graphicPlacements(button[0],button,wires)!;
+    expect(placements.map(p => [p.pin,p.hole.row,p.hole.column,p.current])).toEqual([
+      ['1.l','E',42,true],['2.l','E',40,false],['1.r','F',42,false],['2.r','F',40,false],
+    ]);
+    expect(graphicColumns(placements)).toEqual([39,40,41,42,43]);
+    const rendered=renderToStaticMarkup(createElement(GuideGraphic, {step:button[0], connections:button, wires, type:'pushbutton-6mm'}));
+    expect(rendered).toContain('1.l → E42');
+    expect(rendered).toContain('2.l → E40');
+    expect(rendered).toContain('1.r → F42');
+    expect(rendered).toContain('가운데 홈');
+  });
+  it('refuses to display an incomplete or edited component attachment', () => {
+    expect(graphicPlacements(button[0],button,wires.slice(0,3))).toBeNull();
+    const rendered=renderToStaticMarkup(createElement(GuideGraphic, {step:button[0], connections:button, wires:wires.slice(0,3), type:'pushbutton-6mm'}));
+    expect(rendered).toContain('표시하지 않습니다');
+    expect(rendered).not.toContain('<svg');
+  });
+  it('handles LED polarity, a wire to a sensor and the edge of the board without inventing holes', () => {
+    const led:AssemblyStep[] = [{from:'D1.A',to:'BB1.29t.d',kind:'insert'},{from:'D1.C',to:'BB1.28t.d',kind:'insert'}];
+    const placement=graphicPlacements(led[0],led,led.map(wire))!;
+    expect(placement.map(p=>[p.pin,p.hole.row,p.hole.column])).toEqual([['A','D',29],['C','D',28]]);
+    const ledHtml=renderToStaticMarkup(createElement(GuideGraphic, {step:led[0], connections:led, wires:led.map(wire), type:'led'}));
+    expect(ledHtml).toContain('A (긴 다리, +) → D29');
+    expect(ledHtml).toContain('C (짧은 다리, −) → D28');
+    const sensor:AssemblyStep={from:'S1.AO',to:'BB1.40t.b',kind:'jumper'};
+    const html=renderToStaticMarkup(createElement(GuideGraphic, {step:sensor, connections:[sensor], wires:[wire(sensor)], type:'photoresistor-sensor', color:'#159957'}));
+    expect(html).toContain('② B40 구멍');
+    expect(html).toContain('#159957');
+    expect(guideHole('BB1.0t.a')).toBeNull();
+    expect(guideHole('BB1.64t.a')).toBeNull();
+    expect(guideHole('BB1.1t.f')).toBeNull();
+    expect(graphicColumns([{pin:'x',hole:guideHole('BB1.1t.a')!,current:true}])).toEqual([1,2]);
+  });
+});
