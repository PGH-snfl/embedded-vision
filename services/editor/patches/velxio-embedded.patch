+
+function JumperCable({
+  points,
+  color,
+  selected,
+  onClick,
+}: {
+  points: [number, number, number][];
+  color: string;
+  selected: boolean;
+  onClick: (e: any) => void;
+}) {
+  const geometry = useMemo(() => {
+    // Keep the tube on the native route. A spline can overshoot a bend and
+    // visually suggest a connection that does not exist in the circuit.
+    const vertices = points.map((p) => new T.Vector3(...p));
+    const path = new T.CurvePath<T.Vector3>();
+    for (let i = 1; i < vertices.length; i++) {
+      if (vertices[i - 1].distanceToSquared(vertices[i]) > 1e-16)
+        path.add(new T.LineCurve3(vertices[i - 1], vertices[i]));
+    }
+    if (!path.curves.length)
+      path.add(new T.LineCurve3(vertices[0], vertices[0].clone().addScalar(0.000001)));
+    return new T.TubeGeometry(path, Math.max(36, points.length * 12), 0.00048, 10, false);
+  }, [JSON.stringify(points)]);
+  useEffect(() => () => geometry.dispose(), [geometry]);
+  return (
+    <group>
+      <mesh geometry={geometry} onClick={onClick} onContextMenu={onClick} castShadow>
+        <meshStandardMaterial color={selected ? '#df923c' : color} roughness={0.4} />
+      </mesh>
+      {[points[0], points[points.length - 1]].map((p, i) => (
+        <mesh key={i} position={[p[0], p[1] + 0.0014, p[2]]} castShadow>
+          <boxGeometry args={[0.0021, 0.003, 0.0021]} />
+          <meshStandardMaterial color="#262c2d" roughness={0.5} />
+        </mesh>
+      ))}
+    </group>
+  );
+}
+function Waypoint({
+  wire,
+  index,
+  position,
+}: {
+  wire: string;
+  index: number;
+  position: [number, number, number];
+}) {
+  const group = useRef<T.Group>(null);
+  return (
+    <>
+      <group ref={group} position={position}>
+        <mesh>
+          <sphereGeometry args={[0.0008, 10, 8]} />
+          <meshStandardMaterial color="#ca8a35" />
+        </mesh>
+      </group>
+      <TransformControls
+        object={group as React.RefObject<T.Object3D>}
+        mode="translate"
+        size={0.35}
+        showY={false}
+        onMouseUp={() => {
+          if (group.current)
+            moveWaypoint(wire, index, group.current.position.toArray() as [number, number, number]);
+        }}
+      />
+    </>
+  );
+}
+export function Wires3D() {
+  const project = useStore((s) => s.project),
+    selected = useStore((s) => s.selectedNet),
+    running = useStore((s) => s.simulating),
+    drag = useStore((s) => s.endpointDrag),
+    wireMode = useStore((s) => s.wireMode);
+  return (
+    <>
+      {project.nets
+        .filter((n) => !n.hidden)
+        .map((net) => {
+          const a = resolvePin(project, net.endpoints[0]),
+            b = resolvePin(project, net.endpoints[1]);
+          if (!a || !b) return null;
+          if (drag?.wireId === net.id) {
+            if (drag.side === 'start') a.position = drag.point;
+            else b.position = drag.point;
+          }
+          const lift = 0.012;
+          const points: [number, number, number][] = [
+            a.position,
+            [a.position[0], lift, a.position[2]],
+            ...(net.route || []),
+            [b.position[0], lift, b.position[2]],
+            b.position,
+          ];
+          const pick = (e: any) => {
+            e.stopPropagation();
+            if (useStore.getState().endpointDrag || e.delta > 3) return;
+            e.nativeEvent?.preventDefault();
+            useStore.setState({
+              selected: null,
+              selectedNet: net.id,
+              selectedPoint: e.point.toArray(),
+            });
+            native.getState().setSelectedWire(net.id);
+          };
+          return (
+            <group key={net.id}>
+              <JumperCable
+                points={points}
+                color={net.color || '#328260'}
+                selected={selected === net.id}
+                onClick={pick}
+              />
+              {!running && !wireMode && (
+                <>
+                  <EndpointHandle
+                    wireId={net.id}
+                    side="start"
+                    position={a.position}
+                    emphasized={selected === net.id}
+                  />
+                  <EndpointHandle
+                    wireId={net.id}
+                    side="end"
+                    position={b.position}
+                    emphasized={selected === net.id}
+                  />
+                </>
+              )}
+              {selected === net.id &&
+                !running &&
+                !drag &&
+                (net.handles || []).map((p, i) => (
+                  <Waypoint key={i} wire={net.id} index={i} position={p} />
+                ))}
+            </group>
+          );
+        })}
+    </>
+  );
+}
+export function WireGround() {
+  const wireMode = useStore((s) => s.wireMode),
+    pending = useStore((s) => s.pendingPin),
+    project = useStore((s) => s.project),
+    route = useStore((s) => s.pendingRoute),
+    cursor = useStore((s) => s.cursor);
+  const a = pending ? resolvePin(project, pending) : null;
+  const preview =
+    a && cursor
+      ? [
+          a.position,
+          ...route.map((p) => [p.x * PX, 0.012, p.y * PX] as [number, number, number]),
+          cursor,
+        ]
+      : [];
+  return (
+    <>
+      {preview.length > 1 && (
+        <Line
+          points={preview}
+          color={useStore.getState().wireColor}
+          lineWidth={2}
+          dashed
+          dashSize={0.002}
+          gapSize={0.001}
+        />
+      )}
+      <mesh
+        rotation={[-Math.PI / 2, 0, 0]}
+        position={[0, -0.0002, 0]}
+        onPointerMove={(e) => {
+          if (wireMode && pending) useStore.setState({ cursor: [e.point.x, 0.012, e.point.z] });
+        }}
+        onClick={(e) => {
+          if (e.delta > 3 || useStore.getState().endpointDrag) return;
+          e.stopPropagation();
+          if (wireMode && pending)
+            useStore.setState((s) => ({
+              pendingRoute: [...s.pendingRoute, { x: e.point.x / PX, y: e.point.z / PX }],
+            }));
+          else useStore.getState().select(null);
+        }}
+      >
+        <planeGeometry args={[10, 10]} />
+        <meshBasicMaterial transparent opacity={0} depthWrite={false} />
+      </mesh>
+    </>
+  );
+}
