+// @vitest-environment jsdom
+import { it, expect, vi } from 'vitest';
+import { computeSeating, alignGeneratedSeating } from '../utils/breadboardSnap';
+import { importVlxFile } from '../utils/vlxFile';
+import { useSimulatorStore } from '../store/useSimulatorStore';
+import { spawnSync } from 'node:child_process';
+import { resolve } from 'node:path';
+import { fileURLToPath, URL as NodeURL } from 'node:url';
+import { buildPreflightSnapshot } from '../simulation/verify/verifyFromStore';
+import { buildInputFromStore } from '../simulation/spice/storeAdapter';
+import { verifyCircuit } from '../simulation/verify/circuitVerifier';
+
+it('does not flag a powered button LED breadboard as unpowered', async () => {
+ const root=resolve(fileURLToPath(new NodeURL('.', import.meta.url)), '../../../../..');
+ const script="import json;from backend.design.recipes import new_graph;from backend.workbench.export import export_project;print(json.dumps(export_project(new_graph('a'*32,'arduino_led_button')[0])))";
+ const res=spawnSync(resolve(root,'.venv/bin/python'),['-c',script],{cwd:root,encoding:'utf8'});expect(res.status,res.stderr).toBe(0);
+ const p=JSON.parse(res.stdout);
+ vi.stubGlobal('requestAnimationFrame',()=>0);
+ await importVlxFile({text:async()=>JSON.stringify(p)} as File);
+ const state=useSimulatorStore.getState();
+ const comp=state.components.find(c=>c.id==='SW1')!;
+ const wrap=document.createElement('div');wrap.className='dynamic-component-wrapper';
+ const el=document.createElement('div');el.id='SW1';(el as any).pinInfo=[{name:'1.l',x:0,y:2.2},{name:'2.l',x:0,y:21},{name:'1.r',x:28,y:2.2},{name:'2.r',x:28,y:21}];
+ wrap.append(el);document.body.append(wrap);
+ Object.defineProperties(wrap,{offsetWidth:{value:109},offsetHeight:{value:67}});
+ const aligned=alignGeneratedSeating(comp,state.components,state.wires);
+ expect(aligned).toBeTruthy();
+ state.updateComponent('SW1',aligned!);
+ const corrected=useSimulatorStore.getState();
+ expect(computeSeating(corrected.components.find(c=>c.id==='SW1')!,corrected.components)?.map(s=>[s.pinName,s.holeName])).toEqual([['1.l','42t.e'],['2.l','40t.e'],['1.r','42b.f'],['2.r','40b.f']]);
+ // User-edited draft wires are never treated as generated placement instructions.
+ const edited=structuredClone(p.wires).map((w:any)=>({...w,id:'custom-'+w.id}));
+ expect(alignGeneratedSeating(comp,state.components,edited)).toBeNull();
+ wrap.remove();
+ expect(state.wires).toHaveLength(p.wires.length);
+ const latest=useSimulatorStore.getState();
+ const preflight=buildPreflightSnapshot({components:latest.components,wires:latest.wires,boards:latest.boards});
+ const snap=buildInputFromStore(preflight.snap);
+ const result=await verifyCircuit(snap,{synthesizedPins:preflight.synthesizedPins});
+ expect(result.warnings.filter(w=>w.code==='unpowered-net'),JSON.stringify(result.warnings)).toEqual([]);
+});
diff --git a/frontend/src/__tests__/embedded-button-led-integration.test.ts b/frontend/src/__tests__/embedded-button-led-integration.test.ts
new file mode 100644
index 0000000..ba7d3a1
--- /dev/null
+++ b/frontend/src/__tests__/embedded-button-led-integration.test.ts
@@ -0,0 +1,121 @@
+// @vitest-environment jsdom
+/**
+ * End-to-end electrical/MCU regression for the generated Arduino button LED design.
+ * The exact exported sketch is compiled with the local AVR toolchain. Each phase
+ * solves its actual breadboard wires in ngspice, feeds the resulting button voltage
+ * into the real AVR emulator, and then solves the LED current from its output.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import { spawnSync } from 'node:child_process';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { AVRSimulator } from '../simulation/AVRSimulator';
+import { PinManager } from '../simulation/PinManager';
+import { buildNetlist } from '../simulation/spice/NetlistBuilder';
+import { runNetlist } from './helpers/testSolver';
+import { PartSimulationRegistry } from '../simulation/parts/PartSimulationRegistry';
+import { PROPERTY_CHANGE_EVENT } from '../simulation/parts/partUtils';
+import '../simulation/parts/BasicParts';
+
+const bridge = vi.hoisted(() => ({ sim: null as any, pm: null as any,
+  electrical: { nodeVoltages: {} as Record<string, number>, pinNetMap: new Map<string, string>(),
+    sourcedNets: new Set<string>(), voltageSources: [] as string[] } }));
+vi.mock('../store/useSimulatorStore', () => ({
+  useSimulatorStore: { getState: () => ({ boards: [{ id: 'U1', boardKind: 'arduino-uno' }] }), subscribe: () => () => {} },
+  getBoardSimulator: () => bridge.sim,
+  getBoardPinManager: () => bridge.pm,
+}));
+vi.mock('../store/useElectricalStore', () => ({
+  useElectricalStore: { getState: () => bridge.electrical, subscribe: () => () => {} },
+}));
+
+vi.stubGlobal('requestAnimationFrame', () => 1);
+vi.stubGlobal('cancelAnimationFrame', () => {});
+
+const project = resolve(dirname(fileURLToPath(import.meta.url)), '../../../../..');
+const python = resolve(project, '.venv/bin/python');
+const generate = `
+import json, tempfile
+from pathlib import Path
+from backend.design.recipes import new_graph
+from backend.workbench.export import export_project
+from backend.emulator.toolchain import compile_firmware
+p = export_project(new_graph('a' * 32, 'arduino_led_button')[0])
+src = p['fileGroups']['group-U1'][0]['content']
+with tempfile.TemporaryDirectory(prefix='button-led-test-') as d:
+    compile_firmware('#include <Arduino.h>\\n' + src, d)
+    print(json.dumps({'project': p, 'hex': Path(d, 'firmware.hex').read_text()}))
+`;
+
+describe('generated button LED design', () => {
+  it('uses real breadboard wiring to turn the LED on only while pressed', { timeout: 60000 }, async () => {
+    const build = spawnSync(python, ['-c', generate], { cwd: project, encoding: 'utf8', timeout: 45000 });
+    expect(build.status, build.stderr).toBe(0);
+    const fixture = JSON.parse(build.stdout);
+    const { components, wires } = fixture.project;
+    const button = components.find((c: { id: string }) => c.id === 'SW1');
+    expect(button.metadataId).toBe('pushbutton-6mm');
+    const pm = new PinManager();
+    const sim = new AVRSimulator(pm, 'uno');
+    bridge.sim = sim;
+    bridge.pm = pm;
+    const { connectDigitalInputsToMcu } = await import('../simulation/spice/connectDigitalInputsToMcu');
+    sim.loadHex(fixture.hex);
+    const element = document.createElement('div');
+    const onPropertyChange = (event: Event) => {
+      const { componentId, propName, value } = (event as CustomEvent).detail;
+      if (componentId === 'SW1') button.properties[propName] = value;
+    };
+    window.addEventListener(PROPERTY_CHANGE_EVENT, onPropertyChange);
+    const detach = PartSimulationRegistry.get('pushbutton-6mm')!.attachEvents!(
+      element, sim as never, (pin: string) => pin.startsWith('2.') ? 2 : -1, 'SW1');
+    const steps = (count = 200000) => { for (let i = 0; i < count; i++) sim.step(); };
+    steps();
+
+    async function solve() {
+      const input = {
+        components, wires,
+        boards: [{ id: 'U1', boardKind: 'arduino-uno', vcc: 5,
+          pins: { '2': { type: 'input' }, '5': { type: 'digital', v: pm.getPinState(5) ? 5 : 0 } },
+          groundPinNames: ['GND'], vccPinNames: ['5V'] }],
+        analysis: { kind: 'op' },
+      } as Parameters<typeof buildNetlist>[0];
+      const { netlist, pinNetMap, sourcedNets, voltageSources } = buildNetlist(input);
+      const result = await runNetlist(netlist);
+      const net = pinNetMap.get('U1:2')!;
+      const voltage = result.dcValue(`v(${net})`);
+      bridge.electrical = { nodeVoltages: { [net]: voltage }, pinNetMap, sourcedNets,
+        voltageSources: voltageSources.map((s) => s.toLowerCase()) };
+      return { voltage,
+        current: Math.abs(result.dcValue('i(v_D1_sense)')) };
+    }
+    for (const [pressed, expected] of [[false, false], [true, true], [false, false]] as const) {
+      element.dispatchEvent(new Event(pressed ? 'button-press' : 'button-release'));
+      expect(Boolean(button.properties.pressed)).toBe(pressed);
+      // The production connector injects only source-backed solved levels.
+      const before = await solve();
+      if (pressed) expect(before.voltage).toBeLessThan(0.8);
+      else expect(before.voltage).toBeGreaterThan(2.0);
+      connectDigitalInputsToMcu()();
+      steps();
+      expect(pm.getPinState(5)).toBe(expected);
+      const after = await solve();
+      if (pressed) expect(after.current).toBeGreaterThan(0.001);
+      else expect(after.current).toBeLessThan(0.00001);
+    }
+    // A real four-pin switch has two permanently connected pairs. Grounding
+    // the second pin of the same pair is a miswire and must stay LOW at idle.
+    const groundWire = wires.find((w: { start: { componentId: string; pinName: string } }) =>
+      w.start.componentId === 'SW1' && w.start.pinName === '2.l');
+    expect(groundWire).toBeDefined();
+    groundWire.start.pinName = '1.r';
+    const miswired = await solve();
+    expect(miswired.voltage).toBeLessThan(0.8);
+    connectDigitalInputsToMcu()();
+    steps();
+    expect(pm.getPinState(5)).toBe(true);
+    expect((await solve()).current).toBeGreaterThan(0.001);
+    detach?.();
+    window.removeEventListener(PROPERTY_CHANGE_EVENT, onPropertyChange);
+  });
+});
