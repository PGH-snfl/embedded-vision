+// @vitest-environment jsdom
+import { describe, it, expect } from 'vitest';
+import fixture from './fixtures/embedded-breadboard-led.json';
+import { assemblyModel } from '../components/assembly/assemblyModel';
+import type { Wire } from '../types/wire';
+describe('3D assembly uses exported physical wiring', () => {
+  it('seats all four leads and uses two actual jumpers', () => {
+    const model = assemblyModel(fixture.boards, fixture.components, fixture.wires as Wire[]);
+    expect(model.seats.size).toBe(4);
+    expect(model.jumpers.length).toBe(2);
+    expect(model.seats.get('D1.A')?.hole).toBe('BB1.11t.d');
+    expect(model.seats.get('D1.C')?.hole).toBe('BB1.10t.d');
+    expect(model.unsupported).toEqual([]);
+    // Board pin positions are initially unresolved until the native canvas measures them.
+    expect(model.unresolved).toEqual(['J1', 'J2']);
+  });
+  it('honors measured board pin positions and edited wire endpoints', () => {
+    const wires = structuredClone(fixture.wires) as Wire[];
+    wires[0].start.x = 248;
+    wires[0].start.y = 89;
+    wires[1].start.x = 155.5;
+    wires[1].start.y = 89;
+    let model = assemblyModel(fixture.boards, fixture.components, wires);
+    expect(model.unresolved).toEqual([]);
+    expect(model.jumpers[0].a?.x).toBe(248);
+    const before = model.jumpers[0].b?.x;
+    wires[0].end.pinName = '6t.a';
+    model = assemblyModel(fixture.boards, fixture.components, wires);
+    expect(model.jumpers[0].b!.x - before!).toBeCloseTo(9.6);
+  });
+  it('marks unplugged parts instead of inventing seating positions',()=>{
+    const model=assemblyModel(fixture.boards,fixture.components,(fixture.wires as Wire[]).filter(w=>!w.bb));
+    expect(model.unsupported).toEqual(['R1','D1']);
+  });
+
+  it('does not render an unsupported part as a different device', () => {
+    const extra = { id: 'M1', metadataId: 'motor', x: 10, y: 10, properties: {} };
+    expect(
+      assemblyModel(fixture.boards, [...fixture.components, extra], fixture.wires as Wire[])
+        .unsupported,
+    ).toContain('M1');
+  });
+});
