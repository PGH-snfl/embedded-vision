+
+it('uses measured light sensor and breadboard pin positions for Korean assembly guidance', () => {
+  document.body.innerHTML='';
+  const el=document.createElement('div');el.id='S1';
+  (el as any).pinInfo=[{name:'VCC',x:172,y:16},{name:'GND',x:172,y:26},{name:'DO',x:172,y:35.8},{name:'AO',x:172,y:45.5}];
+  Object.defineProperties(el,{offsetWidth:{value:174},offsetHeight:{value:62}});
+  const wrapper=document.createElement('div');wrapper.className='dynamic-component-wrapper';
+  Object.defineProperties(wrapper,{offsetWidth:{value:186},offsetHeight:{value:74}});
+  wrapper.append(el);document.body.append(wrapper);
+  const previous=useSimulatorStore.getState();
+  try {
+    const wires=[{id:'J1',start:{componentId:'S1',pinName:'AO',x:0,y:0},end:{componentId:'BB1',pinName:'40t.b',x:0,y:0},color:'#159957',waypoints:[]}];
+    useSimulatorStore.setState({components:[{id:'BB1',metadataId:'breadboard',x:400,y:115,properties:{}},{id:'S1',metadataId:'photoresistor-sensor',x:810,y:335,properties:{lux:500}}],boards:[],wires} as never);
+    const project=registerProject(useSimulatorStore.getState());
+    const resolved=resolveGuidePin(project,'S1.AO');
+    expect(resolved).toBeTruthy();
+    // The 3D coordinates use the measured Wokwi AO pin (172, 45.5) and 6px wrapper inset.
+    expect(resolved!.position[0]).toBeCloseTo((810+6+172)*0.0002645833,5);
+    expect(resolved!.position[2]).toBeCloseTo((335+6+45.5)*0.0002645833,5);
+    expect(readableRef('S1.AO')).toContain('조도 센서 S1 AO(아날로그 출력)');
+    expect(guideWarning({from:'S1.AO',to:'BB1.40t.b',kind:'jumper'},wires,project)).toBe('');
+    expect(guideWarning({from:'S1.AO',to:'BB1.40t.b',kind:'jumper'},[],project)).toContain('편집한 회로');
+  } finally {useSimulatorStore.setState({components:previous.components,boards:previous.boards,wires:previous.wires} as never);document.body.innerHTML='';}
+});
