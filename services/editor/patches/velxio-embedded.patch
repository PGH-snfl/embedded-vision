@@ -0,0 +1,13 @@
+import { isBreadboard } from './breadboardNets';
+
+/** Keep selection/inspection available; this only gates position changes. */
+export function isInfrastructureDragLocked(
+  draggedId: string,
+  components: readonly { id: string; metadataId: string }[],
+  movementEnabled: boolean,
+): boolean {
+  if (movementEnabled) return false;
+  if (draggedId === '__board__' || draggedId.startsWith('__board__:')) return true;
+  const component = components.find(c => c.id === draggedId);
+  return !!component && isBreadboard(component.metadataId);
+}
diff --git a/frontend/src/utils/wireReconnect.ts b/frontend/src/utils/wireReconnect.ts
new file mode 100644
index 0000000..f443c5c
--- /dev/null
+++ b/frontend/src/utils/wireReconnect.ts
@@ -0,0 +1,123 @@
+/** Reconnect real native wire endpoints; preview never mutates the electrical circuit. */
+import { useSimulatorStore as native } from '../store/useSimulatorStore';
+import { geometryFor } from '../components/circuitiny/geometry';
+import { PX } from '../components/circuitiny/catalog';
+import { breadboardGroupKey, isBreadboard } from './breadboardNets';
+import type { WireEndpoint } from '../types/wire';
+type NativeState = ReturnType<typeof native.getState>;
+export type WireEnd = 'start' | 'end';
+export function validateWireConnection(s: NativeState, a: WireEndpoint, b: WireEndpoint) {
+  if (a.componentId === b.componentId && a.pinName === b.pinName)
+    throw new Error('다른 핀을 선택하세요.');
+  if (
+    s.wires.some(
+      (w) =>
+        [w.start, w.end].some((e) => e.componentId === a.componentId && e.pinName === a.pinName) &&
+        [w.start, w.end].some((e) => e.componentId === b.componentId && e.pinName === b.pinName),
+    )
+  )
+    throw new Error('이미 연결된 핀입니다.');
+  for (const e of [a, b])
+    if (
+      s.components.some((c) => c.id === e.componentId && isBreadboard(c.metadataId)) &&
+      s.wires.some((w) =>
+        [w.start, w.end].some((p) => p.componentId === e.componentId && p.pinName === e.pinName),
+      )
+    )
+      throw new Error('이미 다리가 꽂힌 구멍입니다. 같은 열의 빈 구멍을 선택하세요.');
+  const parent = new Map<string, string>();
+  const find = (k: string): string => {
+    if (!parent.has(k)) parent.set(k, k);
+    const p = parent.get(k)!;
+    if (p !== k) parent.set(k, find(p));
+    return parent.get(k)!;
+  };
+  const union = (a: string, b: string) => parent.set(find(a), find(b));
+  const key = (e: WireEndpoint) => {
+    if (s.boards.some((b) => b.id === e.componentId) && e.pinName.startsWith('GND'))
+      return e.componentId + '.GND';
+    const c = s.components.find((c) => c.id === e.componentId);
+    return (
+      e.componentId +
+      '.' +
+      (c && isBreadboard(c.metadataId) ? breadboardGroupKey(c.metadataId, e.pinName) : e.pinName)
+    );
+  };
+  for (const w of s.wires) union(key(w.start), key(w.end));
+  union(key(a), key(b));
+  const boardIds = new Set(s.boards.map((b) => b.id));
+  const known = [...parent.keys()].filter((k) => boardIds.has(k.split('.')[0]));
+  const power = known.filter((k) => /\.(5V|3\.3V|3V3|VIN)$/.test(k)),
+    ground = known.filter((k) => /\.GND$/.test(k));
+  if (power.some((p) => ground.some((g) => find(g) === find(p))))
+    throw new Error('전원과 GND를 직접 연결할 수 없습니다.');
+}
+
+export function wirePinTarget(
+  s: NativeState,
+  wireId: string,
+  side: WireEnd,
+  point: { x: number; y: number },
+  tolerance: number,
+) {
+  const wire = s.wires.find((w) => w.id === wireId);
+  if (!wire || wire.bb) return null;
+  let closest: WireEndpoint | null = null,
+    distance = tolerance;
+  for (const item of [...s.boards, ...s.components]) {
+    const g = geometryFor(item);
+    for (const p of g.pins) {
+      const x = (g.position[0] + p.position[0]) / PX,
+        y = (g.position[2] + p.position[2]) / PX;
+      const d = Math.hypot(x - point.x, y - point.y);
+      if (d <= distance) {
+        distance = d;
+        closest = { componentId: item.id, pinName: p.name, x, y };
+      }
+    }
+  }
+  if (!closest) return null;
+  try {
+    validateWireConnection(
+      { ...s, wires: s.wires.filter((w) => w.id !== wireId) },
+      side === 'start' ? closest : wire.start,
+      side === 'end' ? closest : wire.end,
+    );
+    return { endpoint: closest, valid: true, reason: '' };
+  } catch (e) {
+    return {
+      endpoint: closest,
+      valid: false,
+      reason: e instanceof Error ? e.message : '연결할 수 없는 핀입니다.',
+    };
+  }
+}
+export function reconnectWireEnd(wireId: string, side: WireEnd, target: WireEndpoint): boolean {
+  const s = native.getState();
+  if (s.running) throw new Error('정지한 뒤 배선을 옮기세요.');
+  const w = s.wires.find((w) => w.id === wireId);
+  if (!w || w.bb) throw new Error('옮길 수 없는 배선입니다.');
+  const item = [...s.boards, ...s.components].find((c) => c.id === target.componentId);
+  const g = item && geometryFor(item),
+    pin = g?.pins.find((p) => p.name === target.pinName);
+  if (!g || !pin) throw new Error('확인할 수 없는 핀입니다.');
+  target = {
+    ...target,
+    x: (g.position[0] + pin.position[0]) / PX,
+    y: (g.position[2] + pin.position[2]) / PX,
+  };
+  if (w[side].componentId === target.componentId && w[side].pinName === target.pinName)
+    return false;
+  validateWireConnection(
+    { ...s, wires: s.wires.filter((w) => w.id !== wireId) },
+    side === 'start' ? target : w.start,
+    side === 'end' ? target : w.end,
+  );
+  s.recordUpdateWire(
+    wireId,
+    side === 'start' ? { start: w.start } : { end: w.end },
+    side === 'start' ? { start: { ...target } } : { end: { ...target } },
+    '배선 끝점 이동',
+  );
+  return true;
+}
