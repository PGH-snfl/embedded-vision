+// @vitest-environment jsdom
+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, describe, expect, it } from 'vitest';
+import { useDirectBreadboardComponents } from '../components/circuitiny/useBreadboardHoverPreview';
+import { useSimulatorStore as native } from '../store/useSimulatorStore';
+import { useStore } from '../components/circuitiny/store';
+
+function Probe() {
+  const components = useDirectBreadboardComponents();
+  return React.createElement('output', null, components.join(','));
+}
+
+describe('3D breadboard component hover', () => {
+  afterEach(() => { useStore.setState({endpointDrag: null}); });
+
+  it('tracks only seated components on the hovered strip and clears on leave', async () => {
+    (globalThis as any).IS_REACT_ACT_ENVIRONMENT = true;
+    const oldComponents = native.getState().components, oldWires = native.getState().wires;
+    const host = document.createElement('div'); document.body.append(host);
+    const root = createRoot(host);
+    const e = (componentId: string, pinName: string) => ({componentId, pinName, x: 0, y: 0});
+    const wire = (id: string, start: ReturnType<typeof e>, end: ReturnType<typeof e>, bb = false) =>
+      ({id, start, end, bb, color: '#111111', waypoints: []});
+    const components = [
+      {id:'BB1',metadataId:'breadboard', x:0,y:0,properties:{}},
+      {id:'R1',metadataId:'resistor', x:0,y:0,properties:{}},
+      {id:'D1',metadataId:'led', x:0,y:0,properties:{}},
+    ];
+    const wires = [wire('seat-r',e('BB1','23t.b'),e('R1','1'),true),
+      wire('seat-d',e('BB1','29t.b'),e('D1','A'),true),
+      wire('jumper',e('BB1','23t.a'),e('BB1','29t.a'))];
+    await act(async () => {
+      native.setState({components: components as any, wires: wires as any});
+      useStore.setState({endpointDrag:{wireId:'moving',side:'end',point:[0,0,0],valid:true,label:'',hoverTarget:{componentId:'BB1',pinName:'23t.e'}}});
+      root.render(React.createElement(Probe));
+    });
+    expect(host.textContent).toBe('R1');
+    await act(async () => {useStore.setState({endpointDrag:{wireId:'moving',side:'end',point:[0,0,0],valid:true,label:'',hoverTarget:{componentId:'BB1',pinName:'29t.c'}}});});
+    expect(host.textContent).toBe('D1');
+    await act(async () => {useStore.setState({endpointDrag:null});});
+    expect(host.textContent).toBe('');
+    await act(async () => {root.unmount(); native.setState({components: oldComponents, wires: oldWires});}); host.remove();
+  });
+});
