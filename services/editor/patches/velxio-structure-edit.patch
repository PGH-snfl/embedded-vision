+/** Pinless, visual-only geometry. Stored in the native component snapshot so
+ * .vlx, drafts, cloud saves, undo and project deletion share one lifecycle. */
+export const STRUCTURE_ID = 'ev-structure';
+export type StructureShape = 'box' | 'cylinder';
+export type StructureParameters = { shape: StructureShape; width: number; height: number; depth: number; elevation: number; color: string; rotation: number };
+function numeric(value: unknown, fallback: number, min: number, max: number) {
+  const n = typeof value === 'number' ? value : Number(value);
+  return Number.isFinite(n) ? Math.max(min, Math.min(max, n)) : fallback;
+}
+export function structureParameters(input: Record<string, unknown> | undefined): StructureParameters {
+  const p = input || {};
+  return {
+    shape: p.shape === 'cylinder' ? 'cylinder' : 'box',
+    width: numeric(p.width, 40, 2, 500), height: numeric(p.height, 20, 2, 500),
+    depth: numeric(p.depth, 40, 2, 500), elevation: numeric(p.elevation, 0, 0, 500),
+    color: typeof p.color === 'string' && /^#[0-9a-f]{6}$/i.test(p.color) ? p.color : '#829aaf',
+    rotation: numeric(p.rotation, 0, -36000, 36000),
+  };
+}
+export function newStructure(shape: StructureShape, x: number, y: number) {
+  return {id: `structure-${globalThis.crypto?.randomUUID?.() || Math.random().toString(36).slice(2)}`,
+    metadataId: STRUCTURE_ID, x, y, properties: structureParameters({shape})};
+}
