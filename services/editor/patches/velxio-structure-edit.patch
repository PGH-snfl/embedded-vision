+// @vitest-environment jsdom
+import {beforeEach,describe,expect,it} from 'vitest';
+import {newStructure,structureParameters,STRUCTURE_ID} from '../components/circuitiny/structureObjects';
+import {geometryFor} from '../components/circuitiny/geometry';
+import {useSimulatorStore} from '../store/useSimulatorStore';
+import {buildVlxPayload,importVlxFile} from '../utils/vlxFile';
+import {buildSavePayload} from '../utils/projectPayload';
+import {stashWorkspaceForAuth,restoreStashedWorkspace} from '../utils/workspaceDraft';
+import {isAllDigital} from '../simulation/digital/digitalGateEngine';
+import {buildInputFromStore} from '../simulation/spice/storeAdapter';
+
+beforeEach(()=>{sessionStorage.clear();useSimulatorStore.setState({components:[],wires:[],boards:[],activeBoardId:null} as never);});
+describe('visual structures and project persistence',()=>{
+  it('round-trips dimensions, rotation and position in VLX and cloud payload',async()=>{
+    const object=newStructure('cylinder',41,64);object.properties={...object.properties,width:70,height:30,rotation:90};
+    useSimulatorStore.getState().recordAddComponent(object);
+    const payload=JSON.parse(JSON.stringify(buildVlxPayload()));
+    expect(JSON.parse(buildSavePayload().components_json)).toEqual([object]);
+    useSimulatorStore.setState({components:[]} as never);
+    await importVlxFile({text:async()=>JSON.stringify(payload)} as File);
+    expect(useSimulatorStore.getState().components).toEqual([object]);
+    expect(geometryFor(object).pins).toEqual([]);
+  });
+  it('retains structures through auth workspace draft restore',()=>{
+    const object=newStructure('box',30,40);useSimulatorStore.getState().recordAddComponent(object);
+    stashWorkspaceForAuth();useSimulatorStore.setState({components:[]} as never);
+    expect(restoreStashedWorkspace()).toBe(true);
+    expect(useSimulatorStore.getState().components).toEqual([object]);
+  });
+  it('does not change the electrical engine selection or SPICE input',()=>{
+    const gate={id:'g',metadataId:'logic-gate-and',properties:{}};
+    const object=newStructure('box',0,0);
+    expect(isAllDigital([gate])).toBe(true);
+    expect(isAllDigital([gate,object])).toBe(true);
+    expect(isAllDigital([object])).toBe(false);
+    const snap={components:[gate,object],boards:[],wires:[]};
+    expect(buildInputFromStore(snap as never).components).toEqual([gate]);
+    expect(object.metadataId).toBe(STRUCTURE_ID);
+  });
+  it('clamps imported or malformed visual values',()=>{
+    expect(structureParameters({width:Infinity,height:-1,depth:99999,color:'url(x)',elevation:-4})).toMatchObject({width:40,height:2,depth:500,color:'#829aaf',elevation:0});
+  });
+});
