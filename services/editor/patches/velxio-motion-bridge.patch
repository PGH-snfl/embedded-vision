+/** Bridge from the real editor to the host's separate motion preview. */
+export type MotionBridgeResult =
+  | { handled: false }
+  | { handled: true; error?: string };
+
+let motionSource: Record<string, unknown> | undefined;
+export function setMotionSource(source: Record<string, unknown> | undefined) { motionSource = source; }
+export function getMotionSource() { return motionSource; }
+
+/** Legacy drafts have no comparable revision and must not replace a robot circuit. */
+export function matchingCircuitRevision(original: any, saved: any): boolean {
+  const revision = original?.embeddedVision?.circuit_revision;
+  return Number.isSafeInteger(revision) && revision >= 0 &&
+    saved?.embeddedVision?.circuit_revision === revision;
+}
+
+export function acceptedMotionRevision(options: {
+  search: string; referrer: string; eventOrigin: string; fromParent: boolean;
+  data: any; source: Record<string, any>;
+}): number | undefined {
+  try {
+    const query = new URLSearchParams(options.search);
+    const channel = query.get('channel') || '';
+    const origin = options.source.analysis_origin;
+    const revision = options.data?.revision;
+    if (query.get('embedded') !== '1' || query.get('motion') !== '1' ||
+        !/^[a-f0-9]{32,128}$/i.test(channel) || !options.fromParent ||
+        options.data?.type !== 'ev:revision-saved' || options.data?.channel !== channel ||
+        typeof origin !== 'string' || new URL(origin).origin !== origin ||
+        !['http:', 'https:'].includes(new URL(origin).protocol) ||
+        new URL(options.referrer).origin !== origin || options.eventOrigin !== origin ||
+        !Number.isSafeInteger(revision) || revision < 0 ||
+        !Number.isSafeInteger(options.source.circuit_revision) ||
+        revision !== options.source.circuit_revision + 1) return undefined;
+    return revision;
+  } catch { return undefined; }
+}
+
+export function requestMotionPreview(options: {
+  search: string;
+  hash: string;
+  referrer: string;
+  isFramed: boolean;
+  snapshot: () => unknown;
+  send: (message: unknown, origin: string) => void;
+  sourceOverride?: Record<string, unknown>;
+}): MotionBridgeResult {
+  const query = new URLSearchParams(options.search);
+  if (query.get('motion') !== '1') return { handled: false };
+  try {
+    const channel = query.get('channel') || '';
+    if (query.get('embedded') !== '1' || !options.isFramed || !/^[a-f0-9]{32,128}$/i.test(channel)) throw new Error('연결 설정이 올바르지 않습니다.');
+    const encoded = new URLSearchParams(options.hash.slice(1)).get('project');
+    if (!encoded || encoded.length > 2_000_000) throw new Error('원본 프로젝트가 없습니다.');
+    const bytes = Uint8Array.from(atob(encoded), c => c.charCodeAt(0));
+    const original = JSON.parse(new TextDecoder().decode(bytes));
+    const source = original?.embeddedVision;
+    if (original?.format !== 'velxio-project' || typeof source?.source_graph_sha256 !== 'string' || !source.source_graph_sha256) throw new Error('원본 프로젝트를 확인할 수 없습니다.');
+    const origin = source.analysis_origin;
+    if (typeof origin !== 'string') throw new Error('상위 화면 주소가 없습니다.');
+    const parsed = new URL(origin);
+    if (!['http:', 'https:'].includes(parsed.protocol) || parsed.origin !== origin || parsed.username || parsed.password || new URL(options.referrer).origin !== origin) throw new Error('상위 화면 주소가 일치하지 않습니다.');
+    const payload = { ...(options.snapshot() as object), embeddedVision: options.sourceOverride || source };
+    const serialized = JSON.stringify(payload);
+    if (serialized.length > 1_000_000) throw new Error('프로젝트가 너무 큽니다.');
+    options.send({ type: 'ev:motion-request', channel, payload: JSON.parse(serialized) }, origin);
+    return { handled: true };
+  } catch (error) {
+    return { handled: true, error: error instanceof Error ? error.message : '운동 미리보기 요청에 실패했습니다.' };
+  }
+}
