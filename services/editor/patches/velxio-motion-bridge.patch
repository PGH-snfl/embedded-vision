+  const part = (id: string, name: string, x: number, pins: string[]) => ({
+    id, metadataId: 'custom-chip', x, y: 50,
+    properties: { chipName: name, chipJson: JSON.stringify({
+      name, pins: pins.map((pin, i) => ({ name: pin, x: i ? 160 : 0, y: 20 + i * 20 })),
+    }) },
+  });
+  const pi = part('U1', 'Pi 4B (visual only)', 50, ['USB_C', 'GPIO40']);
+  const hat = part('HAT1', 'Motor HAT (visual only)', 300, ['GPIO40', 'M1.left', 'M1.right']);
+  for (const p of [pi, hat]) {
+    const element = document.createElement('velxio-custom-chip') as any;
+    element.id = p.id;
+    element.chipName = p.properties.chipName;
+    element.chipJson = p.properties.chipJson;
+    document.body.appendChild(element);
+  }
+  native.getState().loadProjectState({
+    boards: [], fileGroups: {}, components: [pi, hat], activeBoardId: null,
+    wires: [{ id: 'C1', start: { componentId: 'U1', pinName: 'GPIO40', x: 216, y: 96 },
+      end: { componentId: 'HAT1', pinName: 'GPIO40', x: 306, y: 76 },
+      color: '#24946a', waypoints: [], autoRouted: true }],
