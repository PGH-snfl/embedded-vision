+import { describe, expect, it, vi } from 'vitest';
+import { acceptedMotionRevision, matchingCircuitRevision, requestMotionPreview } from '../components/embeddedMotionBridge';
+
+const channel = 'a'.repeat(32);
+const source = { source_graph_sha256: 'abc', analysis_origin: 'http://localhost:8897' };
+const original = { format: 'velxio-project', embeddedVision: source };
+const encoded = btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(original))));
+const base = () => ({
+  search: `?embedded=1&motion=1&channel=${channel}`,
+  hash: `#project=${encodeURIComponent(encoded)}`,
+  referrer: 'http://localhost:8897/workspace',
+  isFramed: true,
+  snapshot: () => ({ format: 'velxio-project', components: [{ id: 'edited' }], wires: [], boards: [], fileGroups: {} }),
+  send: vi.fn(),
+});
+
+describe('embedded motion preview bridge', () => {
+  it('sends the edited snapshot and provenance only to the matching parent origin', () => {
+    const options = base();
+    expect(requestMotionPreview(options)).toEqual({ handled: true });
+    expect(options.send).toHaveBeenCalledWith({
+      type: 'ev:motion-request', channel,
+      payload: { ...options.snapshot(), embeddedVision: source },
+    }, source.analysis_origin);
+  });
+  it('leaves ordinary editor simulation alone', () => {
+    const options = { ...base(), search: '?embedded=1' };
+    expect(requestMotionPreview(options)).toEqual({ handled: false });
+    expect(options.send).not.toHaveBeenCalled();
+  });
+  it.each([
+    { isFramed: false },
+    { referrer: 'https://example.com/' },
+    { referrer: '' },
+    { search: '?embedded=1&motion=1&channel=short' },
+    { search: `?motion=1&channel=${channel}` },
+    { hash: '#project=invalid' },
+  ])('fails closed for an invalid host or project: %o', mutation => {
+    const options = { ...base(), ...mutation };
+    expect(requestMotionPreview(options)).toMatchObject({ handled: true, error: expect.any(String) });
+    expect(options.send).not.toHaveBeenCalled();
+  });
+  it('rejects snapshots too large to transfer', () => {
+    const options = { ...base(), snapshot: () => ({ data: 'x'.repeat(1_000_001) }) };
+    expect(requestMotionPreview(options)).toMatchObject({ handled: true, error: expect.any(String) });
+    expect(options.send).not.toHaveBeenCalled();
+  });
