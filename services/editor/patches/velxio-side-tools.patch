+import {analysisReturnUrl} from './embeddedAnalysisReturn';
+
+/** Reopen the original reviewed system without discarding a translated draft. */
+export function originalSystemUrl(workspace:string|undefined,source:Record<string,unknown>|undefined){
+ if(workspace&&!/^[a-f0-9]{32}$/.test(workspace))return undefined;
+ if(!source?.translation_target)return undefined;
+ const project=source.source_project,plan=source.inventory_plan,version=source.function_version;
+ if(typeof project!=='string'||!/^[a-f0-9]{32}$/.test(project)||typeof plan!=='string'||!/^[a-f0-9]{32}$/.test(plan)||typeof version!=='string'||!/^[a-f0-9]{64}$/.test(version))return undefined;
+ const base=analysisReturnUrl(workspace,source.analysis_origin);
+ if(!workspace){try{if(typeof source.analysis_origin!=='string'||new URL(base).origin!==new URL(source.analysis_origin).origin)return undefined;}catch{return undefined;}}
+ return base+'rover-editor.html?'+new URLSearchParams({project,plan,function_version:version});
+}
