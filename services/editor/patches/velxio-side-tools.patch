+import {describe,it,expect} from 'vitest';
+import {originalSystemUrl} from '../components/embeddedSystemConversion';
+
+const source={translation_target:'arduino_cpp',source_project:'a'.repeat(32),inventory_plan:'b'.repeat(32),function_version:'c'.repeat(64),analysis_origin:'http://127.0.0.1:8897'};
+describe('system conversion entry',()=>{
+ it('reopens the original system after translation and keeps hosted links in their workspace',()=>{
+  expect(originalSystemUrl(undefined,source)).toBe('http://127.0.0.1:8897/rover-editor.html?project='+source.source_project+'&plan='+source.inventory_plan+'&function_version='+source.function_version);
+  expect(originalSystemUrl('d'.repeat(32),source)).toMatch(/^\/w\/d{32}\/rover-editor.html\?/);
+ });
+ it('refuses unrelated projects and untrusted or malformed return addresses',()=>{
+  expect(originalSystemUrl(undefined,{...source,translation_target:undefined})).toBeUndefined();
+  expect(originalSystemUrl(undefined,{...source,analysis_origin:'https://attacker.example'})).toBeUndefined();
+  expect(originalSystemUrl(undefined,{...source,source_project:'invalid'})).toBeUndefined();
+  expect(originalSystemUrl('invalid',source)).toBeUndefined();
+ });
+});
