+++ b/frontend/src/components/compactMenuPosition.ts
@@ -0,0 +1,7 @@
+/** Keep floating tools inside the viewport even when their trigger is scrolled. */
+export function compactMenuPosition(rect:{left:number;bottom:number},viewport:{width:number;height:number},preferredWidth=360){
+ const width=Math.max(0,Math.min(preferredWidth,viewport.width-24));
+ const left=Math.max(12,Math.min(rect.left,viewport.width-width-12));
+ const top=Math.max(12,Math.min(rect.bottom+6,viewport.height-100));
+ return {left,top,width,maxHeight:Math.max(0,viewport.height-top-12)};
+}
