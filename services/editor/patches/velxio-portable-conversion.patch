+// @vitest-environment jsdom
+import {readFile,writeFile} from 'node:fs/promises';
+import {it,expect,vi} from 'vitest';
+import {probeFunctionalSystem} from '../simulation/functional/FunctionalProbe';
+import {functionalNets} from '../simulation/functional/circuit';
+import {NgSpiceNodeAdapter} from '../simulation/spice/adapters/NgSpiceNodeAdapter';
+import fixture from './fixtures/portable-system-conversion.json';
+vi.mock('../simulation/MicroPythonLoader',async original=>({...await original<typeof import('../simulation/MicroPythonLoader')>(),getFirmware:async()=>new Uint8Array(await readFile('public/firmware/micropython-rp2040.uf2'))}));
+const realFetch=globalThis.fetch;
+vi.stubGlobal('fetch',async(input:RequestInfo|URL,init?:RequestInit)=>String(input).includes('littlefs.wasm')?new Response(await readFile('node_modules/littlefs/dist/littlefs.wasm'),{headers:{'Content-Type':'application/wasm'}}):realFetch(input,init));
+vi.stubGlobal('requestAnimationFrame',()=>1);vi.stubGlobal('cancelAnimationFrame',()=>{});
+
+for(const name of ['button','dimmer','servo'] as const)it('executes current deterministic '+name+' circuit with code-only provider output',async()=>{
+ const project=fixture[name],solver=new NgSpiceNodeAdapter(),before=JSON.stringify(project);
+ try{
+  const report=await probeFunctionalSystem(project,'micropython-source',solver);
+  await writeFile('../../../outputs/portable-system-conversion/'+name+'-execution.json',JSON.stringify(report,null,2));
+  expect(report.status,JSON.stringify(report)).toBe('pass');expect(report.engine).toBe('rp2040js+ngspice');
+  expect(JSON.stringify(project)).toBe(before);
+  const input=project.components.find(p=>p.metadataId===(name==='button'?'pushbutton-6mm':'potentiometer'))!;
+  const output=project.components.find(p=>p.metadataId===(name==='servo'?'servo':'led'))!;
+  const samples=report.samples.filter(s=>s.input===input.id).sort((a,b)=>a.value-b.value);
+  expect(samples.length).toBeGreaterThan(1);
+  const low=samples[0].outputs[output.id],high=samples[samples.length-1].outputs[output.id];
+  expect(high-low).toBeGreaterThan(name==='servo'?800:.001);
+ }finally{solver.dispose();}
+},120000);
+
+it('finds a divided ADC input without crossing ground into other signal nets',()=>{
+ const project=fixture.dimmer,nets=functionalNets(project);
+ const sensor=project.components.find(p=>p.metadataId==='potentiometer')!;
+ expect(nets.boardPin(sensor.id,'SIG',true)).toBe(26);
+ expect(nets.boardPin(sensor.id,'SIG')).toBeNull();
+ const led=project.components.find(p=>p.metadataId==='led')!;
+ expect(nets.boardPin(led.id,'A',true)).toBe(15);
+});
