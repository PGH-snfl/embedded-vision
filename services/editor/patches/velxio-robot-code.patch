@@ -0,0 +1,29 @@
+import {useState} from 'react';
+import {useEditorStore} from '../store/useEditorStore';
+import {getMotionSource} from './embeddedMotionBridge';
+import {findRobotCode} from './embeddedRobotCode';
+
+/** The Python is a file in the existing editor, not executed by the 3D model. */
+export function EmbeddedRobotCode(){
+ const groups=useEditorStore(s=>s.fileGroups);
+ const [status,setStatus]=useState('');
+ const found=findRobotCode(groups);
+ const source=getMotionSource() as {robot_code?:{dependencies?:string;install?:string;run?:string;commands?:string}}|undefined;
+ const info=source?.robot_code;
+ const showCode=()=>{
+  if(!found){setStatus('코드 파일을 찾지 못했습니다.');return;}
+  const store=useEditorStore.getState();store.setActiveGroup(found.group);store.openFile(found.file.id);
+ };
+ const copy=async()=>{
+  if(!found){setStatus('코드 파일을 찾지 못했습니다.');return;}
+  try{await navigator.clipboard.writeText(found.file.content);setStatus('현재 코드를 복사했습니다. Raspberry Pi 파일에 붙여넣으세요.');}
+  catch{showCode();setStatus('자동 복사를 사용할 수 없습니다. 코드 영역에서 Ctrl+A, Ctrl+C를 누르세요.');}
+ };
+ return <div className="ev-robot-code-help">
+  <div className="ev-robot-code-row"><strong>Raspberry Pi 코드 · pi_rover.py</strong><button type="button" onClick={showCode}>코드 열기</button><button type="button" onClick={()=>void copy()} disabled={!found}>코드 복사</button></div>
+  <p>기본 배선 기준입니다. 배선을 바꿨다면 코드와 연결을 대조하세요. 3D 운동은 이 코드를 실행하지 않습니다.</p>
+  <details><summary>복사·실행 방법</summary><p>Raspberry Pi에서 I²C를 켜고 터미널에서 아래 설치 명령을 실행하세요. 코드를 복사해 <code>pi_rover.py</code> 파일에 붙여넣은 뒤 실행합니다.</p>
+   <p>{info?.dependencies}</p><pre>{info?.install}</pre><pre>{info?.run}</pre><p>{info?.commands}</p>
+  </details><span role="status">{status}</span>
+ </div>;
+}
