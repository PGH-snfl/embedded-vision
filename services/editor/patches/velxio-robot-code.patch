@@ -0,0 +1,22 @@
+/** Keep the generated Python in a real chip file group, so VLX exports,
+ * browser drafts and cloud drafts retain edits just like other editor files. */
+export const ROBOT_CODE_NAME = 'pi_rover.py';
+type File = {name:string;content:string};
+type Project = {fileGroups?:Record<string,File[]>;components?:Array<{id:string;metadataId:string}>};
+type Source = {robot_code?:{source?:string};robot_code_group?:string|null};
+
+export function findRobotCode<T extends File>(groups:Record<string,T[]>) {
+ const ordered=Object.keys(groups).sort((a,b)=>Number(b==='group-chip-U1')-Number(a==='group-chip-U1'));
+ for(const group of ordered){const file=groups[group]?.find(f=>f.name===ROBOT_CODE_NAME);if(file)return {group,file};}
+ return undefined;
+}
+
+export function ensureRobotCode<T extends Project>(payload:T,source:Source):T {
+ const groups=payload.fileGroups||{};
+ if(findRobotCode(groups)||typeof source.robot_code?.source!=='string')return payload;
+ const chips=(payload.components||[]).filter(c=>c.metadataId==='custom-chip');
+ const preferred=source.robot_code_group;
+ const group=chips.find(c=>'group-chip-'+c.id===preferred)?preferred:chips.length?'group-chip-'+chips[0].id:null;
+ if(!group)return payload;
+ return {...payload,fileGroups:{...groups,[group]:[...(groups[group]||[]),{name:ROBOT_CODE_NAME,content:source.robot_code.source}]}};
+}
