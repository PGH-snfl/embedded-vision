+// @vitest-environment jsdom
+import {describe,expect,it} from 'vitest';
+import {ensureRobotCode,findRobotCode} from '../components/embeddedRobotCode';
+import {useEditorStore} from '../store/useEditorStore';
+import {useSimulatorStore} from '../store/useSimulatorStore';
+import {buildVlxPayload} from '../utils/vlxFile';
+
+const source={robot_code:{source:'print("generated")'},robot_code_group:'group-chip-U1'};
+const chip={id:'U1',metadataId:'custom-chip',x:0,y:0,properties:{}};
+describe('editable robot Python',()=>{
+ it('migrates old drafts only when the code is missing',()=>{
+  const draft={components:[chip],fileGroups:{'group-chip-U1':[{name:'chip.c',content:'visual'}]}};
+  const updated=ensureRobotCode(draft,source);
+  expect(updated.fileGroups['group-chip-U1']).toEqual([{name:'chip.c',content:'visual'},{name:'pi_rover.py',content:'print("generated")'}]);
+  const changed={...updated,fileGroups:{'group-chip-U1':[{name:'pi_rover.py',content:'print("my edit")'}]}};
+  expect(ensureRobotCode(changed,source)).toBe(changed);
+  expect(findRobotCode(changed.fileGroups)?.file.content).toBe('print("my edit")');
+ });
+ it('preserves edited Python in actual VLX snapshots and restores it',()=>{
+  useSimulatorStore.setState({boards:[],components:[chip],wires:[],activeBoardId:null} as never);
+  const editor=useEditorStore.getState();
+  editor.replaceFileGroups({'group-chip-U1':[{name:'pi_rover.py',content:'print("generated")'},{name:'chip.c',content:'visual'}]});
+  editor.setActiveGroup('group-chip-U1');
+  const file=findRobotCode(useEditorStore.getState().fileGroups)!.file;
+  useEditorStore.getState().openFile(file.id);
+  useEditorStore.getState().setFileContent(file.id,'print("my edit")');
+  const snapshot=buildVlxPayload();
+  expect(snapshot.fileGroups['group-chip-U1'][0].content).toBe('print("my edit")');
+  useEditorStore.getState().replaceFileGroups(snapshot.fileGroups);
+  expect(findRobotCode(useEditorStore.getState().fileGroups)?.file.content).toBe('print("my edit")');
+ });
+});
