+import {UnionFind} from '../spice/unionFind';
+import {breadboardGroupKey} from '../../utils/breadboardNets';
+export type FunctionalPart={id:string;metadataId:string;properties:Record<string,unknown>};
+export type FunctionalProject={components:FunctionalPart[];boards:Array<{id:string;boardKind:string}>;wires:Array<{id:string;start:{componentId:string;pinName:string};end:{componentId:string;pinName:string}}>;embeddedVision?:Record<string,unknown>};
+export function functionalNets(project:FunctionalProject){
+ const uf=new UnionFind(),types=new Map(project.components.map(p=>[p.id,p.metadataId]));
+ const key=(id:string,pin:string)=>{
+  const name=id+':'+pin,group=breadboardGroupKey(types.get(id)||'',pin);
+  if(group)uf.union(name,id+':strip:'+group);
+  if(project.boards.some(b=>b.id===id)&&/^GND(?:[._]?\d+)?$/i.test(pin))uf.union(name,id+':GND');
+  return name;
+ };
+ for(const w of project.wires)uf.union(key(w.start.componentId,w.start.pinName),key(w.end.componentId,w.end.pinName));
+ const connected=(a:string,b:string)=>uf.find(a)===uf.find(b);
+ const boardPin=(part:string,pin:string,series=false):number|null=>{
+  const roots=new Set([uf.find(part+':'+pin)]);
+  if(series)for(let i=0;i<4;i++)for(const p of project.components.filter(c=>c.metadataId==='resistor')){
+   const a=uf.find(p.id+':1'),b=uf.find(p.id+':2');if(roots.has(a)||roots.has(b)){roots.add(a);roots.add(b);}
+  }
+  const board=project.boards[0];if(!board)return null;
+  const matches=Array.from({length:20},(_,i)=>i).filter(i=>roots.has(uf.find(board.id+':'+(i<14?String(i):'A'+(i-14)))));
+  return matches.length===1?matches[0]:null;
+ };
+ return {connected,boardPin};
+}
+const INPUTS:Record<string,{key:string;min:number;max:number;step:number;label:string}>={
+ potentiometer:{key:'value',min:0,max:1023,step:1,label:'다이얼'},
+ 'soil-moisture-sen0193':{key:'value',min:0,max:614,step:1,label:'토양 건조도 · 0 젖음 / 614 건조'},
+ 'photoresistor-sensor':{key:'lux',min:0,max:1000,step:1,label:'밝기 (lux: 빛의 세기)'},
+ 'hc-sr04':{key:'distance',min:2,max:200,step:1,label:'거리 (cm)'},
+};
+export type FunctionalControl={id:string;key:string;kind:'range'|'button';min:number;max:number;step:number;value:number;label:string};
