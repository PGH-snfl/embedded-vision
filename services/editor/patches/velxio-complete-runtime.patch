+          "name": "sketch.ino",
+          "content": "const byte jointPins[4] = {2, 3, 4, 5};\nconst byte trigPin = 8, echoPin = 9;\nbool runGait = false;\nunsigned long nextMeasure = 0;\nunsigned long gaitStart = 0;\n\nvoid setup() {\n  for (byte i = 0; i < 4; ++i) {\n    pinMode(jointPins[i], OUTPUT);\n    digitalWrite(jointPins[i], LOW);\n  }\n  pinMode(trigPin, OUTPUT);\n  digitalWrite(trigPin, LOW);\n  pinMode(echoPin, INPUT);\n}\n\nvoid loop() {\n  const unsigned long frameStart = micros();\n  const unsigned long now = millis();\n  int angle[4] = {90, 90, 90, 90};\n\n  if (runGait) {\n    // 새 시험 기본값: 800ms 교대 주기, 작은 관절 진폭.\n    unsigned long phase = (now - gaitStart) % 800UL;\n    int wave = phase < 400UL\n      ? -100 + (int)(phase * 200UL / 400UL)\n      : 100 - (int)((phase - 400UL) * 200UL / 400UL);\n    angle[0] = 90 + wave * 8 / 100;\n    angle[1] = 90 - wave * 8 / 100;\n    angle[2] = 90 - wave * 6 / 100;\n    angle[3] = 90 + wave * 6 / 100;\n  }\n\n  // 각 채널에 1~2ms 펄스를 한 번씩 전송한다.\n  for (byte i = 0; i < 4; ++i) {\n    unsigned int width = 1000U + (unsigned long)angle[i] * 1000UL / 180UL;\n    digitalWrite(jointPins[i], HIGH);\n    delayMicroseconds(width);\n    digitalWrite(jointPins[i], LOW);\n  }\n\n  if ((long)(now - nextMeasure) >= 0) {\n    nextMeasure = now + 100UL;\n    digitalWrite(trigPin, LOW);\n    delayMicroseconds(2);\n    digitalWrite(trigPin, HIGH);\n    delayMicroseconds(10);\n    digitalWrite(trigPin, LOW);\n    unsigned long echo = pulseIn(echoPin, HIGH, 8000UL);\n    // 새 설계 기준: 20cm 이하 또는 무응답이면 정지.\n    bool allow = echo != 0UL && echo > 1160UL;\n    if (allow && !runGait) gaitStart = millis();\n    runGait = allow;\n  }\n\n  while ((unsigned long)(micros() - frameStart) < 20000UL) {\n    delayMicroseconds(20);\n  }\n}\n"
+        }
