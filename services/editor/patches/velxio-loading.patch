+import {routeAssembly} from './assemblyPlanner';
+type Routing=ReturnType<typeof routeAssembly>;
+/** Complete part state is intentional: even in-place geometry edits invalidate. */
+const keyFor=(parts:any[],wires:any[])=>JSON.stringify([parts,wires.map(w=>[w.id,w.start.componentId,w.start.pinName,w.end.componentId,w.end.pinName])]);
+export function createAssemblyRoutingCache(compute=routeAssembly){
+ const cache=new Map<string,Routing>();
+ const seed=(parts:any[],wires:any[],value:Routing)=>{const key=keyFor(parts,wires);cache.delete(key);cache.set(key,value);if(cache.size>2)cache.delete(cache.keys().next().value!);return value;};
+ return {seed,get(parts:any[],wires:any[]){const key=keyFor(parts,wires),saved=cache.get(key);return saved||seed(parts,wires,compute(parts,wires));}};
+}
+export const assemblyRoutingCache=createAssemblyRoutingCache();
