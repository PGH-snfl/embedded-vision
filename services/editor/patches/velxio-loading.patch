+/** Lowest cost first; equal scores keep the router's existing newest-first tie. */
+export class RouteQueue<T extends {f:number}>{
+ private heap:Array<{value:T;order:number}>=[];
+ private serial=0;
+ get length(){return this.heap.length;}
+ private earlier(a:{value:T;order:number},b:{value:T;order:number}){return a.value.f<b.value.f||(a.value.f===b.value.f&&a.order>b.order);}
+ push(value:T){
+  const entry={value,order:this.serial++},heap=this.heap;heap.push(entry);let i=heap.length-1;
+  while(i>0){const parent=(i-1)>>1;if(!this.earlier(entry,heap[parent]))break;heap[i]=heap[parent];i=parent;}heap[i]=entry;
+ }
+ pop():T|undefined{
+  const heap=this.heap;if(!heap.length)return;
+  const result=heap[0],tail=heap.pop()!;
+  if(heap.length){let i=0;
+   while(true){const left=i*2+1;if(left>=heap.length)break;const right=left+1,best=right<heap.length&&this.earlier(heap[right],heap[left])?right:left;
+    if(!this.earlier(heap[best],tail))break;heap[i]=heap[best];i=best;
+   }heap[i]=tail;
+  }return result.value;
+ }
+}
