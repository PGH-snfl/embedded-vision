+import {proposeAssembly,withAssembly,routeAssembly} from './assemblyPlanner';
+export type AssemblyTask={mode:'initial'|'optimize';project:any};
+export function computeAssembly(task:AssemblyTask){
+ const result=task.mode==='initial'?{project:withAssembly(task.project),changed:true}:proposeAssembly(task.project);
+ // Warm the first displayed routing result in the worker as well.
+ const project=result.project,parts=[...(project.components||[]),...(project.boards||[])];
+ const routing=parts.some(p=>p.properties?.evAssembly)?routeAssembly(parts,project.wires||[]):undefined;
+ return {...result,routing};
+}
