+import {needsAssembly} from './assemblyPlanner';
+import type {AssemblyTask,computeAssembly} from './assemblyTask';
+export type AssemblyResult=ReturnType<typeof computeAssembly>;
+export function requestAssembly(task:AssemblyTask,options:{signal?:AbortSignal;workerFactory?:()=>Worker;timeoutMs?:number}={}):Promise<AssemblyResult>{
+ if(options.signal?.aborted)return Promise.reject(new DOMException('취소되었습니다.','AbortError'));
+ if(task.mode==='initial'&&!needsAssembly(task.project))return Promise.resolve({project:task.project,changed:false,routing:undefined});
+ return new Promise((resolve,reject)=>{
+  let worker:Worker;
+  try{worker=options.workerFactory?options.workerFactory():new Worker(new URL('./assembly.worker.ts',import.meta.url),{type:'module'});}
+  catch{reject(new Error('배치 계산 작업을 시작하지 못했습니다. 브라우저의 Worker 지원을 확인하세요.'));return;}
+  const cleanup=()=>{clearTimeout(timer);options.signal?.removeEventListener('abort',abort);worker.terminate();};
