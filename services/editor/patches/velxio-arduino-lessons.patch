+
+const lesson={version:1,id:'blink',title:'LED 깜빡이기',summary:'켜고 끄기',goals:['출력 제어'],materials:[{ref:'U1',name:'아두이노 UNO',quantity:1}],jumper_count:2,code_notes:[{token:'delay(500)',meaning:'0.5초 기다림'}],run_steps:['시뮬레이션 실행'],checks:['LED가 깜빡입니다.'],challenge:'시간 바꾸기'};
+
+it('provides guide data after a short-ID project loads, without a project hash',()=>{
+ setMotionSource(undefined);const listener=vi.fn(),stop=subscribeMotionSource(listener);
+ expect(guideSteps('').steps).toEqual([]);
+ const source={learning_guide:lesson,assembly:{steps:[{from:'R1.1',to:'BB1.23t.b',kind:'insert'},{from:'R1.2',to:'BB1.29t.b',kind:'insert'},{from:'U1.5',to:'BB1.23t.a',kind:'jumper'}],note:'다리 함께'}};
+ setMotionSource(source);expect(listener).toHaveBeenCalledOnce();
+ const guide=guideFromSource(getMotionSource());expect(guide.steps).toHaveLength(2);expect(guide.steps[0].connections).toHaveLength(2);
+ expect(readLearningGuide(getMotionSource())?.id).toBe('blink');
+ stop();setMotionSource(undefined);expect(listener).toHaveBeenCalledOnce();
+ expect(readLearningGuide({learning_guide:{...lesson,materials:[null]}})).toBeNull();
+});
+
+it('shows preparation and user-operated outcome checks with code hidden in details',async()=>{
+ vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT',true);
+ const host=document.createElement('div');document.body.append(host);const root=createRoot(host),onStart=vi.fn();
