new file mode 100644
--- /dev/null
+++ b/frontend/src/components/circuitiny/LessonGuide.tsx
@@ -0,0 +1,34 @@
+import {useState} from 'react';
+
+export type LessonPhase='prepare'|'wiring'|'run';
+export type LearningGuide={id:string;title:string;summary:string;goals:string[];materials:{ref:string;name:string;quantity:number}[];jumper_count:number;code_notes:{token:string;meaning:string}[];run_steps:string[];checks:string[];challenge:string};
+export function readLearningGuide(source:unknown):LearningGuide|null {
+ const guide=(source as any)?.learning_guide;
+ const strings=(a:unknown)=>Array.isArray(a)&&a.every(x=>typeof x==='string');
+ if(!guide||guide.version!==1||!['id','title','summary','challenge'].every(k=>typeof guide[k]==='string')||!['goals','run_steps','checks'].every(k=>strings(guide[k]))||!Array.isArray(guide.materials)||!guide.materials.every((x:any)=>x&&typeof x.ref==='string'&&typeof x.name==='string'&&Number.isInteger(x.quantity)&&x.quantity>0)||!Array.isArray(guide.code_notes)||!guide.code_notes.every((x:any)=>x&&typeof x.token==='string'&&typeof x.meaning==='string')||!Number.isInteger(guide.jumper_count)||guide.jumper_count<0)return null;
+ return guide;
+}
+export function LessonTabs({phase,onChange}:{phase:LessonPhase;onChange:(phase:LessonPhase)=>void}) {
+ return <nav className="ev-lesson-tabs" aria-label="예제 따라 하기 순서">{([['prepare','① 준비물'],['wiring','② 배선'],['run','③ 실행 확인']] as const).map(([id,label])=><button key={id} aria-pressed={phase===id} onClick={()=>onChange(id)}>{label}</button>)}</nav>;
+}
+export function LessonPreparation({lesson,onStart}:{lesson:LearningGuide;onStart:()=>void}) {
+ return <section className="ev-lesson-body" aria-label="예제 준비물">
+  <h3>어떤 회로인가요?</h3><p>{lesson.summary}</p>
+  <h3>준비할 부품</h3><ul className="ev-lesson-materials">{lesson.materials.map(p=><li key={p.ref}><b>{p.ref}</b> {p.name} × {p.quantity}</li>)}<li>점퍼선 {lesson.jumper_count}개</li></ul>
+  <p>실물로 따라 만들 때는 UNO용 USB 케이블도 준비하세요. 화면에는 완성된 회로가 미리 배치되어 있습니다.</p>
+  <details><summary>이 예제에서 배우는 내용</summary><ul>{lesson.goals.map(goal=><li key={goal}>{goal}</li>)}</ul></details>
+  <button className="ev-lesson-next" onClick={onStart}>부품·배선 따라 연결하기 →</button>
+ </section>;
+}
+export function LessonRun({lesson,running}:{lesson:LearningGuide;running:boolean}) {
+ const [checked,setChecked]=useState<number[]>([]);
+ return <section className="ev-lesson-body" aria-label="예제 실행 확인">
+  <p className="ev-lesson-runtime" role="status">{running?'시뮬레이션 실행 중 · 아래 동작을 직접 확인하세요.':'상단 ‘시뮬레이션 실행’을 누르면 준비된 코드가 실행됩니다.'}</p>
+  <h3>실행 순서</h3><ol>{lesson.run_steps.map(step=><li key={step}>{step}</li>)}</ol>
+  <h3>내가 확인한 동작 {checked.length} / {lesson.checks.length}</h3><p>실제로 확인한 항목을 체크하세요. 자동 검사 결과가 아닙니다.</p>
+  <div className="ev-lesson-checks">{lesson.checks.map((text,index)=><label key={text}><input type="checkbox" checked={checked.includes(index)} onChange={()=>setChecked(prev=>prev.includes(index)?prev.filter(x=>x!==index):[...prev,index])}/><span>{text}</span></label>)}</div>
+  <details><summary>코드가 하는 일</summary>{lesson.code_notes.map(note=><p key={note.token}><code>{note.token}</code><br/>{note.meaning}</p>)}</details>
+  <details><summary>값을 바꿔 도전해 보기</summary><p>{lesson.challenge}</p></details>
+  <p>회로와 코드를 수정하기 전에는 실행을 정지하세요. 완성 후 상단 ‘프로젝트 저장’으로 보관할 수 있습니다.</p>
+ </section>;
+}
