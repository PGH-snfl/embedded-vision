+import {describe,expect,it} from 'vitest';
+import {translatedSimulationNotice} from '../components/translatedSimulationNotice';
+describe('translated circuit execution availability',()=>{
+ it('blocks the translated robot drawings and leaves normal photo and motion recipes unchanged',()=>{
+  expect(translatedSimulationNotice('translated_uno_motor_shield_rover')).toContain('시뮬레이션할 수 없습니다');
+  expect(translatedSimulationNotice('translated_pi_rover_c')).toContain('시뮬레이션할 수 없습니다');
+  expect(translatedSimulationNotice('arduino_distance_indicator')).toBeUndefined();
+  expect(translatedSimulationNotice('uno_obstacle_rover')).toBeUndefined();
