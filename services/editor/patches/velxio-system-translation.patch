+/** Converted rover boards expose their wiring, but custom chips are drawings. */
+export function translatedSimulationNotice(recipe: unknown): string | undefined {
+ if(recipe==='translated_uno_motor_shield_rover')return '이 회로의 모터 실드·모터·전원은 시각 전용입니다. 모터 주행과 코드 실행을 시뮬레이션할 수 없습니다. 회로와 코드는 편집할 수 있습니다.';
+ if(recipe==='translated_pi_rover_c')return '이 회로의 Raspberry Pi·모터 HAT·모터는 시각 전용입니다. C 코드와 모터 주행은 시뮬레이션할 수 없습니다. 회로와 코드는 편집할 수 있습니다.';
+ return undefined;
+}
