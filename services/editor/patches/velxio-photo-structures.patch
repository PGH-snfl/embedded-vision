diff --git a/frontend/src/components/circuitiny/photoStructures.ts b/frontend/src/components/circuitiny/photoStructures.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/circuitiny/photoStructures.ts
@@ -0,0 +1,9 @@
+/** Add source photo objects once; preserve edits and intentional deletions in drafts. */
+export function withPhotoStructures(project:any,original:any){
+ const version=original.embeddedVision?.photo_structure_version;
+ if(typeof version!=='string'||!/^[a-f0-9]{64}$/.test(version)||project.embeddedVision?.photo_structure_version===version)return project;
+ const additions=(original.components||[]).filter((p:any)=>p.metadataId==='ev-structure'&&p.properties?.evPhotoStructure);
+ const ids=new Set((project.components||[]).map((p:any)=>p.id));
+ return {...project,components:[...(project.components||[]),...additions.filter((p:any)=>!ids.has(p.id))],
+  embeddedVision:{...project.embeddedVision,photo_structure_version:version}};
+}
diff --git a/frontend/src/__tests__/photo-structures.test.ts b/frontend/src/__tests__/photo-structures.test.ts
new file mode 100644
