+++ b/frontend/src/__tests__/photo-structures.test.ts
@@ -0,0 +1,21 @@
+import {describe,it,expect} from 'vitest';
+import {withPhotoStructures} from '../components/circuitiny/photoStructures';
+import {structureParameters} from '../components/circuitiny/structureObjects';
+
+describe('photo structure drafts',()=>{
+ it('adds initial photo objects without replacing wires, code or edited geometry',()=>{
+  const wire=[{id:'C1'}],files={code:'edited'},existing={id:'photo-wheel-test',metadataId:'ev-structure',properties:{width:99}};
+  const original={embeddedVision:{photo_structure_version:'a'.repeat(64)},components:[{...existing,properties:{evPhotoStructure:{},width:22}},{id:'photo-frame-new',metadataId:'ev-structure',properties:{evPhotoStructure:{}}}]};
+  const draft={components:[existing],wires:wire,fileGroups:files,embeddedVision:{}};
+  const upgraded=withPhotoStructures(draft,original);
+  expect(upgraded.components[0]).toBe(existing);expect(upgraded.components).toHaveLength(2);
+  expect(upgraded.wires).toBe(wire);expect(upgraded.fileGroups).toBe(files);
+  const deleted={...upgraded,components:[]};
+  expect(withPhotoStructures(deleted,original)).toBe(deleted);
+ });
+ it('keeps legacy structures upright and supports tilted photo wheels',()=>{
+  expect(structureParameters({})).toMatchObject({rotationX:0,rotationZ:0,elevation:0});
+  expect(structureParameters({rotationX:90,rotationZ:-30,elevation:-2})).toMatchObject({rotationX:90,rotationZ:-30,elevation:-2});
+  expect(structureParameters({rotationX:Infinity})).toMatchObject({rotationX:0});
+ });
+});
