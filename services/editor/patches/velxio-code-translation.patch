diff --git a/frontend/src/components/embeddedTranslationBridge.ts b/frontend/src/components/embeddedTranslationBridge.ts
new file mode 100644
index 0000000..583d61c
--- /dev/null
+++ b/frontend/src/components/embeddedTranslationBridge.ts
@@ -0,0 +1,27 @@
+export type TranslationTarget = 'raspberry_pi_c' | 'arduino_cpp';
+export type TranslationResult = {code:string;filename:string;notice:string;details:string[]};
+
+/** Only the analysis page that embedded this editor receives code or replies. */
+export function translationContext(search:string,referrer:string,source:Record<string,unknown>|undefined,isFramed:boolean){
+ try {
+  const query=new URLSearchParams(search),channel=query.get('channel')||'',origin=source?.analysis_origin;
+  if(query.get('embedded')!=='1'||query.get('motion')!=='1'||!isFramed||!/^[a-f0-9]{32,128}$/i.test(channel)||typeof origin!=='string')return undefined;
+  const url=new URL(origin);
+  if(!['http:','https:'].includes(url.protocol)||url.origin!==origin||url.username||url.password||new URL(referrer).origin!==origin)return undefined;
+  return {channel,origin};
+ }catch{return undefined;}
+}
+
+export function acceptedTranslationResult(event:{origin:string;source:unknown;data:any},parent:unknown,ctx:{channel:string;origin:string},requestId:string):{result?:TranslationResult;error?:string}|undefined{
+ const data=event.data;
+ if(event.source!==parent||event.origin!==ctx.origin||data?.type!=='ev:translate-result'||data?.channel!==ctx.channel||data?.requestId!==requestId)return undefined;
+ if(typeof data.error==='string'&&data.error.length<=2000)return {error:data.error};
+ const r=data.result;
+ if(!r||typeof r.code!=='string'||r.code.length>100000||typeof r.filename!=='string'||r.filename.length>200||typeof r.notice!=='string'||r.notice.length>3000||!Array.isArray(r.details)||r.details.length>30||r.details.some((x:unknown)=>typeof x!=='string'||x.length>2000))return {error:'번역 결과 형식이 올바르지 않습니다.'};
+ return {result:{code:r.code,filename:r.filename,notice:r.notice,details:r.details}};
+}
+
+export function makeTranslationRequest(ctx:{channel:string},requestId:string,source:string,target:TranslationTarget){
+ if(!/^[a-f0-9]{32,128}$/i.test(requestId)||!source||source.length>50000||!['raspberry_pi_c','arduino_cpp'].includes(target))throw new Error('번역할 코드와 대상 보드를 확인하세요.');
+ return {type:'ev:translate-request',channel:ctx.channel,requestId,source,target};
+}
