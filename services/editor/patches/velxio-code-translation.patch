+// @vitest-environment jsdom
+import {act,createElement} from 'react';
+import {createRoot} from 'react-dom/client';
+import {afterEach,describe,expect,it,vi} from 'vitest';
+import {EmbeddedCodeTranslation} from '../components/EmbeddedCodeTranslation';
+import {setMotionSource} from '../components/embeddedMotionBridge';
+
+(globalThis as {IS_REACT_ACT_ENVIRONMENT?:boolean}).IS_REACT_ACT_ENVIRONMENT=true;
+const channel='a'.repeat(48),origin='http://127.0.0.1:8897';
+const parent={postMessage:vi.fn()}, originalParent=Object.getOwnPropertyDescriptor(window,'parent');
+const originalReferrer=Object.getOwnPropertyDescriptor(document,'referrer');
+const host=document.createElement('div');document.body.appendChild(host);const root=createRoot(host);
+history.replaceState(null,'',`/?embedded=1&motion=1&channel=${channel}`);
+Object.defineProperty(window,'parent',{configurable:true,value:parent});
+Object.defineProperty(document,'referrer',{configurable:true,value:origin+'/'});
+setMotionSource({analysis_origin:origin});
+afterEach(()=>{act(()=>root.unmount());host.remove();if(originalParent)Object.defineProperty(window,'parent',originalParent);if(originalReferrer)Object.defineProperty(document,'referrer',originalReferrer);setMotionSource(undefined);});
+
+describe('code translation UI',()=>{
+ it('rejects stale results after source edits and keeps translated code separate',async()=>{
+  await act(async()=>root.render(createElement(EmbeddedCodeTranslation,{source:'original Python'})));
+  const button=[...host.querySelectorAll('button')].find(b=>b.textContent==='코드 번역')!;
+  act(()=>button.click());
+  const request=parent.postMessage.mock.calls[0][0];
+  expect(request.source).toBe('original Python');
+  await act(async()=>root.render(createElement(EmbeddedCodeTranslation,{source:'edited Python'})));
+  const result={type:'ev:translate-result',channel,requestId:request.requestId,result:{filename:'test.c',code:'int main(){}',notice:'확인 필요',details:[]}};
+  act(()=>window.dispatchEvent(new MessageEvent('message',{origin,source:parent as unknown as Window,data:result})));
+  expect(host.querySelector('textarea')).toBeNull();
+  expect(host.textContent).toContain('다시 번역');
+  act(()=>button.click());
+  const second=parent.postMessage.mock.calls[1][0];
+  expect(second.source).toBe('edited Python');
+  act(()=>window.dispatchEvent(new MessageEvent('message',{origin,source:parent as unknown as Window,data:{...result,requestId:second.requestId}})));
+  expect(host.querySelector('textarea')?.value).toBe('int main(){}');
+ });
+});
diff --git a/frontend/src/__tests__/embedded-translation-bridge.test.ts b/frontend/src/__tests__/embedded-translation-bridge.test.ts
