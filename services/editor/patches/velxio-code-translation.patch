@@ -0,0 +1,30 @@
+import {describe,it,expect} from 'vitest';
+import {acceptedTranslationResult,makeTranslationRequest,translationContext} from '../components/embeddedTranslationBridge';
+
+const channel='a'.repeat(48),id='b'.repeat(48),origin='http://localhost:8898';
+const query=`?embedded=1&motion=1&channel=${channel}`;
+const source={analysis_origin:origin},ctx={origin,channel};
+const result={code:'int main(){}',filename:'robot.c',notice:'미검증',details:['하드웨어 확인']};
+const message={type:'ev:translate-result',channel,requestId:id,result};
+describe('embedded translation bridge',()=>{
+ it('requires the exact parent, referrer and a strong channel',()=>{
+  expect(translationContext(query,origin+'/',source,true)).toEqual(ctx);
+  expect(translationContext(query,'https://other.example/',source,true)).toBeUndefined();
+  expect(translationContext('?embedded=1&motion=1&channel=bad',origin,source,true)).toBeUndefined();
+  expect(translationContext(query,origin,source,false)).toBeUndefined();
+ });
+ it('sends the actual bounded source with a specific target',()=>{
+  expect(makeTranslationRequest(ctx,id,'my code','raspberry_pi_c')).toEqual({type:'ev:translate-request',channel,requestId:id,source:'my code',target:'raspberry_pi_c'});
+  expect(()=>makeTranslationRequest(ctx,id,'x'.repeat(50001),'arduino_cpp')).toThrow();
+  expect(()=>makeTranslationRequest(ctx,'bad','x','arduino_cpp')).toThrow();
+ });
+ it('ignores other origins, frames, requests and channels',()=>{
+  const parent={};
+  expect(acceptedTranslationResult({origin,source:parent,data:message},parent,ctx,id)).toEqual({result});
+  expect(acceptedTranslationResult({origin:'https://other.example',source:parent,data:message},parent,ctx,id)).toBeUndefined();
+  expect(acceptedTranslationResult({origin,source:{},data:message},parent,ctx,id)).toBeUndefined();
+  expect(acceptedTranslationResult({origin,source:parent,data:{...message,requestId:'c'.repeat(48)}},parent,ctx,id)).toBeUndefined();
+  expect(acceptedTranslationResult({origin,source:parent,data:{...message,channel:'c'.repeat(48)}},parent,ctx,id)).toBeUndefined();
+  expect(acceptedTranslationResult({origin,source:parent,data:{...message,result:{code:'x'}}},parent,ctx,id)?.error).toBeTruthy();
+ });
+});
diff --git a/frontend/src/components/EmbeddedCodeTranslation.tsx b/frontend/src/components/EmbeddedCodeTranslation.tsx
new file mode 100644
index 0000000..1ad7781
--- /dev/null
