@@ -0,0 +1,57 @@
+import {useEffect,useRef,useState} from 'react';
+import {getMotionSource} from './embeddedMotionBridge';
+import {acceptedTranslationResult,makeTranslationRequest,translationContext,type TranslationResult,type TranslationTarget} from './embeddedTranslationBridge';
+
+type Pending={id:string;source:string;target:TranslationTarget;timer:ReturnType<typeof setTimeout>};
+export function EmbeddedCodeTranslation({source}:{source:string|undefined}){
+ const [target,setTarget]=useState<TranslationTarget>('raspberry_pi_c');
+ const [result,setResult]=useState<{value:TranslationResult;source:string;target:TranslationTarget}|null>(null);
+ const [busy,setBusy]=useState(false),[message,setMessage]=useState('');
+ const pending=useRef<Pending|null>(null),latestSource=useRef(source),latestTarget=useRef(target);
+ latestSource.current=source;latestTarget.current=target;
+ useEffect(()=>{
+  const receive=(event:MessageEvent)=>{
+   const job=pending.current,ctx=translationContext(location.search,document.referrer,getMotionSource(),window.parent!==window);
+   if(!job||!ctx)return;
+   const response=acceptedTranslationResult(event,window.parent,ctx,job.id);
+   if(!response)return;
+   clearTimeout(job.timer);pending.current=null;setBusy(false);
+   if(job.source!==latestSource.current||job.target!==latestTarget.current){setMessage('원본 코드 또는 대상이 바뀌어 결과를 표시하지 않았습니다. 다시 번역하세요.');return;}
+   if(response.error){setMessage(response.error);return;}
+   if(response.result){setResult({value:response.result,source:job.source,target:job.target});setMessage('번역 결과를 확인하세요.');}
+  };
+  window.addEventListener('message',receive);
+  return()=>{window.removeEventListener('message',receive);if(pending.current)clearTimeout(pending.current.timer);pending.current=null;};
+ },[]);
+ useEffect(()=>{
+  if(pending.current&&(pending.current.source!==source||pending.current.target!==target)){
+   clearTimeout(pending.current.timer);pending.current=null;setBusy(false);setMessage('원본 코드 또는 대상이 바뀌었습니다. 다시 번역하세요.');
+  }
+  setResult(old=>old&&(old.source!==source||old.target!==target)?null:old);
+ },[source,target]);
+ const translate=()=>{
+  try{
+   if(pending.current)return;
+   const ctx=translationContext(location.search,document.referrer,getMotionSource(),window.parent!==window);
+   if(!ctx)throw new Error('사진 분석 화면과의 연결을 확인하세요.');
+   const bytes=new Uint8Array(24);crypto.getRandomValues(bytes);
+   const id=Array.from(bytes,b=>b.toString(16).padStart(2,'0')).join('');
+   const text=source||'',message=makeTranslationRequest(ctx,id,text,target);
+   setResult(null);setBusy(true);setMessage('현재 코드를 분석하고 있습니다…');
+   const timer=setTimeout(()=>{if(pending.current?.id===id){pending.current=null;setBusy(false);setMessage('번역 요청 시간이 초과되었습니다. 다시 시도하세요.');}},30000);
+   pending.current={id,source:text,target,timer};
+   window.parent.postMessage(message,ctx.origin);
+  }catch(e){if(pending.current)clearTimeout(pending.current.timer);pending.current=null;setBusy(false);setMessage(e instanceof Error?e.message:'번역을 요청할 수 없습니다.');}
+ };
+ const copy=async()=>{
+  if(!result||result.source!==latestSource.current||result.target!==latestTarget.current)return;
+  try{await navigator.clipboard.writeText(result.value.code);setMessage('번역 코드를 복사했습니다.');}
+  catch{setMessage('자동 복사를 사용할 수 없습니다. 결과를 선택하고 Ctrl+C를 누르세요.');}
+ };
+ return <details className="ev-code-translation"><summary>다른 보드·언어로 코드 번역</summary>
+  <p>현재 2륜 로봇 예제에서 주석·서식과 명령별 모터 출력값 변경을 지원합니다. 다른 동작 변경은 자동 번역하지 않습니다. 원본 코드는 바뀌지 않습니다.</p>
+  <div className="ev-robot-code-row"><label>대상 <select value={target} onChange={e=>setTarget(e.target.value as TranslationTarget)}><option value="raspberry_pi_c">Raspberry Pi · C</option><option value="arduino_cpp">Arduino · C++</option></select></label><button type="button" onClick={translate} disabled={busy||!source}>{busy?'번역 중…':'코드 번역'}</button></div>
+  {result&&result.source===source&&result.target===target&&<div><p><strong>{result.value.filename}</strong> · {result.value.notice}</p>{target==='arduino_cpp'&&<p>Arduino Uno와 별도의 Motor Shield V2, 새로운 전원·배선이 필요합니다.</p>}<button type="button" onClick={()=>void copy()}>번역 코드 복사</button><textarea aria-label="번역된 코드" readOnly value={result.value.code}/><details><summary>부품·배선과 실행 방법 자세히</summary>{result.value.details.map((item,i)=><p key={i}>{item}</p>)}</details></div>}
+  <span role="status">{message}</span>
+ </details>;
+}
