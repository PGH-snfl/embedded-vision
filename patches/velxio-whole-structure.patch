+import type {V} from './assemblyMath';
+export type MechanicalPrimitive={shape:'box'|'cylinder'|'sphere'|'torus';size?:V;radius?:number;tube?:number;segments?:number;position:V;rotation?:V;scale?:V;color?:string;metal?:number};
+/** Unit-space details are shared by the editor and the motion renderer. */
+export function mechanicalDetails(id:string,role:string):MechanicalPrimitive[]|undefined{
+ if(role==='wheel'){
+  const pieces:MechanicalPrimitive[]=[{shape:'torus',radius:.41,tube:.09,position:[0,0,0],rotation:[Math.PI/2,0,0],scale:[1,1,1/.18]},
+   {shape:'torus',radius:.305,tube:.025,position:[0,0,0],rotation:[Math.PI/2,0,0],scale:[1,1,16],color:'#343c40'},
+   {shape:'cylinder',radius:.12,size:[0,.9,0],position:[0,0,0],color:'#454d51'}];
+  for(let i=0;i<5;i++){const a=i*Math.PI*2/5;pieces.push({shape:'box',size:[.36,.74,.055],position:[.22*Math.cos(a),0,.22*Math.sin(a)],rotation:[0,-a,0],color:'#343c40'});}
+  for(const sign of [-1,1]){
+   pieces.push({shape:'cylinder',radius:.085,size:[0,.02,0],position:[0,sign*.46,0],color:'#aab4b9',metal:.65});
+   pieces.push({shape:'cylinder',radius:.037,size:[0,.03,0],position:[0,sign*.485,0],segments:6,color:'#c5ced1',metal:.75});
+  }
+  for(let i=0;i<28;i++){const a=i*Math.PI*2/28;pieces.push({shape:'box',size:[.018,.86,.045],position:[.486*Math.cos(a),0,.486*Math.sin(a)],rotation:[0,-a,0],color:'#303337'});}
+  return pieces;
+ }
+ if(role==='support')return [
+  {shape:'cylinder',radius:.43,size:[0,.86,0],segments:6,position:[0,0,0],metal:.5},
+  ...[-1,1].flatMap(sign=>([{shape:'cylinder',radius:.5,size:[0,.06,0],position:[0,sign*.45,0],metal:.65},
+   {shape:'cylinder',radius:.18,size:[0,.03,0],position:[0,sign*.485,0],color:'#485157',metal:.55}] as MechanicalPrimitive[]))];
+ if(id.startsWith('design-mount-motor-'))return [
+  {shape:'box',size:[1,.18,1],position:[0,-.41,0],metal:.65},
+  ...[-1,1].map(sign=>({shape:'box',size:[.12,.82,1],position:[sign*.44,.09,0],metal:.65} as MechanicalPrimitive)),
+  ...[-1,1].flatMap(x=>[-1,1].map(z=>({shape:'cylinder',radius:.055,size:[0,.05,0],position:[x*.44,.475,z*.28],segments:6,color:'#c2cbd0',metal:.75} as MechanicalPrimitive)))];
+ if(id==='design-caster-socket')return [{shape:'torus',radius:.4,tube:.1,position:[0,0,0],rotation:[Math.PI/2,0,0],scale:[1,1,5],metal:.7}];
+ return undefined;
+}
