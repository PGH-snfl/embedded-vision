+import {completeMechanicalScene,COMPLETION_VERSION,type MechanicalNode} from './mechanicalCompletion';
+import {structures,MM_PER_PX} from './assemblyGeometry';
+export function withMechanicalCompletion(project:any){
+ const source=project.embeddedVision||{};
+ if(!['raspberry_pi_2wd_robot','translated_pi_rover_c','translated_uno_motor_shield_rover','uno_obstacle_rover'].includes(source.recipe))return project;
+ if(source.structure_completion?.version===COMPLETION_VERSION)return project;
+ const current=structures(project.components||[]);
+ const nodes:MechanicalNode[]=current.map(o=>({id:o.part.id,label:o.part.properties.label||o.part.id,role:o.role,shape:o.part.properties.shape||'box',position:o.pose.position,size:o.size,rotation:o.pose.rotation,color:o.part.properties.color||'#aab3b7',designed:!!o.part.properties.evDesignedStructure}));
+ const additions=completeMechanicalScene(nodes,'two_wheel_rover');
+ if(!additions.length)return project;
+ const origin=current.find(o=>Array.isArray(o.part.properties.photoSceneOrigin))?.part.properties.photoSceneOrigin||[0,0];
+ const parts=additions.map(n=>({id:n.id,metadataId:'ev-structure',x:(n.position[0]-n.size[0]/2)/MM_PER_PX-6,y:(n.position[2]-n.size[2]/2)/MM_PER_PX-6,
+  properties:{shape:n.shape,label:n.label,width:n.size[0],height:n.size[1],depth:n.size[2],elevation:n.position[1]-n.size[1]/2,
+   rotationX:n.rotation[0]*180/Math.PI,rotation:-n.rotation[1]*180/Math.PI,rotationZ:n.rotation[2]*180/Math.PI,color:n.color,photoSceneOrigin:origin,dimensionsStatus:'UNKNOWN',displayScaleMm:220,
+   evDesignedStructure:{version:COMPLETION_VERSION,role:n.role,status:'INFERRED',source_kind:'DESIGN_COMPLETION',confidence:'low',method:n.method,sourceObjectIds:n.sourceIds,reason:n.reason}}}));
+ return {...project,components:[...project.components,...parts],embeddedVision:{...source,structure_completion:{version:COMPLETION_VERSION,generatedIds:parts.map(p=>p.id),status:'INFERRED',notice:'보이지 않는 부분은 전체 조립을 위한 설계 보완입니다. 실제 원본 형상과 치수는 미확인입니다.'}}};
+}
