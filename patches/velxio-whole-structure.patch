+import {mechanicalDetails,type MechanicalPrimitive} from './mechanicalDetails';
+export function MechanicalShape({id,role,shape,color,ghost,selected}:{id:string;role:string;shape:string;color:string;ghost:boolean;selected:boolean}){
+ const pieces=mechanicalDetails(id,role)||[{shape,size:[1,1,1],position:[0,0,0]} as MechanicalPrimitive];
+ return <>{pieces.map((p,i)=><mesh key={i} position={p.position} rotation={p.rotation} scale={p.scale} castShadow={!ghost} receiveShadow raycast={ghost?()=>{}:undefined}>
+  {p.shape==='sphere'?<sphereGeometry args={[.5,28,20]}/>:p.shape==='torus'?<torusGeometry args={[p.radius!,p.tube!,12,56]}/>:p.shape==='cylinder'?<cylinderGeometry args={[p.radius??.5,p.radius??.5,p.size?.[1]??1,p.segments??40]}/>:<boxGeometry args={p.size||[1,1,1]}/>}
+  <meshStandardMaterial color={p.color||color} metalness={p.metal??.12} roughness={.65} transparent={ghost} opacity={ghost?.18:1} depthWrite={!ghost} emissive={selected?'#9bd1ff':'#000000'} emissiveIntensity={selected?.3:0}/>
+ </mesh>)}</>;
+}
