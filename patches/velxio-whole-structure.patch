+import {rotate,inverseRotate,type V} from './assemblyMath';
+export const COMPLETION_VERSION='whole-structure-v1';
+export type MechanicalNode={id:string;label:string;role:string;shape:'box'|'cylinder'|'sphere';position:V;size:V;rotation:V;color:string;designed?:boolean};
+export type CompletedNode=MechanicalNode&{reason:string;sourceIds:string[];method:'symmetry'|'functional_design'};
+const add=(a:V,b:V)=>a.map((n,i)=>n+b[i]) as V;
+const sub=(a:V,b:V)=>a.map((n,i)=>n-b[i]) as V;
+const distance=(a:V,b:V)=>Math.hypot(...sub(a,b));
+const safe=(n:number)=>Math.max(2,Math.min(500,n));
+export function completeMechanicalScene(nodes:MechanicalNode[],family:string):CompletedNode[]{
+ if(family!=='two_wheel_rover')return [];
+ const base=nodes.find(n=>n.role==='chassis');if(!base)return [];
+ const completed:CompletedNode[]=[],all=[...nodes],ids=new Set(nodes.map(n=>n.id));
+ const local=(p:V)=>inverseRotate(sub(p,base.position),base.rotation),world=(p:V)=>add(base.position,rotate(p,base.rotation));
+ const put=(item:CompletedNode)=>{
+  if(ids.has(item.id)||all.length>=50||[...item.position,...item.size,...item.rotation].some(n=>!Number.isFinite(n))||item.size.some(n=>n<2||n>500))return;
+  ids.add(item.id);all.push(item);completed.push(item);
+ };
+ let wheels=all.filter(n=>n.role==='wheel');
+ if(wheels.length===1){
+  const wheel=wheels[0],p=local(wheel.position);
+  if(Math.abs(p[2])>base.size[2]*.25)put({...wheel,id:'design-wheel-opposite',label:'반대쪽 구동 바퀴',position:world([p[0],p[1],-p[2]]),designed:true,
+   sourceIds:[base.id,wheel.id],method:'symmetry',reason:'선택한 2륜 구동 설계에 맞춰 보이는 바퀴를 반대편에 대칭 배치한 설계입니다.'});
+ }
+ if(!wheels.length){
+  const diameter=safe(base.size[0]*.42),thickness=safe(diameter*.18),y=diameter/2-base.position[1];
+  for(const side of [-1,1])put({id:'design-wheel-'+(side<0?'left':'right'),label:side<0?'왼쪽 구동 바퀴':'오른쪽 구동 바퀴',role:'wheel',shape:'cylinder',
+   position:world([-base.size[0]*.285,y,side*(base.size[2]/2+thickness/2+5)]),size:[diameter,thickness,diameter],rotation:[Math.PI/2,0,0],color:'#242424',designed:true,
+   sourceIds:[base.id],method:'functional_design',reason:'2륜 구동 기능에 필요한 바퀴를 새 설계 치수로 제안했습니다. 사진에서 확인한 부품이 아닙니다.'});
+ }
+ wheels=all.filter(n=>n.role==='wheel');
+ const platform=all.find(n=>n.role==='platform');
+ if(platform){
