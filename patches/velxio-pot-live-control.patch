+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest';
+import { PartSimulationRegistry } from '../simulation/parts/PartSimulationRegistry';
+import { dispatchSensorUpdate, getSensorUpdate } from '../simulation/SensorUpdateRegistry';
+import { getSensorControlForComponent } from '../simulation/sensorControlConfig';
+import '../simulation/parts/ComplexParts';
+
+describe('live potentiometer input for 3D control', () => {
+  it('delivers changes to the wired ADC and the electrical solver state', () => {
+    const element=document.createElement('div') as HTMLElement & {value:number};
+    element.value=512;
+    const adc={channelValues:[0]};
+    const sim={getADC:()=>adc};
+    const events: Array<{componentId:string;propName:string;value:unknown}> = [];
+    const onProp=(e:Event)=>events.push((e as CustomEvent).detail);
+    window.addEventListener('velxio:property-change',onProp);
+    const detach=PartSimulationRegistry.get('potentiometer')!.attachEvents!(element,sim as never,
+      (pin:string)=>pin==='SIG'?14:null,'S1');
+    expect(getSensorControlForComponent({id:'S1',metadataId:'potentiometer',properties:{value:512}} as never)?.controls[0].key).toBe('value');
+    expect(adc.channelValues[0]).toBeCloseTo(512/1023*5,6);
+    dispatchSensorUpdate('S1',{value:900});
+    expect(element.value).toBe(900);
+    expect(adc.channelValues[0]).toBeCloseTo(900/1023*5,6);
+    expect(events.at(-1)).toEqual({componentId:'S1',propName:'value',value:900});
+    dispatchSensorUpdate('S1',{value:100});
+    expect(adc.channelValues[0]).toBeCloseTo(100/1023*5,6);
+    detach?.();
+    expect(getSensorUpdate('S1')).toBeUndefined();
+    window.removeEventListener('velxio:property-change',onProp);
+  });
+});
