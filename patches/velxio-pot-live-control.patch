+// @vitest-environment jsdom
+import { expect, it, vi } from 'vitest';
+import { nativeSurfaceEvent, releaseNativeSurfaces } from '../components/circuitiny/nativeInteraction';
+
+it('releases once even when the synthetic pointerup reaches the window handler', () => {
+  const element=document.createElement('div'); element.id='test-native';
+  const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
+  element.appendChild(svg); document.body.appendChild(element);
+  const up=vi.fn(); svg.addEventListener('pointerup',up);
+  window.addEventListener('pointerup',releaseNativeSurfaces);
+  try {
+    nativeSurfaceEvent('test-native','down',{x:.5,y:.5});
+    nativeSurfaceEvent('test-native','up',{x:.5,y:.5});
+    expect(up).toHaveBeenCalledTimes(1);
+    nativeSurfaceEvent('test-native','down',{x:.5,y:.5});
+    releaseNativeSurfaces();
+    expect(up).toHaveBeenCalledTimes(2);
+  } finally {
+    window.removeEventListener('pointerup',releaseNativeSurfaces);
+    releaseNativeSurfaces(); element.remove();
+  }
+});
