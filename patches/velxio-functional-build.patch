+import {describe,it,expect,vi} from 'vitest';
+import {AVRSimulator} from '../simulation/AVRSimulator';
+import {PinManager} from '../simulation/PinManager';
+import {buildNetlist} from '../simulation/spice/NetlistBuilder';
+import {runNetlist} from './helpers/testSolver';
+import {importVlxFile,buildVlxPayload} from '../utils/vlxFile';
+import {useSimulatorStore} from '../store/useSimulatorStore';
+import {registerProject} from '../components/circuitiny/bridge';
+import {mountedPose,structures,contains,unoModel,bounds} from '../components/circuitiny/assemblyGeometry';
+import dimmer from './fixtures/functional-dimmer.json';
+import servo from './fixtures/functional-servo.json';
+import liveWatering from './fixtures/functional-watering-live.json';
+import {waterBinding} from '../components/circuitiny/environmentObjects';
+import {readPumpCircuit} from '../components/circuitiny/pumpCircuit';
+import {advanceWater,initialWaterState,soilAdc} from '../components/circuitiny/wateringModel';
+vi.stubGlobal('requestAnimationFrame',()=>1);vi.stubGlobal('cancelAnimationFrame',()=>{});
