+          "name": "sketch.ino",
+          "content": "const byte SENSOR_PIN = A0;\nconst byte STOP_PIN = 2;\nconst byte PUMP_PIN = 9;\nconst byte LED_PIN = 8;\n// 새 시제품 가정값이며 원본 임계값이 아님.\nconst int DRY_ON = 450;\nconst int WET_OFF = 350;\nbool watering = false;\nunsigned long lastSample = 0;\nunsigned long lastReport = 0;\nint moistureRaw = 0;\n\nvoid applyOutput(bool on) {\n  digitalWrite(PUMP_PIN, on ? HIGH : LOW);\n  digitalWrite(LED_PIN, on ? HIGH : LOW);\n}\n\nvoid setup() {\n  digitalWrite(PUMP_PIN, LOW);\n  pinMode(PUMP_PIN, OUTPUT);\n  digitalWrite(LED_PIN, LOW);\n  pinMode(LED_PIN, OUTPUT);\n  pinMode(STOP_PIN, INPUT_PULLUP);\n  pinMode(SENSOR_PIN, INPUT);\n  Serial.begin(9600);\n  moistureRaw = analogRead(SENSOR_PIN);\n  applyOutput(false);\n}\n\nvoid loop() {\n  const unsigned long now = millis();\n  const bool inhibited = digitalRead(STOP_PIN) == LOW;\n  if (inhibited) {\n    watering = false;\n    applyOutput(false);\n  }\n  // 100ms는 새 시제품의 샘플링 간격임.\n  if (now - lastSample >= 100UL) {\n    lastSample = now;\n    moistureRaw = analogRead(SENSOR_PIN);\n    if (!inhibited) {\n      if (moistureRaw >= DRY_ON) watering = true;\n      else if (moistureRaw <= WET_OFF) watering = false;\n    }\n    applyOutput(watering && !inhibited);\n  }\n  if (now - lastReport >= 500UL) {\n    lastReport = now;\n    Serial.print(\"soil_raw=\");\n    Serial.print(moistureRaw);\n    Serial.print(\" pump=\");\n    Serial.print(watering && !inhibited ? 1 : 0);\n    Serial.print(\" inhibited=\");\n    Serial.println(inhibited ? 1 : 0);\n  }\n}\n"
