+async function voltage(fixture:typeof dimmer,value:number){
+ const components=fixture.project.components.map(c=>c.id==='S1'?{...c,properties:{...c.properties,value}}:c);
+ const input={components,wires:fixture.project.wires,boards:[{id:'U1',boardKind:'arduino-uno',vcc:5,pins:{},groundPinNames:['GND'],vccPinNames:['5V']}],analysis:{kind:'op'}} as Parameters<typeof buildNetlist>[0];
+ const {netlist,pinNetMap}=buildNetlist(input),result=await runNetlist(netlist);
+ return result.dcValue(`v(${pinNetMap.get('U1:A0')})`);
+}
+function steps(sim:AVRSimulator,count=400000){for(let i=0;i<count;i++)sim.step();}
+describe('completed implementation circuits execute their chosen function',()=>{
+ it('uses the actual potentiometer circuit voltage to control MCU PWM duty',async()=>{
+  const pm=new PinManager(),sim=new AVRSimulator(pm,'uno');sim.loadHex(dimmer.hex);
+  const ratios:number[]=[];
+  for(const value of [0,512,1023]){
+   const v=await voltage(dimmer,value);sim.getADC()!.channelValues[0]=v;steps(sim);
+   let high=0,total=0;
+   for(let i=0;i<300000;i++){const start=sim.getCurrentCycles();sim.step();const dt=sim.getCurrentCycles()-start;total+=dt;if(pm.getPinState(5))high+=dt;}
+   ratios.push(high/total);
+  }
+  expect(ratios[0]).toBeLessThan(.01);expect(ratios[1]).toBeGreaterThan(.45);expect(ratios[1]).toBeLessThan(.55);expect(ratios[2]).toBeGreaterThan(.99);
+ });
+ it('executes the selected servo code and changes its real output pulse width',()=>{
+  const pm=new PinManager(),sim=new AVRSimulator(pm,'uno');sim.loadHex(servo.hex);
+  const pulseLengths:number[]=[];let start=0;
+  pm.onPinChange(9,(_pin,on)=>{if(on)start=sim.getCurrentCycles();else if(start)pulseLengths.push((sim.getCurrentCycles()-start)/16);});
+  sim.getADC()!.channelValues[0]=0;steps(sim,1000000);const low=pulseLengths.slice(-3);
+  pulseLengths.length=0;sim.getADC()!.channelValues[0]=5;steps(sim,1000000);const high=pulseLengths.slice(-3);
+  expect(low.length).toBeGreaterThan(1);expect(high.length).toBeGreaterThan(1);
+  expect(low,JSON.stringify(low)).toSatisfy(v=>v.every((us:number)=>us>980&&us<1030));expect(high,JSON.stringify(high)).toSatisfy(v=>v.every((us:number)=>us>1980&&us<2030));
+ });
+ it('preserves pins, wiring, chosen parts and internal mounting through the editor',async()=>{
+  await importVlxFile({text:async()=>JSON.stringify(dimmer.project)} as File);
+  const state=useSimulatorStore.getState(),payload=buildVlxPayload(),p=registerProject(state);
+  expect(payload.wires).toEqual(dimmer.project.wires);expect(payload.boards[0].properties?.evSelectedDesign).toMatchObject({status:'DESIGN_SELECTED'});
+  expect(p.nets).toHaveLength(6);
+  const all=[...state.components,...state.boards],shell=structures(all).find(s=>s.part.properties.evEnclosure)!;
+  const pose=mountedPose(state.boards[0],all)!;
+  expect(contains(shell.box,bounds('U1',pose,[unoModel.width,unoModel.height,unoModel.depth],true),1)).toBe(true);
+  expect(payload.components.some(c=>c.properties.evInternalHypothesis)).toBe(false);
+ });
+ it('runs the actual API-generated watering code through sensor voltage, driver current and water feedback',async()=>{
+  const project=liveWatering.project,components=structuredClone(project.components),wires=project.wires;
+  const sensor=components.find(c=>c.id==='S1')!,button=components.find(c=>c.id==='B1')!,pump=components.find(c=>c.id==='M1')!;
+  const binding=waterBinding(pump.properties)!;expect(binding.controlPin).toBe(9);expect(binding.gateResistorId).toBe('R1');
+  const pm=new PinManager(),sim=new AVRSimulator(pm,'uno');sim.loadHex(liveWatering.hex);
+  const readings:Array<{on:boolean;current:number}>=[];let lastPower=0;
+  async function solve(){
+   const {netlist,pinNetMap}=buildNetlist({components,wires,boards:[{id:'U1',boardKind:'arduino-uno',vcc:5,
+    pins:{'2':{type:'input',pull:1},'8':{type:'digital',v:pm.getPinState(8)?5:0},'9':{type:'digital',v:pm.getPinState(9)?5:0}},groundPinNames:['GND'],vccPinNames:['5V']}],analysis:{kind:'op'}} as Parameters<typeof buildNetlist>[0]);
+   const result=await runNetlist(netlist);const nodeVoltages:Record<string,number>={},branchCurrents:Record<string,number>={};
+   for(const name of result.variableNames){const v=/^v\((.+)\)$/i.exec(name),i=/^i\((.+)\)$/i.exec(name);if(v)nodeVoltages[v[1].toLowerCase()]=result.dcValue(name);if(i)branchCurrents[i[1].toLowerCase()]=result.dcValue(name);}
+   const level=(pin:string)=>{const net=pinNetMap.get(pin);return net==='0'?0:nodeVoltages[net!]||0;};
+   return {adc:level('U1:A0'),stop:level('U1:2'),reading:readPumpCircuit(binding,components,wires,{nodeVoltages,branchCurrents,pinNetMap,converged:true,error:null},pm.getPinState(9))};
+  }
+  for(const [adc,pressed,on] of [[560,false,true],[280,false,false],[560,true,false],[560,false,true]] as const){
+   sensor.properties.value=adc;(button.properties as Record<string,unknown>).pressed=pressed;
+   const input=await solve();sim.getADC()!.channelValues[0]=input.adc;sim.setPinState(2,input.stop>2.5);steps(sim,2000000);
+   const {reading}=await solve();expect(pm.getPinState(9),JSON.stringify({adc,pressed,voltage:input.adc,stop:input.stop,cycles:sim.getCurrentCycles()})).toBe(on);
+   if(on){expect(reading.current).toBeGreaterThan(.24);expect(reading.power).toBeGreaterThan(.98);}else expect(Math.abs(reading.current)).toBeLessThan(.001);
+   readings.push({on,current:reading.current});lastPower=reading.power;
+  }
+  const world=advanceWater(initialWaterState(binding,560),2,lastPower,binding,true);
+  expect(world.deliveredMl).toBeGreaterThan(0);expect(soilAdc(world,binding)).toBeLessThan(560);
+  console.info('API_GENERATED_WATERING',JSON.stringify(readings));
+ });
+});
