+++ b/frontend/src/components/EmbeddedToolCard.tsx
@@ -0,0 +1,9 @@
+import type {ReactNode} from 'react';
+
+/** Functional groups share the same readable, wrapping toolbar treatment. */
+export function EmbeddedToolCard({title,children,className=''}:{title:string;children:ReactNode;className?:string}){
+ return <section className={`ev-tool-card ${className}`} aria-label={title}>
+  <h2 className="ev-tool-card-title">{title}</h2>
+  <div className="ev-tool-card-body">{children}</div>
+ </section>;
+}
