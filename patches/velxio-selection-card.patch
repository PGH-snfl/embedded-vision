+.ev-selection-card{position:absolute;top:12px;right:12px;z-index:250;width:min(232px,calc(100% - 24px));max-height:calc(100% - 24px);box-sizing:border-box;overflow:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:9px;padding:11px;border:1px solid #d6e2da;border-radius:12px;background:#fffffff5;color:#294a37;box-shadow:0 4px 18px #183b2920;font:12px/1.4 system-ui,sans-serif;pointer-events:auto}
+.ev-selection-card-heading{display:flex;align-items:flex-start;gap:8px;min-width:0}
+.ev-selection-card-heading>div{flex:1;min-width:0}
+.ev-selection-card-heading strong{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:12px;overflow-wrap:anywhere}
+.ev-selection-card-heading small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#75847b;font-size:10px;margin-top:2px}
+.ev-selection-card .ev-selection-card-close{flex:none;width:23px;height:23px;border:0;border-radius:5px;padding:0;background:transparent;color:#718078;font-size:19px;line-height:1;cursor:pointer}
+.ev-selection-card .ev-selection-card-close:hover{background:#edf3ef}
+.ev-selection-card-facts{display:flex;align-items:center;gap:7px;min-width:0}
+.ev-selection-card-facts>span{flex:none;border-radius:4px;padding:2px 6px;background:#eef2ef;color:#69766d;font-size:10px}
+.ev-selection-card-facts>span.is-moving{background:#e3f4e9;color:#176b48}
+.ev-selection-card-facts>small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;color:#677b6b}
+.ev-selection-card .ev-selection-card-move{width:100%;margin:0;padding:7px 10px;border:1px solid #c7dbce;border-radius:7px;background:#f2f8f4;color:#245f3d;font:600 12px/1.4 system-ui,sans-serif;cursor:pointer}
+.ev-selection-card .ev-selection-card-move[aria-pressed=true]{border-color:#236c49;background:#236c49;color:#fff}
+.ev-selection-card button:disabled{cursor:not-allowed;opacity:.5}
+.ev-selection-card-details{flex:none;min-height:0;border-top:1px solid #e4ebe6;padding-top:7px;font-size:11px}
+.ev-selection-card-details>summary{cursor:pointer;color:#697b6e;list-style:none;font-size:10px}
+.ev-selection-card-details>summary:after{content:' ＋';float:right}
+.ev-selection-card-details[open]>summary:after{content:' −'}
+.ev-selection-card-content{overflow:auto;max-height:min(300px,calc(100vh - 280px));margin-top:7px;overscroll-behavior:contain}
+.ev-selection-card-content p{margin:7px 0;font-size:10px;line-height:1.5}
+.ev-selection-card-content label{display:block;margin:8px 0}
+.ev-selection-card-content input{display:block;width:100%;max-width:100%;box-sizing:border-box;margin-top:4px;padding:6px;border:1px solid #d3dfd7;border-radius:5px;background:#fff;color:inherit;font:inherit}
+.ev-selection-card-content input[type=color]{height:30px}
+.ev-selection-card-content button{margin:3px 4px 3px 0;font-size:10px}
+.ev-selection-card-content details{margin:8px 0;padding-top:6px;border-top:1px solid #e2e9e4}
+.ev-selection-card-content summary{cursor:pointer;font-size:10px}
+.ev-selection-card.with-local-tools{top:70px;max-height:calc(100% - 82px)}
+@media(max-width:700px){.ev-selection-card{top:8px;right:8px;width:min(212px,calc(100% - 16px));padding:9px;gap:7px}.ev-selection-card-content{max-height:min(230px,calc(100vh - 250px))}}
