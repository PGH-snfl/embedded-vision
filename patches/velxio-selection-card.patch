+import type {ReactNode} from 'react';
+import './SelectionCard.css';
+
+/** Keep the selection and its movement switch together; details are opt-in. */
+export function SelectionCard({title,reference,info,moving,disabled,status,onMove,onClose,children,className=''}:{
+ title:string;reference:string;info?:ReactNode;moving:boolean;disabled:boolean;status?:string;
+ onMove?:()=>void;onClose:()=>void;children?:ReactNode;className?:string;
+}){
+ return <aside className={'ev-selection-card '+className} aria-label="선택한 오브젝트 정보">
+  <div className="ev-selection-card-heading"><div><strong title={title}>{title}</strong><small title={reference}>{reference}</small></div>
+   <button type="button" className="ev-selection-card-close" aria-label="선택한 오브젝트 정보 닫기" onClick={onClose}>×</button>
+  </div>
+  <div className="ev-selection-card-facts"><span className={moving?'is-moving':''}>{status||(moving?'이동 가능':'고정')}</span>{info&&<small>{info}</small>}</div>
+  {onMove&&<button type="button" className="ev-selection-card-move" aria-label="선택한 오브젝트 이동 활성화" aria-pressed={moving} disabled={disabled} onClick={onMove}>{moving?'이동 완료':'이동 활성화'}</button>}
+  {children&&<details className="ev-selection-card-details"><summary>자세히 보기</summary><div className="ev-selection-card-content">{children}</div></details>}
+ </aside>;
+}
