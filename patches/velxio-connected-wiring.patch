+/** Wire display follows native pin identities. Mechanical routing support is optional. */
+import type {Project,Net} from './project/schema';
+import {resolvePin} from './project/pins';
+import {hardwareModel,mountedPose} from './assemblyGeometry';
+import type {routeAssembly} from './assemblyPlanner';
+export type V=[number,number,number];
+type Routing=ReturnType<typeof routeAssembly>;
+const valid=(p:unknown):p is V=>Array.isArray(p)&&p.length===3&&p.every(n=>typeof n==='number'&&Number.isFinite(n));
+export function assemblyWireNets(project:Project,parts:any[],wires:any[],routing:Routing):Net[]{
+ return project.nets.map((net,i)=>{
+  const wire=wires[i],r=routing.routes[net.id];
+  if(r?.clear&&r.points.length>=2&&r.points.every(valid))return {...net,physicalRoute:true,routeBlocked:false,routeKind:'hardware',
+   connectorBinding:r.binding,route:r.points.map(p=>p.map(n=>n/1000) as V)};
+  const supported=wire&&[wire.start,wire.end].every(end=>{
+   const part=parts.find(p=>p.id===end.componentId),model=part&&hardwareModel(part);
+   return part&&model?.ports[end.pinName]&&mountedPose(part,parts);
+  });
+  // Unsupported parts still have native pins. Never replace or invent those pins.
+  return supported?{...net,physicalRoute:true,routeBlocked:true,routeKind:'blocked',routeNote:r?.reason||'기구 배선 경로를 확인해야 합니다.'}:
+   {...net,physicalRoute:false,routeBlocked:false,routeKind:'pins',routeNote:'실제 단자 기준 표시 배선 · 기구 간섭 검증 전'};
+ });
+}
+export function connectedWirePath(project:Project,net:Net,drag?:{wireId:string;side:'start'|'end';point:V}|null){
+ const a=resolvePin(project,net.endpoints[0]),b=resolvePin(project,net.endpoints[1]);
+ if(!a||!b||!valid(a.position)||!valid(b.position))return null;
+ const start=drag?.wireId===net.id&&drag.side==='start'?drag.point:a.position,
+  end=drag?.wireId===net.id&&drag.side==='end'?drag.point:b.position;
+ if(!valid(start)||!valid(end))return null;
+ const routed=net.physicalRoute&&!net.routeBlocked&&(net.route?.length||0)>=2&&net.route!.every(valid);
+ let points:V[];
+ if(routed)points=[start,...net.route!.slice(1,-1),end];
+ else{
+  const pinRoute=net.routeKind==='pins'||net.routeBlocked||net.physicalRoute;
+  let lift=.012;
+  if(pinRoute){
+   const parts=[...project.components,...(project.boards||[])].filter(c=>c.config?.metadataId!=='ev-structure');
+   const ceiling=Math.max(start[1],end[1],...parts.map(c=>(c.position?.[1]||0)+(typeof c.config?.physicalHeight==='number'?c.config.physicalHeight:.02)));
+   const lane=Math.max(0,project.nets.indexOf(net))%24;
+   lift=ceiling+.018+lane*.0025;
+  }
+  const middle=(net.route||[]).filter(valid).map(p=>[p[0],pinRoute?lift:p[1],p[2]] as V);
+  points=[start,[start[0],lift,start[2]],...middle,[end[0],lift,end[2]],end];
+ }
+ // Consecutive coincident points are harmless electrically but break thin tubes.
+ points=points.filter((p,i)=>!i||p.some((v,j)=>Math.abs(v-points[i-1][j])>1e-9));
+ if(points.length<2){if(net.connectorBinding)points=[start,end];else return null;}
+ const warning=!!net.routeBlocked||!!net.physicalRoute&&!routed;
+ return {points,a:{...a,position:start},b:{...b,position:end},warning,kind:routed?'hardware':warning?'blocked':'pins',note:net.routeNote};
+}
