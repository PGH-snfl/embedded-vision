+/** The automatic photo flow only starts a newly imported, idle editor once. */
+export function shouldAutoRunPhoto(o: {search:string; compact:boolean; ready:boolean;
+ autoRunAllowed:boolean; motionMode:boolean; attempted:boolean; activeBoardId:string|null;
+ anyBoardRunning:boolean}): boolean {
+ const p=new URLSearchParams(o.search);
+ return o.compact && o.ready && o.autoRunAllowed && !o.motionMode &&
+   p.get('embedded')==='1' && p.get('autorun')==='1' && !o.attempted &&
+   !!o.activeBoardId && !o.anyBoardRunning;
+}
