@@ -0,0 +1,19 @@
+import {describe,it,expect} from 'vitest';
+import {shouldAutoRunPhoto} from '../components/editor/embeddedPhotoAutoRun';
+
+describe('photo workflow automatic simulation',()=>{
+ const fresh={search:'?embedded=1&autorun=1',compact:true,ready:true,autoRunAllowed:true,
+   motionMode:false,attempted:false,activeBoardId:'U1',anyBoardRunning:false};
+ it('starts only after a new project and board are ready',()=>{
+  expect(shouldAutoRunPhoto(fresh)).toBe(true);
+  expect(shouldAutoRunPhoto({...fresh,ready:false})).toBe(false);
+  expect(shouldAutoRunPhoto({...fresh,activeBoardId:null})).toBe(false);
+ });
+ it('does not rerun stopped work, restored edits or motion preview',()=>{
+  expect(shouldAutoRunPhoto({...fresh,attempted:true})).toBe(false);
+  expect(shouldAutoRunPhoto({...fresh,autoRunAllowed:false})).toBe(false);
+  expect(shouldAutoRunPhoto({...fresh,motionMode:true})).toBe(false);
+  expect(shouldAutoRunPhoto({...fresh,anyBoardRunning:true})).toBe(false);
+  expect(shouldAutoRunPhoto({...fresh,search:'?embedded=1'})).toBe(false);
+ });
+});
