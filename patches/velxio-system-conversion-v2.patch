+export function conversionEndpoint(path=location.pathname){const wid=/^\/w\/([a-f0-9]{32})(?:\/|$)/.exec(path)?.[1];return wid?`/api/w/${wid}/system-conversions/preview`:'/api/system-conversions/preview';}
+export function conversionFingerprint(project:Record<string,unknown>){const {exportedAt:_,...stable}=project;return JSON.stringify(stable);}
+export function convertedProjectUrl(project:Record<string,any>){
+ const bytes=new TextEncoder().encode(JSON.stringify(project));
+ const encoded=btoa(Array.from(bytes,b=>String.fromCharCode(b)).join(''));
+ const wid=/^\/w\/([a-f0-9]{32})(?:\/|$)/.exec(location.pathname)?.[1];
+ const url=new URL(wid?`/w/${wid}/editor`:'/editor',location.origin);
+ url.searchParams.set('embedded','1');url.searchParams.set('view','system-conversion-2');
+ url.hash='project='+encodeURIComponent(encoded);return url.href;
+}
+export async function requestBoardConversion(project:Record<string,unknown>,target:string,allowAi:boolean,signal?:AbortSignal):Promise<BoardConversionResult>{
+ const endpoint=conversionEndpoint(),id=crypto.randomUUID();
+ let response=await fetch(endpoint,{method:'POST',credentials:'same-origin',signal,
+  headers:{'Content-Type':'application/json','Idempotency-Key':id,...getCsrfHeaders()},body:JSON.stringify({project,target,allow_ai:allowAi})});
+ if(response.status===202){
+  const job=await response.json(),wid=/^\/w\/([a-f0-9]{32})(?:\/|$)/.exec(location.pathname)?.[1];
+  if(!wid||typeof job.status_url!=='string'||!new RegExp(`^/api/w/${wid}/jobs/[a-f0-9]{32}$`).test(job.status_url))throw Error('전환 작업의 작업공간이 일치하지 않습니다.');
+  const deadline=Date.now()+300000;
+  while(true){
+   if(signal?.aborted)throw new DOMException('결과 대기를 중단했습니다. 서버 작업은 자동 재제출하지 않습니다.','AbortError');
+   if(Date.now()>deadline)throw Error('결과 대기 시간이 지났습니다. 서버 작업은 재제출하지 않았습니다.');
+   await new Promise(resolve=>setTimeout(resolve,600));
+   const poll=await fetch(job.status_url,{credentials:'same-origin',signal});if(!poll.ok)throw Error('전환 작업 상태를 읽지 못했습니다.');
+   const status=await poll.json();
+   if(['done','failed','interrupted'].includes(status.status)){
+    response=new Response(JSON.stringify(status.result?.data||status.result||{detail:'전환 작업이 중단됐습니다.'}),{status:status.result?.status_code||(status.status==='done'?200:503),headers:{'Content-Type':'application/json'}});break;
+   }
+  }
+ }
+ const result=await response.json();
+ if(!response.ok){const detail=result.detail;throw Error(typeof detail==='string'?detail:detail?.message||'회로·코드 전환을 완료하지 못했습니다.');}
+ if(result.workbench?.format!=='velxio-project'||result.workbench.boards?.length!==1||result.workbench.boards[0].boardKind!==target||!Array.isArray(result.pin_mapping)||!Array.isArray(result.changes)||!Array.isArray(result.limitations))throw Error('변환 결과의 대상 보드나 형식이 올바르지 않습니다.');
+ return result;
+}
