+  expect(report.samples.find(s=>s.input==='S1'&&s.value===0)!.outputs.D1).toBeLessThan(.00001);
+  expect(JSON.stringify(fixture)).toBe(before);
+  await writeFile('../../../outputs/system-conversion/pico-execution.json',JSON.stringify(report,null,2));
+ }finally{solver.dispose();}
