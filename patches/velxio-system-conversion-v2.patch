+  expect(report.samples.find(s=>s.input==='S1'&&s.value===1)!.outputs.D1).toBeGreaterThan(.001);
+  expect(report.samples.find(s=>s.input==='S1'&&s.value===0)!.outputs.D1).toBeLessThan(.00001);
+  await writeFile('../../../outputs/system-conversion/uno-roundtrip-execution.json',JSON.stringify(report,null,2));
+ }finally{solver.dispose();}
