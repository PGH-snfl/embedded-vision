+import type {Mapper} from './componentToSpice';
+const num=(v:unknown,fallback:number,min:number,max:number)=>Number.isFinite(Number(v))?Math.max(min,Math.min(max,Number(v))):fallback;
+/** Functional, explicitly approximate device models; not manufacturer sign-off. */
+export const WATERING_MAPPERS:Record<string,Mapper>={
+ 'mosfet-irlz44n':(c,n)=>{
+  const d=n('D'),g=n('G'),s=n('S');if(!d||!g||!s)return null;
+  return {cards:[`M_${c.id} ${d} ${g} ${s} WATER_IRLZ44N`],modelsUsed:new Set(['.model WATER_IRLZ44N VDMOS(Vto=1.5 Kp=20 Rd=.015 Rs=.01 Rg=3 Cgs=1.7n Cgdmax=.8n Cgdmin=.15n Cjo=.4n Is=1p)'])};
+ },
+ 'dc-water-pump':(c,n)=>{
+  const plus=n('+'),minus=n('-');if(!plus||!minus)return null;
+  return {cards:[`V_${c.id}_sense ${plus} ${c.id}_sense_mid 0`,
+   `R_${c.id}_winding ${c.id}_sense_mid ${c.id}_coil ${num(c.properties.resistance,48,1,1000)}`,
+   `L_${c.id}_winding ${c.id}_coil ${minus} ${num(c.properties.inductance,.005,.000001,1)}`],modelsUsed:new Set()};
+ },
+ 'dc-power-supply':(c,n)=>{
+  const plus=n('+'),minus=n('-');if(!plus||!minus)return null;
+  const voltage=c.properties.enabled===false||c.properties.enabled==='false'?0:num(c.properties.voltage,12,0,24);
+  return {cards:[`V_${c.id} ${c.id}_positive ${minus} DC ${voltage}`,`R_${c.id}_esr ${c.id}_positive ${plus} .1`],modelsUsed:new Set()};
+ },
+ 'soil-moisture-sen0193':(c,n)=>{
+  const vcc=n('VCC'),gnd=n('GND'),sig=n('SIG');if(!vcc||!gnd||!sig)return null;
+  const output=Math.min(3,num(c.properties.value,560,0,614)*5/1023);
+  return {cards:[`B_${c.id}_out ${c.id}_output ${gnd} V={${output}*u(V(${vcc},${gnd})-3.2)}`,
+   `R_${c.id}_output ${c.id}_output ${sig} 1000`,`R_${c.id}_supply ${vcc} ${gnd} 1000`],modelsUsed:new Set()};
+ },
+ 'diode-1n5822':(c,n)=>{
+  const a=n('A'),cathode=n('C');if(!a||!cathode)return null;
+  return {cards:[`D_${c.id} ${a} ${cathode} WATER_1N5822`],modelsUsed:new Set(['.model WATER_1N5822 D(Is=20u N=1.1 Rs=.04 Bv=40 Ibv=1m Cjo=200p)'])};
+ },
+};
