+import {UnionFind} from '../../simulation/spice/unionFind';
+import {breadboardGroupKey} from '../../utils/breadboardNets';
+import type {WaterBinding} from './environmentObjects';
+type Part={id:string;metadataId:string;properties:Record<string,unknown>};
+type Wire={start:{componentId:string;pinName:string};end:{componentId:string;pinName:string}};
+type Snapshot={converged:boolean;error:string|null;nodeVoltages:Record<string,number>;branchCurrents:Record<string,number>;pinNetMap:Map<string,string>};
+let previousWires:Wire[]|null=null,previousTypes='',network=new UnionFind();
+function nets(parts:Part[],wires:Wire[],boardId:string){
+ const types=boardId+JSON.stringify(parts.map(p=>[p.id,p.metadataId]));
+ if(previousWires===wires&&types===previousTypes)return network;
+ previousWires=wires;previousTypes=types;network=new UnionFind();
+ const byId=new Map(parts.map(p=>[p.id,p.metadataId]));
+ for(const wire of wires){
+  const keys=[wire.start,wire.end].map(e=>{
+   const key=e.componentId+':'+e.pinName,group=breadboardGroupKey(byId.get(e.componentId)||'',e.pinName);
+   if(group)network.union(key,e.componentId+':strip:'+group);
+   if(e.componentId===boardId&&/^GND([._]?\d+)?$/i.test(e.pinName))network.union(key,boardId+':GND');
+   return key;
+  });network.union(keys[0],keys[1]);
+ }
+ return network;
+}
+/** Read solved motor power, with a fresh physical-topology check to reject stale solves. */
+export function readPumpCircuit(binding:WaterBinding,parts:Part[],wires:Wire[],snapshot:Snapshot,command:boolean){
+ const result={power:0,voltage:0,current:0,fault:''};
+ const find=(id:string)=>parts.find(p=>p.id===id);
+ const pump=find(binding.pumpId),driver=find(binding.driverId),supply=find(binding.supplyId),gateR=find(binding.gateResistorId),sensor=find(binding.sensorId);
+ if(pump?.metadataId!=='dc-water-pump'||driver?.metadataId!=='mosfet-irlz44n'||supply?.metadataId!=='dc-power-supply'||gateR?.metadataId!=='resistor'||sensor?.metadataId!=='soil-moisture-sen0193')return {...result,fault:'펌프·MOSFET·전원·센서 부품을 확인하세요.'};
+ const network=nets(parts,wires,binding.boardId),same=(a:string,b:string)=>network.find(a)===network.find(b),pin=binding.boardId+':'+binding.controlPin;
+ const gate=(same(pin,gateR.id+':1')&&same(driver.id+':G',gateR.id+':2'))||(same(pin,gateR.id+':2')&&same(driver.id+':G',gateR.id+':1'));
+ const connections=[[pump.id+':+',supply.id+':+'],[pump.id+':-',driver.id+':D'],[driver.id+':S',supply.id+':-'],[supply.id+':-',binding.boardId+':GND'],[sensor.id+':VCC',binding.boardId+':5V'],[sensor.id+':GND',binding.boardId+':GND'],[sensor.id+':SIG',binding.boardId+':A0']];
+ if(!gate||connections.some(([a,b])=>!same(a,b)))return {...result,fault:'펌프 전원·게이트·공통 접지·센서 배선을 확인하세요.'};
+ if(supply.properties.enabled===false||supply.properties.enabled==='false'||Number(supply.properties.voltage??12)<=0)return {...result,fault:'펌프용 DC 전원이 꺼져 있습니다.'};
+ if(!snapshot.converged||snapshot.error)return {...result,fault:'회로 전기 해석 결과를 기다리고 있습니다.'};
+ const plus=snapshot.pinNetMap.get(pump.id+':+'),minus=snapshot.pinNetMap.get(pump.id+':-');
+ const v=(net:string|undefined)=>net==='0'?0:net?snapshot.nodeVoltages[net]:NaN;
+ const voltage=v(plus)-v(minus),current=snapshot.branchCurrents[('v_'+pump.id+'_sense').toLowerCase()];
+ if(!Number.isFinite(voltage)||!Number.isFinite(current))return {...result,fault:'펌프 전압·전류 해석을 기다리고 있습니다.'};
+ result.voltage=voltage;result.current=current;
+ const nominal=Number(pump.properties.nominalVoltage)||12;
+ if(command&&voltage>=nominal*.7&&current>.02)result.power=Math.min(1,voltage/nominal);
+ else if(command)result.fault='펌프에 구동 전류가 흐르지 않습니다.';
+ return result;
+}
