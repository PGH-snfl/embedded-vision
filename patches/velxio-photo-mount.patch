+import * as T from 'three';
+type V=[number,number,number];
+export function wireGeometry(points:V[]){
+ const vertices=points.map(p=>new T.Vector3(...p)),path=new T.CurvePath<T.Vector3>();
+ for(let i=1;i<vertices.length;i++)if(vertices[i-1].distanceToSquared(vertices[i])>1e-16)path.add(new T.LineCurve3(vertices[i-1],vertices[i]));
+ if(!path.curves.length)path.add(new T.LineCurve3(vertices[0],vertices[0].clone().addScalar(.000001)));
+ return new T.TubeGeometry(path,Math.max(36,points.length*12),.00048,10,false);
+}
+export const cableConnectorPositions=(points:V[]):V[]=>[points[0],points[points.length-1]].map(p=>[p[0],p[1]+.0014,p[2]]);
+export function cableMesh(points:V[],color:string,warning=false){
+ const group=new T.Group();group.name='ev-cable';
+ group.add(new T.Mesh(wireGeometry(points),new T.MeshStandardMaterial({color:warning?'#df923c':color,roughness:.4,transparent:warning,opacity:warning?.4:1})));
+ for(const p of cableConnectorPositions(points)){const end=new T.Mesh(new T.BoxGeometry(.0021,.003,.0021),new T.MeshStandardMaterial({color:'#262c2d',roughness:.5}));end.position.set(...p);group.add(end);}
+ return group;
+}
