+  return {id:p.id,label:String(s.label||p.id),role:s.evPhotoStructure.role,size,
+   center:[(p.x+6)*25.4/96000+size[0]/2,(Number(s.elevation||0)/1000)+size[1]/2,(p.y+6)*25.4/96000+size[2]/2] as V};
