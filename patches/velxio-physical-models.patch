+/** Reviewed presentation models. Product choice is a proposed design, not photo evidence. */
+import cad from './physicalBoardData.json';
+export type Pad={element:string;pad:string;at:[number,number];drill:number};
+export type BoardPart={name:string;package:string;kind:string;at:[number,number];rotation:number;pads:Pad[]};
+export type BoardLayout={width:number;depth:number;pads:Pad[];parts:BoardPart[];holes:Array<{at:[number,number];drill:number}>;source:string;source_sha256:string;license:string;author:string};
+export const boardLayouts=cad as unknown as Record<'hat'|'shield',BoardLayout>;
+type Point=[number,number,number];
+export type PhysicalModel={id:string;name:string;kind:'pi'|'hat'|'shield'|'motor'|'dc-power'|'usb-power';width:number;depth:number;height:number;ports:Record<string,Point>;labels?:Record<string,string>;source:string;basis:string};
+function boardPort(board:BoardLayout,element:string,pad:string,height=8):Point{
+ const p=board.pads.find(p=>p.element===element&&p.pad===pad);
+ if(!p)throw Error('제조사 CAD에서 단자 위치를 찾을 수 없습니다: '+element+'.'+pad);
+ return [p.at[0],height,p.at[1]];
+}
+function terminalPort(board:BoardLayout,element:string,pad:string):Point{
+ const p=boardPort(board,element,pad,4.5),angle=(board.parts.find(p=>p.name===element)?.rotation||0)*Math.PI/180;
+ // CAD gives the through-hole pad; the cable enters the front of its block.
+ return [p[0]+3.6*Math.sin(angle),p[1],p[2]+3.6*Math.cos(angle)];
+}
+const hat=boardLayouts.hat,shield=boardLayouts.shield;
+export const physicalModels:Record<string,PhysicalModel>={
+ 'rpi4b':{id:'rpi4b',name:'Raspberry Pi 4 Model B',kind:'pi',width:85,depth:56,height:18,
+  ports:{GPIO40:[-10,8.5,-24.5],USB_C:[-31.3,3,29]},labels:{GPIO40:'40핀 헤더 전체 결합',USB_C:'USB-C 전원'},
+  source:'https://datasheets.raspberrypi.com/rpi4/raspberry-pi-4-mechanical-drawing.pdf',basis:'제조사 외곽 치수·커넥터 위치 기준. 내부 부품과 높이는 간략 모델입니다.'},
+ 'adafruit-motor-hat-2348':{id:'adafruit-motor-hat-2348',name:'Adafruit Motor HAT #2348 · Rev A',kind:'hat',width:hat.width,depth:hat.depth,height:13,
+  ports:{GPIO40:[0,8,-24.25],'M1.left':terminalPort(hat,'J1','5'),'M1.right':terminalPort(hat,'J1','4'),'M2.left':terminalPort(hat,'J1','2'),'M2.right':terminalPort(hat,'J1','1'),'PWR.positive':terminalPort(hat,'MPOWER','2'),'PWR.negative':terminalPort(hat,'MPOWER','1')},
+  labels:{GPIO40:'40핀 헤더 전체 결합','PWR.positive':'모터 전원 +','PWR.negative':'모터 전원 −'},source:'https://github.com/adafruit/Adafruit-DC-Stepper-Motor-HAT-PCB',basis:'공개 Rev A PCB의 패드·부품 배치 기준. 부품 높이와 기판 모서리는 간략 모델입니다.'},
+ 'adafruit-motor-shield-v2':{id:'adafruit-motor-shield-v2',name:'Adafruit Motor Shield V2.3',kind:'shield',width:shield.width,depth:shield.depth,height:13,
+  ports:{SDA:boardPort(shield,'JP3','2',7),SCL:boardPort(shield,'JP3','1',7),'5V':boardPort(shield,'JP2','4',7),GND:boardPort(shield,'JP2','2',7),
+   'M1.left':terminalPort(shield,'J1','5'),'M1.right':terminalPort(shield,'J1','4'),'M2.left':terminalPort(shield,'J1','2'),'M2.right':terminalPort(shield,'J1','1'),'PWR.positive':terminalPort(shield,'MPOWER','2'),'PWR.negative':terminalPort(shield,'MPOWER','1')},
+  labels:{'PWR.positive':'모터 전원 +','PWR.negative':'모터 전원 −'},source:'https://github.com/adafruit/Adafruit-Motor-Shield-V2-PCB',basis:'공개 V2.3 PCB의 패드·부품 배치 기준. 실물은 Uno 위에 장착하며 여기서는 분리해 표시합니다.'},
+ 'adafruit-micro-dc-2941':{id:'adafruit-micro-dc-2941',name:'Adafruit DC 모터 #2941',kind:'motor',width:32.3,depth:12.3,height:29.9,
+  ports:{black:[-21,3,-1.27],red:[-21,3,1.27]},source:'https://www.adafruit.com/product/2941',basis:'제조사 외곽 치수·제품 형상 기준. 서보 케이스의 2선 DC 모터이며 3선 서보가 아닙니다. 케이블은 개략 배치입니다.'},
+ 'dc-supply-generic':{id:'dc-supply-generic',name:'모터 DC 전원 · 일반형',kind:'dc-power',width:40,depth:28,height:22,
+  ports:{red:[22,5,-4],black:[22,5,4]},source:'',basis:'제품 모델과 외형 치수가 미확인인 일반형 표시입니다. 실제 제품 선택·정격 확인이 필요합니다.'},
+ 'usb-c-supply-generic':{id:'usb-c-supply-generic',name:'USB-C 전원 · 일반형',kind:'usb-power',width:34,depth:28,height:24,
+  ports:{USB_C:[25,6,0]},source:'',basis:'제품 모델과 외형 치수가 미확인인 일반형 표시입니다. USB-C 연결만 표현합니다.'},
+};
+type Part={metadataId?:string;properties?:Record<string,unknown>};
+/** Known old conversion exports lacked a model ID. Upgrade only that authored recipe. */
+export function withLegacyPhysicalModels<T extends {components?:Array<Part&{id:string}>;embeddedVision?:{recipe?:string}}>(project:T):T{
+ if(project.embeddedVision?.recipe!=='translated_uno_motor_shield_rover'||!project.components)return project;
+ const known:Record<string,[string,string]>={SHIELD1:['Adafruit Motor Shield V2 (visual only)','adafruit-motor-shield-v2'],MOTOR_L:['왼쪽 DC 모터 (visual only)','adafruit-micro-dc-2941'],MOTOR_R:['오른쪽 DC 모터 (visual only)','adafruit-micro-dc-2941'],BAT1:['모터용 별도 전원 · 정격 미확인 (visual only)','dc-supply-generic']};
+ return {...project,components:project.components.map(p=>{
+  const entry=known[p.id];
+  return entry&&p.metadataId==='custom-chip'&&p.properties?.chipName===entry[0]&&p.properties.evPhysicalModel===undefined?{...p,properties:{...p.properties,evPhysicalModel:entry[1]}}:p;
+ })};
+}
+export function physicalModelFor(part:Part):PhysicalModel|undefined{
+ if(part.metadataId!=='custom-chip')return undefined;
+ const p=part.properties||{},explicit=p.evPhysicalModel;
+ if(explicit!==undefined)return typeof explicit==='string'?physicalModels[explicit]:undefined;
+ const legacy:Record<string,string>={pi4:'rpi4b',motor_hat:'adafruit-motor-hat-2348',motor_left:'adafruit-micro-dc-2941',motor_right:'adafruit-micro-dc-2941',motor_power:'dc-supply-generic',pi_power:'usb-c-supply-generic'};
+ const id=legacy[String(p.evRoverKind)]||(p.chipName==='Adafruit Motor Shield V2 (visual only)'?'adafruit-motor-shield-v2':undefined);
+ return id?physicalModels[id]:undefined;
+}
+export function physicalPresentation(part:Part,geometry:{rotation:number;pins:Array<{name:string;position:Point}>}){
+ const model=physicalModelFor(part);
+ if(!model||!geometry.pins.length||geometry.pins.some(p=>!model.ports[p.name]))return undefined;
+ const angle=geometry.rotation*Math.PI/180,c=Math.cos(angle),s=Math.sin(angle);
+ const pins=geometry.pins.map(pin=>{const [x,y,z]=model.ports[pin.name];return {...pin,position:[(x*c-z*s)/1000,y/1000,(x*s+z*c)/1000] as Point};});
+ return {model,pins};
+}
