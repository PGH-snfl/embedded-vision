--- /dev/null
+++ b/frontend/src/__tests__/physical-models.test.ts
@@ -0,0 +1,68 @@
+// @vitest-environment jsdom
+import {afterEach,describe,it,expect} from 'vitest';
+import {physicalModels,physicalModelFor,boardLayouts,physicalPresentation,withLegacyPhysicalModels} from '../components/circuitiny/physicalModels';
+import {registerProject,endpoint,connectCircuitiny} from '../components/circuitiny/bridge';
+import {useSimulatorStore as native} from '../store/useSimulatorStore';
+import {useStore} from '../components/circuitiny/store';
+import {geometryFor} from '../components/circuitiny/geometry';
+import {PX,definitions} from '../components/circuitiny/catalog';
+
+let dispose=()=>{};
+afterEach(()=>{dispose();document.body.innerHTML='';});
+describe('physical part presentation',()=>{
+ it('uses manufacturer PCB coordinates, a 40-contact header, and separate motor power terminals',()=>{
+  expect(boardLayouts.hat.pads.filter(p=>p.element==='RPI1')).toHaveLength(40);
+  expect(physicalModels.rpi4b.width).toBe(85);
+  expect(physicalModels.rpi4b.depth).toBe(56);
+  const shield=physicalModels['adafruit-motor-shield-v2'];
+  expect(shield.ports.SDA).not.toEqual(shield.ports.SCL);
+  expect(shield.ports['PWR.positive']).not.toEqual(shield.ports['5V']);
+  const plus=boardLayouts.shield.pads.find(p=>p.element==='MPOWER'&&p.pad==='2')!;
+  expect(shield.ports['PWR.positive'][0]).toBeCloseTo(plus.at[0]);
+  expect(shield.ports['PWR.positive'][2]).toBeCloseTo(plus.at[1]+3.6);
+  expect(physicalModels['adafruit-micro-dc-2941'].ports).not.toHaveProperty('signal');
+ });
+ it('does not assign a specific product to an arbitrary or unknown part',()=>{
+  expect(physicalModelFor({metadataId:'custom-chip',properties:{chipName:'a board'}})).toBeUndefined();
+  expect(physicalModelFor({metadataId:'custom-chip',properties:{evPhysicalModel:'unknown',evRoverKind:'pi4'}})).toBeUndefined();
+  expect(physicalModelFor({metadataId:'resistor',properties:{evPhysicalModel:'rpi4b'}})).toBeUndefined();
+  expect(physicalModelFor({metadataId:'custom-chip',properties:{evRoverKind:'pi4'}})?.id).toBe('rpi4b');
+  expect(physicalModels['dc-supply-generic'].source).toBe('');
+ });
+ it('upgrades known old conversion drawings while preserving code and electrical connections',()=>{
+  const project={embeddedVision:{recipe:'translated_uno_motor_shield_rover'},components:[{id:'MOTOR_L',metadataId:'custom-chip',properties:{chipName:'왼쪽 DC 모터 (visual only)'}}],wires:[{id:'TR5'}],fileGroups:{uno:[{name:'sketch.ino',content:'edited'}]}};
+  const upgraded=withLegacyPhysicalModels(project);
+  expect(upgraded.components[0].properties).toHaveProperty('evPhysicalModel','adafruit-micro-dc-2941');
+  expect(project.components[0].properties).not.toHaveProperty('evPhysicalModel');
+  expect(upgraded.wires).toBe(project.wires);expect(upgraded.fileGroups).toBe(project.fileGroups);
+  expect(withLegacyPhysicalModels({...project,embeddedVision:{recipe:'unknown'}}).components[0].properties).not.toHaveProperty('evPhysicalModel');
+ });
+ it('changes only presentation geometry; native saved pins, wires, dragging and undo retain their coordinates',()=>{
+  document.body.innerHTML='';
+  const pins=[{name:'GPIO40',x:160,y:20},{name:'USB_C',x:0,y:42}];
+  const element=document.createElement('div');element.id='U1';(element as any).pinInfo=pins;document.body.append(element);
+  const hat=document.createElement('div');hat.id='HAT1';(hat as any).pinInfo=[{name:'GPIO40',x:0,y:20}];document.body.append(hat);
+  native.getState().loadProjectState({boards:[],activeBoardId:null,fileGroups:{},
+   wires:[{id:'C1',start:{componentId:'U1',pinName:'GPIO40',x:286,y:176},end:{componentId:'HAT1',pinName:'GPIO40',x:436,y:176},color:'#168b5b',waypoints:[],autoRouted:true}],
+   components:[{id:'U1',metadataId:'custom-chip',x:120,y:150,properties:{evRoverKind:'pi4'}},{id:'HAT1',metadataId:'custom-chip',x:430,y:150,properties:{evRoverKind:'motor_hat'}}]} as any);
+  const before=JSON.stringify([native.getState().components,native.getState().wires]);
+  const p=registerProject(native.getState());useStore.setState({project:p});
+  const pi=p.components[0],def=definitions.get(pi.componentId)!;
+  expect(pi.config?.width).toBe(.085);
+  expect(pi.config?.physicalModelId).toBe('rpi4b');
+  expect(def.pins.find(p=>p.id==='GPIO40')?.position).toEqual([-.01,.0085,-.0245]);
+  expect(def.pins.find(p=>p.id==='GPIO40')?.label).toContain('전체');
+  expect(p.nets[0].endpoints).toEqual(['U1.GPIO40','HAT1.GPIO40']);
+  expect(JSON.stringify([native.getState().components,native.getState().wires])).toBe(before);
+  const end=endpoint('U1.GPIO40',native.getState());
+  expect(end).toMatchObject({componentId:'U1',pinName:'GPIO40'});
+  expect(end.x).toBeCloseTo(120+6+160);expect(end.y).toBeCloseTo(150+6+20);
+  dispose=connectCircuitiny();
+  const old=useStore.getState().project.components[0].position!;
+  useStore.getState().moveComponent('U1',[old[0]+.01,old[1],old[2]]);
+  expect(native.getState().components[0].x).toBeCloseTo(120+.01/PX);
+  native.getState().undo();expect(JSON.stringify([native.getState().components,native.getState().wires])).toBe(before);
+  const g=geometryFor(native.getState().components[0]);
+  expect(physicalPresentation(native.getState().components[0],{...g,rotation:90})?.pins[0].position[0]).toBeCloseTo(.0245);
+ });
+});
