@@ -0,0 +1,96 @@
+/** Procedural product presentation. CAD-derived layout data is CC BY-SA 3.0.
+ * Port identities remain the existing circuit graph's identities. No emulation.
+ */
+import {useEffect,useMemo} from 'react';
+import {Html,RoundedBox} from '@react-three/drei';
+import * as T from 'three';
+import {Lead} from './RealisticBodies';
+import {boardLayouts,physicalModels,type BoardLayout} from './physicalModels';
+type V=[number,number,number];
+const m=(v:number)=>v/1000;
+function Box({at,size,color,metal=0}:{at:V;size:V;color:string;metal?:number}){
+ return <mesh position={at.map(m) as V} castShadow receiveShadow><boxGeometry args={size.map(m) as V}/><meshStandardMaterial color={color} metalness={metal} roughness={metal ? 0.35 : 0.65}/></mesh>;
+}
+function Cylinder({at,radius,height,color,metal=0}:{at:V;radius:number;height:number;color:string;metal?:number}){
+ return <mesh position={at.map(m) as V} castShadow><cylinderGeometry args={[m(radius),m(radius),m(height),24]}/><meshStandardMaterial color={color} metalness={metal} roughness={metal ? 0.3 : 0.65}/></mesh>;
+}
+function BoardPrint({width,depth,items}:{width:number;depth:number;items:Array<[string,number,number,number?]>}){
+ const texture=useMemo(()=>{
+  const canvas=document.createElement('canvas');canvas.width=1536;canvas.height=Math.round(canvas.width*depth/width);
+  const c=canvas.getContext('2d')!;const scale=canvas.width/width;c.textAlign='center';c.textBaseline='middle';c.fillStyle='#edf5e8';
+  for(const [text,x,z,size=2.1] of items){c.font=`600 ${size*scale}px sans-serif`;c.fillText(text,(x+width/2)*scale,(z+depth/2)*scale);}
+  const t=new T.CanvasTexture(canvas);t.colorSpace=T.SRGBColorSpace;t.anisotropy=4;return t;
+ },[width,depth,JSON.stringify(items)]);
+ useEffect(()=>()=>texture.dispose(),[texture]);
+ return <mesh rotation={[-Math.PI/2,0,0]} position={[0,.00265,0]}><planeGeometry args={[m(width),m(depth)]}/><meshBasicMaterial map={texture} transparent depthWrite={false}/></mesh>;
+}
+function Hole({x,z,drill=2.8}:{x:number;z:number;drill?:number}){
+ return <group position={[m(x),.00251,m(z)]} rotation={[-Math.PI/2,0,0]}><mesh><ringGeometry args={[m(drill/2),m(drill/2+.6),20]}/><meshStandardMaterial color="#d4b76a" metalness={.8} roughness={.4}/></mesh><mesh position={[0,0,-.00001]}><circleGeometry args={[m(drill/2),20]}/><meshStandardMaterial color="#17232a"/></mesh></group>;
+}
+function PCB({width,depth,color,holes}:{width:number;depth:number;color:string;holes:Array<{at:[number,number];drill:number}>}){
