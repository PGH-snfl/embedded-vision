+++ b/frontend/src/components/circuitiny/assemblyGeometry.ts
@@ -0,0 +1,75 @@
+import {physicalModelFor,type PhysicalModel} from './physicalModels';
+import {rotate,type V} from './assemblyMath';
+export {rotate};export type {V};
+export type Box={id:string;min:V;max:V};
+export type Pose={position:V;rotation:V};
+export const MM_PER_PX=25.4/96;
+export const plus=(a:V,b:V)=>a.map((v,i)=>v+b[i]) as V;
+export const minus=(a:V,b:V)=>a.map((v,i)=>v-b[i]) as V;
+export function bounds(id:string,pose:Pose,size:V,base=false):Box{
+ const points:V[]=[];
+ for(const x of [-size[0]/2,size[0]/2])for(const y of base?[0,size[1]]:[-size[1]/2,size[1]/2])for(const z of [-size[2]/2,size[2]/2])points.push(plus(pose.position,rotate([x,y,z],pose.rotation)));
+ return {id,min:[0,1,2].map(i=>Math.min(...points.map(p=>p[i]))) as V,max:[0,1,2].map(i=>Math.max(...points.map(p=>p[i]))) as V};
+}
+export function overlap(a:Box,b:Box,gap=0){return [0,1,2].every(i=>a.min[i]<b.max[i]+gap-1e-6&&a.max[i]>b.min[i]-gap+1e-6);}
+export function contains(outer:Box,inner:Box,gap=0){return [0,1,2].every(i=>inner.min[i]>=outer.min[i]+gap-1e-6&&inner.max[i]<=outer.max[i]-gap+1e-6);}
+export function segmentHits(a:V,b:V,box:Box,gap=0){
+ let enter=0,leave=1;
+ for(let i=0;i<3;i++){
+  const lo=box.min[i]-gap,hi=box.max[i]+gap,d=b[i]-a[i];
+  if(Math.abs(d)<1e-9){if(a[i]<=lo+1e-6||a[i]>=hi-1e-6)return false;continue;}
+  const p=(lo-a[i])/d,q=(hi-a[i])/d;enter=Math.max(enter,Math.min(p,q));leave=Math.min(leave,Math.max(p,q));if(enter>=leave-1e-9)return false;
+ }
+ return leave>0&&enter<1;
+}
+export const distance=(a:V,b:V)=>Math.hypot(...minus(a,b));
+export const pathLength=(points:V[])=>points.slice(1).reduce((n,p,i)=>n+distance(points[i],p),0);
+export function simplify(points:V[]):V[]{
+ const out:V[]=[];
+ for(const p of points){if(out.length&&distance(out[out.length-1],p)<1e-6)continue;out.push(p);while(out.length>2){const n=out.length,a=minus(out[n-2],out[n-3]),b=minus(out[n-1],out[n-2]);if(Math.hypot(a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])>1e-6||a.reduce((s,x,i)=>s+x*b[i],0)<0)break;out.splice(n-2,1);}}
+ return out;
+}
+export const unoModel:PhysicalModel={id:'arduino-uno',name:'Arduino Uno',kind:'pi',width:72.58,depth:53.34,height:18,source:'',basis:'기존 편집기 Uno 모델의 표시 치수',ports:Object.fromEntries(Object.entries({A4:246,A5:255.5,'5V':160,'GND.2':169.5}).map(([key,x])=>[key,[(x-137)*MM_PER_PX,7.5,(191.5-101)*MM_PER_PX] as V]))};
+export function hardwareModel(part:any){return part.boardKind==='arduino-uno'?unoModel:physicalModelFor(part);}
+export type Structure={part:any;role:string;pose:Pose;size:V;box:Box};
+export function structures(parts:any[]):Structure[]{
+ return parts.filter(p=>p.metadataId==='ev-structure').map(part=>{
+  const p=part.properties||{},size:V=[Number(p.width),Number(p.height),Number(p.depth)];
+  const pose:Pose={position:[(part.x+6)*MM_PER_PX+size[0]/2,Number(p.elevation||0)+size[1]/2,(part.y+6)*MM_PER_PX+size[2]/2],rotation:[Number(p.rotationX||0),-Number(p.rotation||0),Number(p.rotationZ||0)].map(n=>n*Math.PI/180) as V};
+  return {part,role:p.evPhotoStructure?.role||'other',pose,size,box:bounds(part.id,pose,size)};
+ }).filter(o=>[...o.pose.position,...o.pose.rotation,...o.size].every(Number.isFinite)&&o.size.every(n=>n>=2&&n<=500));
+}
+export type Mount={pose:Pose;baseline:V;host?:{id:string;center:V};note:string};
+/** Physical poses survive native XY moves and follow their mounting object. */
+export function mountedPose(part:any,parts:any[],seen=new Set<string>()):Pose|undefined{
+ const mount=part.properties?.evAssembly as Mount|undefined;
+ if(!mount||seen.has(part.id)||![...mount.pose?.position||[],...mount.pose?.rotation||[],...mount.baseline||[]].every(Number.isFinite)||mount.pose?.position?.length!==3||mount.pose?.rotation?.length!==3||mount.baseline?.length!==3)return;
+ seen.add(part.id);
+ const position=plus(mount.pose.position,[(part.x-mount.baseline[0])*MM_PER_PX,0,(part.y-mount.baseline[1])*MM_PER_PX]);
+ if(mount.host){
+  const host=parts.find(p=>p.id===mount.host!.id),hp=host&&(mountedPose(host,parts,seen)?.position||structures([host])[0]?.pose.position);
+  if(hp)for(let i=0;i<3;i++)position[i]+=hp[i]-mount.host.center[i];
+ }
+ return {position,rotation:mount.pose.rotation};
+}
+export function modelBox(part:any,pose:Pose):Box|undefined{const m=hardwareModel(part);return m&&bounds(part.id,pose,[m.width,m.height,m.depth],true);}
+export function modelPin(model:PhysicalModel,pose:Pose,name:string):V|undefined{return model.ports[name]&&plus(pose.position,rotate(model.ports[name],pose.rotation));}
+export function portDirection(model:PhysicalModel,name:string,rotation:V):V{
+ const p=model.ports[name];let normal:V=[0,1,0];
+ if(name!=='GPIO40'){
+  if(model.kind==='motor')normal=[-1,0,0];
+  else if(model.kind==='usb-power'||model.kind==='dc-power')normal=[1,0,0];
+  else if(model.id==='rpi4b')normal=[0,0,1];
+  else if(model.id==='arduino-uno')normal=[0,1,0];
+  else normal=Math.abs(p[0])/(model.width/2)>Math.abs(p[2])/(model.depth/2)?[Math.sign(p[0]),0,0]:[0,0,Math.sign(p[2])];
+ }
+ return rotate(normal,rotation);
+}
+export function structureObstacles(items:Structure[]):Box[]{
+ return items.flatMap(o=>{
+  if(o.role!=='housing')return [o.box];
+  const {min,max}=o.box,t=2; // proposed open-top service envelope, wall thickness UNKNOWN
+  return [{id:o.part.id+'-floor',min,max:[max[0],min[1]+t,max[2]] as V},
+   ...[0,2].flatMap(axis=>[false,true].map(high=>{const a=[...min] as V,b=[...max] as V;if(high)a[axis]=max[axis]-t;else b[axis]=min[axis]+t;return {id:o.part.id+'-wall-'+axis+high,min:a,max:b};}))];
+ });
+}
