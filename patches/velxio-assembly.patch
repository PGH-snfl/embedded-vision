+/** Deterministic candidate search on the photographed chassis. This is a new
+ * assembly proposal, not recovered mounting dimensions or electrical approval. */
+import {hardwareModel,structures,bounds,contains,overlap,modelBox,modelPin,portDirection,mountedPose,structureObstacles,plus,rotate,MM_PER_PX,type V,type Pose,type Structure,type Box,type Mount} from './assemblyGeometry';
+import {routeCable,type CableRoute} from './assemblyRouting';
+export const ASSEMBLY_VERSION='photo-assembly-v1';
+type Placed={part:any;pose:Pose;box:Box;host:Structure|Placed;note:string};
+const digits=(p:V)=>p.map(n=>Math.round(n*1000)/1000) as V;
