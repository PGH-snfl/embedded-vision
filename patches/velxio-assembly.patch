+export type V=[number,number,number];
+/** Same XYZ Euler convention as Three.js: R = Rx Ry Rz. */
+export function rotate(v:V,r:V):V{
+ const [x,y,z]=v,[a,b,c]=r,xc=x*Math.cos(c)-y*Math.sin(c),yc=x*Math.sin(c)+y*Math.cos(c);
+ const xb=xc*Math.cos(b)+z*Math.sin(b),zb=-xc*Math.sin(b)+z*Math.cos(b);
+ return [xb,yc*Math.cos(a)-zb*Math.sin(a),yc*Math.sin(a)+zb*Math.cos(a)];
+}
+export function inverseRotate(v:V,r:V):V{return ([[1,0,0],[0,1,0],[0,0,1]] as V[]).map(axis=>rotate(axis,r).reduce((n,x,i)=>n+x*v[i],0)) as V;}
