+import * as T from 'three';
+let sceneRoot:(()=>T.Object3D|undefined)|undefined;
+export function registerAssemblyScene(getRoot:()=>T.Object3D|undefined){sceneRoot=getRoot;return ()=>{if(sceneRoot===getRoot)sceneRoot=undefined;};}
+/** Transfer the actual rendered product models and routed cables, not substitute boxes. */
+export function captureAssemblyVisual(parts:any[]){
+ const mounted=new Set(parts.filter(p=>p.properties?.evAssembly).map(p=>p.id));
+ if(!mounted.size)return undefined;
+ const root=sceneRoot?.();if(!root)throw Error('3D 조립 화면을 준비한 뒤 다시 실행하세요.');
+ const photo=parts.find(p=>Array.isArray(p.properties?.photoSceneOrigin)),origin=photo?.properties.photoSceneOrigin||[0,0];
+ const out=new T.Group();out.name='assembled-system';
+ root.updateMatrixWorld(true);
+ for(const id of mounted){
+  const outer=root.getObjectByName('ev-part:'+id),body=outer?.getObjectByName('ev-body:'+id);
+  if(!outer||!body)throw Error(id+'의 실물 모델이 아직 준비되지 않았습니다.');
+  const group=new T.Group();group.name='assembly-part:'+id;group.position.copy(outer.position);group.add(body.clone(true));out.add(group);
+ }
+ root.traverse(child=>{if(child.name==='ev-cable')out.add(child.clone(true));});
+ out.position.set(-origin[0]/1000,0,-origin[1]/1000);
+ // Bake deformed/parametric meshes. In particular CurvePath-backed tubes
+ // cannot be reconstructed through ObjectLoader's parametric constructors.
+ const baked=new Map<string,T.BufferGeometry>();
+ out.traverse(child=>{
+  const mesh=child as T.Mesh;if(!mesh.geometry)return;
+  let geometry=baked.get(mesh.geometry.uuid);
+  if(!geometry){geometry=new T.BufferGeometry().copy(mesh.geometry);baked.set(mesh.geometry.uuid,geometry);}
+  mesh.geometry=geometry;
+ });
+ out.updateMatrixWorld(true);
+ const result=out.toJSON();
+ baked.forEach(geometry=>geometry.dispose());
+ if(JSON.stringify(result).length>12_000_000)throw Error('조립 그래픽이 너무 큽니다. 표시할 부품을 줄인 뒤 다시 실행하세요.');
+ return result;
+}
