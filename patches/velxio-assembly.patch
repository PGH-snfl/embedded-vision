+import {type V,type Box,plus,minus,segmentHits,distance,pathLength,simplify} from './assemblyGeometry';
+export type CableRoute={points:V[];lengthMm:number;clear:boolean;reason?:string;binding?:boolean};
+const orders=[[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]];
+const clearPath=(p:V[],obstacles:Box[])=>p.slice(1).every((b,i)=>!obstacles.some(o=>segmentHits(p[i],b,o,1.2)));
+function escape(point:V,normal:V,box:Box):V{
+ let travel=3;
+ for(let i=0;i<3;i++)if(Math.abs(normal[i])>.01)travel=Math.max(travel,((normal[i]>0?box.max[i]:box.min[i])-point[i])/normal[i]+3);
+ return plus(point,normal.map(n=>n*travel) as V);
+}
+/** Orthogonal visibility graph at obstacle faces; no route through solids. */
+export function routeCable(a:V,b:V,aBox:Box,bBox:Box,aNormal:V,bNormal:V,obstacles:Box[],previous:V[][]=[]):CableRoute{
+ const aa=escape(a,aNormal,aBox),bb=escape(b,bNormal,bBox);
+ const relevant=obstacles.filter(o=>o.id!==aBox.id&&o.id!==bBox.id&&!o.id.startsWith(aBox.id+'-body-')&&!o.id.startsWith(bBox.id+'-body-'));
+ if(!clearPath([a,aa],relevant)||!clearPath([bb,b],relevant))return {points:[],lengthMm:0,clear:false,reason:'단자 인출 공간이 다른 부품과 겹칩니다.'};
+ const candidates:V[][]=[];
+ for(const order of orders){const p:V[]=[aa];let q=[...aa] as V;for(const axis of order){q=[...q] as V;q[axis]=bb[axis];p.push(q);}candidates.push(p);}
+ const top=Math.max(a[1],b[1],...obstacles.map(o=>o.max[1]))+5;
+ for(const y of [Math.max(aa[1],bb[1])+4,top,top+5])for(const xFirst of [true,false]){
+  const c:V=[aa[0],y,aa[2]],d:V=[bb[0],y,bb[2]];
+  candidates.push([aa,c,xFirst?[d[0],y,c[2]]:[c[0],y,d[2]],d,bb]);
+ }
+ const cost=(points:V[])=>pathLength(points)+(points.length-2)*2+previous.reduce((score,path)=>score+path.slice(1).filter((end,i)=>{
+  const center=plus(path[i],minus(end,path[i]).map(x=>x*.5) as V);
+  return points.slice(1).some((p,j)=>distance(center,points[j])<3||distance(center,p)<3);
+ }).length*3,0);
+ let best=candidates.filter(p=>clearPath(p,obstacles)).map(p=>simplify([a,...p,b])).sort((p,q)=>cost(p)-cost(q))[0];
+ if(!best){
+  // Sparse 3D grid contains the endpoint axes and inflated obstacle faces.
+  const coords=[0,1,2].map(axis=>[...new Set([aa[axis],bb[axis],...obstacles.flatMap(o=>[o.min[axis]-3,o.max[axis]+3])].map(x=>Math.round(x*100)/100))].sort((a,b)=>a-b));
+  const ix=(p:V)=>p.map((n,i)=>coords[i].indexOf(Math.round(n*100)/100));
+  const start=ix(aa),end=ix(bb),key=(n:number[])=>n.join(','),point=(n:number[])=>n.map((v,i)=>coords[i][v]) as V;
+  const open=[{n:start,g:0,f:distance(aa,bb),dir:-1}],scores=new Map([[key(start),0]]),parents=new Map<string,string>(),nodes=new Map([[key(start),start]]);
+  let visited=0,goal='';
+  while(open.length&&visited++<14000){
+   open.sort((x,y)=>y.f-x.f);const current=open.pop()!,ck=key(current.n);
+   if(current.g>(scores.get(ck)??Infinity))continue;
+   if(ck===key(end)){goal=ck;break;}
+   for(let axis=0;axis<3;axis++)for(const sign of [-1,1]){
+    const n=[...current.n];n[axis]+=sign;if(n[axis]<0||n[axis]>=coords[axis].length)continue;
+    const p=point(current.n),q=point(n);if(!clearPath([p,q],obstacles))continue;
+    const nk=key(n),g=current.g+distance(p,q)+(current.dir!==-1&&current.dir!==axis?2:0);
+    if(g>=(scores.get(nk)??Infinity))continue;scores.set(nk,g);parents.set(nk,ck);nodes.set(nk,n);open.push({n,g,f:g+Math.abs(q[0]-bb[0])+Math.abs(q[1]-bb[1])+Math.abs(q[2]-bb[2]),dir:axis});
+   }
+  }
+  if(goal){const path:V[]=[];for(let k:string|undefined=goal;k;k=parents.get(k))path.push(point(nodes.get(k)!));best=simplify([a,...path.reverse(),b]);}
+ }
+ return best?{points:best,lengthMm:pathLength(best),clear:true}:{points:[],lengthMm:0,clear:false,reason:'충돌 없이 연결되는 경로를 찾지 못했습니다.'};
+}
