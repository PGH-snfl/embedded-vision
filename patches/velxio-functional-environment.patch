+import preset from './environmentPresets.json';
+import {STRUCTURE_ID,structureParameters} from './structureObjects';
+
+export const ENVIRONMENT_KINDS=['planter','container','reservoir','pump','hose'] as const;
+export type EnvironmentKind=typeof ENVIRONMENT_KINDS[number];
+export const ENVIRONMENT_NAMES:Record<EnvironmentKind,string>={planter:'화분',container:'빈 용기',reservoir:'물통',pump:'펌프',hose:'호스'};
+export const ENVIRONMENT_NOTICE=preset.notice;
+export type WaterBinding=typeof preset.binding;
+type Part={id:string;metadataId:string;x:number;y:number;properties:Record<string,unknown>};
+export function environmentKind(props:Record<string,unknown>|undefined):EnvironmentKind|null{
+ return ENVIRONMENT_KINDS.includes(props?.environmentKind as EnvironmentKind)?props!.environmentKind as EnvironmentKind:null;
+}
+export function waterBinding(props:Record<string,unknown>|undefined):WaterBinding|null{
+ if(environmentKind(props)!=='pump'||!props?.waterSystem||typeof props.waterSystem!=='object')return null;
+ const raw=props.waterSystem as Record<string,unknown>,base=preset.binding,result={...base};
+ for(const key of ['boardId','sensorId','outputId','planterId','reservoirId','hoseId'] as const){
+  if(typeof raw[key]!=='string'||! /^[A-Za-z0-9_-]{1,80}$/.test(raw[key]))return null;
+  result[key]=raw[key];
+ }
+ for(const key of ['controlPin','flowMlPerSecond','soilCapacityMl','reservoirCapacityMl','initialReservoirMl','potCapacityMl','absorptionMlPerSecond'] as const){
+  const n=Number(raw[key]);
+  result[key]=Number.isFinite(n)?Math.max(key==='controlPin'?0:1,Math.min(key==='controlPin'?13:10000,n)):base[key];
+ }
+ result.controlPin=Math.round(result.controlPin);
+ result.initialReservoirMl=Math.min(result.initialReservoirMl,result.reservoirCapacityMl);
+ return result;
+}
+export function wateringEnvironmentParts():Part[]{
+ const scale=96/25.4;
+ return preset.objects.map(item=>({id:item.id,metadataId:STRUCTURE_ID,
+  x:((item.center_mm[0]-item.width/2)*scale)-6,y:((item.center_mm[1]-item.depth/2)*scale)-6,
+  properties:{...structureParameters({...item,shape:['pump','hose'].includes(item.kind)?'box':'cylinder'}),
+   label:item.label,environmentKind:item.kind,environmentPreset:'watering-v1',visualOnly:true,
+   designBasis:'authored_functional_environment',
+   ...(item.kind==='pump'?{waterSystem:{...preset.binding}}:{}),...(item.kind==='hose'?{connected:true}:{})}}));
+}
+export function newEnvironmentObject(kind:EnvironmentKind,x:number,y:number):Part{
+ const source=preset.objects.find(p=>p.kind===(kind==='container'?'planter':kind))!;
+ const id='env-'+(globalThis.crypto?.randomUUID?.()||Math.random().toString(36).slice(2));
+ return {id,metadataId:STRUCTURE_ID,x,y,properties:{
+  ...structureParameters({...source,shape:['pump','hose'].includes(kind)?'box':'cylinder'}),
+  environmentKind:kind,label:ENVIRONMENT_NAMES[kind],visualOnly:true,designBasis:'user_authored_object',
+  ...(kind==='hose'?{connected:true}:{})}};
+}
+/** Upgrade old watering drafts once; a user's later deletions remain deleted. */
+export function withFunctionalEnvironment<T extends {components?:Part[];embeddedVision?:Record<string,unknown>}>(project:T):T{
+ if(project.embeddedVision?.recipe!==preset.recipe||Number(project.embeddedVision?.environment_design_version)>=preset.version)return project;
+ const existing=project.components||[],ids=new Set(existing.map(p=>p.id));
+ const parts=wateringEnvironmentParts();
+ // Never give a colliding circuit component a new visual role.
+ if(parts.some(p=>ids.has(p.id)&&!environmentKind(existing.find(e=>e.id===p.id)?.properties)))return project;
+ return {...project,components:[...existing,...parts.filter(p=>!ids.has(p.id))],
+  embeddedVision:{...project.embeddedVision,environment_design_version:preset.version}};
+}
