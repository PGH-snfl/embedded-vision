+
+let root:Root,frames:FrameRequestCallback[],led:HTMLElement;const inputs:number[]=[];
+beforeEach(()=>{
+ vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT',true);frames=[];inputs.length=0;clock.ms=0;clock.high=false;clock.duty=0;
+ vi.stubGlobal('requestAnimationFrame',(cb:FrameRequestCallback)=>{frames.push(cb);return frames.length;});
+ vi.stubGlobal('cancelAnimationFrame',()=>{});
+ native.setState({components:[...wateringEnvironmentParts(),{id:'S1',metadataId:'potentiometer',x:0,y:0,properties:{value:800}},{id:'D1',metadataId:'led',x:0,y:0,properties:{}}],boards:[{id:'U1',boardKind:'arduino-uno',running:true}] as never,running:true});
+ led=document.createElement('div');led.id='D1';document.body.appendChild(led);
+ registerSensorUpdate('S1',v=>inputs.push(Number(v.value)));
+ root=createRoot(document.createElement('div'));act(()=>root.render(React.createElement(EnvironmentRuntime)));
+});
+afterEach(()=>{act(()=>root.unmount());unregisterSensorUpdate('S1');led.remove();vi.unstubAllGlobals();});
+const frame=(ms:number)=>act(()=>{clock.ms=ms;frames.shift()!(ms);});
+it('requires live MCU output and solved LED light, pauses on stop, and blocks a missing hose',()=>{
+ frame(0);frame(100);expect(useEnvironmentStore.getState().water?.deliveredMl).toBe(0);
+ clock.high=true;frame(200);expect(useEnvironmentStore.getState().water?.deliveredMl).toBe(0);
+ emitLedOutput(led,'D1',1,200);frame(300);
