+
+/** One persistent world per editor. Views consume it; changing the camera never resets it. */
+export function EnvironmentRuntime(){
+ const signature=native(s=>JSON.stringify(s.components.filter(c=>environmentKind(c.properties)==='pump'&&waterBinding(c.properties)).map(c=>[c.id,waterBinding(c.properties)])));
+ const hydration=native(s=>s.hydrationSeq),reset=native(s=>s.sensorResetNonce);
+ useEffect(()=>{
+  const pump=native.getState().components.find(c=>environmentKind(c.properties)==='pump'&&waterBinding(c.properties));
+  const binding=pump&&waterBinding(pump.properties);
+  if(!pump||!binding){useEnvironmentStore.setState({systemId:null,binding:null,water:null});return;}
+  const sensor=native.getState().components.find(c=>c.id===binding.sensorId);
+  useEnvironmentStore.setState({systemId:pump.id,binding,water:initialWaterState(binding,Number(sensor?.properties?.value??800))});
+  let frame=0,previousMs:number|null=null,lastInjected:number|null=null,lastFeedbackMs=-Infinity;
+  const tick=()=>{
+   frame=requestAnimationFrame(tick);
