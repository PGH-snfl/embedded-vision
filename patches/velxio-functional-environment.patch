+import type {WaterBinding} from './environmentObjects';
+
+export type WaterState={reservoirMl:number;potWaterMl:number;soilWaterMl:number;deliveredMl:number;
+ flowMlPerSecond:number;flowTimeMs:number;pumpCommand:number;guestMs:number;fault:string;running:boolean};
+const clamp=(n:number,min:number,max:number)=>Math.max(min,Math.min(max,Number.isFinite(n)?n:min));
+export function initialWaterState(binding:WaterBinding,adc:number):WaterState{
+ return {reservoirMl:binding.initialReservoirMl,potWaterMl:0,
+  soilWaterMl:(1-clamp(adc,0,1023)/1023)*binding.soilCapacityMl,deliveredMl:0,
+  flowMlPerSecond:0,flowTimeMs:0,pumpCommand:0,guestMs:0,fault:'',running:false};
+}
+export function soilAdc(state:WaterState,binding:WaterBinding){
+ return Math.round(1023*(1-clamp(state.soilWaterMl/binding.soilCapacityMl,0,1)));
+}
+/** Conservative volume accounting. dt is simulated MCU time, never display time. */
+export function advanceWater(state:WaterState,dtSeconds:number,power:number,binding:WaterBinding,connected=true):WaterState{
+ const dt=Number.isFinite(dtSeconds)?Math.max(0,dtSeconds):0,command=clamp(power,0,1);
+ const rate=connected?binding.flowMlPerSecond*command:0;
+ const soilSpace=Math.max(0,binding.soilCapacityMl-state.soilWaterMl);
+ const possible=Math.min(state.reservoirMl,rate*dt);
+ const absorption=Math.min(soilSpace,binding.absorptionMlPerSecond*dt,state.potWaterMl+possible);
+ const delivered=Math.min(possible,Math.max(0,binding.potCapacityMl-state.potWaterMl)+absorption);
+ const absorbed=Math.min(soilSpace,binding.absorptionMlPerSecond*dt,state.potWaterMl+delivered);
+ const reservoirMl=Math.max(0,state.reservoirMl-delivered);
+ const potWaterMl=clamp(state.potWaterMl+delivered-absorbed,0,binding.potCapacityMl);
+ const flowing=connected&&command>0&&reservoirMl>1e-6&&(potWaterMl<binding.potCapacityMl-1e-6||absorbed>0);
+ return {...state,reservoirMl,potWaterMl,soilWaterMl:state.soilWaterMl+absorbed,
+  deliveredMl:state.deliveredMl+delivered,flowMlPerSecond:flowing?rate:0,
+  flowTimeMs:state.flowTimeMs+(rate>0?delivered/rate*1000:0),pumpCommand:command,
+  guestMs:state.guestMs+dt*1000,running:true,
+  fault:!connected?'급수 대상·물통·호스 연결을 확인하세요.':command>0&&reservoirMl<=1e-6?'물통이 비었습니다.':
+   command>0&&!flowing?'용기가 가득 찼습니다.':''};
+}
