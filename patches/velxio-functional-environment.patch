+// @vitest-environment jsdom
+import {afterEach,expect,it,vi} from 'vitest';
+import HEX from './fixtures/watering-control.ino.hex?raw';
+import preset from '../components/circuitiny/environmentPresets.json';
+import {advanceWater,initialWaterState,soilAdc} from '../components/circuitiny/wateringModel';
+import {AVRSimulator} from '../simulation/AVRSimulator';
+import {PinManager} from '../simulation/PinManager';
+import {PartSimulationRegistry} from '../simulation/parts/PartSimulationRegistry';
+import {dispatchSensorUpdate} from '../simulation/SensorUpdateRegistry';
+import '../simulation/parts/ComplexParts';
+const b=preset.binding;
+let sim:AVRSimulator|undefined,detach:(()=>void)|undefined;
+afterEach(()=>{detach?.();sim?.stop();vi.unstubAllGlobals();});
+const volume=(s:ReturnType<typeof initialWaterState>)=>s.reservoirMl+s.potWaterMl+s.soilWaterMl;
+it('conserves volume with bounded water levels and follows simulated elapsed time',()=>{
+ const initial=initialWaterState(b,800),one=advanceWater(initial,1,1,b);
+ let split=initial;for(let i=0;i<100;i++)split=advanceWater(split,.01,1,b);
+ expect(one.deliveredMl).toBe(30);expect(one.soilWaterMl-initial.soilWaterMl).toBeCloseTo(12,8);
+ expect(split.deliveredMl).toBeCloseTo(one.deliveredMl,8);expect(volume(one)).toBeCloseTo(volume(initial),8);
+ let full=initial;for(let i=0;i<2000;i++)full=advanceWater(full,.02,1,b);
+ expect(volume(full)).toBeCloseTo(volume(initial),6);expect(full.reservoirMl).toBe(0);
+ expect(full.soilWaterMl).toBeLessThanOrEqual(b.soilCapacityMl);expect(full.potWaterMl).toBeLessThanOrEqual(b.potCapacityMl);
+ expect(full.flowMlPerSecond).toBe(0);expect(full.fault).toContain('비었습니다');
+});
+it('does not deliver water while off, paused, disconnected, empty or full',()=>{
+ const s=initialWaterState(b,800);
+ for(const next of [advanceWater(s,1,0,b),advanceWater(s,0,1,b),advanceWater(s,1,1,b,false)])expect(next.deliveredMl).toBe(0);
+ expect(advanceWater({...s,reservoirMl:0},1,1,b).flowMlPerSecond).toBe(0);
+ expect(advanceWater({...s,potWaterMl:b.potCapacityMl,soilWaterMl:b.soilCapacityMl},1,1,b).deliveredMl).toBe(0);
+ expect(advanceWater(s,1,1,b,false).fault).toContain('연결');
+ expect(soilAdc({...s,soilWaterMl:b.soilCapacityMl},b)).toBe(0);
+});
+it.each([.5,1,2])('compiled UNO code waters dry soil and switches itself off after sensor feedback at %sx',speed=>{
+ const frames:FrameRequestCallback[]=[];
+ vi.stubGlobal('requestAnimationFrame',(cb:FrameRequestCallback)=>{frames.push(cb);return frames.length;});
+ vi.stubGlobal('cancelAnimationFrame',()=>{});
+ const pm=new PinManager();sim=new AVRSimulator(pm);sim.loadHex(HEX);sim.setSpeed(speed);
+ const sensor=document.createElement('div') as unknown as HTMLElement&{value:number};sensor.value=800;
+ detach=PartSimulationRegistry.get('potentiometer')!.attachEvents!(sensor,sim as never,pin=>pin==='SIG'?14:null,'water-sensor')||undefined;
+ let water=initialWaterState(b,800),previous=0,onAt:number|null=null,offAt:number|null=null,hadOn=false;
+ sim.start();frames.shift()!(0);
+ for(let wall=10;wall<=6000/speed;wall+=10){
+  frames.shift()!(wall);
+  const guest=sim.getCurrentCycles()/sim.getClockHz()*1000,power=pm.getPinState(5)?1:0;
+  if(power&&!hadOn){onAt=guest;hadOn=true;}
+  if(!power&&hadOn&&offAt===null)offAt=guest;
+  water=advanceWater(water,(guest-previous)/1000,power,b);previous=guest;
+  dispatchSensorUpdate('water-sensor',{value:soilAdc(water,b)});
+ }
+ expect(pm.getOutputPins().has(5)).toBe(true);expect(onAt).not.toBeNull();expect(offAt).not.toBeNull();
+ expect(offAt!).toBeGreaterThan(2300);expect(offAt!).toBeLessThan(3200);
+ expect(pm.getPinState(5)).toBe(false);expect(water.deliveredMl).toBeGreaterThan(60);expect(water.deliveredMl).toBeLessThan(100);
+ expect(soilAdc(water,b)).toBeLessThan(500);expect(volume(water)).toBeCloseTo(volume(initialWaterState(b,800)),5);
+});
