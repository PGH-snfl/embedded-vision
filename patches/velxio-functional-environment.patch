+import {useEffect} from 'react';
+import {useSimulatorStore as native,getBoardSimulator,getBoardPinManager} from '../../store/useSimulatorStore';
+import {getSensorUpdate,getLastSensorValues,dispatchSensorUpdate} from '../../simulation/SensorUpdateRegistry';
+import {lastLedOutput} from '../../simulation/ledOutput';
+import {environmentKind,waterBinding} from './environmentObjects';
