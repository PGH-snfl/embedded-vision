+import * as T from 'three';
+type V=[number,number,number];
+export type PhotoPiece={shape:'box'|'cylinder'|'sphere';position:V;size:V;rotation:V;color:string};
+export type PhotoGeometry={shape?:string;size?:V;outline?:number[][]|null;holes?:number[][][];details?:PhotoPiece[]};
+const vector=(a:unknown,f:V):V=>Array.isArray(a)&&a.length===3&&a.every(n=>typeof n==='number'&&Number.isFinite(n)&&Math.abs(n)<=7)?a as V:f;
+function profile(raw:unknown):T.Vector2[]|null{
+ if(!Array.isArray(raw)||raw.length<3||raw.length>24)return null;
+ if(raw.some(p=>!Array.isArray(p)||p.length!==2||p.some(n=>typeof n!=='number'||!Number.isFinite(n)||Math.abs(n)>.5)))return null;
+ return raw.map(p=>new T.Vector2(p[0],-p[1]));
+}
+/** Shared actual mesh factory; no role-based wheel, leg or robot replacement. */
+export function photoGeometryMesh(raw:PhotoGeometry,color:string,ghost=false,selected=false){
+ const group=new T.Group();group.name='photo-derived-geometry';
+ const material=(c:string)=>new T.MeshStandardMaterial({color:/^#[0-9a-f]{6}$/i.test(c)?c:color,
+  metalness:.12,roughness:.58,transparent:ghost,opacity:ghost?.18:1,depthWrite:!ghost,
+  emissive:selected?'#9bd1ff':'#000000',emissiveIntensity:selected?.3:0});
+ const points=profile(raw.outline);let geometry:T.BufferGeometry;
+ if(points){const shape=new T.Shape(points);for(const hole of (Array.isArray(raw.holes)?raw.holes:[]).slice(0,6)){const p=profile(hole);if(p)shape.holes.push(new T.Path(p));}
+  geometry=new T.ExtrudeGeometry(shape,{depth:1,bevelEnabled:false,curveSegments:8,steps:1});
+  geometry.translate(0,0,-.5);geometry.rotateX(-Math.PI/2);
+ }else geometry=raw.shape==='sphere'?new T.SphereGeometry(.5,24,16):raw.shape==='cylinder'?new T.CylinderGeometry(.5,.5,1,40):new T.BoxGeometry(1,1,1);
+ const base=new T.Mesh(geometry,material(color));base.name='photo-base';base.castShadow=!ghost;base.receiveShadow=true;group.add(base);
+ for(const [i,p] of (Array.isArray(raw.details)?raw.details:[]).slice(0,12).entries()){
+  if(!p||!['box','cylinder','sphere'].includes(p.shape))continue;
+  const g=p.shape==='sphere'?new T.SphereGeometry(.5,20,12):p.shape==='cylinder'?new T.CylinderGeometry(.5,.5,1,28):new T.BoxGeometry(1,1,1);
+  const mesh=new T.Mesh(g,material(p.color));mesh.name='photo-detail-'+i;
+  const dims=vector(raw.size,[1,1,1]).map(n=>Math.max(.002,n)) as V,
+   position=vector(p.position,[0,0,0]),size=vector(p.size,[1,1,1]),
+   rotation=new T.Quaternion().setFromEuler(new T.Euler(...vector(p.rotation,[0,0,0])));
+  // Compensate the parent's nonuniform scale before rotating a detail. A
+  // thin sensor plate must not squash its round transducers into ellipses.
+  let physical=size.map((n,j)=>n*dims[j]) as V;
+  if(p.shape==='cylinder'){
+   const basis=[new T.Vector3(1,0,0),new T.Vector3(0,1,0),new T.Vector3(0,0,1)].map(v=>v.applyQuaternion(rotation).multiply(new T.Vector3(...dims)).length());
+   const radiusScale=Math.min(basis[0],basis[2]);physical=[size[0]*radiusScale,size[1]*basis[1],size[2]*radiusScale];
+  }else if(p.shape==='sphere')physical=size.map(n=>n*Math.min(...dims)) as V;
+  mesh.matrixAutoUpdate=false;
+  mesh.matrix.makeScale(...dims.map(n=>1/n) as V).multiply(new T.Matrix4().compose(
+   new T.Vector3(...position.map((n,j)=>n*dims[j]) as V),rotation,new T.Vector3(...physical)));
+  mesh.castShadow=!ghost;mesh.receiveShadow=true;group.add(mesh);
+ }
+ return group;
+}
